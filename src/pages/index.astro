---
import ToolLayout from '../layouts/ToolLayout.astro';
import tools from '../data/tools.json';

const allTools = tools.categories.flatMap(c => c.tools);
const featured = ['password-generator', 'qr-generator', 'json-formatter', 'subnetting', 'color-picker', 'unit-converter', 'markdown-to-html', 'image-resizer'];
const featuredTools = featured.map(s => allTools.find(t => t.slug === s)).filter(Boolean);

function getIcon(slug) {
  const icons = {
    'hash-generator': '#', 'uuid-generator': 'U', 'base64-coded': 'B64', 'json-formatter': '{}',
    'password-generator': '🔑', 'qr-generator': '▐▌', 'subnetting': '🌐', 'color-picker': '🎨',
    'unit-converter': '⇄', 'markdown-to-html': 'MD', 'image-resizer': '🖼', 'css-minifier': 'CSS',
    'json-to-typescript': 'TS', 'json-schema-generator': '📋', 'email-validator': '@',
    'password-memorable': '🔐', 'user-agent-parser': '🖥', 'color-converter': '🌈', 'word-frequency': '📊',
  };
  return icons[slug] || '⚡';
}
function getColor(slug) {
  const c = {
    'hash-generator': '#ef4444', 'uuid-generator': '#8b5cf6', 'password-generator': '#10b981',
    'qr-generator': '#6366f1', 'json-formatter': '#f59e0b', 'subnetting': '#0ea5e9',
    'color-picker': '#e11d48', 'unit-converter': '#14b8a6', 'markdown-to-html': '#059669',
    'image-resizer': '#8b5cf6', 'css-minifier': '#3b82f6', 'json-to-typescript': '#3178c6',
    'email-validator': '#06b6d4',
  };
  return c[slug] || '#6366f1';
}
---

<ToolLayout
  title="WebApps Naufal Rakha - 86+ Online Developer Tools"
  description="Koleksi 86+ online tools gratis untuk developer: password generator, hash generator, QR code, subnetting, JSON, dan banyak lagi. 100% di browser, tanpa server."
  keywords="web tools, online tools, developer tools, web apps, password generator, hash generator, qr code, json formatter"
>
  <!-- Hero -->
  <div class="hero-section" style="background:linear-gradient(135deg,#6366f1,#8b5cf6,#a855f7);color:#fff;border:none;">
    <div class="d-flex flex-wrap align-items-center gap-4">
      <div style="flex:1;min-width:200px">
        <h1 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:800;letter-spacing:-.03em;" class="mb-2">🚀 WebApps</h1>
        <p style="font-size:.95rem;opacity:.9;max-width:500px">86+ online tools gratis. Semua jalan di browser — data ga pernah ke server.</p>
        <div class="stats-bar d-flex gap-4 flex-wrap mt-3" style="opacity:.85">
          <div><strong style="font-size:1.15rem;">{allTools.length}</strong> <span style="font-size:.8rem">Tools</span></div>
          <div><strong style="font-size:1.15rem;">6</strong> <span style="font-size:.8rem">Kategori</span></div>
          <div><strong style="font-size:1.15rem;">0</strong> <span style="font-size:.8rem">Server</span></div>
          <div><strong style="font-size:1.15rem;">100%</strong> <span style="font-size:.8rem">Gratis</span></div>
        </div>
      </div>
      <div style="font-size:3.5rem;opacity:.3;line-height:1;user-select:none;">⚡</div>
    </div>
  </div>

  <!-- Search -->
  <div class="mb-4">
    <div class="input-group">
      <span class="input-group-text bg-white border-end-0" style="border-color:var(--border)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </span>
      <input type="search" id="toolSearch" class="form-control border-start-0" placeholder="Cari tool... (contoh: password, hash, json)" aria-label="Cari tool" style="border-radius:0 .5rem .5rem 0">
    </div>
    <div class="form-text text-center mt-1">
      <span id="toolCount">{allTools.length}</span> tools tersedia &nbsp;|&nbsp; Tekan <kbd>/</kbd> untuk fokus pencarian
    </div>
  </div>

  <!-- Category quick jump -->
  <div class="cat-quick mb-4">
    {tools.categories.map(cat => (
      <a href={`#cat-${cat.name.replace(/\s+/g, '-')}`} class="cat-chip">{cat.icon} {cat.name}</a>
    ))}
  </div>

  <!-- Featured tools -->
  <div class="mb-4" id="pinnedSection" style="display:none">
    <h5 class="fw-bold mb-3">⭐ Pinned</h5>
    <div class="tool-grid" id="pinnedGrid"></div>
  </div>

  <div class="mb-4">
    <h5 class="fw-bold mb-3">🔥 Featured</h5>
    <div class="tool-grid">
      {featuredTools.map(t => (
        <a href={`/tools/${t.slug}`} class="tool-card-sm">
          <div class="tc-icon" style="background:var(--accent-soft);color:var(--accent);font-size:1rem;">
            {getIcon(t.slug)}
          </div>
          <div style="flex:1;min-width:0">
            <div class="tc-name">{t.name}</div>
            <div class="tc-desc">{t.desc}</div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- All tools by category -->
  <div id="toolGrid">
    {tools.categories.map(cat => (
      <div data-category={cat.name} id={`cat-${cat.name.replace(/\s+/g, '-')}`}>
        <h5 class="fw-bold mb-3 mt-3 d-flex align-items-center gap-2">
          {cat.icon}
          <span>{cat.name}</span>
          <span class="tag-badge">{cat.tools.length}</span>
        </h5>
        <div class="tool-grid">
          {cat.tools.map(t => (
            <a href={`/tools/${t.slug}`} class="tool-card-sm" data-slug={t.slug}>
              <div class="tc-icon" style={`background:${getColor(t.slug)}15;color:${getColor(t.slug)};`}>
                {getIcon(t.slug)}
              </div>
              <div style="flex:1;min-width:0">
                <div class="tc-name">{t.name}</div>
                <div class="tc-desc">{t.desc}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div id="noResults" class="text-center py-5" style="display:none;">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-muted mb-3"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <h5 class="text-muted">Tidak ada tool yang cocok</h5>
    <p class="text-muted small">Coba kata kunci lain</p>
  </div>
</ToolLayout>

<script is:inline>
const search = document.getElementById('toolSearch');
const grid = document.getElementById('toolGrid');
const count = document.getElementById('toolCount');
const noResults = document.getElementById('noResults');
const allCards = Array.from(document.querySelectorAll('[data-slug]'));

const getPinned = () => JSON.parse(localStorage.getItem('pinnedTools2') || '[]');
const setPinned = (arr) => localStorage.setItem('pinnedTools2', JSON.stringify(arr));
const pinnedSection = document.getElementById('pinnedSection');
const pinnedGrid = document.getElementById('pinnedGrid');

function updatePinned() {
  const pinned = getPinned();
  if (pinned.length === 0) { pinnedSection.style.display = 'none'; return; }
  pinnedSection.style.display = 'block';
  pinnedGrid.innerHTML = '';
  pinned.forEach(slug => {
    const card = allCards.find(c => c.dataset.slug === slug);
    if (card) {
      const clone = card.cloneNode(true);
      const btn = document.createElement('button');
      btn.className = 'btn btn-sm btn-outline-danger py-0 px-1';
      btn.textContent = '×';
      btn.style.cssText = 'position:absolute;top:-4px;right:-4px;width:20px;height:20px;border-radius:50%;padding:0;font-size:11px;line-height:1;z-index:2';
      btn.onclick = (e) => { e.preventDefault(); setPinned(getPinned().filter(s => s !== slug)); updatePinned(); };
      clone.style.position = 'relative';
      clone.prepend(btn);
      pinnedGrid.appendChild(clone);
    }
  });
}

search.addEventListener('input', function() {
  const q = this.value.toLowerCase().trim();
  let visible = 0;
  allCards.forEach(card => {
    const ok = !q || card.textContent.toLowerCase().includes(q);
    card.closest('[data-category]').style.display = ok ? '' : 'none';
    if (ok) visible++;
  });
  count.textContent = visible;
  noResults.style.display = visible === 0 && q ? 'block' : 'none';
});

document.addEventListener('keydown', (e) => {
  if (e.key === '/' && document.activeElement !== search) { e.preventDefault(); search.focus(); }
});

// Pin on double-click
allCards.forEach(card => {
  card.addEventListener('dblclick', (e) => {
    e.preventDefault();
    const slug = card.dataset.slug;
    const pinned = getPinned();
    if (pinned.includes(slug)) {
      setPinned(pinned.filter(s => s !== slug));
    } else {
      pinned.push(slug);
      setPinned(pinned);
    }
    updatePinned();
  });
});

updatePinned();
</script>