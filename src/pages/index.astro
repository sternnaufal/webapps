---
import ToolLayout from '../layouts/ToolLayout.astro';
import tools from '../data/tools.json';

const allTools = tools.categories.flatMap(c => c.tools);
const catCount = tools.categories.length;
const featured = ['password-generator', 'qr-generator', 'json-formatter', 'color-picker', 'subnetting', 'hash-generator', 'uuid-generator', 'regex-tester', 'typing-speed-test', 'unit-converter'];
const featuredTools = featured.map(s => allTools.find(t => t.slug === s)).filter(Boolean);

const catAccent: Record<string, string> = {
  'Developer Tools': '#6366f1',
  'Network & URL': '#3b82f6',
  'Text & Media': '#f59e0b',
  'Generators': '#10b981',
  'Converters': '#8b5cf6',
  'Utilities': '#14b8a6',
};
const slugCat: Record<string, string> = {};
tools.categories.forEach(c => c.tools.forEach(t => { slugCat[t.slug] = c.name; }));
function catColor(slug: string): string { return catAccent[slugCat[slug]] || '#6366f1'; }

const iconMap: Record<string, string> = {
  'password-generator': '🔑', 'qr-generator': '▐▌', 'json-formatter': '{}', 'subnetting': '📐',
  'color-picker': '🎨', 'hash-generator': '#', 'uuid-generator': '🆔', 'regex-tester': '.*',
  'typing-speed-test': '⌨', 'unit-converter': '⇄', 'image-resizer': '🖼', 'base64-coded': 'B64',
  'diff-checker': '⇔', 'sql-formatter': 'SQL', 'yaml-json': '⇄', 'meta-tag-generator': '🏷',
  'ascii-table': 'A', 'css-minifier': 'CSS', 'url-encode': '%', 'cron-builder': '⏰',
  'mac-address-generator': '🔗', 'user-agent-parser': '🖥', 'textcase': 'Aa', 'lorem-ipsum': '¶',
  'md-preview': 'MD', 'image-to-base64': '🖼', 'color-converter': '🌈', 'gradient-generator': '◐',
  'contrast-checker': '◐', 'html-preview': '</>', 'http-status': '📡', 'char-counter': '#',
  'jwt-decoder': 'JWT', 'json-csv': '⇄', 'css-unit': 'px', 'html-entity': '&',
  'random-color-generator': '🎰', 'epoch-converter': '⏱', 'avatar-generator': '👤',
  'barcode-generator': '▮▯', 'email-validator': '@', 'password-memorable': '🔐',
  'password-strength': '💪', 'bmi-calculator': '⚖', 'tip-calculator': '💰',
  'decision-maker': '🎲', 'age-calculator': '🎂', 'percentage-calculator': '%',
  'pomodoro': '🍅', 'countdown': '⏳', 'savings-calculator': '🏦', 'number-to-words': '🔤',
  'roman-numeral': 'IV', 'sleep-cycle': '😴', 'calorie-calculator': '🍎',
  'discount-calculator': '🏷', 'mortgage-calculator': '🏠', 'dice-roller': '🎲',
  'screen-recorder': '⏺', 'world-clock': '🌍', 'rsa-generator': '🔒',
  'random-number-generator': '🎲', 'markdown-to-html': '▶', 'text-repeater': '×',
  'reverse-text': '↩', 'list-sorter': '↕', 'morse-code-converter': '···',
  'word-frequency': '📊', 'palindrome-checker': '↔', 'anagram-finder': '🔀',
  'konverter-bilangan': '2', 'time-converter': '🌍', 'date-calculator': '📅',
  'decimal-to-fraction': '½', 'timer': '⏱', 'stopwatch': '⏱', 'notes-app': '📝',
  'csv-viewer': '📊',   'word-counter': 'W', 'compound-interest-calculator': '$', 'emoji-picker': '😊', 'slug-generator': '🔗', 'html-minifier': '</>',
  'default': '⚡',
};

function icon(slug: string): string { return iconMap[slug] || iconMap.default; }

const colMap: Record<string, string> = {
  'password-generator': '#10b981', 'qr-generator': '#6366f1', 'json-formatter': '#f59e0b',
  'color-picker': '#e11d48', 'subnetting': '#0ea5e9', 'hash-generator': '#ef4444',
  'uuid-generator': '#8b5cf6', 'regex-tester': '#10b981', 'typing-speed-test': '#6366f1',
  'unit-converter': '#14b8a6', 'image-resizer': '#8b5cf6', 'base64-coded': '#06b6d4',
  'diff-checker': '#6366f1', 'sql-formatter': '#3b82f6', 'yaml-json': '#f97316',
  'meta-tag-generator': '#ec4899', 'ascii-table': '#14b8a6', 'css-minifier': '#3b82f6',
  'url-encode': '#8b5cf6', 'cron-builder': '#a855f7', 'mac-address-generator': '#6366f1',
  'user-agent-parser': '#64748b', 'textcase': '#f43f5e', 'lorem-ipsum': '#64748b',
  'md-preview': '#059669', 'image-to-base64': '#0ea5e9',   'color-converter': '#8b5cf6',
  'emoji-picker': '#ca8a04', 'html-minifier': '#16a34a', 'slug-generator': '#14b8a6', 'word-counter': '#ea580c', 'compound-interest-calculator': '#059669',
};
function col(slug: string): string { return colMap[slug] || '#6366f1'; }
---

<ToolLayout title={`WebApps - ${allTools.length}+ Online Tools Gratis`} description={`${allTools.length}+ online tools gratis untuk developer. 100% di browser, tanpa server.`} wide>
  <!-- Hero -->
  <div class="mb-10">
    <div class="flex items-start gap-4 mb-4">
      <div class="w-12 h-12 rounded-xl bg-primary text-primary-content flex items-center justify-center text-xl font-bold shrink-0">W</div>
      <div>
        <h1 class="text-3xl lg:text-4xl font-bold tracking-tight" style="letter-spacing:-0.03em;">WebApps</h1>
        <p class="text-sm mt-1 opacity-60 max-w-lg">{allTools.length} tools gratis — semua jalan di browser, data ga pernah ke server.</p>
      </div>
    </div>
    <div class="flex flex-wrap gap-3">
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg" style="background:oklch(0.97 0.003 270);">
        <span class="text-sm font-bold">{allTools.length}</span>
        <span class="text-xs opacity-50">Tools</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg" style="background:oklch(0.97 0.003 270);">
        <span class="text-sm font-bold">{catCount}</span>
        <span class="text-xs opacity-50">Kategori</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg" style="background:oklch(0.97 0.003 270);">
        <span class="text-sm font-bold">100%</span>
        <span class="text-xs opacity-50">Gratis</span>
      </div>
    </div>
  </div>

  <!-- Search -->
  <div class="mb-8">
    <div class="relative max-w-md">
      <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 opacity-30" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" clip-rule="evenodd"/></svg>
      <input type="search" id="toolSearch" class="input input-bordered w-full pl-9 py-2.5 text-sm" placeholder="Cari tool..." />
      <kbd class="kbd kbd-sm absolute right-2.5 top-1/2 -translate-y-1/2 opacity-30 hidden sm:inline text-[10px]">/</kbd>
    </div>
    <p class="text-xs opacity-40 mt-1.5"><span id="toolCount">{allTools.length}</span> tools tersedia</p>
  </div>

  <!-- Category Pills -->
  <div class="flex flex-wrap gap-2 mb-8">
    {tools.categories.map(cat => {
      const slug = cat.name.toLowerCase().replace(/[\s&]+/g, '-').replace(/[^a-z0-9-]/g, '');
      return (
        <a href={`/tools/category/${slug}`} class="btn btn-xs rounded-full gap-1.5 font-normal opacity-60 hover:opacity-100 transition-opacity">
          {cat.icon} {cat.name}
        </a>
      );
    })}
  </div>

  <!-- Featured -->
  <div class="mb-10">
    <h2 class="text-sm font-semibold mb-3 flex items-center gap-1.5 opacity-70">
      <span>★</span> Featured
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2.5">
      {featuredTools.map(t => (
        <a href={`/tools/${t.slug}`} class="tool-card" data-slug={t.slug} style={`border-top:3px solid ${catColor(t.slug)}`}>
          <div class="tool-card-icon" style={`background:${col(t.slug)}15;color:${col(t.slug)}`}>{icon(t.slug)}</div>
          <div class="min-w-0 flex-1">
            <div class="tool-card-name">{t.name}</div>
            <div class="tool-card-desc">{t.desc}</div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- All Categories -->
  <div id="toolGrid">
    {tools.categories.map(cat => (
      <div data-category={cat.name} id={`cat-${cat.name.replace(/\s+/g, '-')}`} class="mb-8">
        <h2 class="text-sm font-semibold mb-3 flex items-center gap-1.5 opacity-70">
          {cat.icon} {cat.name}
          <span class="text-[10px] opacity-40 ml-0.5">{cat.tools.length}</span>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2.5">
          {cat.tools.map(t => (
            <a href={`/tools/${t.slug}`} class="tool-card" data-slug={t.slug} style={`border-top:3px solid ${catColor(t.slug)}`}>
              <div class="tool-card-icon" style={`background:${col(t.slug)}15;color:${col(t.slug)}`}>{icon(t.slug)}</div>
              <div class="min-w-0 flex-1">
                <div class="tool-card-name">{t.name}</div>
                <div class="tool-card-desc">{t.desc}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- No Results -->
  <div id="noResults" class="hidden text-center py-16">
    <div class="text-2xl mb-3 opacity-20">🔍</div>
    <p class="font-medium">Tidak ada tool yang cocok</p>
    <p class="text-xs opacity-40 mt-1">Coba kata kunci lain. Tekan <kbd class="kbd kbd-xs">Esc</kbd> untuk reset.</p>
  </div>

  <!-- Keyboard Shortcuts Help (hidden by default) -->
  <div id="shortcutsHelp" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm" onclick="closeHelp(event)">
    <div class="rounded-xl p-6 max-w-sm w-full mx-4 shadow-2xl" style="background:oklch(1 0 0);border:1px solid oklch(0.9 0.005 270);" onclick="event.stopPropagation()">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-bold">Pintasan Keyboard</h3>
        <button onclick="closeHelp()" class="btn btn-ghost btn-xs btn-square opacity-40 hover:opacity-100" aria-label="Tutup">&times;</button>
      </div>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between items-center"><span class="opacity-60">Cari tool</span><span><kbd class="kbd kbd-xs">/</kbd> atau <kbd class="kbd kbd-xs">Ctrl+K</kbd></span></div>
        <div class="flex justify-between items-center"><span class="opacity-60">Tutup / Reset</span><span><kbd class="kbd kbd-xs">Esc</kbd></span></div>
        <div class="flex justify-between items-center"><span class="opacity-60">Bantuan ini</span><span><kbd class="kbd kbd-xs">?</kbd></span></div>
      </div>
    </div>
  </div>
</ToolLayout>

<script is:inline>
(function(){
var s=document.getElementById('toolSearch'),g=document.getElementById('toolGrid'),c=document.getElementById('toolCount'),n=document.getElementById('noResults'),h=document.getElementById('shortcutsHelp');
var cards=Array.from(g.querySelectorAll('[data-slug]'));
var t=null;

function filter(q){
  q=q.toLowerCase().trim();
  var v=0;
  cards.forEach(function(cd){
    var ok=!q||cd.textContent.toLowerCase().includes(q);
    cd.closest('[data-category]').style.display=ok?'':'none';
    if(ok)v++;
  });
  c.textContent=v;
  n.classList.toggle('hidden',v>0||!q);
}

s.addEventListener('input',function(){
  clearTimeout(t);
  var val=this.value;
  t=setTimeout(function(){filter(val)},150);
});

function closeHelp(e){
  if(!e||e.target===h){h.classList.add('hidden')}
}

document.addEventListener('keydown',function(e){
  var key=e.key;
  var isSearchFocused=document.activeElement===s;

  // / or Ctrl+K -> focus search
  if((key==='/'||(key==='k'&&(e.ctrlKey||e.metaKey)))&&!isSearchFocused){
    e.preventDefault();s.focus();s.select();
    return;
  }

  // ? -> toggle help (only when not typing in input)
  if(key==='?'&&!isSearchFocused){
    e.preventDefault();
    h.classList.toggle('hidden');
    return;
  }

  // Esc -> clear search or close help
  if(key==='Escape'){
    if(!h.classList.contains('hidden')){
      h.classList.add('hidden');
      e.preventDefault();
    } else if(s.value){
      s.value='';
      filter('');
      s.focus();
      e.preventDefault();
    }
  }
});
})();
</script>
