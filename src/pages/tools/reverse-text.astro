---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Reverse Text';
const description = 'Reverse text online. Balikkan teks, kata, kalimat, atau baris dengan berbagai mode.';
const keywords = 'reverse text, reverse string, balik teks, reverse words, reverse sentences';
const aboutText = 'adalah alat untuk membalikkan teks dalam berbagai mode: balik karakter, balik kata, balik baris, atau kombinasi balik kata dan karakter.';
const aboutExtra = 'Reverse text memiliki banyak kegunaan: membuat teks efek cermin, membantu proses encoding/dekoding sederhana, eksperimen linguistik, pembuatan pola teks, dan debugging data. Dengan Reverse Text, Anda dapat membalikkan teks per karakter, membalikkan urutan kata dalam kalimat, membalikkan urutan baris, atau bahkan membalikkan kata dan karakter sekaligus.';
const relatedTools = [
  { slug: 'textcase', name: 'Text Case Converter', icon: 'Aa' },
  { slug: 'text-repeater', name: 'Text Repeater', icon: '×' },
  { slug: 'palindrome-checker', name: 'Palindrome Checker', icon: '↔' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Input</label>
      <textarea id="textInput" class="textarea textarea-bordered w-full text-sm font-mono" rows="5" placeholder="Masukkan teks..." autofocus>Halo, apa kabar?
Selamat datang di WebApps!
Semoga harimu menyenangkan.</textarea>
      <div class="mt-3 mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Mode</label>
        <select id="modeSelect" class="select select-bordered w-full select-sm">
          <option value="chars">Balik Karakter</option>
          <option value="words">Balik Kata</option>
          <option value="lines">Balik Baris</option>
          <option value="wordsChars">Balik Kata + Karakter</option>
        </select>
      </div>
      <button id="btnReverse" class="btn btn-primary btn-sm w-full">Reverse</button>
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs font-medium opacity-60">Output</span>
        <button id="btnCopy" class="btn btn-ghost btn-sm">Copy</button>
      </div>
      <textarea id="outputArea" class="textarea textarea-bordered w-full text-sm font-mono" rows="8" readonly></textarea>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var inp=document.getElementById('textInput'),mode=document.getElementById('modeSelect'),out=document.getElementById('outputArea');
document.getElementById('btnReverse').addEventListener('click',function(){
  var t=inp.value,m=mode.value;
  if(m==='chars')out.value=t.split('').reverse().join('');
  else if(m==='words')out.value=t.split(/\s+/).reverse().join(' ');
  else if(m==='lines')out.value=t.split('\n').reverse().join('\n');
  else if(m==='wordsChars')out.value=t.split(/\s+/).reverse().map(function(w){return w.split('').reverse().join('')}).join(' ');
});
document.getElementById('btnCopy').addEventListener('click',function(){
  if(!out.value)return;var b=this;
  navigator.clipboard.writeText(out.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)});
});
document.getElementById('btnReverse').click();
</script>