---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Reverse Text';
const description = 'Reverse text online. Balikkan teks, kata, kalimat, atau baris dengan berbagai mode.';
const keywords = 'reverse text, reverse string, balik teks, reverse words, reverse sentences';
const aboutText = 'Reverse Text Reverse text online. Balikkan teks, kata, kalimat, atau baris dengan berbagai mode.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'textcase', name: 'Textcase', icon: 'Aa' },
  { slug: 'text-repeater', name: 'Text Repeater', icon: '×' },
  { slug: 'palindrome-checker', name: 'Palindrome Checker', icon: '↔' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0f9ff;color:#0891b2;">Aa</div><div><h1 class="h3 mb-0">Reverse Text</h1><p class="opacity-60 small mb-0">Balikkan teks dengan berbagai mode: balik karakter, kata, kalimat, atau baris.</p></div></header>
<div class="flex flex-wrap gap-4"><div class="col-lg-6">
<div class="card card-bordered bg-base-100 p-3">
<div class="mb-3"><label class="label-text font-semibold">Input</label><textarea id="textInput" class="input input-bordered w-full font-mono" rows="5" placeholder="Masukkan teks..." autofocus>Halo, apa kabar?
Selamat datang di WebApps!
Semoga harimu menyenangkan.</textarea></div>
<div class="mb-3"><label class="label-text font-semibold">Mode</label>
<select id="modeSelect" class="select select-bordered w-full"><option value="chars">Balik Karakter</option><option value="words">Balik Kata</option><option value="lines">Balik Baris</option><option value="wordsChars">Balik Kata + Karakter</option></select></div>
<button id="btnReverse" class="btn btn-primary w-full">Reverse</button>
</div></div>
<div class="col-lg-6">
<div class="card card-bordered bg-base-100 p-3">
<div class="flex justify-between items-center mb-2"><label class="label-text font-semibold mb-0">Output</label><button id="btnCopy" class="btn btn-sm btn-outline-secondary">Copy</button></div>
<textarea id="outputArea" class="input input-bordered w-full font-mono" rows="8" readonly></textarea>
</div></div></div>
`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var inp=document.getElementById('textInput'),mode=document.getElementById('modeSelect'),out=document.getElementById('outputArea');
document.getElementById('btnReverse').addEventListener('click',function(){
  var t=inp.value,m=mode.value;
  if(m==='chars')out.value=t.split('').reverse().join('');
  else if(m==='words')out.value=t.split(/\\s+/).reverse().join(' ');
  else if(m==='lines')out.value=t.split('\\n').reverse().join('\\n');
  else if(m==='wordsChars')out.value=t.split(/\\s+/).reverse().map(function(w){return w.split('').reverse().join('')}).join(' ');
});
document.getElementById('btnCopy').addEventListener('click',function(){
  if(!out.value)return;var b=this;
  navigator.clipboard.writeText(out.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)});
});
document.getElementById('btnReverse').click();
</script>

