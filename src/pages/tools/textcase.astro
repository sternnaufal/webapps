---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Text Case Converter';
const description = 'Konversi huruf besar/kecil teks online. UPPER, lower, Title Case, camelCase, snake_case, dan lainnya.';
const keywords = 'text case converter, uppercase, lowercase, title case, case converter';
const aboutText = 'Text Case Converter memungkinkan Anda mengkonversi teks ke berbagai format case secara instan. Mendukung uppercase, lowercase, title case, camelCase, snake_case, dan lainnya. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const aboutExtra = 'Konversi case teks sangat berguna dalam berbagai skenario: penulisan judul artikel, pemrograman (camelCase untuk variabel JavaScript, snake_case untuk Python), pembuatan konten SEO, dan standarisasi format teks. Dengan Text Case Converter, Anda dapat dengan cepat mengubah case teks tanpa perlu menulis ulang manual. Cukup paste teks, pilih format case yang diinginkan, dan hasilnya langsung tersedia.';
const relatedTools = [
  { slug: 'reverse-text', name: 'Reverse Text', icon: '↩' },
  { slug: 'text-repeater', name: 'Text Repeater', icon: '×' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' },
  { slug: 'slug-generator', name: 'Slug Generator', icon: '🔗' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="mb-4">
    <label class="text-xs font-medium opacity-60 mb-1 block">Masukkan Teks</label>
    <textarea id="text" class="textarea textarea-bordered w-full text-sm font-mono" rows="4" placeholder="Masukkan teks di sini..."></textarea>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-2 mb-4">
    <button type="button" data-action="upper" class="btn btn-primary btn-sm convert-btn">UPPERCASE</button>
    <button type="button" data-action="lower" class="btn btn-primary btn-sm convert-btn">lowercase</button>
    <button type="button" data-action="title" class="btn btn-primary btn-sm convert-btn">Title Case</button>
    <button type="button" data-action="snake" class="btn btn-primary btn-sm convert-btn">snake_case</button>
    <button type="button" data-action="camel" class="btn btn-primary btn-sm convert-btn">camelCase</button>
  </div>

  <div id="resultContainer" style="display:none;">
    <div class="rounded-xl p-4" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium opacity-60">Hasil</span>
        <button id="copyResultBtn" class="btn btn-ghost btn-sm">Copy</button>
      </div>
      <pre id="resultText" class="text-sm whitespace-pre-wrap font-mono opacity-80"></pre>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
function convert(action) {
  var input = document.getElementById('text').value;
  if (!input.trim()) {
    alert('Masukkan teks terlebih dahulu');
    return;
  }

  var result = '';
  switch (action) {
    case 'upper':
      result = input.toUpperCase();
      break;
    case 'lower':
      result = input.toLowerCase();
      break;
    case 'title':
      result = input.toLowerCase().replace(/\b\w/g, function(c) { return c.toUpperCase(); });
      break;
    case 'snake':
      result = input.toLowerCase().trim().replace(/\s+/g, '_');
      break;
    case 'camel':
      result = input.toLowerCase().replace(/\b\w/g, function(c) { return c.toUpperCase(); }).replace(/\s+/g, '').replace(/^./, function(c) { return c.toLowerCase(); });
      break;
  }

  document.getElementById('resultText').textContent = result;
  document.getElementById('resultContainer').style.display = 'block';
}

document.querySelectorAll('.convert-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    convert(this.getAttribute('data-action'));
  });
});

document.getElementById('copyResultBtn').addEventListener('click', function() {
  var text = document.getElementById('resultText').textContent;
  if (!text) return;
  navigator.clipboard.writeText(text).then(function() {
    var btn = document.getElementById('copyResultBtn');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
  });
});
</script>