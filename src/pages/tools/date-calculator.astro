---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Date Duration Calculator';
const description = 'Kalkulator durasi tanggal online. Hitung selisih hari, tambah/kurang hari, dan konversi tanggal.';
const keywords = 'date calculator, date duration, days between dates, date difference, kalkulator tanggal';
const aboutText = 'Date Duration Calculator Kalkulator durasi tanggal online. Hitung selisih hari, tambah/kurang hari, dan konversi tanggal.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'time-converter', name: 'Time Converter', icon: '🌍' },
  { slug: 'epoch-converter', name: 'Epoch Converter', icon: '⏱' },
  { slug: 'countdown', name: 'Countdown', icon: '⏳' },
  { slug: 'age-calculator', name: 'Age Calculator', icon: '🎂' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#eef2ff;color:#4f46e5;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></div><div><h1 class="h3 mb-0">Date Duration Calculator</h1><p class="opacity-60 small mb-0">Hitung selisih antar tanggal, tambah/kurang hari, dan konversi format tanggal.</p></div></header>
<div class="flex flex-wrap gap-4">
<div class="col-lg-6">
<div class="card card-bordered bg-base-100 p-3 mb-3"><h6 class="mb-3">Selisih Tanggal</h6>
<div class="row gap-2 mb-3"><div class="col-6"><label class="label-text small">Tanggal Mulai</label><input type="date" id="startDate" class="input input-bordered w-full"></div><div class="col-6"><label class="label-text small">Tanggal Akhir</label><input type="date" id="endDate" class="input input-bordered w-full"></div></div>
<button id="btnCalcDiff" class="btn btn-primary w-full">Hitung Selisih</button>
<div id="diffResult" class="mt-3 p-3 bg-light rounded small"></div>
</div>
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Tambah / Kurang Hari</h6>
<div class="row gap-2 mb-3"><div class="col-6"><label class="label-text small">Tanggal</label><input type="date" id="baseDate" class="input input-bordered w-full"></div><div class="col-6"><label class="label-text small">Jumlah Hari</label><input type="number" id="daysInput" class="input input-bordered w-full" value="7"></div></div>
<div class="flex gap-2"><button id="btnAdd" class="btn btn-success flex-fill">+ Tambah Hari</button><button id="btnSub" class="btn btn-error flex-fill">- Kurangi Hari</button></div>
<div id="addResult" class="mt-3 p-3 bg-light rounded small"></div>
</div>
</div>
<div class="col-lg-6">
<div class="card card-bordered bg-base-100 p-3 mb-3"><h6 class="mb-3">Konversi Format Tanggal</h6>
<div class="mb-2"><label class="label-text small">Masukkan tanggal</label><input type="date" id="convertDate" class="input input-bordered w-full"></div>
<button id="btnConvert" class="btn btn-primary w-full">Konversi</button>
<div id="convertResult" class="mt-3 p-3 bg-light rounded small"></div>
</div>
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Informasi Tanggal</h6>
<div class="mb-2"><label class="label-text small">Pilih tanggal</label><input type="date" id="infoDate" class="input input-bordered w-full"></div>
<button id="btnInfo" class="btn btn-primary w-full">Tampilkan Info</button>
<div id="infoResult" class="mt-3 p-3 bg-light rounded small"></div>
</div>
</div>
</div>
`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var today=new Date().toISOString().split('T')[0];
['startDate','endDate','baseDate','convertDate','infoDate'].forEach(function(id){document.getElementById(id).value=today});

function fmt(d){return d.toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}

document.getElementById('btnCalcDiff').addEventListener('click',function(){
  var s=new Date(document.getElementById('startDate').value),e=new Date(document.getElementById('endDate').value);
  if(isNaN(s)||isNaN(e)){document.getElementById('diffResult').innerHTML='<span class="text-error">Tanggal tidak valid</span>';return}
  var ms=e-s,days=Math.round(ms/86400000),weeks=Math.floor(days/7),years=Math.floor(days/365.25),months=Math.floor(years*12+(days%365.25)/30.44);
  document.getElementById('diffResult').innerHTML=
    '<div class="font-bold mb-2">'+fmt(s)+' &rarr; '+fmt(e)+'</div>'+
    '<table class="table table-sm small mb-0"><tr><td>Total Hari</td><td class="font-bold">'+days+' hari</td></tr>'+
    '<tr><td>Total Minggu</td><td class="font-bold">'+weeks+' minggu '+(days%7)+' hari</td></tr>'+
    '<tr><td>Total Bulan</td><td class="font-bold">'+Math.round(months)+' bulan</td></tr>'+
    '<tr><td>Total Tahun</td><td class="font-bold">'+years+' tahun '+(days%365)+' hari</td></tr></table>';
});

['btnAdd','btnSub'].forEach(function(id){
  document.getElementById(id).addEventListener('click',function(){
    var d=new Date(document.getElementById('baseDate').value),n=parseInt(document.getElementById('daysInput').value)||0;
    if(id==='btnSub')n=-n;
    d.setDate(d.getDate()+n);
    document.getElementById('addResult').innerHTML='<span class="font-bold">'+n+' hari</span>: '+fmt(d)+' <span class="opacity-60">('+d.toISOString().split('T')[0]+')</span>';
  });
});

document.getElementById('btnConvert').addEventListener('click',function(){
  var d=new Date(document.getElementById('convertDate').value);
  if(isNaN(d)){document.getElementById('convertResult').innerHTML='<span class="text-error">Tanggal tidak valid</span>';return}
  var months=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
  document.getElementById('convertResult').innerHTML=
    '<table class="table table-sm small mb-0">'+
    '<tr><td>ISO</td><td class="font-mono">'+d.toISOString().split('T')[0]+'</td></tr>'+
    '<tr><td>Locale ID</td><td>'+d.toLocaleDateString('id-ID')+'</td></tr>'+
    '<tr><td>Locale US</td><td>'+d.toLocaleDateString('en-US')+'</td></tr>'+
    '<tr><td>Format panjang</td><td>'+fmt(d)+'</td></tr>'+
    '<tr><td>Unix Timestamp</td><td class="font-mono">'+(d.getTime()/1000)+'</td></tr>'+
    '<tr><td>Nama hari</td><td>'+d.toLocaleDateString('id-ID',{weekday:'long'})+'</td></tr>'+
    '<tr><td>Nama bulan</td><td>'+months[d.getMonth()]+'</td></tr>'+
    '<tr><td>Tahun</td><td>'+d.getFullYear()+'</td></tr></table>';
});

document.getElementById('btnInfo').addEventListener('click',function(){
  var d=new Date(document.getElementById('infoDate').value);
  if(isNaN(d)){document.getElementById('infoResult').innerHTML='<span class="text-error">Tanggal tidak valid</span>';return}
  var day=d.getDay(),isWeekend=day===0||day===6;
  document.getElementById('infoResult').innerHTML=
    '<table class="table table-sm small mb-0">'+
    '<tr><td>Tanggal</td><td>'+fmt(d)+'</td></tr>'+
    '<tr><td>Hari ke-</td><td>'+d.getDate()+'/'+(d.getMonth()+1)+'/'+d.getFullYear()+'</td></tr>'+
    '<tr><td>Hari dalam tahun</td><td>'+Math.ceil((d-new Date(d.getFullYear(),0,0))/86400000)+'/'+(d.getFullYear()%4===0?366:365)+'</td></tr>'+
    '<tr><td>Status</td><td>'+(isWeekend?'<span class="text-error">Akhir Pekan</span>':'<span class="text-success">Hari Kerja</span>')+'</td></tr>'+
    '<tr><td>Kuartal</td><td>Q'+Math.ceil((d.getMonth()+1)/3)+'</td></tr></table>';
});
</script>

