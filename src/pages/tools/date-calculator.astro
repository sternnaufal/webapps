---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Date Duration Calculator';
const description = 'Kalkulator durasi tanggal online. Hitung selisih hari, tambah/kurang hari, dan konversi tanggal.';
const keywords = 'date calculator, date duration, days between dates, date difference, kalkulator tanggal';
const aboutText = 'Date Duration Calculator Kalkulator durasi tanggal online. Hitung selisih hari, tambah/kurang hari, dan konversi tanggal.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'time-converter', name: 'Time Converter', icon: '🌍' },
  { slug: 'epoch-converter', name: 'Epoch Converter', icon: '⏱' },
  { slug: 'countdown', name: 'Countdown', icon: '⏳' },
  { slug: 'age-calculator', name: 'Age Calculator', icon: '🎂' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="mb-5">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</header>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
  <div>
    <div class="rounded-xl p-5 mb-4" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
      <div class="text-sm font-semibold mb-3">Selisih Tanggal</div>
      <div class="grid grid-cols-2 gap-2 mb-3">
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Tanggal Mulai</label>
          <input type="date" id="startDate" class="input input-bordered w-full input-sm">
        </div>
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Tanggal Akhir</label>
          <input type="date" id="endDate" class="input input-bordered w-full input-sm">
        </div>
      </div>
      <button id="btnCalcDiff" class="btn btn-primary btn-sm w-full">Hitung Selisih</button>
      <div id="diffResult" class="mt-3 rounded-lg p-3 text-xs" style="background:oklch(0.95 0.005 270);"></div>
    </div>
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
      <div class="text-sm font-semibold mb-3">Tambah / Kurang Hari</div>
      <div class="grid grid-cols-2 gap-2 mb-3">
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Tanggal</label>
          <input type="date" id="baseDate" class="input input-bordered w-full input-sm">
        </div>
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Jumlah Hari</label>
          <input type="number" id="daysInput" class="input input-bordered w-full input-sm" value="7">
        </div>
      </div>
      <div class="flex gap-2">
        <button id="btnAdd" class="btn btn-primary btn-sm flex-1">+ Tambah Hari</button>
        <button id="btnSub" class="btn btn-ghost btn-sm flex-1">- Kurangi Hari</button>
      </div>
      <div id="addResult" class="mt-3 rounded-lg p-3 text-xs" style="background:oklch(0.95 0.005 270);"></div>
    </div>
  </div>
  <div>
    <div class="rounded-xl p-5 mb-4" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
      <div class="text-sm font-semibold mb-3">Konversi Format Tanggal</div>
      <div class="mb-2">
        <label class="text-xs font-medium opacity-60 mb-1 block">Masukkan tanggal</label>
        <input type="date" id="convertDate" class="input input-bordered w-full input-sm">
      </div>
      <button id="btnConvert" class="btn btn-primary btn-sm w-full">Konversi</button>
      <div id="convertResult" class="mt-3 rounded-lg p-3 text-xs" style="background:oklch(0.95 0.005 270);"></div>
    </div>
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
      <div class="text-sm font-semibold mb-3">Informasi Tanggal</div>
      <div class="mb-2">
        <label class="text-xs font-medium opacity-60 mb-1 block">Pilih tanggal</label>
        <input type="date" id="infoDate" class="input input-bordered w-full input-sm">
      </div>
      <button id="btnInfo" class="btn btn-primary btn-sm w-full">Tampilkan Info</button>
      <div id="infoResult" class="mt-3 rounded-lg p-3 text-xs" style="background:oklch(0.95 0.005 270);"></div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var today=new Date().toISOString().split('T')[0];
['startDate','endDate','baseDate','convertDate','infoDate'].forEach(function(id){document.getElementById(id).value=today});

function fmt(d){return d.toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}

document.getElementById('btnCalcDiff').addEventListener('click',function(){
  var s=new Date(document.getElementById('startDate').value),e=new Date(document.getElementById('endDate').value);
  if(isNaN(s)||isNaN(e)){document.getElementById('diffResult').innerHTML='<span class="text-xs text-red-500">Tanggal tidak valid</span>';return}
  var ms=e-s,days=Math.round(ms/86400000),weeks=Math.floor(days/7),years=Math.floor(days/365.25),months=Math.floor(years*12+(days%365.25)/30.44);
  document.getElementById('diffResult').innerHTML=
    '<div class="font-semibold mb-2 text-sm">'+fmt(s)+' &rarr; '+fmt(e)+'</div>'+
    '<table class="w-full text-xs"><tr><td class="opacity-60 py-0.5">Total Hari</td><td class="font-semibold text-right">'+days+' hari</td></tr>'+
    '<tr><td class="opacity-60 py-0.5">Total Minggu</td><td class="font-semibold text-right">'+weeks+' minggu '+(days%7)+' hari</td></tr>'+
    '<tr><td class="opacity-60 py-0.5">Total Bulan</td><td class="font-semibold text-right">'+Math.round(months)+' bulan</td></tr>'+
    '<tr><td class="opacity-60 py-0.5">Total Tahun</td><td class="font-semibold text-right">'+years+' tahun '+(days%365)+' hari</td></tr></table>';
});

['btnAdd','btnSub'].forEach(function(id){
  document.getElementById(id).addEventListener('click',function(){
    var d=new Date(document.getElementById('baseDate').value),n=parseInt(document.getElementById('daysInput').value)||0;
    if(id==='btnSub')n=-n;
    d.setDate(d.getDate()+n);
    document.getElementById('addResult').innerHTML='<span class="font-semibold text-sm">'+n+' hari</span>: '+fmt(d)+' <span class="opacity-40 text-xs">('+d.toISOString().split('T')[0]+')</span>';
  });
});

document.getElementById('btnConvert').addEventListener('click',function(){
  var d=new Date(document.getElementById('convertDate').value);
  if(isNaN(d)){document.getElementById('convertResult').innerHTML='<span class="text-xs text-red-500">Tanggal tidak valid</span>';return}
  var months=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
  document.getElementById('convertResult').innerHTML=
    '<table class="w-full text-xs">'+
    '<tr><td class="opacity-60 py-0.5 pr-3">ISO</td><td class="font-mono">'+d.toISOString().split('T')[0]+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Locale ID</td><td>'+d.toLocaleDateString('id-ID')+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Locale US</td><td>'+d.toLocaleDateString('en-US')+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Format panjang</td><td>'+fmt(d)+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Unix Timestamp</td><td class="font-mono">'+(d.getTime()/1000)+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Nama hari</td><td>'+d.toLocaleDateString('id-ID',{weekday:'long'})+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Nama bulan</td><td>'+months[d.getMonth()]+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Tahun</td><td>'+d.getFullYear()+'</td></tr></table>';
});

document.getElementById('btnInfo').addEventListener('click',function(){
  var d=new Date(document.getElementById('infoDate').value);
  if(isNaN(d)){document.getElementById('infoResult').innerHTML='<span class="text-xs text-red-500">Tanggal tidak valid</span>';return}
  var day=d.getDay(),isWeekend=day===0||day===6;
  document.getElementById('infoResult').innerHTML=
    '<table class="w-full text-xs">'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Tanggal</td><td>'+fmt(d)+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Hari ke-</td><td>'+d.getDate()+'/'+(d.getMonth()+1)+'/'+d.getFullYear()+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Hari dalam tahun</td><td>'+Math.ceil((d-new Date(d.getFullYear(),0,0))/86400000)+'/'+(d.getFullYear()%4===0?366:365)+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Status</td><td>'+(isWeekend?'<span class="text-red-500">Akhir Pekan</span>':'<span class="text-green-600">Hari Kerja</span>')+'</td></tr>'+
    '<tr><td class="opacity-60 py-0.5 pr-3">Kuartal</td><td>Q'+Math.ceil((d.getMonth()+1)/3)+'</td></tr></table>';
});
</script>