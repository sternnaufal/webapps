---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Palindrome Checker';
const description = 'Cek palindrome online. Periksa apakah kata, kalimat, atau angka adalah palindrome.';
const keywords = 'palindrome checker, palindrome check, cek palindrome, palindrome test';
const aboutText = 'adalah alat untuk memeriksa apakah sebuah kata, kalimat, atau angka merupakan palindrome — yaitu teks yang dibaca sama dari depan dan belakang.';
const aboutExtra = 'Palindrome adalah kata, frasa, atau urutan yang membaca sama maju dan mundur, seperti "Kasur ini rusak", "racecar", atau "12321". Palindrome Checker ini mendukung pengecekan dengan atau tanpa case-sensitive, dan secara otomatis mengabaikan spasi serta tanda baca. Dilengkapi dengan contoh-contoh palindrome populer dalam bahasa Indonesia dan Inggris untuk referensi.';
const relatedTools = [
  { slug: 'anagram-finder', name: 'Anagram Finder', icon: '🔀' },
  { slug: 'reverse-text', name: 'Reverse Text', icon: '↩' },
  { slug: 'word-frequency', name: 'Word Frequency Counter', icon: '📊' },
  { slug: 'textcase', name: 'Text Case Converter', icon: 'Aa' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Masukkan Teks</label>
      <textarea id="textInput" class="textarea textarea-bordered w-full text-sm font-mono mb-3" rows="3" placeholder="Masukkan teks..." autofocus>Kasur ini rusak</textarea>
      <div class="flex gap-2 mb-3">
        <button id="btnCheck" class="btn btn-primary btn-sm">Cek Palindrome</button>
        <button id="btnClear" class="btn btn-ghost btn-sm">Clear</button>
      </div>
      <div class="flex items-center gap-2 mb-3">
        <input type="checkbox" id="caseSensitive" class="checkbox checkbox-sm">
        <label class="text-xs opacity-60" for="caseSensitive">Case sensitive (beda huruf besar/kecil dianggap beda)</label>
      </div>
      <div id="resultArea" class="rounded-xl p-4 text-center" style="display:none;background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
        <div class="text-2xl mb-1" id="resultIcon">?</div>
        <div class="text-sm font-bold" id="resultText"></div>
        <div class="text-xs opacity-60" id="resultDetail"></div>
      </div>
    </div>
    <div>
      <div class="rounded-xl p-4" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
        <div class="text-xs font-medium opacity-60 mb-2">Contoh Palindrome</div>
        <div class="text-xs leading-relaxed">
          <div style="cursor:pointer" class="example hover:opacity-60">Kasur ini rusak</div>
          <div style="cursor:pointer" class="example hover:opacity-60">Ibu Ratna antar ubi</div>
          <div style="cursor:pointer" class="example hover:opacity-60">Kakak</div>
          <div style="cursor:pointer" class="example hover:opacity-60">Aku suka rajawali, bapak? Apakah jawab? Aku suka rajawali, ibu?</div>
          <div style="cursor:pointer" class="example hover:opacity-60">12321</div>
          <div style="cursor:pointer" class="example hover:opacity-60">racecar</div>
        </div>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var inp=document.getElementById('textInput'),res=document.getElementById('resultArea'),icon=document.getElementById('resultIcon'),txt=document.getElementById('resultText'),det=document.getElementById('resultDetail'),cs=document.getElementById('caseSensitive');
function check(){
  var t=inp.value.trim();if(!t){res.style.display='none';return}
  var clean=cs.checked?t:t.toLowerCase().replace(/[^a-z0-9]/g,'');
  var rev=clean.split('').reverse().join('');
  var isPal=clean===rev;
  res.style.display='block';
  icon.textContent=isPal?'✓':'✗';icon.style.color=isPal?'#22c55e':'#ef4444';
  txt.textContent=isPal?'Palindrome!':'Bukan Palindrome';
  txt.style.color=isPal?'#22c55e':'#ef4444';
  det.innerHTML='<span class="opacity-60">Setelah difilter: "'+clean+'"<br>Dibalik: "'+rev+'"</span>';
}
document.getElementById('btnCheck').addEventListener('click',check);
document.getElementById('btnClear').addEventListener('click',function(){inp.value='';res.style.display='none'});
inp.addEventListener('input',check);cs.addEventListener('change',check);
document.querySelectorAll('.example').forEach(function(el){
  el.addEventListener('click',function(){inp.value=this.textContent;check()});
});
inp.value='Kasur ini rusak';check();
</script>