---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'RSA Key Generator';
const description = 'Generate pasangan kunci RSA (public/private key) online. RSA key generator untuk keamanan data.';
const keywords = 'rsa key generator, rsa, public key, private key, encryption';
const aboutText = 'RSA Key Generator adalah alat untuk menghasilkan pasangan kunci RSA (public key dan private key) langsung di browser menggunakan Web Crypto API. Kunci privat tidak pernah meninggalkan browser Anda. Mendukung ukuran kunci 2048-bit dan 4096-bit dengan format SPKI untuk public key dan PKCS8 untuk private key dalam format PEM.';
const aboutExtra = 'RSA (Rivest-Shamir-Adleman) adalah algoritma kriptografi asimetris yang banyak digunakan untuk enkripsi data dan tanda tangan digital. Public key dapat dibagikan secara bebas, sementara private key harus dijaga kerahasiaannya. Alat ini berguna untuk developer yang membutuhkan pasangan kunci RSA untuk pengembangan aplikasi, implementasi keamanan API, atau pembuatan sertifikat SSL self-signed.';
const relatedTools = [
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'jwt-decoder', name: 'JWT Decoder', icon: 'JWT' },
  { slug: 'base64-coded', name: 'Base64 Encoder', icon: 'B64' },
  { slug: 'password-generator', name: 'Password Generator', icon: '🔑' },
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>

  <div class="rounded-xl p-5 mt-4" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
    <div class="mb-3">
      <label class="text-xs font-medium opacity-60 mb-1 block">Key Size</label>
      <select id="keySize" class="select select-bordered w-full select-sm" style="max-width:200px;">
        <option value="2048">2048-bit</option>
        <option value="4096">4096-bit</option>
      </select>
    </div>
    <button id="btnGenerate" class="btn btn-primary btn-sm">Generate Keys</button>
  </div>

  <div id="keyOutput" style="display:none;" class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <label class="text-xs font-medium opacity-60 mb-1 block">Public Key (SPKI PEM)</label>
      <textarea id="pubKey" class="textarea textarea-bordered w-full text-sm font-mono" rows="6" readonly></textarea>
      <button class="btn btn-ghost btn-sm mt-1 copy-key" data-target="pubKey">Copy</button>
    </div>
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <label class="text-xs font-medium opacity-60 mb-1 block">Private Key (PKCS8 PEM)</label>
      <textarea id="privKey" class="textarea textarea-bordered w-full text-sm font-mono" rows="12" readonly></textarea>
      <button class="btn btn-ghost btn-sm mt-1 copy-key" data-target="privKey">Copy</button>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
function ab2pem(buf,label){var b64=btoa(String.fromCharCode.apply(null,new Uint8Array(buf))),chunks=[];for(var i=0;i<b64.length;i+=64)chunks.push(b64.substr(i,64));return'-----BEGIN '+label+'-----\n'+chunks.join('\n')+'\n-----END '+label+'-----\n'}
document.getElementById('btnGenerate').addEventListener('click',async function(){var size=parseInt(document.getElementById('keySize').value,10);this.disabled=true;this.textContent='Generating...';
try{var keyPair=await crypto.subtle.generateKey({name:'RSA-OAEP',modulusLength:size,publicExponent:new Uint8Array([1,0,1]),hash:'SHA-256'},true,['encrypt','decrypt']);
var pubBuf=await crypto.subtle.exportKey('spki',keyPair.publicKey),privBuf=await crypto.subtle.exportKey('pkcs8',keyPair.privateKey);
document.getElementById('pubKey').value=ab2pem(pubBuf,'PUBLIC KEY');document.getElementById('privKey').value=ab2pem(privBuf,'PRIVATE KEY');document.getElementById('keyOutput').style.display='block';
}catch(e){alert('Error: '+e.message)}finally{this.disabled=false;this.textContent='Generate Keys'}});
document.querySelectorAll('.copy-key').forEach(function(b){b.addEventListener('click',function(){var id=this.getAttribute('data-target'),text=document.getElementById(id).value;if(!text)return;navigator.clipboard.writeText(text).then(function(){var t=this;this.textContent='Copied!';setTimeout(function(){this.textContent='Copy'}.bind(this),1500)}.bind(this))})});
</script>