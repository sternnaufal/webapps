---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'RSA Key Generator';
const description = 'Generate pasangan kunci RSA (public/private key) online. RSA key generator untuk keamanan data.';
const keywords = 'rsa key generator, rsa, public key, private key, encryption';
const aboutText = 'RSA Key Generator Generate pasangan kunci RSA (public/private key) online. RSA key generator untuk keamanan data.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'jwt-decoder', name: 'Jwt Decoder', icon: 'JWT' },
  { slug: 'base64-coded', name: 'Base64 Coded', icon: 'B64' },
  { slug: 'password-generator', name: 'Password Generator', icon: '🔑' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0f9ff;color:#0284c7;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg></div><div><h1 class="h3 mb-0">RSA Key Generator</h1><p class="opacity-60 small mb-0">Generate pasangan kunci RSA 2048/4096-bit langsung di browser. Private key tidak pernah dikirim ke server.</p></div></header>
<div class="mb-3"><label class="label-text">Key Size</label>
<select id="keySize" class="select select-bordered w-full" style="max-width:200px;"><option value="2048">2048-bit</option><option value="4096">4096-bit</option></select>
<button id="btnGenerate" class="btn btn-primary mt-2">Generate Keys</button></div>
<div id="keyOutput" style="display:none;">
<div class="mb-3"><label class="label-text font-semibold">Public Key (SPKI PEM)</label><textarea id="pubKey" class="input input-bordered w-full font-mono" rows="6" readonly></textarea><button class="btn btn-sm btn-outline-secondary mt-1 copy-key" data-target="pubKey">Copy</button></div>
<div class="mb-3"><label class="label-text font-semibold">Private Key (PKCS8 PEM)</label><textarea id="privKey" class="input input-bordered w-full font-mono" rows="12" readonly></textarea><button class="btn btn-sm btn-outline-secondary mt-1 copy-key" data-target="privKey">Copy</button></div>
</div>
`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
function ab2pem(buf,label){var b64=btoa(String.fromCharCode.apply(null,new Uint8Array(buf))),chunks=[];for(var i=0;i<b64.length;i+=64)chunks.push(b64.substr(i,64));return'-----BEGIN '+label+'-----\\n'+chunks.join('\\n')+'\\n-----END '+label+'-----\\n'}
document.getElementById('btnGenerate').addEventListener('click',async function(){var size=parseInt(document.getElementById('keySize').value,10);this.disabled=true;this.textContent='Generating...';
try{var keyPair=await crypto.subtle.generateKey({name:'RSA-OAEP',modulusLength:size,publicExponent:new Uint8Array([1,0,1]),hash:'SHA-256'},true,['encrypt','decrypt']);
var pubBuf=await crypto.subtle.exportKey('spki',keyPair.publicKey),privBuf=await crypto.subtle.exportKey('pkcs8',keyPair.privateKey);
document.getElementById('pubKey').value=ab2pem(pubBuf,'PUBLIC KEY');document.getElementById('privKey').value=ab2pem(privBuf,'PRIVATE KEY');document.getElementById('keyOutput').style.display='block';
}catch(e){alert('Error: '+e.message)}finally{this.disabled=false;this.textContent='Generate Keys'}});
document.querySelectorAll('.copy-key').forEach(function(b){b.addEventListener('click',function(){var id=this.getAttribute('data-target'),text=document.getElementById(id).value;if(!text)return;navigator.clipboard.writeText(text).then(function(){var t=this;this.textContent='Copied!';setTimeout(function(){this.textContent='Copy'}.bind(this),1500)}.bind(this))})});
</script>

