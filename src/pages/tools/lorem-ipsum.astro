---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Lorem Ipsum Generator';
const description = 'Generate teks lorem ipsum untuk dummy content. Lorem ipsum generator dengan berbagai opsi panjang.';
const keywords = 'lorem ipsum, dummy text, placeholder text, lorem generator, sample text';
const aboutText = 'adalah alat untuk menghasilkan teks lorem ipsum sebagai placeholder atau dummy content dalam desain web, percetakan, dan pengembangan aplikasi.';
const aboutExtra = 'Teks lorem ipsum adalah teks standar yang digunakan dalam industri percetakan dan typesetting sejak tahun 1500-an. Lorem ipsum generator ini memungkinkan Anda menghasilkan teks dalam berbagai format: paragraf, kalimat, atau kata-kata individual. Sangat berguna untuk mockup desain website, pembuatan template, prototyping aplikasi, dan pengujian layout. Cukup tentukan jumlah yang diinginkan dan pilih tipe output.';
const relatedTools = [
  { slug: 'textcase', name: 'Text Case Converter', icon: 'Aa' },
  { slug: 'word-counter', name: 'Word Counter', icon: '⚡' },
  { slug: 'char-counter', name: 'Char Counter', icon: '#' },
  { slug: 'md-preview', name: 'Markdown Previewer', icon: 'MD' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <form id="loremForm" class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Jumlah</label>
      <input type="number" id="amount" class="input input-bordered w-full input-sm" min="1" value="3">
    </div>
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Tipe</label>
      <select id="type" class="select select-bordered w-full select-sm">
        <option value="paragraphs">Paragraf</option>
        <option value="sentences">Kalimat</option>
        <option value="words">Kata</option>
      </select>
    </div>
    <div class="flex items-end">
      <button type="submit" class="btn btn-primary btn-sm w-full">Generate</button>
    </div>
  </form>

  <div class="rounded-xl p-4" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium opacity-60">Hasil</span>
      <button id="copyBtn" class="btn btn-ghost btn-sm">Copy</button>
    </div>
    <div id="output" class="text-sm whitespace-pre-wrap"></div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var loremText = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec condimentum mollis ante, in euismod eros. Donec ex metus, ornare eget interdum sed, auctor quis ligula. Sed dictum, tellus eget molestie finibus, orci nibh fringilla tortor, ac finibus dolor ipsum varius mi. Sed erat est, interdum id lacus id, convallis pellentesque leo. Aliquam placerat arcu sem, vel dictum neque malesuada non. Maecenas et magna turpis. Cras sit amet finibus lectus, sit amet volutpat nisi. Fusce vehicula viverra orci, ac molestie mi luctus at. Nunc luctus porta tellus, sed bibendum metus. Morbi blandit ligula in mi finibus ullamcorper. Nullam vestibulum dui eget odio accumsan euismod. Ut ornare non ante non tincidunt. Integer neque leo, semper sed justo eget, maximus imperdiet neque.\n\nMauris pharetra augue ut cursus commodo. Suspendisse potenti. Sed ullamcorper bibendum nunc, ac pharetra risus faucibus at. Quisque tellus leo, vehicula volutpat semper et, volutpat vel turpis. Orci varius natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Proin accumsan lorem feugiat quam pretium efficitur. Quisque aliquam hendrerit purus, in pulvinar nunc auctor dictum.\n\nQuisque dignissim tempus suscipit. Vestibulum lacinia volutpat velit. Suspendisse ut arcu cursus, aliquet velit non, suscipit quam. Curabitur lobortis tincidunt felis, eget commodo elit lobortis vitae. Ut ligula elit, consequat a posuere vel, sodales ac enim. In cursus quis ex quis fringilla. Aenean elementum dictum magna, nec ultricies nunc finibus sed. Nulla eu faucibus quam. In vitae arcu vehicula orci ultrices cursus.\n\nPraesent nec metus dolor. Curabitur accumsan, tellus ac malesuada varius, ligula massa vulputate magna, in porta diam mauris et ipsum. Pellentesque egestas elementum eleifend. Donec quis dolor dui. Quisque vel consectetur eros, vel porta magna. Duis ut volutpat mi. Integer neque urna, aliquam a commodo non, tempus ut purus.\n\nCurabitur pharetra molestie nunc, at tincidunt urna suscipit sed. Mauris malesuada vulputate risus in fringilla. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse dolor nunc, tristique sit amet lorem eget, vestibulum porttitor tortor. Pellentesque arcu orci, fringilla a venenatis vitae, volutpat in ipsum. Proin non leo a nisl imperdiet scelerisque in id libero.';

function generateLorem(amount, type) {
  var words = loremText.split(/\s+/);
  var sentences = loremText.split(/(?<=[.!?])\s+/);
  var paragraphs = loremText.split(/\n\s*\n/);
  var result = '';

  if (type === 'words') {
    for (var i = 0; i < amount; i++) {
      var randomIndex = Math.floor(Math.random() * words.length);
      result += words[randomIndex] + '';
    }
  } else if (type === 'sentences') {
    for (var i = 0; i < amount; i++) {
      var randomIndex = Math.floor(Math.random() * sentences.length);
      result += sentences[randomIndex] + '';
    }
  } else {
    for (var i = 0; i < amount; i++) {
      var randomIndex = Math.floor(Math.random() * paragraphs.length);
      result += paragraphs[randomIndex] + '\n\n';
    }
  }

  return result.trim();
}

document.getElementById('loremForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var amount = parseInt(document.getElementById('amount').value);
  var type = document.getElementById('type').value;
  document.getElementById('output').textContent = generateLorem(amount, type);
});

document.getElementById('copyBtn').addEventListener('click', function() {
  var text = document.getElementById('output').textContent;
  if (!text) return;
  navigator.clipboard.writeText(text).then(function() {
    alert('Hasil berhasil dicopy!');
  });
});
</script>