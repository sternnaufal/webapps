---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'URL Encode / Decode';
const description = 'Encode dan decode URL online gratis. URL encoder dengan dukungan RFC 3986.';
const keywords = 'url encode, url decode, url encoder, url decoder, encode url';
const aboutText = 'URL encoder dan decoder online untuk mengkonversi teks ke format URL-encoded dan sebaliknya. Mendukung encodeURIComponent (encoding ketat untuk query string), encodeURI (encoding untuk seluruh URL), dan decodeURIComponent.';
const aboutExtra = 'URL encoding (juga dikenal sebagai percent-encoding) adalah mekanisme untuk mengkodekan karakter-karakter khusus dalam URL agar dapat ditransmisikan dengan aman melalui internet. Karakter seperti spasi, &, ?, #, dan karakter non-ASCII perlu di-encode untuk menghindari interpretasi yang salah oleh server web. Alat ini mendukung RFC 3986 dengan tiga mode: encodeURIComponent (meng-encode semua karakter kecuali huruf, angka, dan -_.~), encodeURI (meng-encode karakter yang tidak diizinkan dalam URI), dan decodeURIComponent (mengembalikan encoded string ke bentuk aslinya). Semua pemrosesan dilakukan 100% di browser, data tidak dikirim ke server mana pun.';
const relatedTools = [
  { slug: 'base64-coded', name: 'Base64 Encoder', icon: 'B64' },
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'html-entity', name: 'HTML Entity', icon: '&' },
  { slug: 'slug-generator', name: 'Slug Generator', icon: '🔗' }
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #3b82f6;">
    <div class="mb-3">
      <label for="inputText" class="text-xs font-medium opacity-60 mb-1 block">Input</label>
      <textarea id="inputText" class="textarea textarea-bordered w-full text-sm font-mono" rows="4" placeholder="Masukkan teks atau URL encoded string...">https://example.com/search?q=hello world&lang=id&page=1</textarea>
    </div>
    <div class="flex gap-2 flex-wrap mb-3">
      <button id="btnEncComponent" class="btn btn-primary btn-sm">encodeURIComponent</button>
      <button id="btnEncURI" class="btn btn-ghost btn-sm">encodeURI</button>
      <button id="btnDecode" class="btn btn-ghost btn-sm">decodeURIComponent</button>
      <button id="btnSwap" class="btn btn-ghost btn-sm">Swap Input/Output</button>
      <button id="btnClear" class="btn btn-ghost btn-sm">Clear</button>
    </div>
    <div>
      <label for="outputText" class="text-xs font-medium opacity-60 mb-1 block">Output</label>
      <textarea id="outputText" class="textarea textarea-bordered w-full text-sm font-mono" rows="4" readonly></textarea>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
var inp = document.getElementById('inputText');
var out = document.getElementById('outputText');

document.getElementById('btnEncComponent').addEventListener('click', function() {
  try { out.value = encodeURIComponent(inp.value); } catch (e) { out.value = 'Error: ' + e.message; }
});
document.getElementById('btnEncURI').addEventListener('click', function() {
  try { out.value = encodeURI(inp.value); } catch (e) { out.value = 'Error: ' + e.message; }
});
document.getElementById('btnDecode').addEventListener('click', function() {
  try { out.value = decodeURIComponent(inp.value); } catch (e) { out.value = 'Error: ' + e.message; }
});
document.getElementById('btnSwap').addEventListener('click', function() {
  var tmp = inp.value;
  inp.value = out.value;
  out.value = tmp;
});
document.getElementById('btnClear').addEventListener('click', function() { inp.value = ''; out.value = ''; });
</script>