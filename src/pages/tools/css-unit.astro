---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'CSS Unit Converter';
const description = 'CSS unit converter online. Konversi px, rem, em, vw, vh, persen, pt, pc, cm, mm, inci.';
const keywords = 'css unit converter, px to rem, px to em, rem to px, css units, responsive design';
const aboutText = 'CSS Unit Converter CSS unit converter online. Konversi px, rem, em, vw, vh, persen, pt, pc, cm, mm, inci.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'color-picker', name: 'Color Picker', icon: '🎨' },
  { slug: 'color-converter', name: 'Color Converter', icon: '🌈' },
  { slug: 'gradient-generator', name: 'Gradient Generator', icon: '◐' },
  { slug: 'contrast-checker', name: 'Contrast Checker', icon: '◐' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0f9ff;color:#0284c7;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></div><div><h1 class="h3 mb-0">CSS Unit Converter</h1><p class="opacity-60 small mb-0">Konversi antar unit CSS. Atur basis rem (root) dan viewport untuk hasil akurat.</p></div></header>
<div class="flex flex-wrap gap-4">
<div class="lg:w-5/12 w-full">
<div class="card card-bordered bg-base-100 p-3 mb-3">
<div class="mb-3"><label class="label-text font-semibold">Nilai</label><input type="number" id="inputValue" class="input input-bordered w-full" value="16" step="any"></div>
<div class="mb-3"><label class="label-text font-semibold">Dari unit</label>
<select id="fromUnit" class="select select-bordered w-full">
<option value="px">px</option><option value="rem" selected>rem</option><option value="em">em</option><option value="vw">vw</option><option value="vh">vh</option><option value="%">%</option><option value="pt">pt</option><option value="pc">pc</option><option value="cm">cm</option><option value="mm">mm</option><option value="in">in</option>
</select></div>
<div class="mb-3"><label class="label-text font-semibold">Ke unit</label>
<select id="toUnit" class="select select-bordered w-full">
<option value="px" selected>px</option><option value="rem">rem</option><option value="em">em</option><option value="vw">vw</option><option value="vh">vh</option><option value="%">%</option><option value="pt">pt</option><option value="pc">pc</option><option value="cm">cm</option><option value="mm">mm</option><option value="in">in</option>
</select></div>
<hr>
<div class="row gap-2">
<div class="col-6"><label class="label-text small">Basis rem (px)</label><input type="number" id="baseRem" class="input input-bordered w-full" value="16" step="any"></div>
<div class="col-6"><label class="label-text small">Viewport width (px)</label><input type="number" id="vpWidth" class="input input-bordered w-full" value="1920" step="any"></div>
<div class="col-6"><label class="label-text small">Viewport height (px)</label><input type="number" id="vpHeight" class="input input-bordered w-full" value="1080" step="any"></div>
<div class="col-6"><label class="label-text small">DPI</label><input type="number" id="dpi" class="input input-bordered w-full" value="96" step="any"></div>
</div>
</div>
</div>
<div class="lg:w-7/12 w-full">
<div class="card card-bordered bg-base-100 p-3">
<h5 class="font-semibold mb-3">Hasil Konversi</h5>
<div class="h2 font-bold mb-3" id="resultValue">1 rem</div>
<div class="overflow-x-auto"><table class="table table-sm small mb-0">
<thead><tr><th>Unit</th><th>Nilai</th></tr></thead>
<tbody id="allResults"></tbody>
</table></div>
</div>
</div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var inpVal=document.getElementById('inputValue'),fromU=document.getElementById('fromUnit'),toU=document.getElementById('toUnit');
var baseRem=document.getElementById('baseRem'),vpW=document.getElementById('vpWidth'),vpH=document.getElementById('vpHeight'),dpi=document.getElementById('dpi');
var resVal=document.getElementById('resultValue'),allRes=document.getElementById('allResults');

function toPx(val,unit)&#123;
  var br=parseFloat(baseRem.value)||16,vw=parseFloat(vpW.value)||1920,vh=parseFloat(vpH.value)||1080,d=parseFloat(dpi.value)||96;
  switch(unit)&#123;
    case'px':return val;
    case'rem':case'em':return val*br;
    case'vw':return val*vw/100;
    case'vh':return val*vh/100;
    case'%':return val*vw/100;
    case'pt':return val*d/72;
    case'pc':return val*d/6;
    case'cm':return val*d/2.54;
    case'mm':return val*d/25.4;
    case'in':return val*d;
    default:return val;
  &#125;
&#125;
function fromPx(px,unit)&#123;
  var br=parseFloat(baseRem.value)||16,vw=parseFloat(vpW.value)||1920,vh=parseFloat(vpH.value)||1080,d=parseFloat(dpi.value)||96;
  switch(unit)&#123;
    case'px':return px;
    case'rem':case'em':return px/br;
    case'vw':return px*100/vw;
    case'vh':return px*100/vh;
    case'%':return px*100/vw;
    case'pt':return px*72/d;
    case'pc':return px*6/d;
    case'cm':return px*2.54/d;
    case'mm':return px*25.4/d;
    case'in':return px/d;
    default:return px;
  &#125;
&#125;

var units=['px','rem','em','vw','vh','%','pt','pc','cm','mm','in'];

function convert()&#123;
  var val=parseFloat(inpVal.value)||0,fu=fromU.value,tu=toU.value;
  var px=toPx(val,fu);
  var result=fromPx(px,tu);
  resVal.textContent=val+' '+fu+' = '+result.toFixed(4)+' '+tu;
  allRes.innerHTML='';
  units.forEach(function(u)&#123;
    var v=fromPx(px,u);
    allRes.innerHTML+='<tr'+(u===tu?' class="table-active"':'')+'><td>'+u+'</td><td class="font-mono">'+v.toFixed(4)+'</td></tr>';
  &#125;);
&#125;

[inpVal,fromU,toU,baseRem,vpW,vpH,dpi].forEach(function(el)&#123;el.addEventListener('input',convert)&#125;);
convert();
</script>

