---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'UUID / GUID Generator';
const description = 'Generate UUID/GUID v4 online gratis. UUID generator dengan satu klik, copy ke clipboard.';
const keywords = 'uuid generator, guid generator, uuid v4, generate uuid, unique id';
const aboutText = 'UUID (Universally Unique Identifier) atau GUID generator online untuk membuat identifier unik secara instan. Alat ini mendukung pembuatan UUID versi 1 (time-based), versi 3 (namespace MD5), versi 4 (random), dan versi 5 (namespace SHA-1). UUID banyak digunakan dalam pengembangan perangkat lunak untuk mengidentifikasi entity secara unik tanpa memerlukan koordinasi terpusat.';
const aboutExtra = 'Generator ini menyediakan beberapa format output: standar dengan tanda hubung, uppercase, dan braces. Cukup pilih versi UUID, atur jumlah (hingga 50 sekaligus), dan klik Generate. Hasil dapat disalin satu per satu atau semua sekaligus. UUID versi 4 berbasis angka acak kriptografis adalah yang paling umum digunakan.';
const relatedTools = [
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'base64-coded', name: 'Base64 Encode/Decode', icon: 'B64' },
  { slug: 'password-generator', name: 'Password Generator', icon: '🔑' },
  { slug: 'qr-generator', name: 'QR Code Generator', icon: '▐▌' },
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);">
    <form id="uuidForm" onsubmit="return generateUUIDs()">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
        <div>
          <label for="version" class="text-xs font-medium opacity-60 mb-1 block">Versi UUID</label>
          <select id="version" class="select select-bordered w-full select-sm">
            <option value="v4" selected>v4 (Random)</option>
            <option value="v1">v1 (Time-based)</option>
            <option value="v3">v3 (MD5)</option>
            <option value="v5">v5 (SHA1)</option>
          </select>
        </div>
        <div>
          <label for="count" class="text-xs font-medium opacity-60 mb-1 block">Jumlah</label>
          <select id="count" class="select select-bordered w-full select-sm">
            <option value="1" selected>1</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="50">50</option>
          </select>
        </div>
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Format</label>
          <div class="flex gap-3 h-full items-center">
            <label class="flex items-center gap-1.5 text-xs">
              <input class="checkbox checkbox-xs" type="checkbox" id="format_upper">
              UPPER
            </label>
            <label class="flex items-center gap-1.5 text-xs">
              <input class="checkbox checkbox-xs" type="checkbox" id="format_braces">
              &#123;braces&#125;
            </label>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
        <div id="nsSection" style="display:none;">
          <label for="namespace" class="text-xs font-medium opacity-60 mb-1 block">Namespace UUID</label>
          <input type="text" id="namespace" class="input input-bordered w-full input-sm" placeholder="6ba7b810-9dad-11d1-80b4-00c04fd430c8">
          <div class="text-xs opacity-40 mt-0.5">Default: DNS namespace</div>
        </div>
        <div>
          <label for="name" class="text-xs font-medium opacity-60 mb-1 block">Name (untuk v3/v5)</label>
          <input type="text" id="name" class="input input-bordered w-full input-sm" placeholder="example.com">
        </div>
      </div>

      <div class="flex gap-2">
        <button type="submit" class="btn btn-primary btn-sm">Generate</button>
        <button type="button" id="btnCopyAll" class="btn btn-ghost btn-sm" disabled>Copy All</button>
      </div>
    </form>

    <div id="results" class="mt-4"></div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
const NAMESPACES = {
  'dns': '6ba7b810-9dad-11d1-80b4-00c04fd430c8',
  'url': '6ba7b811-9dad-11d1-80b4-00c04fd430c8',
  'oid': '6ba7b812-9dad-11d1-80b4-00c04fd430c8',
  'x500': '6ba7b814-9dad-11d1-80b4-00c04fd430c8'
};

let generatedUUIDs = [];

function uuidV1() {
  const now = Date.now();
  const time = (now + 12219292800000) * 10000 + Math.floor(Math.random() * 10000);
  const timeLow = (time >>> 0).toString(16).padStart(8, '0');
  const timeMid = ((time / 0x100000000) >>> 0).toString(16).padStart(4, '0');
  const timeHiVersion = (((time / 0x1000000000000) >>> 0) & 0x0fff | 0x1000).toString(16).padStart(4, '0');
  const clockSeq = Math.floor(Math.random() * 0x4000);
  const clockSeqHi = (((clockSeq >> 8) & 0x3f) | 0x80).toString(16).padStart(2, '0');
  const clockSeqLow = (clockSeq & 0xff).toString(16).padStart(2, '0');
  const node = Math.floor(Math.random() * 0xffffffffffff).toString(16).padStart(12, '0');
  return `${timeLow}-${timeMid}-${timeHiVersion}-${clockSeqHi}${clockSeqLow}-${node}`;
}

function uuidV4() {
  const bytes = new Uint8Array(16);
  crypto.getRandomValues(bytes);
  bytes[6] = (bytes[6] & 0x0f) | 0x40;
  bytes[8] = (bytes[8] & 0x3f) | 0x80;
  const h = Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
  return `${h.slice(0,8)}-${h.slice(8,12)}-${h.slice(12,16)}-${h.slice(16,20)}-${h.slice(20)}`;
}

function hexToBinary(hex) {
  const binary = [];
  for (let i = 0; i < hex.length; i += 2) binary.push(parseInt(hex.substr(i, 2), 16));
  return new Uint8Array(binary);
}

function binaryToHex(arr) {
  return Array.from(arr).map(b => b.toString(16).padStart(2, '0')).join('');
}

function uuidFromHash(name, namespace, version) {
  const nsClean = namespace.replace(/[{-}]/g, '');
  if (nsClean.length !== 32) return null;
  const nsBinary = hexToBinary(nsClean);
  const nameBytes = new TextEncoder().encode(name);
  const combined = new Uint8Array(nsBinary.length + nameBytes.length);
  combined.set(nsBinary);
  combined.set(nameBytes, nsBinary.length);
  let hash;
  if (version === 3) hash = CryptoJS.MD5(binaryToHex(combined)).toString();
  else hash = CryptoJS.SHA1(binaryToHex(combined)).toString();
  const timeLow = hash.substr(0, 8);
  const timeMid = hash.substr(8, 4);
  let timeHiVersion = hash.substr(12, 4);
  let clockSeqHi = hash.substr(16, 2);
  const clockSeqLow = hash.substr(18, 2);
  const node = hash.substr(20, 12);
  timeHiVersion = ((parseInt(timeHiVersion, 16) & 0x0fff) | (version << 12)).toString(16).padStart(4, '0');
  clockSeqHi = ((parseInt(clockSeqHi, 16) & 0x3f) | 0x80).toString(16).padStart(2, '0');
  return `${timeLow}-${timeMid}-${timeHiVersion}-${clockSeqHi}${clockSeqLow}-${node}`;
}

function formatUUID(uuid, uppercase, braces) {
  let result = uppercase ? uuid.toUpperCase() : uuid.toLowerCase();
  if (braces) result = '{' + result + '}';
  return result;
}

function generateUUIDs() {
  const version = document.getElementById('version').value;
  const count = Math.min(50, Math.max(1, parseInt(document.getElementById('count').value)));
  const upper = document.getElementById('format_upper').checked;
  const braces = document.getElementById('format_braces').checked;
  const name = document.getElementById('name').value;
  let namespace = document.getElementById('namespace').value.trim();
  if (!namespace) namespace = NAMESPACES.dns;
  generatedUUIDs = [];
  const results = [];

  if ((version === 'v3' || version === 'v5') && name && !isValidNamespace(namespace)) {
    document.getElementById('results').innerHTML = '<div class="text-xs text-error">Namespace tidak valid. Masukkan UUID namespace yang benar.</div>';
    return false;
  }

  for (let i = 0; i < count; i++) {
    let uuid;
    switch (version) {
      case 'v1': uuid = uuidV1(); break;
      case 'v3': uuid = uuidFromHash(name, namespace, 3); break;
      case 'v5': uuid = uuidFromHash(name, namespace, 5); break;
      default: uuid = uuidV4();
    }
    if (!uuid) {
      document.getElementById('results').innerHTML = '<div class="text-xs text-error">Gagal generate UUID. Periksa input Anda.</div>';
      return false;
    }
    const formatted = formatUUID(uuid, upper, braces);
    results.push(formatted);
    generatedUUIDs.push(formatted);
  }

  renderResults(results);
  document.getElementById('btnCopyAll').disabled = false;
  return false;
}

function isValidNamespace(ns) {
  return /^\{?[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}\}?$/.test(ns);
}

function renderResults(uuids) {
  let html = '<div class="overflow-x-auto"><table class="table table-sm w-full text-xs"><thead><tr class="opacity-50"><th class="pb-2 w-10">#</th><th class="pb-2">UUID</th><th class="pb-2 w-20">Aksi</th></tr></thead><tbody>';
  uuids.forEach((uuid, idx) => {
    const id = `uuid_${idx}`;
    html += `<tr class="border-b" style="border-color:oklch(0.9 0.005 270);"><td class="py-2 opacity-50">${idx + 1}</td><td class="py-2 font-mono"><code id="${id}" class="text-xs">${escapeHtml(uuid)}</code></td><td class="py-2"><button class="btn btn-ghost btn-xs" onclick="copyText('${id}')">Copy</button></td></tr>`;
  });
  html += '</tbody></table></div>';
  document.getElementById('results').innerHTML = html;
}

function copyText(id) {
  const text = document.getElementById(id).innerText;
  navigator.clipboard.writeText(text).then(() => showToast('Copied!'));
}

function escapeHtml(text) {
  const d = document.createElement('div');
  d.textContent = text;
  return d.innerHTML;
}

function showToast(msg) {
  const t = document.createElement('div');
  t.className = 'tool-toast';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2000);
}

document.getElementById('version').addEventListener('change', () => {
  const v = document.getElementById('version').value;
  document.getElementById('nsSection').style.display = (v === 'v3' || v === 'v5') ? 'block' : 'none';
});

document.getElementById('btnCopyAll').addEventListener('click', () => {
  if (generatedUUIDs.length === 0) { showToast('Tidak ada data'); return; }
  navigator.clipboard.writeText(generatedUUIDs.join('\n')).then(() => showToast('All UUIDs copied!'));
});
</script>
