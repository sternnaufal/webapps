---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'UUID / GUID Generator';
const description = 'Generate UUID/GUID v4 online gratis. UUID generator dengan satu klik, copy ke clipboard.';
const keywords = 'uuid generator, guid generator, uuid v4, generate uuid, unique id';
const aboutText = 'UUID / GUID Generator Generate UUID/GUID v4 online gratis. UUID generator dengan satu klik, copy ke clipboard.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'base64-coded', name: 'Base64 Coded', icon: 'B64' },
  { slug: 'password-generator', name: 'Password Generator', icon: '🔑' },
  { slug: 'qr-generator', name: 'Qr Generator', icon: '▐▌' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<!-- Navbar khusus mobile -->
      

      <header class="flex items-center justify-between mb-4">
        <div class="flex gap-3 items-center">
          <div class="tool-icon" style="background:var(--accent-soft);color:var(--accent);"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg></div>
          <div>
            <h1 class="h3 mb-0">UUID / GUID Generator</h1>
            <p class="opacity-60 small mb-0">Generate UUID v1, v3, v4, v5  pilih quantity dan format (uppercase / braces).</p>
          </div>
        </div>
      </header>

      <form id="uuidForm" onsubmit="return generateUUIDs()" class="flex flex-wrap gap-3 mb-4">
        <div class="md:w-1/3 w-full">
          <label for="version" class="label-text">Versi UUID</label>
          <select id="version" class="select select-bordered w-full" required>
            <option value="v4" selected>v4 (Random)  direkomendasikan</option>
            <option value="v1">v1 (Time-based)</option>
            <option value="v3">v3 (MD5, namespace+name)</option>
            <option value="v5">v5 (SHA1, namespace+name)</option>
          </select>
        </div>

        <div class="col-md-2">
          <label for="count" class="label-text">Jumlah</label>
          <select id="count" class="select select-bordered w-full">
            <option value="1" selected>1</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
          </select>
        </div>

        <div class="md:w-1/4 w-full">
          <label for="format" class="label-text">Format</label>
          <div class="flex gap-2">
            <div class="flex items-center gap-2">
              <input class="checkbox" type="checkbox" id="format_upper">
              <label class="flex items-center gap-2-label" for="format_upper">UPPERCASE</label>
            </div>
            <div class="flex items-center gap-2">
              <input class="checkbox" type="checkbox" id="format_braces">
              <label class="flex items-center gap-2-label" for="format_braces">&#123;braces&#125;</label>
            </div>
          </div>
        </div>

        <div class="md:w-1/4 w-full" id="nsSection" style="display:none;">
          <label for="namespace" class="label-text">Namespace UUID</label>
          <input type="text" id="namespace" class="input input-bordered w-full" placeholder="6ba7b810-9dad-11d1-80b4-00c04fd430c8">
          <div class="text-xs opacity-60">Default DNS namespace</div>
        </div>

        <div class="w-full">
          <label for="name" class="label-text">Name (untuk v3/v5)</label>
          <input type="text" id="name" class="input input-bordered w-full" placeholder="Name string (mis: example.com)">
        </div>

        <div class="w-full">
          <button type="submit" class="btn btn-info">Generate</button>
          <button type="button" id="btnCopyAll" class="btn btn-outline ml-2" disabled>Copy All</button>
        </div>
      </form>

      <div id="results"></div>
    `n

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
const NAMESPACES = &#123;
  'dns': '6ba7b810-9dad-11d1-80b4-00c04fd430c8',
  'url': '6ba7b811-9dad-11d1-80b4-00c04fd430c8',
  'oid': '6ba7b812-9dad-11d1-80b4-00c04fd430c8',
  'x500': '6ba7b814-9dad-11d1-80b4-00c04fd430c8'
&#125;;

let generatedUUIDs = [];

function uuidV1() &#123;
  const now = Date.now();
  const time = (now + 12219292800000) * 10000 + Math.floor(Math.random() * 10000);
  const timeLow = (time >>> 0).toString(16).padStart(8, '0');
  const timeMid = ((time / 0x100000000) >>> 0).toString(16).padStart(4, '0');
  const timeHiVersion = (((time / 0x1000000000000) >>> 0) & 0x0fff | 0x1000).toString(16).padStart(4, '0');

  const clockSeq = Math.floor(Math.random() * 0x4000);
  const clockSeqHi = (((clockSeq >> 8) & 0x3f) | 0x80).toString(16).padStart(2, '0');
  const clockSeqLow = (clockSeq & 0xff).toString(16).padStart(2, '0');

  const node = Math.floor(Math.random() * 0xffffffffffff).toString(16).padStart(12, '0');

  return \`\$&#123;timeLow&#125;-\$&#123;timeMid&#125;-\$&#123;timeHiVersion&#125;-\$&#123;clockSeqHi&#125;\$&#123;clockSeqLow&#125;-\$&#123;node&#125;\`;
&#125;

function uuidV4() &#123;
  const bytes = new Uint8Array(16);
  crypto.getRandomValues(bytes);
  bytes[6] = (bytes[6] & 0x0f) | 0x40;
  bytes[8] = (bytes[8] & 0x3f) | 0x80;
  const h = Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
  return \`\$&#123;h.slice(0,8)&#125;-\$&#123;h.slice(8,12)&#125;-\$&#123;h.slice(12,16)&#125;-\$&#123;h.slice(16,20)&#125;-\$&#123;h.slice(20)&#125;\`;
&#125;

function hexToBinary(hex) &#123;
  const binary = [];
  for (let i = 0; i < hex.length; i += 2) &#123;
    binary.push(parseInt(hex.substr(i, 2), 16));
  &#125;
  return new Uint8Array(binary);
&#125;

function binaryToHex(arr) &#123;
  return Array.from(arr).map(b => b.toString(16).padStart(2, '0')).join('');
&#125;

function uuidFromHash(name, namespace, version) &#123;
  const nsClean = namespace.replace(/[-&#123;&#125;]/g, '');
  if (nsClean.length !== 32) return null;

  const nsBinary = hexToBinary(nsClean);
  const nameBytes = new TextEncoder().encode(name);
  const combined = new Uint8Array(nsBinary.length + nameBytes.length);
  combined.set(nsBinary);
  combined.set(nameBytes, nsBinary.length);

  let hash;
  if (version === 3) &#123;
    hash = CryptoJS.MD5(binaryToHex(combined)).toString();
  &#125; else &#123;
    hash = CryptoJS.SHA1(binaryToHex(combined)).toString();
  &#125;

  const timeLow = hash.substr(0, 8);
  const timeMid = hash.substr(8, 4);
  let timeHiVersion = hash.substr(12, 4);
  let clockSeqHi = hash.substr(16, 2);
  const clockSeqLow = hash.substr(18, 2);
  const node = hash.substr(20, 12);

  timeHiVersion = ((parseInt(timeHiVersion, 16) & 0x0fff) | (version << 12)).toString(16).padStart(4, '0');
  clockSeqHi = ((parseInt(clockSeqHi, 16) & 0x3f) | 0x80).toString(16).padStart(2, '0');

  return \`\$&#123;timeLow&#125;-\$&#123;timeMid&#125;-\$&#123;timeHiVersion&#125;-\$&#123;clockSeqHi&#125;\$&#123;clockSeqLow&#125;-\$&#123;node&#125;\`;
&#125;

function formatUUID(uuid, uppercase, braces) &#123;
  let result = uppercase ? uuid.toUpperCase() : uuid.toLowerCase();
  if (braces) result = '&#123;' + result + '&#125;';
  return result;
&#125;

function generateUUIDs() &#123;
  const version = document.getElementById('version').value;
  const count = Math.min(50, Math.max(1, parseInt(document.getElementById('count').value)));
  const upper = document.getElementById('format_upper').checked;
  const braces = document.getElementById('format_braces').checked;
  const name = document.getElementById('name').value;
  let namespace = document.getElementById('namespace').value.trim();

  if (!namespace) namespace = NAMESPACES.dns;

  generatedUUIDs = [];
  const results = [];

  if ((version === 'v3' || version === 'v5') && name && !isValidNamespace(namespace)) &#123;
    document.getElementById('results').innerHTML = '<div class="alert alert-error">Namespace tidak valid. Masukkan UUID namespace yang benar.</div>';
    return false;
  &#125;

  for (let i = 0; i < count; i++) &#123;
    let uuid;
    switch (version) &#123;
      case 'v1': uuid = uuidV1(); break;
      case 'v3': uuid = uuidFromHash(name, namespace, 3); break;
      case 'v5': uuid = uuidFromHash(name, namespace, 5); break;
      default: uuid = uuidV4();
    &#125;

    if (!uuid) &#123;
      document.getElementById('results').innerHTML = '<div class="alert alert-error">Gagal generate UUID. Periksa input Anda.</div>';
      return false;
    &#125;

    const formatted = formatUUID(uuid, upper, braces);
    results.push(formatted);
    generatedUUIDs.push(formatted);
  &#125;

  renderResults(results);
  document.getElementById('btnCopyAll').disabled = false;

  return false;
&#125;

function isValidNamespace(ns) &#123;
  const pattern = /^(\\&#123;)?[0-9a-fA-F]&#123;8&#125;(-)?[0-9a-fA-F]&#123;4&#125;(-)?[0-9a-fA-F]&#123;4&#125;(-)?[0-9a-fA-F]&#123;4&#125;(-)?[0-9a-fA-F]&#123;12&#125;(\\&#125;)?$/;
  return pattern.test(ns);
&#125;

function renderResults(uuids) &#123;
  let html = '<div class="card card-bordered bg-base-100 p-3 mb-4"><h5 class="mb-3">Hasil UUID</h5><div class="overflow-x-auto"><table class="table table-sm table-zebra align-middle"><thead class="table-light"><tr><th>#</th><th>UUID</th><th>Aksi</th></tr></thead><tbody>';

  uuids.forEach((uuid, idx) => &#123;
    const id = \`uuid_\$&#123;idx&#125;\`;
    html += \`<tr><td>\$&#123;idx + 1&#125;</td><td class="uuid-code"><code id="\$&#123;id&#125;">\$&#123;escapeHtml(uuid)&#125;</code></td><td><button class="btn btn-sm btn-outline-secondary" onclick="copyText('\$&#123;id&#125;')">Copy</button></td></tr>\`;
  &#125;);

  html += '</tbody></table></div></div>';
  document.getElementById('results').innerHTML = html;
&#125;

function copyText(id) &#123;
  const text = document.getElementById(id).innerText;
  navigator.clipboard.writeText(text).then(() => showToast('Copied to clipboard'));
&#125;

function escapeHtml(text) &#123;
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
&#125;

function showToast(message) &#123;
  const toast = document.createElement('div');
  toast.className = 'toast items-center text-bg-light border p-2 toast-fixed';
  toast.innerHTML = \`<div class="flex"><div class="toast-body">\$&#123;message&#125;</div><button type="button" class="btn-close btn-close-white mr-2 m-auto" aria-label="Close"></button></div>\`;
  document.body.appendChild(toast);
  toast.querySelector('.btn-close').addEventListener('click', () => toast.remove());
  setTimeout(() => toast.remove(), 2200);
&#125;

document.getElementById('version').addEventListener('change', () => &#123;
  const v = document.getElementById('version').value;
  document.getElementById('nsSection').style.display = (v === 'v3' || v === 'v5') ? 'block' : 'none';
&#125;);

document.getElementById('btnCopyAll').addEventListener('click', () => &#123;
  if (generatedUUIDs.length === 0) &#123;
    showToast('Tidak ada data untuk disalin');
    return;
  &#125;
  navigator.clipboard.writeText(generatedUUIDs.join('\\n')).then(() => showToast('All UUIDs copied'));
&#125;);
</script>

