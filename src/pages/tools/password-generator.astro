---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Password Generator';
const description = 'Generate password kuat dan acak online. Password generator dengan opsi panjang, huruf, angka, simbol.';
const keywords = 'password generator, random password, strong password, password acak, password kuat';
const aboutText = 'Password generator online untuk membuat kata sandi acak yang kuat dan aman dengan panjang 8 hingga 128 karakter. Alat ini membantu Anda menghasilkan password kompleks yang sulit ditebak dan kebal terhadap serangan brute force. Fitur kustomisasi meliputi pengaturan panjang password, pemilihan jenis karakter (huruf besar, huruf kecil, angka, simbol), serta opsi untuk menghindari karakter ambigu seperti O, 0, I, l, dan 1 yang sering tertukar.';
const aboutExtra = 'Password generator sangat penting untuk menjaga keamanan akun digital Anda. Dengan semakin banyaknya layanan online yang kita gunakan, menggunakan password yang sama untuk semua akun sangat berbahaya. Alat ini membantu Anda membuat password unik dan kuat untuk setiap akun: sosial media, email, internet banking, e-commerce, VPN, dan layanan cloud. Gunakan password minimal 12 karakter dengan kombinasi huruf besar, huruf kecil, angka, dan simbol untuk keamanan optimal. Generator password ini gratis dan tidak terbatas jumlah penggunaannya.';
const relatedTools = [
  { slug: 'password-strength', name: 'Password Strength', icon: '🛡' },
  { slug: 'uuid-generator', name: 'UUID Generator', icon: '🆔' },
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'qr-generator', name: 'QR Generator', icon: '▐▌' },
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

  <!-- Form -->
  <form id="pwForm" class="flex flex-wrap gap-3 mb-4" onsubmit="return false;">
    <div class="md:w-1/4 w-full">
      <label for="length" class="label-text font-medium text-sm">Panjang</label>
      <input type="number" id="length" class="input input-bordered w-full input-sm" min="4" max="128" value="16" />
      <div class="text-xs opacity-50 mt-0.5">Antara 4–128 karakter</div>
    </div>

    <div class="md:w-1/4 w-full">
      <label class="label-text font-medium text-sm">Jumlah hasil</label>
      <select id="count" class="select select-bordered w-full select-sm">
        <option value="1" selected>1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="5">5</option>
        <option value="10">10</option>
        <option value="20">20</option>
      </select>
    </div>

    <div class="md:w-1/2 w-full">
      <label class="label-text font-medium text-sm">Karakter</label>
      <div class="flex gap-3 flex-wrap text-sm">
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input class="checkbox checkbox-xs" type="checkbox" id="lower" checked>
          <span>Lowercase (a–z)</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input class="checkbox checkbox-xs" type="checkbox" id="upper" checked>
          <span>Uppercase (A–Z)</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input class="checkbox checkbox-xs" type="checkbox" id="numbers" checked>
          <span>Numbers (0–9)</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input class="checkbox checkbox-xs" type="checkbox" id="symbols">
          <span>Symbols (!@#...)</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input class="checkbox checkbox-xs" type="checkbox" id="excludeAmbiguous">
          <span>Exclude ambiguous (0 O 1 l I)</span>
        </label>
      </div>
    </div>

    <div class="w-full flex gap-2 flex-wrap">
      <button id="btnGenerate" class="btn btn-warning btn-sm">Generate</button>
      <button id="btnCopyAll" class="btn btn-outline btn-sm" disabled>Copy All</button>
    </div>
  </form>

  <!-- Strength & info -->
  <div class="card card-bordered bg-base-200/50 mb-4">
    <div class="card-body p-4">
      <div class="flex items-center justify-between mb-2">
        <div>
          <strong class="text-sm">Kekuatan & Entropy</strong>
          <div class="text-xs opacity-50">Estimasi kekuatan password berdasarkan entropy.</div>
        </div>
        <div id="entropyText" class="text-xs text-right font-mono">Entropy: — bits</div>
      </div>
      <div class="strength-bar mb-1">
        <div id="strengthFill" class="strength-fill"></div>
      </div>
      <div id="strengthLabel" class="text-xs font-medium"></div>
    </div>
  </div>

  <!-- Results -->
  <div id="resultsContainer" class="mb-4"></div>

  <!-- Tips -->
  <div class="card card-bordered bg-base-200/50">
    <div class="card-body p-4">
      <h5 class="font-bold text-sm mb-2">Tips</h5>
      <ul class="text-xs space-y-1 opacity-80">
        <li>Gunakan panjang minimal 12 karakter untuk password akun penting.</li>
        <li>Jangan gunakan password yang sama pada banyak layanan.</li>
        <li>Aktifkan 2-factor authentication bila tersedia.</li>
      </ul>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
const POOLS = &#123;
  lower: 'abcdefghijklmnopqrstuvwxyz',
  upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
  numbers: '0123456789',
  symbols: '!@#$%^&*()-_=+[]&#123;&#125;|;:,.<>?/~\`'
&#125;;

const AMBIGUOUS = '0O1lI|';

function buildCharset(options) &#123;
  let set = '';
  if (options.lower) set += POOLS.lower;
  if (options.upper) set += POOLS.upper;
  if (options.numbers) set += POOLS.numbers;
  if (options.symbols) set += POOLS.symbols;
  if (options.excludeAmbiguous) &#123;
    set = set.split('').filter(c => !AMBIGUOUS.includes(c)).join('');
  &#125;
  return Array.from(new Set(set)).join('');
&#125;

function secureRandomInt(max) &#123;
  const array = new Uint32Array(1);
  window.crypto.getRandomValues(array);
  return array[0] % max;
&#125;

function generateOne(length, charset) &#123;
  if (!charset || charset.length === 0) return '';
  let out = '';
  for (let i = 0; i < length; i++) &#123;
    out += charset[secureRandomInt(charset.length)];
  &#125;
  return out;
&#125;

function calcEntropy(length, charsetSize) &#123;
  if (charsetSize <= 0 || length <= 0) return 0;
  return (length * Math.log2(charsetSize));
&#125;

function strengthLabel(entropy) &#123;
  if (entropy < 28) return &#123;label: 'Very weak', color:'#ff6b6b'&#125;;
  if (entropy < 36) return &#123;label: 'Weak', color:'#ff914d'&#125;;
  if (entropy < 60) return &#123;label: 'Fair', color:'#ffd166'&#125;;
  if (entropy < 80) return &#123;label: 'Strong', color:'#a0e75a'&#125;;
  return &#123;label: 'Very strong', color:'#47d160'&#125;;
&#125;

function renderResults(list) &#123;
  const container = document.getElementById('resultsContainer');
  container.innerHTML = '';
  if (!list || list.length === 0) return;

  const table = document.createElement('table');
  table.className = 'table table-sm table-zebra pwd-output';
  const thead = document.createElement('thead');
  thead.innerHTML = '<tr><th>#</th><th>Password</th><th>Action</th></tr>';
  table.appendChild(thead);
  const tbody = document.createElement('tbody');

  list.forEach((pw, idx) => &#123;
    const tr = document.createElement('tr');
    tr.innerHTML = \`<td>\$&#123;idx+1&#125;</td><td><code id="pw_\$&#123;idx&#125;">\$&#123;pw&#125;</code></td><td><button class="btn btn-sm btn-outline-secondary" onclick="copyText('pw_\$&#123;idx&#125;')">Copy</button></td>\`;
    tbody.appendChild(tr);
  &#125;);

  table.appendChild(tbody);
  container.appendChild(table);
  document.getElementById('btnCopyAll').disabled = false;
&#125;

function copyText(id) &#123;
  const text = document.getElementById(id).innerText;
  navigator.clipboard.writeText(text).then(() => &#123;
    showToast('Copied to clipboard', 'success');
  &#125;);
&#125;

function copyAll(list) &#123;
  if (!list || list.length === 0) return;
  navigator.clipboard.writeText(list.join('\\n')).then(() => &#123;
    showToast('All passwords copied', 'success');
  &#125;);
&#125;

function showToast(message, variant='info') &#123;
  const toast = document.createElement('div');
  toast.className = 'toast items-center text-bg-light border p-2';
  toast.style.position = 'fixed';
  toast.style.right = '20px';
  toast.style.bottom = '20px';
  toast.style.zIndex = 9999;
  toast.innerHTML = \`<div class="flex"><div class="toast-body">\$&#123;message&#125;</div><button type="button" class="btn-close btn-close-white mr-2 m-auto" aria-label="Close"></button></div>\`;
  document.body.appendChild(toast);
  toast.querySelector('.btn-close').addEventListener('click', () => toast.remove());
  setTimeout(() => &#123; toast.remove(); &#125;, 2500);
&#125;

document.getElementById('btnGenerate').addEventListener('click', function (e) &#123;
  e.preventDefault();
  const length = parseInt(document.getElementById('length').value, 10) || 16;
  const count = parseInt(document.getElementById('count').value, 10) || 1;
  const options = &#123;
    lower: document.getElementById('lower').checked,
    upper: document.getElementById('upper').checked,
    numbers: document.getElementById('numbers').checked,
    symbols: document.getElementById('symbols').checked,
    excludeAmbiguous: document.getElementById('excludeAmbiguous').checked
  &#125;;

  const charset = buildCharset(options);
  if (!charset || charset.length === 0) &#123;
    showToast('Pilih set karakter minimal satu (lower/upper/numbers/symbols)', 'warning');
    return;
  &#125;

  const results = [];
  for (let i = 0; i < count; i++) &#123;
    results.push(generateOne(length, charset));
  &#125;

  renderResults(results);

  const entropy = calcEntropy(length, charset.length);
  const eText = entropy.toFixed(1);
  document.getElementById('entropyText').innerText = \`Entropy: \$&#123;eText&#125; bits\`;

  const s = strengthLabel(entropy);
  const fill = document.getElementById('strengthFill');
  const pct = Math.min(100, Math.round((entropy / 100) * 100));
  fill.style.width = pct + '%';
  fill.style.background = s.color;
  document.getElementById('strengthLabel').innerText = s.label;

  document.getElementById('btnCopyAll').onclick = () => copyAll(results);
  document.getElementById('btnCopyAll').disabled = false;
&#125;);

document.getElementById('btnCopyAll').disabled = true;
</script>

