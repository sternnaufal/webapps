---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Time Converter';
const description = 'Konversi waktu dan zona waktu online. Time converter dengan dukungan berbagai format dan timezone.';
const keywords = 'time converter, timezone converter, konversi waktu, time tool';
const aboutText = 'Time Converter Konversi waktu dan zona waktu online. Time converter dengan dukungan berbagai format dan timezone.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'epoch-converter', name: 'Epoch Converter', icon: '⏱' },
  { slug: 'date-calculator', name: 'Date Calculator', icon: '📅' },
  { slug: 'world-clock', name: 'World Clock', icon: '🌍' },
  { slug: 'countdown', name: 'Countdown', icon: '⏳' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0fdf4;color:#16a34a;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div><h1 class="h3 mb-0">Time Converter</h1><p class="opacity-60 small mb-0">Konversi epoch/unix timestamp ke readable date, dan sebaliknya. Juga konversi timezone.</p></div></header>
<ul class="nav nav-tabs mb-4"><li class="nav-item"><a class="nav-link active" href="#" data-tab="epoch">Epoch Converter</a></li><li class="nav-item"><a class="nav-link" href="#" data-tab="tz">Timezone Converter</a></li></ul>
<div id="tabEpoch">
<div class="card card-bordered bg-base-100 p-4"><div class="flex flex-wrap gap-3 align-items-end">
<div class="md:w-1/2 w-full"><label class="label-text">Unix Timestamp (seconds)</label><input id="epochInput" class="input input-bordered w-full font-mono" value="1718612345"><div class="flex gap-2 mt-2"><button id="btnEpochNow" class="btn btn-outline-primary btn-sm">Now</button><button id="btnEpochToDate" class="btn btn-primary btn-sm">To Date</button></div></div>
<div class="md:w-1/2 w-full"><label class="label-text">Readable Date (ISO)</label><input id="dateInput" class="input input-bordered w-full font-mono" value="2024-06-17T06:59:05.000Z"><div class="flex gap-2 mt-2"><button id="btnDateNow" class="btn btn-outline-primary btn-sm">Now</button><button id="btnDateToEpoch" class="btn btn-primary btn-sm">To Epoch</button></div></div></div>
<div class="flex flex-wrap gap-3 mt-3"><div class="md:w-1/4 w-full"><div class="p-3 rounded text-center" style="background:var(--surface-soft)"><small class="opacity-60">UTC</small><div id="dispUTC" class="font-semibold font-mono mt-1">-</div></div></div>
<div class="md:w-1/4 w-full"><div class="p-3 rounded text-center" style="background:var(--surface-soft)"><small class="opacity-60">Local</small><div id="dispLocal" class="font-semibold font-mono mt-1">-</div></div></div>
<div class="md:w-1/4 w-full"><div class="p-3 rounded text-center" style="background:var(--surface-soft)"><small class="opacity-60">ISO</small><div id="dispISO" class="font-semibold font-mono mt-1">-</div></div></div>
<div class="md:w-1/4 w-full"><div class="p-3 rounded text-center" style="background:var(--surface-soft)"><small class="opacity-60">Relative</small><div id="dispRelative" class="font-semibold font-mono mt-1">-</div></div></div></div></div></div>
<div id="tabTZ" style="display:none;">
<div class="card card-bordered bg-base-100 p-4"><div class="flex flex-wrap gap-3">
<div class="md:w-1/3 w-full"><label class="label-text">Date & Time</label><input id="tzInput" type="datetime-local" class="input input-bordered w-full"></div>
<div class="md:w-1/3 w-full"><label class="label-text">From Timezone</label><select id="tzFrom" class="select select-bordered w-full font-mono"></select></div>
<div class="md:w-1/3 w-full"><label class="label-text">To Timezone</label><select id="tzTo" class="select select-bordered w-full font-mono"></select></div></div>
<div class="mt-3"><button id="btnTZConvert" class="btn btn-primary">Convert</button></div>
<div id="tzResult" class="mt-3 p-3 rounded bg-white border font-mono" style="display:none;"></div></div></div>
`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
// Tabs
document.querySelectorAll('#tabEpoch, #tabTZ').forEach(function(){});
document.querySelectorAll('.nav-tabs .nav-link').forEach(function(t){t.addEventListener('click',function(e){e.preventDefault();document.querySelectorAll('.nav-tabs .nav-link').forEach(function(x){x.classList.remove('active')});this.classList.add('active');
var tab=this.getAttribute('data-tab');document.getElementById('tabEpoch').style.display=tab==='epoch'?'block':'none';document.getElementById('tabTZ').style.display=tab==='tz'?'block':'none'})});
// Epoch
var eInp=document.getElementById('epochInput'),dInp=document.getElementById('dateInput'),dUTC=document.getElementById('dispUTC'),dLoc=document.getElementById('dispLocal'),dISO=document.getElementById('dispISO'),dRel=document.getElementById('dispRelative');
function updateFromEpoch(){var s=parseInt(eInp.value,10);if(isNaN(s))return;var d=new Date(s*1000);refreshDisplay(d)}
function updateFromDate(){var s=dInp.value;if(!s)return;var d=new Date(s);if(isNaN(d.getTime()))return;eInp.value=Math.floor(d.getTime()/1000);refreshDisplay(d)}
function refreshDisplay(d){dUTC.textContent=d.toUTCString();dLoc.textContent=d.toLocaleString();dISO.textContent=d.toISOString();
var n=Date.now(),diff=Math.floor((n-d.getTime())/1000);if(diff<60)dRel.textContent='just now';else if(diff<3600)dRel.textContent=Math.floor(diff/60)+' min ago';else if(diff<86400)dRel.textContent=Math.floor(diff/3600)+' hours ago';else dRel.textContent=Math.floor(diff/86400)+' days ago'}
document.getElementById('btnEpochNow').addEventListener('click',function(){eInp.value=Math.floor(Date.now()/1000);updateFromEpoch()});
document.getElementById('btnEpochToDate').addEventListener('click',updateFromEpoch);
document.getElementById('btnDateNow').addEventListener('click',function(){dInp.value=new Date().toISOString().slice(0,16);updateFromDate()});
document.getElementById('btnDateToEpoch').addEventListener('click',updateFromDate);
// TZ
var tzNames=Intl.supportedValuesOf?Intl.supportedValuesOf('timeZone'):['UTC','Asia/Jakarta','Asia/Makassar','Asia/Jayapura','America/New_York','America/Los_Angeles','Europe/London','Europe/Berlin','Asia/Tokyo','Australia/Sydney','Pacific/Auckland'];
var tzF=document.getElementById('tzFrom'),tzT=document.getElementById('tzTo');
tzNames.forEach(function(z){var o1=document.createElement('option');o1.value=z;o1.textContent=z;tzF.appendChild(o1);
var o2=document.createElement('option');o2.value=z;o2.textContent=z;tzT.appendChild(o2)});tzF.value=Intl.DateTimeFormat().resolvedOptions().timeZone;tzT.value='UTC';
document.getElementById('btnTZConvert').addEventListener('click',function(){var v=document.getElementById('tzInput').value;if(!v){alert('Pilih tanggal & waktu');return}var d=new Date(v+':00'),f=tzF.value,t=tzT.value;
var fStr=d.toLocaleString('en-US',{timeZone:f,timeStyle:'full',dateStyle:'full'}),tStr=d.toLocaleString('en-US',{timeZone:t,timeStyle:'full',dateStyle:'full'});
document.getElementById('tzResult').innerHTML='<div class="mb-2"><strong>'+f+':</strong> '+fStr+'</div><div><strong>'+t+':</strong> '+tStr+'</div>';document.getElementById('tzResult').style.display='block'});
updateFromEpoch();
</script>

