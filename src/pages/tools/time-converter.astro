---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Time Converter';
const description = 'Konversi waktu dan zona waktu online. Time converter dengan dukungan berbagai format dan timezone.';
const keywords = 'time converter, timezone converter, konversi waktu, time tool';
const aboutText = 'Konversi waktu dan zona waktu online. Time converter dengan dukungan berbagai format dan timezone.';
const relatedTools = [
  { slug: 'epoch-converter', name: 'Epoch Converter', icon: '⏱' },
  { slug: 'date-calculator', name: 'Date Calculator', icon: '📅' },
  { slug: 'world-clock', name: 'World Clock', icon: '🌍' },
  { slug: 'countdown', name: 'Countdown', icon: '⏳' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="mb-5">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</header>

<div class="flex gap-2 mb-4">
  <button class="btn btn-sm active-tab" data-tab="epoch" style="background:#8b5cf6;color:oklch(1 0 0);border:none;border-radius:8px;">Epoch Converter</button>
  <button class="btn btn-sm" data-tab="tz" style="background:oklch(0.93 0.008 270);color:oklch(0.3 0.02 270);border:none;border-radius:8px;">Timezone Converter</button>
</div>

<div id="tabEpoch">
  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="text-xs font-medium opacity-60 mb-1 block">Unix Timestamp (seconds)</label>
        <input id="epochInput" class="input input-bordered w-full input-sm font-mono" value="1718612345">
        <div class="flex gap-2 mt-2">
          <button id="btnEpochNow" class="btn btn-ghost btn-sm">Now</button>
          <button id="btnEpochToDate" class="btn btn-primary btn-sm">To Date</button>
        </div>
      </div>
      <div>
        <label class="text-xs font-medium opacity-60 mb-1 block">Readable Date (ISO)</label>
        <input id="dateInput" class="input input-bordered w-full input-sm font-mono" value="2024-06-17T06:59:05.000Z">
        <div class="flex gap-2 mt-2">
          <button id="btnDateNow" class="btn btn-ghost btn-sm">Now</button>
          <button id="btnDateToEpoch" class="btn btn-primary btn-sm">To Epoch</button>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-4">
      <div class="rounded-lg p-3 text-center" style="background:oklch(0.95 0.005 270);">
        <div class="text-xs opacity-40">UTC</div>
        <div id="dispUTC" class="text-sm font-semibold font-mono mt-1">-</div>
      </div>
      <div class="rounded-lg p-3 text-center" style="background:oklch(0.95 0.005 270);">
        <div class="text-xs opacity-40">Local</div>
        <div id="dispLocal" class="text-sm font-semibold font-mono mt-1">-</div>
      </div>
      <div class="rounded-lg p-3 text-center" style="background:oklch(0.95 0.005 270);">
        <div class="text-xs opacity-40">ISO</div>
        <div id="dispISO" class="text-sm font-semibold font-mono mt-1">-</div>
      </div>
      <div class="rounded-lg p-3 text-center" style="background:oklch(0.95 0.005 270);">
        <div class="text-xs opacity-40">Relative</div>
        <div id="dispRelative" class="text-sm font-semibold font-mono mt-1">-</div>
      </div>
    </div>
  </div>
</div>

<div id="tabTZ" style="display:none;">
  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="text-xs font-medium opacity-60 mb-1 block">Date & Time</label>
        <input id="tzInput" type="datetime-local" class="input input-bordered w-full input-sm">
      </div>
      <div>
        <label class="text-xs font-medium opacity-60 mb-1 block">From Timezone</label>
        <select id="tzFrom" class="select select-bordered w-full select-sm font-mono"></select>
      </div>
      <div>
        <label class="text-xs font-medium opacity-60 mb-1 block">To Timezone</label>
        <select id="tzTo" class="select select-bordered w-full select-sm font-mono"></select>
      </div>
    </div>
    <div class="mt-3">
      <button id="btnTZConvert" class="btn btn-primary btn-sm">Convert</button>
    </div>
    <div id="tzResult" class="mt-3 rounded-lg p-3 font-mono text-sm" style="background:oklch(0.95 0.005 270);border:1px solid oklch(0.9 0.005 270);display:none;"></div>
  </div>
</div>

<ToolShell about={aboutText} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
// Tabs
document.querySelectorAll('[data-tab]').forEach(function(t){t.addEventListener('click',function(e){e.preventDefault();
document.querySelectorAll('[data-tab]').forEach(function(x){x.style.background='oklch(0.93 0.008 270)';x.style.color='oklch(0.3 0.02 270)';});
this.style.background='#8b5cf6';this.style.color='oklch(1 0 0)';
var tab=this.getAttribute('data-tab');document.getElementById('tabEpoch').style.display=tab==='epoch'?'block':'none';document.getElementById('tabTZ').style.display=tab==='tz'?'block':'none'})});
// Epoch
var eInp=document.getElementById('epochInput'),dInp=document.getElementById('dateInput'),dUTC=document.getElementById('dispUTC'),dLoc=document.getElementById('dispLocal'),dISO=document.getElementById('dispISO'),dRel=document.getElementById('dispRelative');
function updateFromEpoch(){var s=parseInt(eInp.value,10);if(isNaN(s))return;var d=new Date(s*1000);refreshDisplay(d)}
function updateFromDate(){var s=dInp.value;if(!s)return;var d=new Date(s);if(isNaN(d.getTime()))return;eInp.value=Math.floor(d.getTime()/1000);refreshDisplay(d)}
function refreshDisplay(d){dUTC.textContent=d.toUTCString();dLoc.textContent=d.toLocaleString();dISO.textContent=d.toISOString();
var n=Date.now(),diff=Math.floor((n-d.getTime())/1000);if(diff<60)dRel.textContent='just now';else if(diff<3600)dRel.textContent=Math.floor(diff/60)+' min ago';else if(diff<86400)dRel.textContent=Math.floor(diff/3600)+' hours ago';else dRel.textContent=Math.floor(diff/86400)+' days ago'}
document.getElementById('btnEpochNow').addEventListener('click',function(){eInp.value=Math.floor(Date.now()/1000);updateFromEpoch()});
document.getElementById('btnEpochToDate').addEventListener('click',updateFromEpoch);
document.getElementById('btnDateNow').addEventListener('click',function(){dInp.value=new Date().toISOString().slice(0,16);updateFromDate()});
document.getElementById('btnDateToEpoch').addEventListener('click',updateFromDate);
// TZ
var tzNames=Intl.supportedValuesOf?Intl.supportedValuesOf('timeZone'):['UTC','Asia/Jakarta','Asia/Makassar','Asia/Jayapura','America/New_York','America/Los_Angeles','Europe/London','Europe/Berlin','Asia/Tokyo','Australia/Sydney','Pacific/Auckland'];
var tzF=document.getElementById('tzFrom'),tzT=document.getElementById('tzTo');
tzNames.forEach(function(z){var o1=document.createElement('option');o1.value=z;o1.textContent=z;tzF.appendChild(o1);
var o2=document.createElement('option');o2.value=z;o2.textContent=z;tzT.appendChild(o2)});tzF.value=Intl.DateTimeFormat().resolvedOptions().timeZone;tzT.value='UTC';
document.getElementById('btnTZConvert').addEventListener('click',function(){var v=document.getElementById('tzInput').value;if(!v){alert('Pilih tanggal & waktu');return}var d=new Date(v+':00'),f=tzF.value,t=tzT.value;
var fStr=d.toLocaleString('en-US',{timeZone:f,timeStyle:'full',dateStyle:'full'}),tStr=d.toLocaleString('en-US',{timeZone:t,timeStyle:'full',dateStyle:'full'});
document.getElementById('tzResult').innerHTML='<div class="mb-2"><strong>'+f+':</strong> '+fStr+'</div><div><strong>'+t+':</strong> '+tStr+'</div>';document.getElementById('tzResult').style.display='block'});
updateFromEpoch();
</script>