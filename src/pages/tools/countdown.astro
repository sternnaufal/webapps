---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Countdown Timer';
const description = 'Countdown timer online. Hitung mundur ke tanggal dan acara spesial seperti tahun baru, ulang tahun, atau liburan.';
const keywords = 'countdown timer, hitung mundur, countdown online, tahun baru countdown';
const aboutText = 'Countdown timer online. Hitung mundur ke tanggal dan acara spesial seperti tahun baru, ulang tahun, atau liburan.';
const relatedTools = [
  { slug: 'timer', name: 'Timer', icon: '⏱' },
  { slug: 'stopwatch', name: 'Stopwatch', icon: '⏱' },
  { slug: 'pomodoro', name: 'Pomodoro', icon: '🍅' },
  { slug: 'date-calculator', name: 'Date Calculator', icon: '📅' }
];

const toolCss = `.cd-unit{text-align:center;padding:0.5rem}.cd-unit .num{font-size:2.5rem;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.2;color:#6366f1}.cd-unit .lbl{font-size:0.7rem;opacity:0.6;text-transform:uppercase}`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5 mb-4" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
  <div class="grid grid-cols-1 md:grid-cols-5 gap-3 items-end">
    <div class="md:col-span-1"><label class="text-xs font-medium opacity-60 mb-1 block">Nama Acara</label><input type="text" id="eventName" class="input input-bordered w-full input-sm" value="Tahun Baru 2027"></div>
    <div><label class="text-xs font-medium opacity-60 mb-1 block">Tanggal</label><input type="date" id="eventDate" class="input input-bordered w-full input-sm"></div>
    <div><label class="text-xs font-medium opacity-60 mb-1 block">Jam</label><input type="time" id="eventTime" class="input input-bordered w-full input-sm" value="00:00"></div>
    <div><label class="text-xs font-medium opacity-60 mb-1 block">&nbsp;</label><button id="btnSet" class="btn btn-primary btn-sm w-full">Set</button></div>
    <div><label class="text-xs font-medium opacity-60 mb-1 block">&nbsp;</label>
      <select id="presetSelect" class="select select-bordered w-full select-sm">
        <option value="">Preset Cepat</option>
        <option value="nye">Tahun Baru (1 Jan)</option>
        <option value="ultah">Ulang Tahun +1 thn</option>
        <option value="libur">Liburan +1 bln</option>
        <option value="week">+1 Minggu</option>
      </select>
    </div>
  </div>
</div>

<div class="rounded-xl p-5 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
  <div class="text-sm font-bold mb-4" id="cdTitle">Menuju: Tahun Baru 2027</div>
  <div class="flex justify-center gap-3">
    <div class="cd-unit"><div class="num" id="cdDays">0</div><div class="lbl">Hari</div></div>
    <div class="cd-unit"><div class="num" id="cdHours">0</div><div class="lbl">Jam</div></div>
    <div class="cd-unit"><div class="num" id="cdMins">0</div><div class="lbl">Menit</div></div>
    <div class="cd-unit"><div class="num" id="cdSecs">0</div><div class="lbl">Detik</div></div>
  </div>
  <div id="cdStatus" class="mt-3 text-xs opacity-60"></div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>

<script is:inline>
var cdDays=document.getElementById('cdDays'),cdHours=document.getElementById('cdHours'),cdMins=document.getElementById('cdMins'),cdSecs=document.getElementById('cdSecs'),cdTitle=document.getElementById('cdTitle'),cdStatus=document.getElementById('cdStatus');
var evName=document.getElementById('eventName'),evDate=document.getElementById('eventDate'),evTime=document.getElementById('eventTime'),btnSet=document.getElementById('btnSet'),preset=document.getElementById('presetSelect');
var target=null,timer=null;

function setCountdown(name,dateStr,timeStr){
  target=new Date(dateStr+'T'+(timeStr||'00:00'));
  evName.value=name;evDate.value=dateStr;evTime.value=timeStr||'00:00';
  cdTitle.textContent='Menuju: '+name;
  if(timer)clearInterval(timer);
  tick();timer=setInterval(tick,1000);
}

function tick(){
  if(!target){cdDays.textContent='0';cdHours.textContent='0';cdMins.textContent='0';cdSecs.textContent='0';cdStatus.textContent='';return}
  var now=new Date(),diff=target-now;
  if(diff<=0){
    cdDays.textContent='0';cdHours.textContent='0';cdMins.textContent='0';cdSecs.textContent='0';
    cdStatus.innerHTML='<span class="text-green-600 font-bold">&#127881; '+evName.value+' sudah tiba!</span>';
    if(timer)clearInterval(timer);
    return;
  }
  var d=Math.floor(diff/86400000),h=Math.floor((diff%86400000)/3600000),m=Math.floor((diff%3600000)/60000),s=Math.floor((diff%60000)/1000);
  cdDays.textContent=d;cdHours.textContent=String(h).padStart(2,'0');cdMins.textContent=String(m).padStart(2,'0');cdSecs.textContent=String(s).padStart(2,'0');
  cdStatus.innerHTML='<span class="opacity-60">'+evName.value+': '+target.toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'})+'</span>';
}

btnSet.addEventListener('click',function(){
  var d=evDate.value,t=evTime.value,n=evName.value.trim()||'Acara';
  if(!d){alert('Pilih tanggal!');return}
  setCountdown(n,d,t);
});

preset.addEventListener('change',function(){
  var now=new Date(),y=now.getFullYear(),m=String(now.getMonth()+1).padStart(2,'0'),d=String(now.getDate()).padStart(2,'0');
  if(this.value==='nye'){var ny=new Date(y+1,0,1);setCountdown('Tahun Baru '+(y+1),ny.toISOString().split('T')[0],'00:00')}
  else if(this.value==='ultah'){var b=new Date(y+1,now.getMonth(),now.getDate());setCountdown('Ulang Tahun',b.toISOString().split('T')[0],'00:00')}
  else if(this.value==='libur'){var l=new Date(now);l.setMonth(l.getMonth()+1);setCountdown('Liburan '+l.toLocaleDateString('id-ID',{month:'long'}),l.toISOString().split('T')[0],'00:00')}
  else if(this.value==='week'){var w=new Date(now);w.setDate(w.getDate()+7);setCountdown('+1 Minggu',w.toISOString().split('T')[0],'00:00')}
  this.value='';
});

// Set default: New Year 2027
var nyDate=new Date(2027,0,1);
setCountdown('Tahun Baru 2027',nyDate.toISOString().split('T')[0],'00:00');
</script>