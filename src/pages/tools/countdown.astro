---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Countdown Timer';
const description = 'Countdown timer online. Hitung mundur ke tanggal dan acara spesial seperti tahun baru, ulang tahun, atau liburan.';
const keywords = 'countdown timer, hitung mundur, countdown online, tahun baru countdown';
const aboutText = 'Countdown Timer Countdown timer online. Hitung mundur ke tanggal dan acara spesial seperti tahun baru, ulang tahun, atau liburan.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'timer', name: 'Timer', icon: '⏱' },
  { slug: 'stopwatch', name: 'Stopwatch', icon: '⏱' },
  { slug: 'pomodoro', name: 'Pomodoro', icon: '🍅' },
  { slug: 'date-calculator', name: 'Date Calculator', icon: '📅' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#fef2f2;color:#dc2626;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div><h1 class="h3 mb-0">Countdown Timer</h1><p class="opacity-60 small mb-0">Hitung mundur ke tanggal spesial: tahun baru, ulang tahun, liburan, atau acara penting lainnya.</p></div></header>
<div class="card card-bordered bg-base-100 p-4 mb-4">
<div class="flex flex-wrap gap-3 align-items-end"><div class="md:w-1/3 w-full"><label class="label-text font-semibold">Nama Acara</label><input type="text" id="eventName" class="input input-bordered w-full" value="Tahun Baru 2027"></div>
<div class="md:w-1/4 w-full"><label class="label-text font-semibold">Tanggal</label><input type="date" id="eventDate" class="input input-bordered w-full"></div>
<div class="col-md-2"><label class="label-text font-semibold">Jam</label><input type="time" id="eventTime" class="input input-bordered w-full" value="00:00"></div>
<div class="col-md-1"><label class="label-text font-semibold">&nbsp;</label><button id="btnSet" class="btn btn-primary w-full">Set</button></div>
<div class="col-md-2"><label class="label-text font-semibold">&nbsp;</label>
<select id="presetSelect" class="select select-bordered w-full"><option value="">Preset Cepat</option><option value="nye">Tahun Baru (1 Jan)</option><option value="ultah">Ulang Tahun +1 thn</option><option value="libur">Liburan +1 bln</option><option value="week">+1 Minggu</option></select></div></div></div>
<div class="card card-bordered bg-base-100 p-4 text-center">
<h5 id="cdTitle" class="font-bold mb-4">Menuju: Tahun Baru 2027</h5>
<div class="flex flex-wrap gap-3 justify-center"><div class="col-3 col-md-2"><div class="cd-unit"><div class="num" id="cdDays">0</div><div class="lbl">Hari</div></div></div>
<div class="col-3 col-md-2"><div class="cd-unit"><div class="num" id="cdHours">0</div><div class="lbl">Jam</div></div></div>
<div class="col-3 col-md-2"><div class="cd-unit"><div class="num" id="cdMins">0</div><div class="lbl">Menit</div></div></div>
<div class="col-3 col-md-2"><div class="cd-unit"><div class="num" id="cdSecs">0</div><div class="lbl">Detik</div></div></div></div>
<div id="cdStatus" class="mt-3 text-sm opacity-60"></div></div>
`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var cdDays=document.getElementById('cdDays'),cdHours=document.getElementById('cdHours'),cdMins=document.getElementById('cdMins'),cdSecs=document.getElementById('cdSecs'),cdTitle=document.getElementById('cdTitle'),cdStatus=document.getElementById('cdStatus');
var evName=document.getElementById('eventName'),evDate=document.getElementById('eventDate'),evTime=document.getElementById('eventTime'),btnSet=document.getElementById('btnSet'),preset=document.getElementById('presetSelect');
var target=null,timer=null;

function setCountdown(name,dateStr,timeStr){
  target=new Date(dateStr+'T'+(timeStr||'00:00'));
  evName.value=name;evDate.value=dateStr;evTime.value=timeStr||'00:00';
  cdTitle.textContent='Menuju: '+name;
  if(timer)clearInterval(timer);
  tick();timer=setInterval(tick,1000);
}

function tick(){
  if(!target){cdDays.textContent='0';cdHours.textContent='0';cdMins.textContent='0';cdSecs.textContent='0';cdStatus.textContent='';return}
  var now=new Date(),diff=target-now;
  if(diff<=0){
    cdDays.textContent='0';cdHours.textContent='0';cdMins.textContent='0';cdSecs.textContent='0';
    cdStatus.innerHTML='<span class="text-success font-bold">? '+evName.value+' sudah tiba!</span>';
    if(timer)clearInterval(timer);
    return;
  }
  var d=Math.floor(diff/86400000),h=Math.floor((diff%86400000)/3600000),m=Math.floor((diff%3600000)/60000),s=Math.floor((diff%60000)/1000);
  cdDays.textContent=d;cdHours.textContent=String(h).padStart(2,'0');cdMins.textContent=String(m).padStart(2,'0');cdSecs.textContent=String(s).padStart(2,'0');
  cdStatus.innerHTML='<span class="opacity-60">'+evName.value+': '+target.toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'})+'</span>';
}

btnSet.addEventListener('click',function(){
  var d=evDate.value,t=evTime.value,n=evName.value.trim()||'Acara';
  if(!d){alert('Pilih tanggal!');return}
  setCountdown(n,d,t);
});

preset.addEventListener('change',function(){
  var now=new Date(),y=now.getFullYear(),m=String(now.getMonth()+1).padStart(2,'0'),d=String(now.getDate()).padStart(2,'0');
  if(this.value==='nye'){var ny=new Date(y+1,0,1);setCountdown('Tahun Baru '+(y+1),ny.toISOString().split('T')[0],'00:00')}
  else if(this.value==='ultah'){var b=new Date(y+1,now.getMonth(),now.getDate());setCountdown('Ulang Tahun',b.toISOString().split('T')[0],'00:00')}
  else if(this.value==='libur'){var l=new Date(now);l.setMonth(l.getMonth()+1);setCountdown('Liburan '+l.toLocaleDateString('id-ID',{month:'long'}),l.toISOString().split('T')[0],'00:00')}
  else if(this.value==='week'){var w=new Date(now);w.setDate(w.getDate()+7);setCountdown('+1 Minggu',w.toISOString().split('T')[0],'00:00')}
  this.value='';
});

// Set default: New Year 2027
var nyDate=new Date(2027,0,1);
setCountdown('Tahun Baru 2027',nyDate.toISOString().split('T')[0],'00:00');
</script>

