---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'MAC Address Generator';
const description = 'MAC address generator online. Generate alamat MAC acak dengan format colon, dash, atau dot. Batch generate, vendor prefix, dan OUI lookup.';
const keywords = 'MAC address generator, generate MAC, random MAC, MAC vendor lookup, OUI, alamat MAC';
const aboutText = 'MAC address generator online untuk menghasilkan alamat MAC acak dengan berbagai format dan opsi. Mendukung format colon (AA:BB:CC:DD:EE:FF), dash (AA-BB-CC-DD-EE-FF), dot (AABB.CCDD.EEFF), batch generate hingga 50 MAC, vendor prefix dari berbagai vendor (Apple, Intel, Cisco, VMware, Samsung, Dell, HP, Microsoft, Lenovo, dan lainnya), serta opsi unicast/multicast dan locally administered.';
const aboutExtra = 'MAC (Media Access Control) address adalah identifikasi unik 48-bit yang ditetapkan oleh pabrikan untuk setiap perangkat jaringan. Struktur MAC terdiri dari 6 oktet (12 digit heksadesimal): 3 oktet pertama adalah OUI (Organizationally Unique Identifier) yang mengidentifikasi vendor pabrik, dan 3 oktet terakhir adalah nomor seri unik perangkat. Bit 0 oktet pertama menentukan unicast (0) atau multicast (1), bit 1 menentukan globally unique (0) atau locally administered (1). Generator ini berguna untuk pengujian jaringan, simulasi, konfigurasi virtual machine, dan development. Semua pemrosesan dilakukan 100% di browser, data tidak dikirim ke server mana pun.';
const relatedTools = [
  { slug: 'uuid-generator', name: 'UUID Generator', icon: '🆔' },
  { slug: 'subnetting', name: 'Subnetting', icon: '📐' },
  { slug: 'ip-calculator', name: 'IP Calculator', icon: '🔌' },
  { slug: 'cron-builder', name: 'Cron Builder', icon: '⏰' }
];

const toolCss = `
    .mac-cell { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9rem; }
  `;
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #3b82f6;">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
          <div>
            <label for="macCount" class="text-xs font-medium opacity-60 mb-1 block">Jumlah</label>
            <input type="number" id="macCount" class="input input-bordered w-full input-sm" value="5" min="1" max="50">
          </div>
          <div>
            <label for="macFormat" class="text-xs font-medium opacity-60 mb-1 block">Format</label>
            <select id="macFormat" class="select select-bordered w-full select-sm">
              <option value="colon">AA:BB:CC:DD:EE:FF</option>
              <option value="dash">AA-BB-CC-DD-EE-FF</option>
              <option value="dot">AABB.CCDD.EEFF</option>
            </select>
          </div>
          <div>
            <label for="macVendor" class="text-xs font-medium opacity-60 mb-1 block">Vendor Prefix</label>
            <select id="macVendor" class="select select-bordered w-full select-sm">
              <option value="">Random</option>
              <option value="001A2A">Apple Inc.</option>
              <option value="3C22FB">Apple Inc.</option>
              <option value="A483E7">Apple Inc.</option>
              <option value="001B21">Intel Corp.</option>
              <option value="3C970E">Intel Corp.</option>
              <option value="6805CA">Intel Corp.</option>
              <option value="001AA1">Cisco Systems</option>
              <option value="00260B">Cisco Systems</option>
              <option value="005056">VMware</option>
              <option value="001599">Samsung Elec.</option>
              <option value="34C3AC">Samsung Elec.</option>
              <option value="00188B">Dell Inc.</option>
              <option value="3417EB">Dell Inc.</option>
              <option value="B083FE">Dell Inc.</option>
              <option value="0050B6">Dell Inc.</option>
              <option value="001B63">Hewlett-Packard</option>
              <option value="3C5282">Hewlett-Packard</option>
              <option value="00155D">Microsoft Corp.</option>
              <option value="3C0771">Lenovo</option>
              <option value="9C5C8E">Lenovo</option>
              <option value="00163E">Xerox Corp.</option>
              <option value="08002B">DEC/Intel</option>
              <option value="002590">Nokia</option>
              <option value="08EA40">Huawei Tech.</option>
              <option value="346F24">Huawei Tech.</option>
              <option value="A4E731">TP-Link Tech.</option>
              <option value="14CF92">TP-Link Tech.</option>
              <option value="049226">Netgear Inc.</option>
              <option value="002248">Sony Corp.</option>
              <option value="00254B">ZTE Corp.</option>
              <option value="9C28BF">Ubiquiti Inc.</option>
              <option value="00D068">Ubiquiti Inc.</option>
            </select>
          </div>
        </div>
        <div class="flex items-center gap-4 mb-3 flex-wrap">
          <label class="flex items-center gap-2 text-xs">
            <input type="radio" name="multicast" id="macUnicast" value="unicast" checked>
            Unicast
          </label>
          <label class="flex items-center gap-2 text-xs">
            <input type="radio" name="multicast" id="macMulticast" value="multicast">
            Multicast
          </label>
          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" id="macLocal" class="checkbox checkbox-sm">
            Locally Administered
          </label>
        </div>
        <button id="btnGenerate" class="btn btn-primary btn-sm w-full">Generate MAC Address</button>
        <div id="macOutput" class="mt-3">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-medium opacity-60">Hasil:</span>
            <button id="btnCopyAll" class="btn btn-ghost btn-sm">Copy Semua</button>
          </div>
          <table class="table table-sm mb-0"><tbody id="macTableBody"></tbody></table>
        </div>
      </div>
      <div>
        <div class="mb-3">
          <h6 class="text-xs font-medium opacity-60 mb-2">Quick Presets</h6>
          <div class="flex gap-2 flex-wrap">
            <button class="btn btn-ghost btn-sm preset" data-count="3" data-fmt="colon">3 MAC</button>
            <button class="btn btn-ghost btn-sm preset" data-count="10" data-fmt="dash">10 MAC Dash</button>
            <button class="btn btn-ghost btn-sm preset" data-count="5" data-fmt="dot">5 MAC Dot</button>
            <button class="btn btn-ghost btn-sm preset" data-count="5" data-local="1">Local Admin</button>
            <button class="btn btn-ghost btn-sm preset" data-count="3" data-vendor="001A2A">Apple MACs</button>
          </div>
        </div>
        <div>
          <h6 class="text-xs font-medium opacity-60 mb-2">Informasi MAC Address</h6>
          <div class="text-xs" style="line-height:1.7">
            <p class="mb-1"><strong>Struktur:</strong> MAC 48-bit terdiri dari 6 octet (12 digit hex).</p>
            <p class="mb-1"><strong>OUI:</strong> 3 octet pertama adalah <em>Organizationally Unique Identifier</em> — kode vendor pabrik.</p>
            <p class="mb-1"><strong>Bit 0 (unicast/multicast):</strong> Bit terendah octet pertama. 0 = unicast, 1 = multicast.</p>
            <p class="mb-0"><strong>Bit 1 (global/local):</strong> Bit kedua octet pertama. 0 = globally unique (pabrik), 1 = locally administered.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<style is:inline>
{toolCss}
</style>

<script is:inline>
var cntInp=document.getElementById('macCount'),fmtInp=document.getElementById('macFormat'),venInp=document.getElementById('macVendor');
var chkLocal=document.getElementById('macLocal'),tblBody=document.getElementById('macTableBody');

function randomByte(){return Math.floor(Math.random()*256);}

function formatMAC(bytes,fmt){
  var parts=[];
  for(var i=0;i<6;i++)parts.push(bytes[i].toString(16).toUpperCase().padStart(2,'0'));
  if(fmt==='dash')return parts.join('-');
  if(fmt==='dot')return parts.slice(0,3).join('')+'.'+parts.slice(3,6).join('');
  return parts.join(':');
}

function generateMAC(){
  var bytes=[];
  var ven=venInp.value;
  if(ven){
    for(var i=0;i<3;i++)bytes.push(parseInt(ven.substr(i*2,2),16));
    for(var i=3;i<6;i++)bytes.push(randomByte());
  }else{
    for(var i=0;i<6;i++)bytes.push(randomByte());
  }
  var unicast=document.querySelector('input[name="multicast"]:checked').value==='unicast';
  if(unicast)bytes[0]=bytes[0]&0xFE;
  else bytes[0]=bytes[0]|0x01;
  if(chkLocal.checked)bytes[0]=bytes[0]|0x02;
  else bytes[0]=bytes[0]&0xFD;
  return bytes;
}

function generate(){
  var cnt=parseInt(cntInp.value)||5;if(cnt<1)cnt=1;if(cnt>50)cnt=50;
  var fmt=fmtInp.value;
  var rows='';
  for(var i=0;i<cnt;i++){
    var mac=formatMAC(generateMAC(),fmt);
    rows+='<tr><td class="mac-cell">'+(i+1)+'</td><td class="mac-cell font-semibold">'+mac+'</td><td class="text-right"><button class="btn btn-ghost btn-sm copy-single" data-mac="'+mac+'">Copy</button></td></tr>';
  }
  tblBody.innerHTML=rows;
}

document.getElementById('btnGenerate').addEventListener('click',generate);

document.getElementById('btnCopyAll').addEventListener('click',function(){
  var lines=[];tblBody.querySelectorAll('.mac-cell.font-semibold').forEach(function(el){lines.push(el.textContent);});
  navigator.clipboard.writeText(lines.join('\n')).then(function(){showToast(lines.length+' MAC copied');}).catch(function(){});
});

document.addEventListener('click',function(e){
  if(e.target.classList.contains('copy-single')){
    navigator.clipboard.writeText(e.target.dataset.mac).then(function(){showToast('MAC copied: '+e.target.dataset.mac);}).catch(function(){});
  }
});

document.querySelectorAll('.preset').forEach(function(el){el.addEventListener('click',function(){
  if(this.dataset.count)cntInp.value=this.dataset.count;
  if(this.dataset.fmt)fmtInp.value=this.dataset.fmt;
  if(this.dataset.vendor)venInp.value=this.dataset.vendor;
  if(this.dataset.local==='1')chkLocal.checked=true;else chkLocal.checked=false;
  generate();
})});

function showToast(m){
  var t=document.createElement('div');t.className='toast items-center text-bg-light border p-2';
  t.style.position='fixed';t.style.right='20px';t.style.bottom='20px';t.style.zIndex=9999;
  t.innerHTML='<div class="flex"><div class="toast-body">'+m+'</div><button type="button" class="btn-close btn-close-white mr-2 m-auto" aria-label="Close"></button></div>';
  document.body.appendChild(t);
  t.querySelector('.btn-close').addEventListener('click',function(){t.remove();});
  setTimeout(function(){t.remove();},2500);
}

generate();
</script>