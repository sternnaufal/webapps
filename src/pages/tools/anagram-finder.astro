---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Anagram Finder';
const description = 'Cek anagram online. Periksa apakah dua kata atau kalimat adalah anagram.';
const keywords = 'anagram checker, anagram finder, cek anagram, word game, anagram';
const aboutText = 'Anagram Finder Cek anagram online. Periksa apakah dua kata atau kalimat adalah anagram.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'palindrome-checker', name: 'Palindrome Checker', icon: '↔' },
  { slug: 'word-frequency', name: 'Word Frequency', icon: '📊' },
  { slug: 'textcase', name: 'Textcase', icon: 'Aa' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0fdf4;color:#16a34a;">Aa</div><div><h1 class="h3 mb-0">Anagram Finder</h1><p class="opacity-60 small mb-0">Periksa apakah dua kata/kalimat adalah anagram. Anagram adalah kata yang memiliki huruf yang sama jika disusun ulang.</p></div></header>
<div class="flex flex-wrap gap-4"><div class="col-lg-6">
<div class="card card-bordered bg-base-100 p-3">
<div class="mb-3"><label class="label-text font-semibold">Teks 1</label><textarea id="text1" class="input input-bordered w-full font-mono" rows="2" placeholder="Masukkan teks pertama..." autofocus>listen</textarea></div>
<div class="mb-3"><label class="label-text font-semibold">Teks 2</label><textarea id="text2" class="input input-bordered w-full font-mono" rows="2" placeholder="Masukkan teks kedua...">silent</textarea></div>
<button id="btnCheck" class="btn btn-primary w-full">Cek Anagram</button>
<div id="resultArea" class="mt-3 p-4 rounded text-center" style="display:none"><div class="display-3 mb-2" id="resultIcon">?</div><div class="h4 font-bold" id="resultText"></div><div id="resultDetail" class="text-sm opacity-60"></div></div>
</div></div>
<div class="col-lg-6">
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Contoh Anagram</h6>
<div class="small" style="line-height:2.2">
<div style="cursor:pointer" class="example" data-a="listen" data-b="silent">listen ? silent</div>
<div style="cursor:pointer" class="example" data-a="earth" data-b="heart">earth ? heart</div>
<div style="cursor:pointer" class="example" data-a="tar" data-b="rat">tar ? rat</div>
<div style="cursor:pointer" class="example" data-a="dusty" data-b="study">dusty ? study</div>
<div style="cursor:pointer" class="example" data-a="elvis" data-b="lives">elvis ? lives</div>
<div style="cursor:pointer" class="example" data-a="tea" data-b="eat">tea ? eat</div>
</div></div>
<div class="card card-bordered bg-base-100 p-3 mt-3"><h6 class="mb-3">Huruf Sama</h6>
<div id="letterCompare" class="small"></div></div>
</div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var t1=document.getElementById('text1'),t2=document.getElementById('text2'),res=document.getElementById('resultArea'),icon=document.getElementById('resultIcon'),txt=document.getElementById('resultText'),det=document.getElementById('resultDetail'),lc=document.getElementById('letterCompare');
function check(){
  var a=t1.value.trim().toLowerCase().replace(/[^a-z]/g,''),b=t2.value.trim().toLowerCase().replace(/[^a-z]/g,'');
  if(!a||!b){res.style.display='none';lc.innerHTML='';return}
  var sortA=a.split('').sort().join(''),sortB=b.split('').sort().join('');
  var isAna=sortA===sortB;
  res.style.display='block';
  icon.textContent=isAna?'?':'?';icon.style.color=isAna?'#22c55e':'#ef4444';
  txt.textContent=isAna?'Anagram!':'Bukan Anagram';
  txt.style.color=isAna?'#22c55e':'#ef4444';
  det.innerHTML='<span>Teks 1: "'+a+'"<br>Teks 2: "'+b+'"</span>';
  var sortedA=a.split('').sort().join(', '),sortedB=b.split('').sort().join(', ');
  lc.innerHTML='<div class="font-bold mb-1">Perbandingan huruf:</div><table class="table table-sm small mb-0"><tr><td>'+t1.value.trim()+'</td><td class="font-mono">['+sortedA+']</td></tr><tr><td>'+t2.value.trim()+'</td><td class="font-mono">['+sortedB+']</td></tr></table>';
}
document.getElementById('btnCheck').addEventListener('click',check);
t1.addEventListener('input',check);t2.addEventListener('input',check);
document.querySelectorAll('.example').forEach(function(el){
  el.addEventListener('click',function(){t1.value=this.dataset.a;t2.value=this.dataset.b;check()});
});
check();
</script>

