---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Anagram Finder';
const description = 'Cek anagram online. Periksa apakah dua kata atau kalimat adalah anagram.';
const keywords = 'anagram checker, anagram finder, cek anagram, word game, anagram';
const aboutText = 'adalah alat untuk memeriksa apakah dua kata atau kalimat merupakan anagram — yaitu kata yang memiliki huruf-huruf yang sama jika disusun ulang.';
const aboutExtra = 'Anagram adalah fenomena linguistik di mana dua kata atau frasa terdiri dari huruf yang persis sama namun dalam urutan berbeda. Contoh populer: "listen" dan "silent", "earth" dan "heart". Anagram Finder ini membantu Anda mengecek anagram dengan cepat, dilengkapi perbandingan huruf terurut dan contoh-contoh anagram. Berguna untuk word games, teka-teki, pembelajaran bahasa, dan konten kreatif.';
const relatedTools = [
  { slug: 'palindrome-checker', name: 'Palindrome Checker', icon: '↔' },
  { slug: 'word-frequency', name: 'Word Frequency Counter', icon: '📊' },
  { slug: 'textcase', name: 'Text Case Converter', icon: 'Aa' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Teks 1</label>
        <textarea id="text1" class="textarea textarea-bordered w-full text-sm font-mono" rows="2" placeholder="Masukkan teks pertama..." autofocus>listen</textarea>
      </div>
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Teks 2</label>
        <textarea id="text2" class="textarea textarea-bordered w-full text-sm font-mono" rows="2" placeholder="Masukkan teks kedua...">silent</textarea>
      </div>
      <button id="btnCheck" class="btn btn-primary btn-sm w-full">Cek Anagram</button>
      <div id="resultArea" class="mt-3 rounded-xl p-4 text-center" style="display:none;background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
        <div class="text-2xl mb-1" id="resultIcon">?</div>
        <div class="text-sm font-bold" id="resultText"></div>
        <div id="resultDetail" class="text-xs opacity-60"></div>
      </div>
    </div>
    <div>
      <div class="rounded-xl p-4 mb-3" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
        <div class="text-xs font-medium opacity-60 mb-2">Contoh Anagram</div>
        <div class="text-xs leading-relaxed">
          <div style="cursor:pointer" class="example hover:opacity-60" data-a="listen" data-b="silent">listen ↔ silent</div>
          <div style="cursor:pointer" class="example hover:opacity-60" data-a="earth" data-b="heart">earth ↔ heart</div>
          <div style="cursor:pointer" class="example hover:opacity-60" data-a="tar" data-b="rat">tar ↔ rat</div>
          <div style="cursor:pointer" class="example hover:opacity-60" data-a="dusty" data-b="study">dusty ↔ study</div>
          <div style="cursor:pointer" class="example hover:opacity-60" data-a="elvis" data-b="lives">elvis ↔ lives</div>
          <div style="cursor:pointer" class="example hover:opacity-60" data-a="tea" data-b="eat">tea ↔ eat</div>
        </div>
      </div>
      <div class="rounded-xl p-4" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
        <div class="text-xs font-medium opacity-60 mb-2">Huruf Sama</div>
        <div id="letterCompare" class="text-xs"></div>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var t1=document.getElementById('text1'),t2=document.getElementById('text2'),res=document.getElementById('resultArea'),icon=document.getElementById('resultIcon'),txt=document.getElementById('resultText'),det=document.getElementById('resultDetail'),lc=document.getElementById('letterCompare');
function check(){
  var a=t1.value.trim().toLowerCase().replace(/[^a-z]/g,''),b=t2.value.trim().toLowerCase().replace(/[^a-z]/g,'');
  if(!a||!b){res.style.display='none';lc.innerHTML='';return}
  var sortA=a.split('').sort().join(''),sortB=b.split('').sort().join('');
  var isAna=sortA===sortB;
  res.style.display='block';
  icon.textContent=isAna?'✓':'✗';icon.style.color=isAna?'#22c55e':'#ef4444';
  txt.textContent=isAna?'Anagram!':'Bukan Anagram';
  txt.style.color=isAna?'#22c55e':'#ef4444';
  det.innerHTML='<span>Teks 1: "'+a+'"<br>Teks 2: "'+b+'"</span>';
  var sortedA=a.split('').sort().join(', '),sortedB=b.split('').sort().join(', ');
  lc.innerHTML='<div class="font-bold mb-1">Perbandingan huruf:</div><div class="text-xs"><div>'+t1.value.trim()+': ['+sortedA+']</div><div>'+t2.value.trim()+': ['+sortedB+']</div></div>';
}
document.getElementById('btnCheck').addEventListener('click',check);
t1.addEventListener('input',check);t2.addEventListener('input',check);
document.querySelectorAll('.example').forEach(function(el){
  el.addEventListener('click',function(){t1.value=this.dataset.a;t2.value=this.dataset.b;check()});
});
check();
</script>