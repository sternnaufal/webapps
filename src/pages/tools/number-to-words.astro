---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Number to Words';
const description = 'Konversi angka ke huruf (terbilang) Bahasa Indonesia. Ubah angka menjadi teks terbilang untuk kwitansi, cek, dokumen resmi.';
const keywords = 'number to words, angka ke huruf, terbilang, konversi angka, angka ke kata, spell number';
const aboutText = 'Number to Words Konversi angka ke huruf (terbilang) Bahasa Indonesia. Ubah angka menjadi teks terbilang untuk kwitansi, cek, dokumen resmi.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'konverter-bilangan', name: 'Konverter Bilangan', icon: '2' },
  { slug: 'roman-numeral', name: 'Roman Numeral', icon: 'IV' },
  { slug: 'word-counter', name: 'Word Counter', icon: '⚡' },
  { slug: 'char-counter', name: 'Char Counter', icon: '#' }
];

const toolCss = `.word-result{font-size:1.15rem;font-weight:600;line-height:1.7;padding:1rem;border-radius:8px;background:oklch(0.95 0.003 270)}`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-8/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Masukkan Angka</label>
        <div class="flex gap-2">
          <input type="text" id="numInput" class="input input-bordered w-full input-sm" value="1234567" placeholder="Masukkan angka...">
          <button id="btnCopy" class="btn btn-ghost btn-sm">Copy</button>
        </div>
      </div>
      <div class="word-result text-sm" id="resultArea">
        <span id="wordResult">satu juta dua ratus tiga puluh empat ribu lima ratus enam puluh tujuh</span>
      </div>
      <div class="mt-2 text-xs opacity-60" id="numInfo"></div>
    </div>
  </div>
  <div class="lg:w-4/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Contoh Angka</div>
      <div class="flex flex-wrap gap-1">
        <button class="btn btn-ghost btn-xs sampel" data-n="2024">2024</button>
        <button class="btn btn-ghost btn-xs sampel" data-n="50000">50.000</button>
        <button class="btn btn-ghost btn-xs sampel" data-n="1000000">1.000.000</button>
        <button class="btn btn-ghost btn-xs sampel" data-n="999999999">999.999.999</button>
        <button class="btn btn-ghost btn-xs sampel" data-n="7500">7.500</button>
        <button class="btn btn-ghost btn-xs sampel" data-n="1000000000">1 M</button>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>

<script is:inline>
var inp=document.getElementById('numInput'),res=document.getElementById('wordResult'),inf=document.getElementById('numInfo');
var sat=['','satu','dua','tiga','empat','lima','enam','tujuh','delapan','sembilan'];
var belas=['sepuluh','sebelas','dua belas','tiga belas','empat belas','lima belas','enam belas','tujuh belas','delapan belas','sembilan belas'];
var puluh=['','','dua puluh','tiga puluh','empat puluh','lima puluh','enam puluh','tujuh puluh','delapan puluh','sembilan puluh'];
var ribuan=['','ribu','juta','milyar','trilyun'];
function terbilang(n){
  if(n===0)return'nol';var r='',i=0;
  while(n>0){var g=n%1000;if(g>0){var s='';
    if(g>=100){var h=Math.floor(g/100);s+=(h===1?'seratus':sat[h]+' ratus')+' ';g%=100}
    if(g>=20){s+=puluh[Math.floor(g/10)]+' ';g%=10}
    if(g>=1){if(g<10)s+=sat[g]+' ';else s+=belas[g-10]+' '}
    if(i===1&&Math.floor(n/1000)%1000===1&&n<2000)s='seribu ';else r=s+ribuan[i]+' '+r
  }n=Math.floor(n/1000);i++}
  return r.trim();
}
function convert(){
  var raw=inp.value.replace(/[^0-9,.]/g,'').replace(',','.');if(!raw){res.textContent='';return}
  var parts=raw.split('.');var intp=parseInt(parts[0])||0;var txt=terbilang(intp);
  if(parts[1]&&parts[1].length>0){txt+=' koma '+parts[1].split('').map(function(d){return sat[parseInt(d)]||'?'}).join(' ')}
  res.textContent=txt||'nol';
  inf.textContent='Angka: '+parts[0]+(parts[1]?'.'+parts[1]:'')+' | '+intp.toLocaleString('id-ID')+(parts[1]?','+parts[1]:'')+' digit';
}
document.getElementById('btnCopy').addEventListener('click',function(){navigator.clipboard.writeText(res.textContent).catch(function(){})});
inp.addEventListener('input',convert);
document.querySelectorAll('.sampel').forEach(function(el){el.addEventListener('click',function(){inp.value=this.dataset.n;convert()})});
convert();
</script>