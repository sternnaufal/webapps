---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Stopwatch';
const description = 'Stopwatch online dengan fitur lap times. Hitung waktu dengan akurat, catat split time, dan export hasil.';
const keywords = 'stopwatch, online stopwatch, timer, lap timer, count up, pengukur waktu';
const aboutText = 'Stopwatch online dengan fitur lap times. Hitung waktu dengan akurat, catat split time, dan export hasil.';
const relatedTools = [
  { slug: 'timer', name: 'Timer', icon: '⏱' },
  { slug: 'countdown', name: 'Countdown', icon: '⏳' },
  { slug: 'pomodoro', name: 'Pomodoro', icon: '🍅' },
  { slug: 'sleep-cycle', name: 'Sleep Cycle', icon: '😴' }
];

const toolCss = `.sw-time{font-size:3.5rem;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.2;letter-spacing:2px}@media(max-width:576px){.sw-time{font-size:2.5rem}}`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5 mb-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-center">
        <div class="sw-time" id="display">00:00:00.00</div>
        <div class="flex gap-2 justify-center mt-4">
          <button id="btnStart" class="btn btn-primary btn-sm">Mulai</button>
          <button id="btnLap" class="btn btn-ghost btn-sm" disabled>Lap</button>
          <button id="btnStop" class="btn btn-ghost btn-sm" disabled>Stop</button>
          <button id="btnReset" class="btn btn-ghost btn-sm">Reset</button>
        </div>
      </div>
    </div>
    <div class="rounded-xl p-4" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="flex justify-between items-center mb-2">
        <span class="text-xs font-medium opacity-60">Lap Times</span>
        <button id="btnCopyLaps" class="btn btn-ghost btn-xs">Copy</button>
      </div>
      <div id="lapList" style="max-height:250px;overflow-y:auto"><span class="text-xs opacity-60">Belum ada lap</span></div>
    </div>
  </div>
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-4" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Ringkasan</div>
      <div class="text-sm space-y-2">
        <div class="flex justify-between"><span class="opacity-60">Total Waktu</span><span class="font-bold" id="totalTimeDisplay">00:00:00.00</span></div>
        <div class="flex justify-between"><span class="opacity-60">Jumlah Lap</span><span class="font-bold" id="lapCountDisplay">0</span></div>
        <div class="flex justify-between"><span class="opacity-60">Lap Tercepat</span><span class="font-bold text-green-600" id="fastLap">-</span></div>
        <div class="flex justify-between"><span class="opacity-60">Lap Terlambat</span><span class="font-bold text-red-600" id="slowLap">-</span></div>
        <div class="flex justify-between"><span class="opacity-60">Rata-rata Lap</span><span class="font-bold" id="avgLap">-</span></div>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>

<script is:inline>
var d=document.getElementById('display'),bS=document.getElementById('btnStart'),bL=document.getElementById('btnLap'),bSt=document.getElementById('btnStop'),bR=document.getElementById('btnReset'),lL=document.getElementById('lapList'),tTD=document.getElementById('totalTimeDisplay'),lCD=document.getElementById('lapCountDisplay'),fL=document.getElementById('fastLap'),sL=document.getElementById('slowLap'),aL=document.getElementById('avgLap'),lH=[];var st=0,run=0,intv=null;function fmt(t){var h=Math.floor(t/3600000),m=Math.floor((t%3600000)/60000),s=Math.floor((t%60000)/1000),cs=Math.floor(t%1000/10);return(h+'').padStart(2,'0')+':'+(m+'').padStart(2,'0')+':'+(s+'').padStart(2,'0')+'.'+(cs+'').padStart(2,'0')}function upd(){var n=Date.now()-st+run;d.textContent=fmt(n);tTD.textContent=fmt(n)}function start(){if(intv)return;st=Date.now();intv=setInterval(upd,30);bS.disabled=true;bL.disabled=false;bSt.disabled=false}function stop(){clearInterval(intv);intv=null;run+=Date.now()-st;bS.disabled=false;bL.disabled=true;bSt.disabled=true}function reset(){clearInterval(intv);intv=null;st=0;run=0;d.textContent='00:00:00.00';tTD.textContent='00:00:00.00';lH=[];lL.innerHTML='<span class="text-xs opacity-60">Belum ada lap</span>';lCD.textContent='0';fL.textContent='-';sL.textContent='-';aL.textContent='-';bS.disabled=false;bL.disabled=true;bSt.disabled=true}function lap(){if(!intv)return;var n=Date.now()-st+run;lH.push(n);lL.innerHTML=lH.map(function(t,i){return'<div class="flex justify-between text-xs py-1 border-b"><span>Lap '+(i+1)+'</span><span class="font-bold">'+fmt(t)+'</span></div>'}).join('');lCD.textContent=lH.length;var mn=Math.min.apply(null,lH),mx=Math.max.apply(null,lH),av=lH.reduce(function(a,b){return a+b},0)/lH.length;fL.textContent=fmt(mn);sL.textContent=fmt(mx);aL.textContent=fmt(av)}document.getElementById('btnCopyLaps').addEventListener('click',function(){var t=lH.map(function(t,i){return'Lap '+(i+1)+': '+fmt(t)}).join('\n');navigator.clipboard.writeText(t).catch(function(){})});bS.addEventListener('click',start);bL.addEventListener('click',lap);bSt.addEventListener('click',stop);bR.addEventListener('click',reset);
</script>