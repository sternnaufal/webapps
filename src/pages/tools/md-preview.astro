---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Markdown Previewer';
const description = 'Preview markdown secara real-time online. Editor markdown dengan live preview dan HTML output.';
const keywords = 'markdown previewer, markdown editor, md to html, markdown online';
const aboutText = 'Markdown Previewer adalah editor markdown dengan live preview real-time. Tulis markdown di panel kiri dan lihat hasil HTML yang sudah dirender di panel kanan secara instan. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const aboutExtra = 'Markdown adalah bahasa markup ringan yang banyak digunakan untuk dokumentasi, README GitHub, forum diskusi, catatan, dan blogging. Markdown Previewer ini mendukung sintaks markdown lengkap termasuk heading, bold, italic, list, link, code blocks dengan syntax highlighting, tabel, dan blockquote. Sangat berguna bagi developer, penulis teknis, dan siapapun yang bekerja dengan markdown untuk melihat hasil rendering secara instan.';
const relatedTools = [
  { slug: 'html-preview', name: 'HTML Preview', icon: '</>' },
  { slug: 'markdown-to-html', name: 'Markdown to HTML', icon: '▶' },
  { slug: 'lorem-ipsum', name: 'Lorem Ipsum Generator', icon: '¶' },
  { slug: 'textcase', name: 'Text Case Converter', icon: 'Aa' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Markdown Input</label>
      <textarea id="editor" class="textarea textarea-bordered w-full text-sm font-mono" rows="12" placeholder="# Judul&#10;Teks **bold** dan *italic*&#10;- List item 1&#10;- List item 2"></textarea>
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs font-medium opacity-60">Live Preview</span>
        <button id="copyBtn" class="btn btn-ghost btn-sm">Copy HTML</button>
      </div>
      <div id="preview" class="text-sm"></div>
    </div>
  </div>

  <div class="mt-5">
    <div class="text-xs font-medium opacity-60 mb-2">Markdown Cheat Sheet</div>
    <div class="overflow-x-auto text-xs">
      <table class="table table-sm w-full">
        <thead>
          <tr class="opacity-60"><th class="font-normal">Simbol</th><th class="font-normal">Fungsi</th><th class="font-normal">Contoh</th></tr>
        </thead>
        <tbody>
          <tr><td><code class="font-mono">#</code></td><td>Heading 1</td><td><code class="font-mono"># Judul</code></td></tr>
          <tr><td><code class="font-mono">##</code></td><td>Heading 2</td><td><code class="font-mono">## Subjudul</code></td></tr>
          <tr><td><code class="font-mono">**teks**</code></td><td>Bold</td><td><code class="font-mono">**teks tebal**</code></td></tr>
          <tr><td><code class="font-mono">*teks*</code></td><td>Italic</td><td><code class="font-mono">*teks miring*</code></td></tr>
          <tr><td><code class="font-mono">- item</code></td><td>List</td><td><code class="font-mono">- satu<br>- dua</code></td></tr>
          <tr><td><code class="font-mono">[teks](url)</code></td><td>Link</td><td><code class="font-mono">[Google](https://google.com)</code></td></tr>
          <tr><td><code class="font-mono">`kode`</code></td><td>Inline Code</td><td><code class="font-mono">`console.log("Hi")`</code></td></tr>
          <tr><td><code class="font-mono">```</code></td><td>Code Block</td><td><code class="font-mono">```js<br>console.log("Hi")<br>```</code></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
marked.setOptions({
  breaks: true,
  gfm: true,
  highlight: function(code, lang) {
    return hljs.highlightAuto(code, [lang]).value;
  }
});

var editor = document.getElementById('editor');
var preview = document.getElementById('preview');
var copyBtn = document.getElementById('copyBtn');

function updatePreview() {
  preview.innerHTML = marked.parse(editor.value);
}

editor.addEventListener('input', updatePreview);

copyBtn.addEventListener('click', function() {
  navigator.clipboard.writeText(preview.innerHTML)
    .then(function() {
      copyBtn.textContent = 'Copied!';
      setTimeout(function() { copyBtn.textContent = 'Copy HTML'; }, 1500);
    });
});

editor.value = '# Selamat Datang\n\nIni **Markdown Previewer**!\n\n- Tulisan *italic*\n- Tulisan **bold**\n- Link: [Web Naufal Rakha](https://naufalrakha.my.id)\n\n```js\nconsole.log(\'Hello World\');\n```';
updatePreview();
</script>