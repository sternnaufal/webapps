---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'YAML to JSON Converter';
const description = 'Konversi YAML ke JSON dan JSON ke YAML online. Format data dengan cepat dan akurat.';
const keywords = 'yaml to json, json to yaml, yaml converter, yaml formatter';
const aboutText = 'YAML to JSON converter online untuk mengkonversi data antara format YAML dan JSON secara instan. Alat ini mendukung konversi dua arah: YAML ke JSON dan JSON ke YAML. Sangat berguna bagi developer dan DevOps engineer yang bekerja dengan konfigurasi dalam berbagai format.';
const aboutExtra = 'Cukup paste data YAML atau JSON pada kolom input, lalu pilih arah konversi. Hasil akan langsung ditampilkan di kolom output dan dapat disalin ke clipboard. Alat ini menggunakan library js-yaml untuk parsing YAML dan native JSON API browser. Semua pemrosesan dilakukan 100% di browser, data tidak dikirim ke server mana pun.';
const relatedTools = [
  { slug: 'json-formatter', name: 'JSON Formatter', icon: '{}' },
  { slug: 'json-csv', name: 'JSON to CSV', icon: '⇄' },
  { slug: 'sql-formatter', name: 'SQL Formatter', icon: 'SQL' },
  { slug: 'html-entity', name: 'HTML Entity Encoder', icon: '&' }
];

---

<ToolLayout title={title} description={description} keywords={keywords}>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
    <div>
      <label for="inputArea" class="text-xs font-medium opacity-60 mb-1 block">Input</label>
      <textarea id="inputArea" class="textarea textarea-bordered w-full text-sm font-mono" rows="10" placeholder="Paste YAML atau JSON..."></textarea>
      <div class="flex gap-2 mt-2">
        <button id="btnToJson" class="btn btn-primary btn-sm">YAML &rarr; JSON</button>
        <button id="btnToYaml" class="btn btn-ghost btn-sm">JSON &rarr; YAML</button>
        <button id="btnClear" class="btn btn-ghost btn-sm">Clear</button>
      </div>
    </div>
    <div>
      <div class="flex justify-between items-center mb-1">
        <label for="outputArea" class="text-xs font-medium opacity-60 mb-1 block">Output</label>
        <button id="btnCopy" class="btn btn-ghost btn-xs">Copy</button>
      </div>
      <textarea id="outputArea" class="textarea textarea-bordered w-full text-sm font-mono" rows="10" readonly></textarea>
    </div>
  </div>

</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var inp=document.getElementById('inputArea'),out=document.getElementById('outputArea');
function toJson(){try{var d=jsyaml.load(inp.value);out.value=JSON.stringify(d,null,2)}catch(e){out.value='Error: '+e.message}}
function toYaml(){try{var d=JSON.parse(inp.value);out.value=jsyaml.dump(d,{indent:2})}catch(e){out.value='Error: '+e.message}}
document.getElementById('btnToJson').addEventListener('click',toJson);
document.getElementById('btnToYaml').addEventListener('click',toYaml);
document.getElementById('btnClear').addEventListener('click',function(){inp.value='';out.value=''});
document.getElementById('btnCopy').addEventListener('click',function(){if(!out.value)return;var b=this;navigator.clipboard.writeText(out.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)})});
</script>