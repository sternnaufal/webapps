---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'YAML ? JSON Converter';
const description = 'Konversi YAML ke JSON dan JSON ke YAML online. Format data dengan cepat dan akurat.';
const keywords = 'yaml to json, json to yaml, yaml converter, yaml formatter';
const aboutText = 'YAML ? JSON Converter Konversi YAML ke JSON dan JSON ke YAML online. Format data dengan cepat dan akurat.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'json-formatter', name: 'Json Formatter', icon: '{}' },
  { slug: 'json-csv', name: 'Json Csv', icon: '⇄' },
  { slug: 'sql-formatter', name: 'Sql Formatter', icon: 'SQL' },
  { slug: 'html-entity', name: 'Html Entity', icon: '&' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#fefce8;color:#ca8a04;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></div><div><h1 class="h3 mb-0">YAML ? JSON Converter</h1><p class="opacity-60 small mb-0">Konversi YAML ke JSON atau JSON ke YAML. Paste data, pilih arah, dan konversi.</p></div></header>
<div class="flex flex-wrap gap-4 mb-4">
<div class="col-lg-6"><label class="label-text font-semibold">Input</label><textarea id="inputArea" class="input input-bordered w-full font-mono" rows="10" placeholder="Paste YAML atau JSON..."></textarea>
<div class="flex gap-2 mt-2"><button id="btnToJson" class="btn btn-primary">YAML ? JSON</button><button id="btnToYaml" class="btn btn-success">JSON ? YAML</button><button id="btnClear" class="btn btn-outline-danger">Clear</button></div></div>
<div class="col-lg-6"><div class="flex justify-between items-center mb-1"><label class="label-text font-semibold mb-0">Output</label><button id="btnCopy" class="btn btn-sm btn-outline-secondary">Copy</button></div>
<textarea id="outputArea" class="input input-bordered w-full font-mono" rows="10" readonly></textarea></div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var inp=document.getElementById('inputArea'),out=document.getElementById('outputArea');
function toJson(){try{var d=jsyaml.load(inp.value);out.value=JSON.stringify(d,null,2)}catch(e){out.value='Error: '+e.message}}
function toYaml(){try{var d=JSON.parse(inp.value);out.value=jsyaml.dump(d,{indent:2})}catch(e){out.value='Error: '+e.message}}
document.getElementById('btnToJson').addEventListener('click',toJson);
document.getElementById('btnToYaml').addEventListener('click',toYaml);
document.getElementById('btnClear').addEventListener('click',function(){inp.value='';out.value=''});
document.getElementById('btnCopy').addEventListener('click',function(){if(!out.value)return;var b=this;navigator.clipboard.writeText(out.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)})});
</script>

