---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Tip Calculator';
const description = 'Kalkulator tip online. Hitung tip, bagi bill, dan conversion mata uang.';
const keywords = 'tip calculator, bill splitter, tip, kalkulator tip, bagi tagihan';
const aboutText = 'Kalkulator tip online. Hitung tip, bagi bill, dan conversion mata uang.';
const relatedTools = [
  { slug: 'discount-calculator', name: 'Discount Calculator', icon: '🏷' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' },
  { slug: 'mortgage-calculator', name: 'Mortgage Calculator', icon: '🏠' },
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Total Tagihan</label>
        <div class="flex"><span class="input-group-text text-xs px-2 flex items-center" style="background:oklch(0.93 0.003 270);border:1px solid oklch(0.9 0.005 270);border-right:0;border-radius:6px 0 0 6px;">Rp</span><input type="number" id="billInput" class="input input-bordered w-full input-sm rounded-l-none" value="500000" step="1000"></div>
      </div>
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Persentase Tip</label>
        <div class="flex gap-2 flex-wrap mb-2" id="tipPresets">
          <button class="btn btn-ghost btn-xs" data-pct="5">5%</button>
          <button class="btn btn-ghost btn-xs" data-pct="10">10%</button>
          <button class="btn btn-primary btn-xs" data-pct="15">15%</button>
          <button class="btn btn-ghost btn-xs" data-pct="20">20%</button>
          <button class="btn btn-ghost btn-xs" data-pct="25">25%</button>
        </div>
        <input type="range" id="tipRange" class="range range-sm w-full" min="0" max="50" value="15">
        <div class="flex justify-between text-xs opacity-60"><span>0%</span><span id="tipLabel">15%</span><span>50%</span></div>
      </div>
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Jumlah Orang</label>
        <div class="flex"><button id="decPeople" class="btn btn-ghost btn-sm rounded-r-none">-</button><input type="number" id="peopleInput" class="input input-bordered w-full input-sm text-center rounded-none" value="1" min="1" max="100"><button id="incPeople" class="btn btn-ghost btn-sm rounded-l-none">+</button></div>
      </div>
    </div>
  </div>
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Ringkasan</div>
      <div class="grid grid-cols-2 gap-3 mb-3">
        <div class="p-3 rounded text-center" style="background:oklch(0.95 0.003 270);">
          <span class="text-xs opacity-60">Tip</span>
          <div class="text-lg font-bold" id="tipAmount">Rp 75.000</div>
        </div>
        <div class="p-3 rounded text-center" style="background:oklch(0.95 0.003 270);">
          <span class="text-xs opacity-60">Total + Tip</span>
          <div class="text-lg font-bold" id="totalAmount">Rp 575.000</div>
        </div>
        <div class="p-3 rounded text-center" style="background:oklch(0.95 0.003 270);">
          <span class="text-xs opacity-60">Per Orang (tip)</span>
          <div class="text-lg font-bold" id="tipPerPerson">Rp 75.000</div>
        </div>
        <div class="p-3 rounded text-center" style="background:oklch(0.55 0.25 270 / 0.1);">
          <span class="text-xs opacity-60">Total Per Orang</span>
          <div class="text-lg font-bold" id="totalPerPerson" style="color:#6366f1">Rp 575.000</div>
        </div>
      </div>
      <div id="breakdown" class="text-xs"></div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
var bill=document.getElementById('billInput'),tipRange=document.getElementById('tipRange'),tipLabel=document.getElementById('tipLabel'),people=document.getElementById('peopleInput');
function fmt(n){return 'Rp '+Math.round(n).toLocaleString('id-ID')}
function calc(){
  var b=parseFloat(bill.value)||0,p=parseInt(people.value)||1,t=parseFloat(tipRange.value);
  var tip=b*t/100,total=b+tip,tipPP=tip/p,totalPP=total/p;
  document.getElementById('tipAmount').textContent=fmt(tip);
  document.getElementById('totalAmount').textContent=fmt(total);
  document.getElementById('tipPerPerson').textContent=fmt(tipPP);
  document.getElementById('totalPerPerson').textContent=fmt(totalPP);
  document.getElementById('breakdown').innerHTML=
    '<table class="table table-sm w-full text-xs mb-0"><tr><td class="py-1 opacity-60">Tagihan</td><td class="py-1 text-right">'+fmt(b)+'</td></tr>'+
    '<tr><td class="py-1 opacity-60">Tip ('+t+'%)</td><td class="py-1 text-right">'+fmt(tip)+'</td></tr>'+
    '<tr class="font-bold"><td class="py-1">Total</td><td class="py-1 text-right">'+fmt(total)+'</td></tr>'+
    '<tr><td colspan="2"><hr class="my-1"></td></tr>'+
    '<tr><td class="py-1">Dibagi '+p+' orang</td><td class="py-1 text-right">'+fmt(totalPP)+'/orang</td></tr></table>';
}
bill.addEventListener('input',calc);
tipRange.addEventListener('input',function(){tipLabel.textContent=this.value+'%';calc();});
people.addEventListener('input',calc);
document.getElementById('decPeople').addEventListener('click',function(){people.value=Math.max(1,parseInt(people.value)-1);calc();});
document.getElementById('incPeople').addEventListener('click',function(){people.value=Math.min(100,parseInt(people.value)+1);calc();});
document.querySelectorAll('#tipPresets .btn').forEach(function(b){
  b.addEventListener('click',function(){
    document.querySelectorAll('#tipPresets .btn').forEach(function(x){x.className='btn btn-ghost btn-xs'});
    this.className='btn btn-primary btn-xs';
    tipRange.value=this.dataset.pct;tipLabel.textContent=this.dataset.pct+'%';calc();
  });
});
calc();
</script>