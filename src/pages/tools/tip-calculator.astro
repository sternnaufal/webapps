---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Tip Calculator';
const description = 'Kalkulator tip online. Hitung tip, bagi bill, dan conversion mata uang.';
const keywords = 'tip calculator, bill splitter, tip, kalkulator tip, bagi tagihan';
const aboutText = 'Tip Calculator Kalkulator tip online. Hitung tip, bagi bill, dan conversion mata uang.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'discount-calculator', name: 'Discount Calculator', icon: '🏷' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' },
  { slug: 'mortgage-calculator', name: 'Mortgage Calculator', icon: '🏠' },
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0fdf4;color:#16a34a;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div><h1 class="h3 mb-0">Tip Calculator</h1><p class="opacity-60 small mb-0">Hitung tip, bagi bill, dan lihat total per orang.</p></div></header>
<div class="flex flex-wrap gap-4">
<div class="lg:w-5/12 w-full"><div class="card card-bordered bg-base-100 p-3">
<div class="mb-3"><label class="label-text font-semibold">Total Tagihan</label><div class="input-group"><span class="input-group-text">Rp</span><input type="number" id="billInput" class="input input-bordered w-full" value="500000" step="1000"></div></div>
<div class="mb-3"><label class="label-text font-semibold">Persentase Tip</label>
<div class="flex gap-2 flex-wrap" id="tipPresets">
<button class="btn btn-outline-primary btn-sm" data-pct="5">5%</button>
<button class="btn btn-outline-primary btn-sm" data-pct="10">10%</button>
<button class="btn btn-primary btn-sm" data-pct="15">15%</button>
<button class="btn btn-outline-primary btn-sm" data-pct="20">20%</button>
<button class="btn btn-outline-primary btn-sm" data-pct="25">25%</button>
</div>
<div class="mt-2"><input type="range" id="tipRange" class="range range-sm" min="0" max="50" value="15"><div class="flex justify-between text-sm opacity-60"><span>0%</span><span id="tipLabel">15%</span><span>50%</span></div></div></div>
<div class="mb-3"><label class="label-text font-semibold">Jumlah Orang</label><div class="input-group"><button id="decPeople" class="btn btn-outline">-</button><input type="number" id="peopleInput" class="input input-bordered w-full text-center" value="1" min="1" max="100"><button id="incPeople" class="btn btn-outline">+</button></div></div>
</div></div>
<div class="lg:w-7/12 w-full"><div class="card card-bordered bg-base-100 p-3">
<h6 class="mb-3">Ringkasan</h6>
<div class="flex flex-wrap gap-3"><div class="col-6"><div class="p-3 bg-light rounded text-center"><small class="opacity-60">Tip</small><div class="h4 mb-0 font-bold" id="tipAmount">Rp 75.000</div></div></div>
<div class="col-6"><div class="p-3 bg-light rounded text-center"><small class="opacity-60">Total + Tip</small><div class="h4 mb-0 font-bold" id="totalAmount">Rp 575.000</div></div></div>
<div class="col-6"><div class="p-3 bg-light rounded text-center"><small class="opacity-60">Per Orang (tip)</small><div class="h4 mb-0 font-bold" id="tipPerPerson">Rp 75.000</div></div></div>
<div class="col-6"><div class="p-3" style="background:#eef2ff;border-radius:8px;text-align:center"><small class="opacity-60">Total Per Orang</small><div class="h4 mb-0 font-bold" id="totalPerPerson" style="color:var(--accent)">Rp 575.000</div></div></div>
</div>
<div class="mt-3 p-3 bg-light rounded small">
<div id="breakdown"></div>
</div>
</div></div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var bill=document.getElementById('billInput'),tipRange=document.getElementById('tipRange'),tipLabel=document.getElementById('tipLabel'),people=document.getElementById('peopleInput');
function fmt(n)&#123;return 'Rp '+Math.round(n).toLocaleString('id-ID')&#125;
function calc()&#123;
  var b=parseFloat(bill.value)||0,p=parseInt(people.value)||1,t=parseFloat(tipRange.value);
  var tip=b*t/100,total=b+tip,tipPP=tip/p,totalPP=total/p;
  document.getElementById('tipAmount').textContent=fmt(tip);
  document.getElementById('totalAmount').textContent=fmt(total);
  document.getElementById('tipPerPerson').textContent=fmt(tipPP);
  document.getElementById('totalPerPerson').textContent=fmt(totalPP);
  document.getElementById('breakdown').innerHTML=
    '<table class="table table-sm small mb-0"><tr><td>Tagihan</td><td class="text-right">'+fmt(b)+'</td></tr>'+
    '<tr><td>Tip ('+t+'%)</td><td class="text-right">'+fmt(tip)+'</td></tr>'+
    '<tr class="font-bold"><td>Total</td><td class="text-right">'+fmt(total)+'</td></tr>'+
    '<tr><td colspan="2"><hr class="my-1"></td></tr>'+
    '<tr><td>Dibagi '+p+' orang</td><td class="text-right">'+fmt(totalPP)+'/orang</td></tr></table>';
&#125;
bill.addEventListener('input',calc);
tipRange.addEventListener('input',function()&#123;tipLabel.textContent=this.value+'%';calc();&#125;);
people.addEventListener('input',calc);
document.getElementById('decPeople').addEventListener('click',function()&#123;people.value=Math.max(1,parseInt(people.value)-1);calc();&#125;);
document.getElementById('incPeople').addEventListener('click',function()&#123;people.value=Math.min(100,parseInt(people.value)+1);calc();&#125;);
document.querySelectorAll('#tipPresets .btn').forEach(function(b)&#123;
  b.addEventListener('click',function()&#123;
    document.querySelectorAll('#tipPresets .btn').forEach(function(x)&#123;x.className='btn btn-outline-primary btn-sm'&#125;);
    this.className='btn btn-primary btn-sm';
    tipRange.value=this.dataset.pct;tipLabel.textContent=this.dataset.pct+'%';calc();
  &#125;);
&#125;);
calc();
</script>

