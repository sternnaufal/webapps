---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Color Format Converter';
const description = 'Konversi warna antara format HEX, RGB, RGBA, HSL, HSLA, dan CMYK. Color picker visual.';
const keywords = 'color converter, hex to rgb, rgb to hsl, color picker, konversi warna, cmyk';
const aboutText = 'adalah alat untuk mengkonversi warna antara berbagai format: HEX, RGB, RGBA, HSL, HSLA, dan CMYK. Dilengkapi color picker visual dan input manual.';
const aboutExtra = 'Konversi format warna sangat penting dalam workflow desain dan pengembangan web. Desainer web menggunakan HEX dan RGB untuk CSS, desainer cetak menggunakan CMYK, dan desainer UI sering bekerja dengan HSL untuk kemudahan penyesuaian. Color Format Converter ini memungkinkan Anda memasukkan warna dalam format apapun (HEX, RGB, atau HSL) dan mendapatkan semua format lainnya secara otomatis. Dilengkapi juga color picker visual untuk memilih warna secara langsung.';
const relatedTools = [
  { slug: 'color-picker', name: 'Color Picker', icon: '🎨' },
  { slug: 'gradient-generator', name: 'Gradient Generator', icon: '◐' },
  { slug: 'contrast-checker', name: 'Contrast Checker', icon: '◐' },
  { slug: 'css-unit', name: 'CSS Unit Converter', icon: 'px' }
];
---

<ToolLayout title={title} description={description} keywords={keywords}>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <div class="rounded-xl p-3 mb-3" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
        <label class="text-xs font-medium opacity-60 mb-1 block">Color Picker</label>
        <input type="color" id="ccPick" class="input input-bordered w-full" value="#6366f1" style="height:50px;cursor:pointer">
      </div>
      <div class="rounded-xl p-3" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
        <label class="text-xs font-medium opacity-60 mb-1 block">Manual Input</label>
        <input type="text" id="ccIn" class="input input-bordered w-full input-sm font-mono" value="#6366f1" placeholder="#ff0000 / rgb(255,0,0) / hsl(0,100%,50%)">
        <div class="text-xs opacity-40 mt-1">HEX, RGB, atau HSL</div>
      </div>
    </div>
    <div>
      <div class="rounded-xl p-3" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
        <div class="flex items-center gap-3 mb-3">
          <div id="ccPrev" style="width:60px;height:60px;border-radius:12px;background:#6366f1;border:2px solid oklch(0.85 0.01 270);"></div>
          <div>
            <div class="text-sm font-medium">Preview</div>
            <span id="ccHexLabel" class="text-xs opacity-60 font-mono">#6366f1</span>
          </div>
        </div>
        <div class="text-xs space-y-1">
          <div class="flex justify-between items-center py-1"><span class="opacity-60">HEX</span><span id="ccHex" class="font-mono font-medium">#6366f1</span><button class="btn btn-ghost btn-xs" onclick="ccCopy('ccHex')">Copy</button></div>
          <div class="flex justify-between items-center py-1 border-t" style="border-color:oklch(0.93 0.005 270);"><span class="opacity-60">RGB</span><span id="ccRgb" class="font-mono font-medium">rgb(99,102,241)</span><button class="btn btn-ghost btn-xs" onclick="ccCopy('ccRgb')">Copy</button></div>
          <div class="flex justify-between items-center py-1 border-t" style="border-color:oklch(0.93 0.005 270);"><span class="opacity-60">RGBA</span><span id="ccRgba" class="font-mono font-medium">rgba(99,102,241,1)</span><button class="btn btn-ghost btn-xs" onclick="ccCopy('ccRgba')">Copy</button></div>
          <div class="flex justify-between items-center py-1 border-t" style="border-color:oklch(0.93 0.005 270);"><span class="opacity-60">HSL</span><span id="ccHsl" class="font-mono font-medium">hsl(239,83%,67%)</span><button class="btn btn-ghost btn-xs" onclick="ccCopy('ccHsl')">Copy</button></div>
          <div class="flex justify-between items-center py-1 border-t" style="border-color:oklch(0.93 0.005 270);"><span class="opacity-60">CMYK</span><span id="ccCmyk" class="font-mono font-medium">cmyk(59%,57%,0%,5%)</span><button class="btn btn-ghost btn-xs" onclick="ccCopy('ccCmyk')">Copy</button></div>
        </div>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
function ccCopy(id){navigator.clipboard.writeText(document.getElementById(id).textContent);}
function ccHex2Rgb(h){const r=/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(h);return r?[parseInt(r[1],16),parseInt(r[2],16),parseInt(r[3],16)]:null}
function ccRgb2Hsl(r,g,b){r/=255;g/=255;b/=255;const mx=Math.max(r,g,b),mn=Math.min(r,g,b);let h=(mx+mn)/2,s=(mx+mn)/2,l=(mx+mn)/2;if(mx!==mn){const d=mx-mn;s=l>.5?d/(2-mx-mn):d/(mx+mn);switch(mx){case r:h=((g-b)/d+(g<b?6:0))/6;break;case g:h=((b-r)/d+2)/6;break;case b:h=((r-g)/d+4)/6;break}}return[Math.round(h*360),Math.round(s*100),Math.round(l*100)]}
function ccRgb2Cmyk(r,g,b){const c=1-(r/255),m=1-(g/255),y=1-(b/255),k=Math.min(c,m,y);return[Math.round((c-k)/(1-k)*100)||0,Math.round((m-k)/(1-k)*100)||0,Math.round((y-k)/(1-k)*100)||0,Math.round(k*100)]}
function ccParse(s){s=s.trim().toLowerCase();let r,g,b;if(s.startsWith("#")){const x=ccHex2Rgb(s);if(x)[r,g,b]=x}else if(s.startsWith("rgb")){const m=s.match(/\d+/g);if(m&&m.length>=3)[r,g,b]=m.slice(0,3).map(Number)}else if(s.startsWith("hsl")){const m=s.match(/\d+/g);if(m&&m.length>=3){const[h2,s2,l2]=m.slice(0,3).map(Number);const S=s2/100,L=l2/100,C=(1-Math.abs(2*L-1))*S,X=C*(1-Math.abs((h2/60)%2-1)),m2=L-C/2;let r1=0,g1=0,b1=0;if(h2<60)[r1,g1,b1]=[C,X,0];else if(h2<120)[r1,g1,b1]=[X,C,0];else if(h2<180)[r1,g1,b1]=[0,C,X];else if(h2<240)[r1,g1,b1]=[0,X,C];else if(h2<300)[r1,g1,b1]=[X,0,C];else[r1,g1,b1]=[C,0,X];[r,g,b]=[Math.round((r1+m2)*255),Math.round((g1+m2)*255),Math.round((b1+m2)*255)]}}return[r,g,b]}
function ccUpd(r,g,b){if(r===undefined)return;const hex="#"+[r,g,b].map(x=>x.toString(16).padStart(2,"0")).join("");const[h,s,l]=ccRgb2Hsl(r,g,b);const[c,my,y,k]=ccRgb2Cmyk(r,g,b);document.getElementById("ccPrev").style.background=hex;document.getElementById("ccHexLabel").textContent=hex;document.getElementById("ccHex").textContent=hex;document.getElementById("ccRgb").textContent="rgb("+r+","+g+","+b+")";document.getElementById("ccRgba").textContent="rgba("+r+","+g+","+b+",1)";document.getElementById("ccHsl").textContent="hsl("+h+","+s+"%,"+l+"%)";document.getElementById("ccCmyk").textContent="cmyk("+c+","+my+","+y+","+k+")"}
document.getElementById("ccPick").oninput=function(){document.getElementById("ccIn").value=this.value;const x=ccHex2Rgb(this.value);if(x)ccUpd(...x)};
document.getElementById("ccIn").oninput=function(){const x=ccParse(this.value);if(x[0]!==undefined){document.getElementById("ccPick").value="#"+[x[0],x[1],x[2]].map(v=>v.toString(16).padStart(2,"0")).join("");ccUpd(...x)}};const _r=ccHex2Rgb("#6366f1");if(_r)ccUpd(..._r);
</script>