---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Color Format Converter';
const desc = 'Konversi warna antara format HEX, RGB, RGBA, HSL, HSLA, dan CMYK. Color picker visual.';
const keywords = 'color converter, hex to rgb, rgb to hsl, color picker, konversi warna, cmyk';
const aboutText = 'Color Format Converter Color Format Converter online. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'color-picker', name: 'Color Picker', icon: '🎨' },
  { slug: 'gradient-generator', name: 'Gradient Generator', icon: '◐' },
  { slug: 'contrast-checker', name: 'Contrast Checker', icon: '◐' },
  { slug: 'css-unit', name: 'Css Unit', icon: 'px' }
];
const bodyHtml = '<div class="flex flex-wrap gap-4">\n  <div class="md:w-1/2 w-full">\n    <div class="card card-bordered bg-base-100 p-3 mb-3"><label class="label-text font-semibold">Color Picker</label><input type="color" id="ccPick" class="input input-bordered w-full input input-bordered w-full-color w-full" value="#6366f1" style="height:50px"></div>\n    <div class="card card-bordered bg-base-100 p-3"><label class="label-text font-semibold">Manual Input</label><input type="text" id="ccIn" class="input input-bordered w-full font-mono" value="#6366f1" placeholder="#ff0000 / rgb(255,0,0) / hsl(0,100%,50%)"><div class="text-xs opacity-60">HEX, RGB, atau HSL</div></div>\n  </div>\n  <div class="md:w-1/2 w-full">\n    <div class="card card-bordered bg-base-100 p-3">\n      <div class="flex items-center gap-3 mb-3"><div id="ccPrev" style="width:60px;height:60px;border-radius:12px;background:#6366f1;border:2px solid #e9ecef"></div><div><h6 class="mb-0">Preview</h6><span id="ccHexLabel" class="text-sm opacity-60">#6366f1</span></div></div>\n      <table class="table table-sm small mb-0"><tbody>\n        <tr><td>HEX</td><td id="ccHex" class="font-semibold font-mono">#6366f1</td><td><button class="btn btn-sm py-0 px-1 btn-outline-secondary" onclick="ccCopy(\'ccHex\')">Copy</button></td></tr>\n        <tr><td>RGB</td><td id="ccRgb" class="font-semibold font-mono">rgb(99,102,241)</td><td><button class="btn btn-sm py-0 px-1 btn-outline-secondary" onclick="ccCopy(\'ccRgb\')">Copy</button></td></tr>\n        <tr><td>RGBA</td><td id="ccRgba" class="font-semibold font-mono">rgba(99,102,241,1)</td><td><button class="btn btn-sm py-0 px-1 btn-outline-secondary" onclick="ccCopy(\'ccRgba\')">Copy</button></td></tr>\n        <tr><td>HSL</td><td id="ccHsl" class="font-semibold font-mono">hsl(239,83%,67%)</td><td><button class="btn btn-sm py-0 px-1 btn-outline-secondary" onclick="ccCopy(\'ccHsl\')">Copy</button></td></tr>\n        <tr><td>CMYK</td><td id="ccCmyk" class="font-semibold font-mono">cmyk(59,58,0,5)</td><td><button class="btn btn-sm py-0 px-1 btn-outline-secondary" onclick="ccCopy(\'ccCmyk\')">Copy</button></td></tr>\n      </tbody></table>\n    </div>\n  </div>\n</div>';
---

<ToolLayout title={title} description=&#123;desc&#125; keywords={keywords}>
<Fragment set:html=&#123;bodyHtml&#125; />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float{position:fixed;bottom:24px;right:24px;z-index:9999;background:#ff6b6b;color:#fff;border-radius:50px;padding:10px 20px 10px 16px;text-decoration:none;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;box-shadow:0 4px 15px rgba(255,107,107,0.4);transition:all .3s ease;font-family:"Inter",sans-serif}
.saweria-float:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(255,107,107,0.6);color:#fff}
.saweria-float svg{animation:pulse 1.5s ease infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
@media(max-width:576px){.saweria-float{bottom:16px;right:16px;padding:8px 14px 8px 10px;font-size:12px}}
</style>

<script is:inline>
function ccCopy(id)&#123;navigator.clipboard.writeText(document.getElementById(id).textContent);&#125;
function ccHex2Rgb(h)&#123;const r=/^#?([a-f\d]&#123;2&#125;)([a-f\d]&#123;2&#125;)([a-f\d]&#123;2&#125;)$/i.exec(h);return r?[parseInt(r[1],16),parseInt(r[2],16),parseInt(r[3],16)]:null&#125;
function ccRgb2Hsl(r,g,b)&#123;r/=255;g/=255;b/=255;const mx=Math.max(r,g,b),mn=Math.min(r,g,b);let h=(mx+mn)/2,s=(mx+mn)/2,l=(mx+mn)/2;if(mx!==mn)&#123;const d=mx-mn;s=l>.5?d/(2-mx-mn):d/(mx+mn);switch(mx)&#123;case r:h=((g-b)/d+(g<b?6:0))/6;break;case g:h=((b-r)/d+2)/6;break;case b:h=((r-g)/d+4)/6;break&#125;&#125;return[Math.round(h*360),Math.round(s*100),Math.round(l*100)]&#125;
function ccRgb2Cmyk(r,g,b)&#123;const c=1-(r/255),m=1-(g/255),y=1-(b/255),k=Math.min(c,m,y);return[Math.round((c-k)/(1-k)*100)||0,Math.round((m-k)/(1-k)*100)||0,Math.round((y-k)/(1-k)*100)||0,Math.round(k*100)]&#125;
function ccParse(s)&#123;s=s.trim().toLowerCase();let r,g,b;if(s.startsWith("#"))&#123;const x=ccHex2Rgb(s);if(x)[r,g,b]=x&#125;else if(s.startsWith("rgb"))&#123;const m=s.match(/\d+/g);if(m&&m.length>=3)[r,g,b]=m.slice(0,3).map(Number)&#125;else if(s.startsWith("hsl"))&#123;const m=s.match(/\d+/g);if(m&&m.length>=3)&#123;const[h2,s2,l2]=m.slice(0,3).map(Number);const S=s2/100,L=l2/100,C=(1-Math.abs(2*L-1))*S,X=C*(1-Math.abs((h2/60)%2-1)),m2=L-C/2;let r1=0,g1=0,b1=0;if(h2<60)[r1,g1,b1]=[C,X,0];else if(h2<120)[r1,g1,b1]=[X,C,0];else if(h2<180)[r1,g1,b1]=[0,C,X];else if(h2<240)[r1,g1,b1]=[0,X,C];else if(h2<300)[r1,g1,b1]=[X,0,C];else[r1,g1,b1]=[C,0,X];[r,g,b]=[Math.round((r1+m2)*255),Math.round((g1+m2)*255),Math.round((b1+m2)*255)]&#125;&#125;return[r,g,b]&#125;
function ccUpd(r,g,b)&#123;if(r===undefined)return;const hex="#"+[r,g,b].map(x=>x.toString(16).padStart(2,"0")).join("");const[h,s,l]=ccRgb2Hsl(r,g,b);const[c,my,y,k]=ccRgb2Cmyk(r,g,b);document.getElementById("ccPrev").style.background=hex;document.getElementById("ccHexLabel").textContent=hex;document.getElementById("ccHex").textContent=hex;document.getElementById("ccRgb").textContent="rgb("+r+","+g+","+b+")";document.getElementById("ccRgba").textContent="rgba("+r+","+g+","+b+",1)";document.getElementById("ccHsl").textContent="hsl("+h+","+s+"%,"+l+"%)";document.getElementById("ccCmyk").textContent="cmyk("+c+","+my+","+y+","+k+")"&#125;
document.getElementById("ccPick").oninput=function()&#123;document.getElementById("ccIn").value=this.value;const x=ccHex2Rgb(this.value);if(x)ccUpd(...x)&#125;;
document.getElementById("ccIn").oninput=function()&#123;const x=ccParse(this.value);if(x[0]!==undefined)&#123;document.getElementById("ccPick").value="#"+[x[0],x[1],x[2]].map(v=>v.toString(16).padStart(2,"0")).join("");ccUpd(...x)&#125;&#125;;const _r=ccHex2Rgb("#6366f1");if(_r)ccUpd(..._r);
</script>

