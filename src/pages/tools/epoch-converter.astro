---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Epoch / Unix Timestamp Converter';
const description = 'Epoch & Unix timestamp converter online. Ubah timestamp ke tanggal dan sebaliknya. Kalkulator waktu Unix untuk developer.';
const keywords = 'epoch converter, unix timestamp, epoch time, timestamp to date, date to timestamp, epoch calculator';
const aboutText = 'Epoch & Unix timestamp converter online. Ubah timestamp ke tanggal dan sebaliknya. Kalkulator waktu Unix untuk developer.';
const relatedTools = [
  { slug: 'cron-builder', name: 'Cron Builder', icon: '⏰' },
  { slug: 'date-calculator', name: 'Date Calculator', icon: '📅' },
  { slug: 'time-converter', name: 'Time Converter', icon: '🌍' },
  { slug: 'countdown', name: 'Countdown', icon: '⏳' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f8fafc;color:#475569;">&#9200;</div><div><h1 class="h3 mb-0">Epoch / Unix Timestamp Converter</h1><p class="opacity-60 small mb-0">Konversi Unix timestamp ke tanggal dan sebaliknya dengan mudah.</p></div></header><div class="flex flex-wrap gap-4"><div class="col-lg-6"><div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Timestamp ke Tanggal</h6><input type="number" id="timestampInput" class="input input-bordered w-full mb-2" value="1718000000" placeholder="Masukkan timestamp..."><div class="flex items-center gap-2 mb-2"><input type="checkbox" id="isMillis" class="checkbox"><label class="flex items-center gap-2-label small" for="isMillis">Input dalam milidetik</label></div><button id="btnConvert" class="btn btn-primary w-full">Convert</button><div id="tsResult" class="mt-3 p-3 rounded bg-light small" style="display:none"></div><div class="flex gap-2 mt-2"><button class="btn btn-outline btn-sm flex-fill" onclick="document.getElementById('timestampInput').value=Math.floor(Date.now()/1000);convertTs()">Sekarang (detik)</button><button class="btn btn-outline btn-sm flex-fill" onclick="document.getElementById('timestampInput').value=Date.now();document.getElementById('isMillis').checked=true;convertTs()">Sekarang (ms)</button></div></div></div><div class="col-lg-6"><div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Tanggal ke Timestamp</h6><input type="datetime-local" id="dateInput" class="input input-bordered w-full mb-2"><button id="btnDateToTs" class="btn btn-primary w-full">Convert ke Timestamp</button><div id="dtResult" class="mt-3 p-3 rounded bg-light small" style="display:none"></div></div><div class="card card-bordered bg-base-100 p-3 mt-3"><h6 class="mb-3">Waktu Saat Ini</h6><div class="p-3 rounded bg-light small"><div>Unix Timestamp: <span class="font-bold" id="nowTs">-</span></div><div>Tanggal: <span class="font-bold" id="nowDate">-</span></div><div>UTC: <span class="font-bold" id="nowUtc">-</span></div></div></div></div></div>

<ToolShell about={aboutText} />

</ToolLayout>



<script is:inline>
var tsInp=document.getElementById('timestampInput'),isM=document.getElementById('isMillis'),tsR=document.getElementById('tsResult'),dInp=document.getElementById('dateInput'),dtR=document.getElementById('dtResult'),nTs=document.getElementById('nowTs'),nDt=document.getElementById('nowDate'),nUt=document.getElementById('nowUtc');function pad(n){return(n+'').padStart(2,'0')}function convertTs(){var v=parseFloat(tsInp.value);if(isNaN(v)){tsR.style.display='none';return}var ms=isM.checked?v:v*1000;var d=new Date(ms);if(isNaN(d.getTime())){tsR.innerHTML='<span class="text-error">Invalid timestamp</span>';tsR.style.display='block';return}tsR.style.display='block';tsR.innerHTML='<table class="table table-sm mb-0"><tr><td>Tanggal</td><td class="font-bold">'+d.toLocaleDateString('id-ID',{year:'numeric',month:'long',day:'numeric',weekday:'long'})+'</td></tr><tr><td>Waktu</td><td class="font-bold">'+pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds())+'</td></tr><tr><td>UTC</td><td>'+d.toUTCString()+'</td></tr><tr><td>Tahun</td><td>'+d.getFullYear()+'</td></tr><tr><td>Bulan</td><td>'+(d.getMonth()+1)+'</td></tr><tr><td>Hari</td><td>'+d.getDate()+'</td></tr><tr><td>Jam</td><td>'+d.getHours()+'</td></tr><tr><td>Menit</td><td>'+d.getMinutes()+'</td></tr><tr><td>Detik</td><td>'+d.getSeconds()+'</td></tr><tr><td>Milidetik</td><td>'+d.getMilliseconds()+'</td></tr><tr><td>Day of Year</td><td>'+Math.floor((d-new Date(d.getFullYear(),0,0))/(86400000))+'</td></tr><tr><td>Week of Year</td><td>'+Math.ceil((((d-new Date(d.getFullYear(),0,1))/(86400000))+d.getDay()+1)/7)+'</td></tr></table>'}function convertDate(){var v=dInp.value;if(!v){dtR.style.display='none';return}var d=new Date(v);var ts=Math.floor(d.getTime()/1000);dtR.style.display='block';dtR.innerHTML='<table class="table table-sm mb-0"><tr><td>Timestamp (detik)</td><td class="font-bold">'+ts+'</td></tr><tr><td>Timestamp (ms)</td><td class="font-bold">'+d.getTime()+'</td></tr><tr><td>Tanggal</td><td>'+d.toLocaleDateString('id-ID',{year:'numeric',month:'long',day:'numeric',weekday:'long'})+'</td></tr><tr><td>UTC</td><td>'+d.toUTCString()+'</td></tr></table>'}function updateNow(){var n=Date.now();nTs.textContent=Math.floor(n/1000);nDt.textContent=new Date(n).toLocaleString('id-ID');nUt.textContent=new Date(n).toUTCString()}document.getElementById('btnConvert').addEventListener('click',convertTs);document.getElementById('btnDateToTs').addEventListener('click',convertDate);tsInp.addEventListener('input',convertTs);dInp.value=new Date().toISOString().slice(0,16);updateNow();setInterval(updateNow,1000);convertTs();
</script>

