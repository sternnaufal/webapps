---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Word Frequency Counter';
const desc = 'Hitung frekuensi kata dalam teks. Analisis teks untuk SEO, content writing, dan riset kata kunci.';
const keywords = 'word frequency, counter, text analysis, seo, keyword density, frekuensi kata';
const aboutText = 'Word Frequency Counter Word Frequency Counter online. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'char-counter', name: 'Char Counter', icon: '#' },
  { slug: 'word-counter', name: 'Word Counter', icon: '⚡' },
  { slug: 'palindrome-checker', name: 'Palindrome Checker', icon: '↔' },
  { slug: 'anagram-finder', name: 'Anagram Finder', icon: '🔀' }
];
const bodyHtml = '<div class="flex flex-wrap gap-4">\n  <div class="w-full">\n    <textarea id="wfInput" class="input input-bordered w-full font-mono" rows="8" placeholder="Tempel teks di sini..."></textarea>\n  </div>\n  <div class="w-full">\n    <div class="flex gap-2 flex-wrap">\n      <button id="wfCountBtn" class="btn btn-warning">Hitung Frekuensi</button>\n      <button id="wfClearBtn" class="btn btn-outline">Clear</button>\n      <div class="flex items-center gap-2 form-switch ml-auto flex items-center">\n        <input class="checkbox" type="checkbox" id="wfIgnoreCase" checked>\n        <label class="flex items-center gap-2-label small" for="wfIgnoreCase">Ignore case</label>\n      </div>\n      <div class="flex items-center gap-2 form-switch flex items-center">\n        <input class="checkbox" type="checkbox" id="wfExcludeCommon">\n        <label class="flex items-center gap-2-label small" for="wfExcludeCommon">Exclude common words</label>\n      </div>\n    </div>\n  </div>\n  <div class="md:w-1/3 w-full">\n    <div class="card card-bordered bg-base-100 p-3">\n      <h6 class="font-semibold mb-2">Statistik</h6>\n      <div class="small"><div class="flex justify-between"><span>Total kata</span><span id="wfTotalWords">0</span></div><div class="flex justify-between"><span>Kata unik</span><span id="wfUniqueWords">0</span></div><div class="flex justify-between"><span>Total karakter</span><span id="wfTotalChars">0</span></div><div class="flex justify-between"><span>Density tertinggi</span><span id="wfTopDensity">0%</span></div></div>\n    </div>\n  </div>\n  <div class="md:w-2/3 w-full">\n    <div class="overflow-x-auto small">\n      <table class="table table-sm table-hover">\n        <thead><tr><th>#</th><th>Kata</th><th>Frekuensi</th><th>%</th><th>Bar</th></tr></thead>\n        <tbody id="wfTableBody"><tr><td colspan="5" class="opacity-60 text-center">Hasil akan muncul di sini</td></tr></tbody>\n      </table>\n    </div>\n  </div>\n</div>';
---

<ToolLayout title={title} description={desc} keywords={keywords}>
<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float{position:fixed;bottom:24px;right:24px;z-index:9999;background:#ff6b6b;color:#fff;border-radius:50px;padding:10px 20px 10px 16px;text-decoration:none;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;box-shadow:0 4px 15px rgba(255,107,107,0.4);transition:all .3s ease;font-family:"Inter",sans-serif}
.saweria-float:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(255,107,107,0.6);color:#fff}
.saweria-float svg{animation:pulse 1.5s ease infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
@media(max-width:576px){.saweria-float{bottom:16px;right:16px;padding:8px 14px 8px 10px;font-size:12px}}
</style>

<script is:inline>
const SW=new Set(["the","a","an","and","or","but","in","on","at","to","for","of","by","with","from","is","are","was","were","be","been","has","had","have","do","does","did","will","would","can","could","its","this","that","these","those","i","you","he","she","we","they","me","him","her","us","them","my","your","his","her","its","our","their","not","no","nor","so","if","then","than","too","very","just","all","each","every","both","few","more","most","other","some","such","only","own","same","what","which","who","whom","when","where","why","how","yang","dan","di","ke","dari","dengan","untuk","pada","adalah","akan","tidak","sudah","dapat","bisa","telah","ini","itu","saya","kami","kita","anda","dia","mereka","dalam","ada","juga","atau","karena","sebagai","oleh","tentang","setelah","antara","seperti","tanpa","sampai","sebelum","sesudah","melalui","serta","namun","tetapi","sedangkan","meskipun","walaupun","sehingga","maka","agar","supaya","bahwa","apakah","bila","kalau","jika","saat"]);
document.getElementById("wfCountBtn").onclick=wf;document.getElementById("wfClearBtn").onclick=()=>{document.getElementById("wfInput").value="";wf()};
document.getElementById("wfInput").oninput=wf;document.getElementById("wfIgnoreCase").onchange=wf;document.getElementById("wfExcludeCommon").onchange=wf;
function wf(){const t=document.getElementById("wfInput").value;const ic=document.getElementById("wfIgnoreCase").checked;const ec=document.getElementById("wfExcludeCommon").checked;let p=ic?t.toLowerCase():t;p=p.replace(/[^\w\s\-\'\u00C0-\u024F]/g," ").replace(/\s+/g," ").trim();const w=p?p.split(/\s+/):[];const ttl=w.length;const v=w.filter(x=>x.length>0&&!/^\d+$/.test(x));const f={};v.forEach(x=>{if(ec&&SW.has(x))return;f[x]=(f[x]||0)+1});const s=Object.entries(f).sort((a,b)=>b[1]-a[1]);const u=s.length;document.getElementById("wfTotalWords").textContent=ttl;document.getElementById("wfUniqueWords").textContent=u;document.getElementById("wfTotalChars").textContent=t.length;document.getElementById("wfTopDensity").textContent=u>0&&s.length>0?((s[0][1]/ttl)*100).toFixed(1)+"%":"0%";const tb=document.getElementById("wfTableBody");if(s.length===0){tb.innerHTML='<tr><td colspan="5" class="opacity-60 text-center">Tidak ada kata</td></tr>';return}const mx=s[0][1];tb.innerHTML=s.map(([w,c],i)=>'<tr><td>'+(i+1)+'</td><td class="font-semibold">'+w+'</td><td>'+c+'</td><td>'+((c/ttl)*100).toFixed(2)+'%</td><td style="width:150px"><div style="height:14px;background:#e9ecef;border-radius:4px;overflow:hidden"><div style="width:'+(c/mx*100)+'%;height:100%;background:#6366f1;border-radius:4px;transition:width .3s"></div></div></td></tr>').join("")}wf();
</script>

