---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Word Frequency Counter';
const description = 'Hitung frekuensi kata dalam teks. Analisis teks untuk SEO, content writing, dan riset kata kunci.';
const keywords = 'word frequency, counter, text analysis, seo, keyword density, frekuensi kata';
const aboutText = 'adalah alat untuk menganalisis frekuensi kemunculan setiap kata dalam teks. Dilengkapi statistik total kata, kata unik, total karakter, dan density tertinggi.';
const aboutExtra = 'Analisis frekuensi kata sangat berguna untuk optimasi SEO (Search Engine Optimization), content writing, riset kata kunci, dan analisis teks akademik. Dengan Word Frequency Counter, Anda dapat mengidentifikasi kata-kata yang paling sering muncul dalam konten, mengecek keyword density, dan memastikan konten Anda tidak over-optimasi. Fitur exclude common words membantu fokus pada kata-kata yang relevan dengan topik.';
const relatedTools = [
  { slug: 'char-counter', name: 'Char Counter', icon: '#' },
  { slug: 'word-counter', name: 'Word Counter', icon: '⚡' },
  { slug: 'palindrome-checker', name: 'Palindrome Checker', icon: '↔' },
  { slug: 'anagram-finder', name: 'Anagram Finder', icon: '🔀' }
];
---

<ToolLayout title={title} description={description} keywords={keywords}>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="mb-3">
    <textarea id="wfInput" class="textarea textarea-bordered w-full text-sm font-mono" rows="6" placeholder="Tempel teks di sini..."></textarea>
  </div>

  <div class="flex gap-2 flex-wrap items-center mb-4">
    <button id="wfCountBtn" class="btn btn-primary btn-sm">Hitung Frekuensi</button>
    <button id="wfClearBtn" class="btn btn-ghost btn-sm">Clear</button>
    <label class="flex items-center gap-1 text-xs opacity-60 ml-auto">
      <input class="checkbox checkbox-sm" type="checkbox" id="wfIgnoreCase" checked>
      Ignore case
    </label>
    <label class="flex items-center gap-1 text-xs opacity-60">
      <input class="checkbox checkbox-sm" type="checkbox" id="wfExcludeCommon">
      Exclude common words
    </label>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3">
    <div class="rounded-xl p-3" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
      <div class="text-xs font-medium opacity-60 mb-2">Statistik</div>
      <div class="text-xs space-y-1">
        <div class="flex justify-between"><span>Total kata</span><span id="wfTotalWords" class="font-medium">0</span></div>
        <div class="flex justify-between"><span>Kata unik</span><span id="wfUniqueWords" class="font-medium">0</span></div>
        <div class="flex justify-between"><span>Total karakter</span><span id="wfTotalChars" class="font-medium">0</span></div>
        <div class="flex justify-between"><span>Density tertinggi</span><span id="wfTopDensity" class="font-medium">0%</span></div>
      </div>
    </div>
    <div class="md:col-span-2 rounded-xl p-3" style="background:oklch(0.99 0.001 270);border:1px solid oklch(0.93 0.005 270);">
      <div class="overflow-x-auto text-xs">
        <table class="table table-sm w-full">
          <thead>
            <tr class="opacity-60"><th class="font-normal">#</th><th class="font-normal">Kata</th><th class="font-normal">Frekuensi</th><th class="font-normal">%</th><th class="font-normal">Bar</th></tr>
          </thead>
          <tbody id="wfTableBody">
            <tr><td colspan="5" class="opacity-60 text-center">Hasil akan muncul di sini</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
const SW=new Set(["the","a","an","and","or","but","in","on","at","to","for","of","by","with","from","is","are","was","were","be","been","has","had","have","do","does","did","will","would","can","could","its","this","that","these","those","i","you","he","she","we","they","me","him","her","us","them","my","your","his","her","its","our","their","not","no","nor","so","if","then","than","too","very","just","all","each","every","both","few","more","most","other","some","such","only","own","same","what","which","who","whom","when","where","why","how","yang","dan","di","ke","dari","dengan","untuk","pada","adalah","akan","tidak","sudah","dapat","bisa","telah","ini","itu","saya","kami","kita","anda","dia","mereka","dalam","ada","juga","atau","karena","sebagai","oleh","tentang","setelah","antara","seperti","tanpa","sampai","sebelum","sesudah","melalui","serta","namun","tetapi","sedangkan","meskipun","walaupun","sehingga","maka","agar","supaya","bahwa","apakah","bila","kalau","jika","saat"]);
document.getElementById("wfCountBtn").onclick=wf;document.getElementById("wfClearBtn").onclick=()=>{document.getElementById("wfInput").value="";wf()};
document.getElementById("wfInput").oninput=wf;document.getElementById("wfIgnoreCase").onchange=wf;document.getElementById("wfExcludeCommon").onchange=wf;
function wf(){const t=document.getElementById("wfInput").value;const ic=document.getElementById("wfIgnoreCase").checked;const ec=document.getElementById("wfExcludeCommon").checked;let p=ic?t.toLowerCase():t;p=p.replace(/[^\w\s\-\'\u00C0-\u024F]/g," ").replace(/\s+/g," ").trim();const w=p?p.split(/\s+/):[];const ttl=w.length;const v=w.filter(x=>x.length>0&&!/^\d+$/.test(x));const f={};v.forEach(x=>{if(ec&&SW.has(x))return;f[x]=(f[x]||0)+1});const s=Object.entries(f).sort((a,b)=>b[1]-a[1]);const u=s.length;document.getElementById("wfTotalWords").textContent=ttl;document.getElementById("wfUniqueWords").textContent=u;document.getElementById("wfTotalChars").textContent=t.length;document.getElementById("wfTopDensity").textContent=u>0&&s.length>0?((s[0][1]/ttl)*100).toFixed(1)+"%":"0%";const tb=document.getElementById("wfTableBody");if(s.length===0){tb.innerHTML='<tr><td colspan="5" class="opacity-60 text-center">Tidak ada kata</td></tr>';return}const mx=s[0][1];tb.innerHTML=s.map(([w,c],i)=>'<tr><td>'+(i+1)+'</td><td class="font-medium">'+w+'</td><td>'+c+'</td><td>'+((c/ttl)*100).toFixed(2)+'%</td><td style="width:150px"><div style="height:14px;background:#e9ecef;border-radius:4px;overflow:hidden"><div style="width:'+(c/mx*100)+'%;height:100%;background:#f59e0b;border-radius:4px;transition:width .3s"></div></div></td></tr>').join("")}wf();
</script>