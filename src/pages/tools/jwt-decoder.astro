---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'JWT Decoder';
const description = 'Decode JWT token online. Lihat header, payload, dan verifikasi signature secara lokal.';
const keywords = 'jwt decoder, jwt token, json web token, jwt debugger';
const aboutText = 'JWT Decoder Decode JWT token online. Lihat header, payload, dan verifikasi signature secara lokal.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'rsa-generator', name: 'Rsa Generator', icon: '🔒' },
  { slug: 'base64-coded', name: 'Base64 Coded', icon: 'B64' },
  { slug: 'uuid-generator', name: 'Uuid Generator', icon: '🆔' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#fef2f2;color:#dc2626;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div><div><h1 class="h3 mb-0">JWT Decoder</h1><p class="opacity-60 small mb-0">Decode JWT token secara lokal di browser. Data tidak dikirim ke server.</p></div></header>
<div class="mb-3"><label class="label-text font-semibold">Token</label>
<textarea id="jwtInput" class="input input-bordered w-full font-mono" rows="2" placeholder="Paste JWT token...">eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6Ik5hdWZhbCBSYWtoYSIsImlhdCI6MTUxNjIzOTAyMn0</textarea>
<div id="statusMsg" class="small mt-1"></div></div>
<div class="flex flex-wrap gap-3 mb-3"><div class="md:w-1/2 w-full"><label class="label-text font-semibold small">Header</label><pre id="headerOut" class="bg-light p-2 rounded border"></pre></div><div class="md:w-1/2 w-full"><label class="label-text font-semibold small">Payload</label><pre id="payloadOut" class="bg-light p-2 rounded border"></pre></div></div>
<div id="verifySection" class="card card-bordered bg-base-100 p-3 mb-3"><div class="row gap-2 align-items-end">
<div class="md:w-1/3 w-full"><label class="label-text font-semibold small">Secret / Public Key <small class="opacity-60">(untuk verifikasi)</small></label><input type="text" id="secretKey" class="input input-bordered w-full font-mono" placeholder="Rahasia..." style="font-size:0.8rem"></div>
<div class="col-md-2"><label class="label-text font-semibold small">&nbsp;</label><button id="btnVerify" class="btn btn-primary w-full">Verify</button></div>
<div class="md:w-1/2 w-full"><label class="label-text font-semibold small">Hasil Verifikasi</label><div id="verifyResult" class="text-sm opacity-60" style="padding:6px 0">Masukkan secret lalu klik Verify.</div></div>
</div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var inp=document.getElementById('jwtInput'),hdr=document.getElementById('headerOut'),pay=document.getElementById('payloadOut'),msg=document.getElementById('statusMsg'),sec=document.getElementById('secretKey'),vres=document.getElementById('verifyResult');
function decode(){
  var t=inp.value.trim();
  if(!t||t.split('.').length<3){hdr.textContent='';pay.textContent='';msg.textContent='';return;}
  var parts=t.split('.');
  try{
    var header=JSON.parse(atob(parts[0].replace(/-/g,'+').replace(/_/g,'/')));
    var payload=JSON.parse(atob(parts[1].replace(/-/g,'+').replace(/_/g,'/')));
    hdr.textContent=JSON.stringify(header,null,2);
    pay.textContent=JSON.stringify(payload,null,2);
    msg.innerHTML='<span class="text-success">? Valid JWT format</span>';
    inp.className='input input-bordered w-full font-mono valid';
  }catch(e){
    hdr.textContent='Error: '+e.message;pay.textContent='';msg.innerHTML='<span class="text-error">? Invalid JWT format</span>';
    inp.className='input input-bordered w-full font-mono invalid';
  }
}
inp.addEventListener('input',decode);decode();

function b64url(s){return s.replace(/-/g,'+').replace(/_/g,'/')}
function toU8(s){return Uint8Array.from(atob(s),function(c){return c.charCodeAt(0)})}
document.getElementById('btnVerify').addEventListener('click',async function(){
  var t=inp.value.trim(),s=sec.value.trim();
  if(!t||!s){vres.textContent='Token dan secret harus diisi.';vres.className='small text-error';return;}
  var parts=t.split('.');
  if(parts.length<3){vres.textContent='Token tidak valid.';vres.className='small text-error';return;}
  vres.textContent='Memverifikasi...';vres.className='text-sm opacity-60';
  try{
    var key=toU8(b64url(btoa(s))).buffer;
    var alg={name:'HMAC',hash:{name:'SHA-256'}};
    var sig=await crypto.subtle.importKey('raw',key,alg,false,['verify']);
    var ok=await crypto.subtle.verify(alg,sig,toU8(b64url(parts[2])),new TextEncoder().encode(parts[0]+'.'+parts[1]));
    vres.textContent=ok?'? Signature valid!':'? Signature TIDAK valid (secret salah?)';
    vres.className='small '+(ok?'text-success':'text-error');
  }catch(e){
    vres.textContent='Gagal verifikasi. Mungkin bukan HS256 atau format salah.';vres.className='small text-warning';
  }
});
</script>

