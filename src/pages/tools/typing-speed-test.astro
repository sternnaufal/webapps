---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Typing Speed Test';
const description = 'Tes kecepatan mengetik online. Ukur WPM (words per minute), akurasi, dan waktu.';
const keywords = 'typing speed test, test kecepatan mengetik, wpm test, typing test indonesia';
const aboutText = 'Typing speed test online untuk mengukur kecepatan dan akurasi mengetik Anda. Alat ini menampilkan teks acak Bahasa Indonesia yang harus diketik dalam batas waktu tertentu (15, 30, atau 60 detik). Hasil tes mencakup WPM (Words Per Minute), akurasi persentase, dan jumlah karakter benar/salah.';
const aboutExtra = 'WPM (Words Per Minute) dihitung dengan standar internasional: 1 word = 5 karakter. Skor WPM umum: &lt;30 lambat, 30-40 rata-rata, 40-60 baik, 60-80 cepat, &gt;80 expert. Akurasi dihitung dari jumlah karakter benar dibagi total karakter yang diketik. Fokus pada akurasi tinggi terlebih dahulu, kecepatan akan meningkat dengan latihan rutin.';
const relatedTools = [
  { slug: 'timer', name: 'Timer', icon: '⏱' },
  { slug: 'stopwatch', name: 'Stopwatch', icon: '⏱' },
  { slug: 'word-counter', name: 'Word Counter', icon: '#' },
  { slug: 'char-counter', name: 'Character Counter', icon: '#' },
];
const toolCss = `.typing-text{font-family:monospace;font-size:1.05rem;line-height:1.8;letter-spacing:0.5px;padding:1rem;border-radius:8px;background:oklch(0.9 0.005 270);user-select:none}.typing-text .correct{color:#22c55e}.typing-text .wrong{color:#ef4444;text-decoration:underline}.typing-text .current{background:#6366f1;color:#fff;border-radius:2px}.result-stat{text-align:center;padding:0.6rem;border-radius:8px;background:oklch(0.9 0.005 270)}.result-stat .value{font-size:1.5rem;font-weight:700}.result-stat .label{font-size:0.7rem;text-transform:uppercase;opacity:0.5}`;
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="flex flex-wrap gap-4">
    <div class="lg:w-8/12 w-full">
      <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
        <div class="flex justify-between items-center mb-3">
          <select id="durationSelect" class="select select-bordered select-sm">
            <option value="15">15 detik</option>
            <option value="30" selected>30 detik</option>
            <option value="60">60 detik</option>
            <option value="120">2 menit</option>
          </select>
          <span class="text-xs opacity-60 font-mono" id="timerDisplay">30s</span>
        </div>
        <div class="typing-text" id="textDisplay"></div>
        <textarea id="userInput" class="textarea textarea-bordered w-full text-sm font-mono mt-3" rows="2" placeholder="Ketik di sini..." disabled></textarea>
        <div class="flex gap-2 mt-3">
          <button id="btnStart" class="btn btn-primary btn-sm">Mulai Tes</button>
          <button id="btnReset" class="btn btn-ghost btn-sm">Reset</button>
        </div>
        <div id="resultsArea" class="grid grid-cols-4 gap-2 mt-3" style="display:none">
          <div class="result-stat"><div class="value" id="wpmDisplay">0</div><div class="label">WPM</div></div>
          <div class="result-stat"><div class="value" id="accDisplay">0%</div><div class="label">Akurasi</div></div>
          <div class="result-stat"><div class="value" id="timeDisplay">0s</div><div class="label">Waktu</div></div>
          <div class="result-stat"><div class="value" id="charDisplay">0/0</div><div class="label">Benar/Salah</div></div>
        </div>
      </div>
    </div>
    <div class="lg:w-4/12 w-full">
      <div class="rounded-xl p-4" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
        <div class="text-xs font-medium opacity-60 mb-3">Skor WPM</div>
        <div class="text-xs space-y-1">
          <div>&lt; 30: <span class="opacity-50">Pemula</span></div>
          <div>30-40: <span class="opacity-60">Rata-rata</span></div>
          <div>40-60: <span class="text-success">Baik</span></div>
          <div>60-80: <span class="text-primary">Cepat</span></div>
          <div>80-100: <span class="text-secondary">Sangat Cepat</span></div>
          <div>&gt; 100: <span class="font-bold text-secondary">Expert</span></div>
        </div>
      </div>
      <div class="rounded-xl p-4 mt-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
        <div class="text-xs font-medium opacity-60 mb-3">Tips</div>
        <ul class="text-xs space-y-1 opacity-70">
          <li>Fokus pada akurasi, bukan kecepatan</li>
          <li>Gunakan semua jari untuk mengetik</li>
          <li>Posisi tangan rileks di home row</li>
          <li>Latihan rutin 10 menit per hari</li>
        </ul>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<style is:inline>{toolCss}</style>

<script is:inline>
// Long paragraphs for typing practice
var TEXTS = [
  "Pada suatu hari di sebuah desa kecil yang terletak di kaki gunung hiduplah seorang pemuda bernama Raka. Ia dikenal sebagai pemuda yang rajin dan tekun dalam bekerja. Setiap pagi sebelum matahari terbit ia sudah bangun untuk membantu orang tuanya di sawah. Walaupun hidup sederhana Raka selalu bersyukur dan tidak pernah mengeluh. Ia percaya bahwa kerja keras dan kesabaran akan membuahkan hasil yang manis di kemudian hari. Semangatnya yang tinggi membuat banyak orang di desa itu kagum dan menjadikannya contoh bagi anak-anak muda lainnya.",
  "Perkembangan teknologi digital telah mengubah cara manusia berkomunikasi bekerja dan menjalani kehidupan sehari-hari. Dulu untuk mengirim pesan orang harus menulis surat dan menunggu berhari-hari bahkan berminggu-minggu. Sekarang dengan adanya internet dan smartphone komunikasi bisa dilakukan dalam hitungan detik. Kemajuan ini membawa banyak manfaat namun juga tantangan tersendiri seperti berkurangnya interaksi tatap muka dan masalah privasi data. Oleh karena itu penting bagi kita untuk menggunakan teknologi secara bijak dan bertanggung jawab.",
  "Olahraga memiliki banyak manfaat bagi kesehatan tubuh dan pikiran. Dengan berolahraga secara teratur sirkulasi darah menjadi lancar otot-otot lebih kuat dan sistem kekebalan tubuh meningkat. Selain itu olahraga juga membantu mengurangi stres dan kecemasan karena saat berolahraga tubuh melepaskan hormon endorfin yang membuat perasaan lebih bahagia. Tidak perlu olahraga berat jalan kaki santai selama tiga puluh menit setiap hari sudah cukup untuk menjaga kebugaran tubuh. Yang terpenting adalah konsistensi bukan intensitasnya.",
  "Indonesia adalah negara kepulauan terbesar di dunia dengan lebih dari tujuh belas ribu pulau yang membentang dari Sabang sampai Merauke. Kekayaan alam dan budayanya sangat beragam mulai dari suku bangsa bahasa daerah rumah adat tarian tradisional hingga kuliner khas masing-masing daerah. Keberagaman ini adalah aset berharga yang harus dijaga dan dilestarikan. Salah satu cara untuk melestarikannya adalah dengan mengenalkan budaya Indonesia kepada generasi muda sejak dini melalui pendidikan formal maupun kegiatan ekstrakurikuler.",
  "Membaca adalah jendela dunia sebuah ungkapan yang sangat tepat karena dengan membaca kita bisa mengetahui berbagai informasi dan pengetahuan dari seluruh dunia tanpa harus bepergian. Buku merupakan sumber ilmu yang tidak ada habisnya untuk digali. Semakin banyak kita membaca semakin luas wawasan dan pemahaman kita tentang berbagai hal. Membaca juga dapat melatih kemampuan berpikir kritis menganalisis informasi dan meningkatkan kosakata. Oleh karena itu biasakanlah membaca minimal lima belas menit setiap hari untuk meningkatkan kualitas diri.",
  "Pemanasan global atau global warming adalah fenomena meningkatnya suhu rata-rata bumi akibat efek rumah kaca yang disebabkan oleh aktivitas manusia seperti pembakaran bahan bakar fosil penggundulan hutan dan polusi industri. Dampak dari pemanasan global sangat serius mulai dari mencairnya es di kutub naiknya permukaan air laut perubahan iklim ekstrem hingga punahnya berbagai spesies hewan dan tumbuhan. Untuk mengatasi masalah ini diperlukan kerja sama dari semua pihak pemerintah dunia usaha dan masyarakat untuk beralih ke energi terbarukan dan menjalani gaya hidup ramah lingkungan.",
  "Seni adalah ekspresi jiwa seseorang yang dituangkan dalam berbagai bentuk seperti lukisan musik tari teater dan sastra. Setiap orang memiliki cara yang berbeda-beda dalam mengekspresikan perasaannya melalui seni. Ada yang meluapkan emosinya melalui goresan kuas di atas kanvas ada juga yang menuangkan imajinasinya melalui rangkaian kata-kata indah dalam sebuah puisi. Seni tidak hanya berfungsi sebagai hiburan tetapi juga sebagai media komunikasi kritik sosial dan dokumentasi sejarah. Tanpa seni kehidupan manusia akan terasa hampa dan monoton.",
  "Pendidikan adalah investasi jangka panjang yang sangat penting bagi masa depan seseorang dan bangsa. Melalui pendidikan seseorang dapat mengembangkan potensi diri memperoleh pengetahuan dan keterampilan yang dibutuhkan untuk meraih kesuksesan. Pemerintah Indonesia telah mencanangkan program wajib belajar dua belas tahun untuk memastikan setiap warga negara mendapatkan akses pendidikan yang layak. Namun masih banyak tantangan yang harus dihadapi seperti kualitas guru yang merata infrastruktur sekolah yang memadai dan biaya pendidikan yang terjangkau bagi semua kalangan.",
  "Kesehatan mental sama pentingnya dengan kesehatan fisik. Sayangnya masih banyak orang yang mengabaikan kesehatan mental karena stigma dan kurangnya pemahaman. Padahal gangguan kesehatan mental seperti stres depresi dan kecemasan bisa menyerang siapa saja tanpa memandang usia atau latar belakang. Penting untuk menyadari bahwa mencari bantuan profesional seperti konseling atau terapi bukanlah suatu kelemahan melainkan langkah berani untuk menjadi lebih baik. Istirahat yang cukup makan bergizi dan menjalin hubungan sosial yang positif juga dapat menjaga kesehatan mental.",
  "Revolusi industri keempat yang dikenal dengan istilah Industri 4.0 ditandai dengan integrasi teknologi digital ke dalam berbagai aspek kehidupan termasuk dunia kerja. Kecerdasan buatan atau artificial intelligence internet of things robotika dan big data adalah beberapa teknologi yang mengubah cara kita bekerja dan berproduksi. Banyak pekerjaan tradisional yang mulai digantikan oleh mesin dan otomatisasi. Oleh karena itu penting bagi setiap individu untuk terus belajar mengembangkan keterampilan baru dan beradaptasi dengan perubahan agar tidak tertinggal oleh kemajuan zaman.",
  // Shorter sentences for variety (used when testing on mobile or quick mode)
  "Kucing itu duduk di atas tikar sambil menikmati sinar matahari pagi yang hangat. Belajar coding memang tidak mudah tapi sangat menyenangkan jika sudah terbiasa. Internet menghubungkan miliaran orang di seluruh dunia dalam hitungan detik. Kopi hitam tanpa gula adalah minuman favorit para programmer di pagi hari. Musik klasik dapat membantu meningkatkan konsentrasi saat belajar atau bekerja.",
  "Matahari terbit di timur dan tenggelam di barat setiap hari tanpa henti. Teknologi blockchain mengubah cara kita bertransaksi dan menyimpan data. Olahraga teratur baik untuk kesehatan jantung dan kebugaran tubuh secara umum. Bahasa Indonesia adalah bahasa persatuan yang digunakan di seluruh Nusantara. Gunung berapi terbentuk dari lelehan batuan panas yang naik ke permukaan bumi."
];

var dS=document.getElementById('durationSelect'),tD=document.getElementById('timerDisplay'),
  txD=document.getElementById('textDisplay'),uI=document.getElementById('userInput'),
  bS=document.getElementById('btnStart'),bR=document.getElementById('btnReset'),
  rA=document.getElementById('resultsArea'),wD=document.getElementById('wpmDisplay'),
  aD=document.getElementById('accDisplay'),tiD=document.getElementById('timeDisplay'),
  cD=document.getElementById('charDisplay');

var fullText='',pos=0,correctChars=0,wrongChars=0,started=false,finished=false,
  startTime=0,duration=30,timerInt=null,remaining=0;

function pickText() {
  // Pick a long paragraph (first 10 are long, last 2 are short)
  var i = Math.floor(Math.random() * 10); // bias toward long texts
  fullText = TEXTS[i];
  // Sometimes combine two for even longer text
  if (Math.random() < 0.3) {
    fullText += ' ' + TEXTS[Math.floor(Math.random() * 10)];
  }
  txD.innerHTML = '';
  for (var j = 0; j < fullText.length; j++) {
    var s = document.createElement('span');
    s.textContent = fullText[j];
    if (j === 0) s.className = 'current';
    txD.appendChild(s);
  }
  if (fullText.length > 0) {
    var fc = txD.querySelector('.current');
    if (fc) fc.scrollIntoView({block: 'nearest'});
  }
}

function resetTest() {
  clearInterval(timerInt);
  started = false; finished = false;
  uI.disabled = true; uI.value = '';
  bS.disabled = false; bS.textContent = 'Mulai Tes';
  rA.style.display = 'none';
  duration = parseInt(dS.value) || 30;
  remaining = duration;
  tD.textContent = remaining + 's';
  pickText();
  pos = 0; correctChars = 0; wrongChars = 0;
}

dS.addEventListener('change', function() { if (!started) resetTest(); });

function startTest() {
  if (started || finished) return;
  started = true;
  uI.disabled = false; uI.focus();
  startTime = Date.now();
  bS.disabled = true; bS.textContent = 'Berlangsung...';
  remaining = duration;
  timerInt = setInterval(function() {
    remaining--;
    tD.textContent = Math.max(0, remaining) + 's';
    if (remaining <= 0) endTest();
  }, 1000);
}

function endTest() {
  finished = true;
  clearInterval(timerInt);
  uI.disabled = true;
  bS.textContent = 'Selesai';
  var elapsed = (Date.now() - startTime) / 1000;
  var totalTyped = correctChars + wrongChars;
  var wpm = elapsed > 0 ? Math.round((correctChars / 5) / (elapsed / 60)) : 0;
  var acc = totalTyped > 0 ? Math.round(correctChars / totalTyped * 100) : 0;
  wD.textContent = wpm;
  aD.textContent = acc + '%';
  tiD.textContent = elapsed.toFixed(1) + 's';
  cD.textContent = correctChars + '/' + wrongChars;
  rA.style.display = 'grid';
}

uI.addEventListener('input', function() {
  if (!started || finished) return;
  var val = this.value;
  var lastIdx = val.length - 1;
  if (lastIdx < 0) return;
  if (lastIdx >= fullText.length) return;

  var spans = txD.querySelectorAll('span');
  
  // Cek apakah karakter baru sesuai atau salah
  if (val[lastIdx] === fullText[lastIdx]) {
    if (spans[lastIdx]) spans[lastIdx].className = 'correct';
    correctChars++;
  } else {
    if (spans[lastIdx]) spans[lastIdx].className = 'wrong';
    wrongChars++;
  }

  // Update span yang sudah diketik sebelumnya
  for (var i = 0; i <= lastIdx; i++) {
    if (i < lastIdx) {
      if (val[i] === fullText[i]) {
        if (spans[i]) spans[i].className = 'correct';
      } else {
        if (spans[i]) spans[i].className = 'wrong';
      }
    }
    // current position
    if (i === lastIdx && i + 1 < fullText.length) {
      if (spans[i + 1]) spans[i + 1].className = 'current';
    }
  }

  pos = lastIdx + 1;
});

bS.addEventListener('click', startTest);
bR.addEventListener('click', resetTest);
resetTest();
</script>
