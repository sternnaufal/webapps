---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Memorable Password Generator';
const desc = 'Buat password kuat yang mudah diingat. Gabungkan kata-kata acak jadi frasa yang aman tapi mudah diingat.';
const keywords = 'memorable password, password phrase, easy password, word password, xkcd password';
const aboutText = 'Memorable Password Generator Memorable Password Generator online. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'password-generator', name: 'Password Generator', icon: '🔑' },
  { slug: 'password-strength', name: 'Password Strength', icon: '💪' },
  { slug: 'rsa-generator', name: 'Rsa Generator', icon: '🔒' },
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' }
];
const bodyHtml = '<div class="flex flex-wrap gap-4">\n  <div class="w-full"><div class="card card-bordered bg-base-100 p-4 text-center mb-3"><div id="mpOut" class="text-3xl font-bold font-bold mb-2 font-mono" style="word-break:break-word;font-size:clamp(1.2rem,4vw,2.5rem)">correcthorsebatterystaple</div><div class="flex justify-center gap-2"><button id="mpGen" class="btn btn-warning rounded-full px-4">Generate</button><button id="mpCopy" class="btn btn-outline rounded-full px-3">Copy</button></div></div></div>\n  <div class="md:w-1/3 w-full"><div class="card card-bordered bg-base-100 p-3 small">\n    <h6 class="font-semibold mb-2">Settings</h6>\n    <div class="mb-2"><label class="label-text">Words</label><input type="range" id="mpCnt" class="range range-sm" min="2" max="8" value="4"><div class="flex justify-between"><span>2</span><span id="mpCntVal">4</span><span>8</span></div></div>\n    <div class="mb-2"><select id="mpSep" class="select select-bordered w-full select select-bordered w-full-sm"><option value="-">Hyphen (-)</option><option value="." selected>Dot (.)</option><option value="_">Underscore (_)</option><option value="">None</option></select></div>\n    <div class="flex items-center gap-2"><input class="checkbox" type="checkbox" id="mpCap" checked><label class="flex items-center gap-2-label" for="mpCap">Capitalize</label></div>\n    <div class="flex items-center gap-2"><input class="checkbox" type="checkbox" id="mpNum" checked><label class="flex items-center gap-2-label" for="mpNum">Add number</label></div>\n  </div></div>\n  <div class="md:w-2/3 w-full"><div class="card card-bordered bg-base-100 p-3 small">\n    <h6 class="font-semibold mb-2">Password Strength</h6>\n    <table class="table table-sm mb-0"><tbody>\n      <tr><td class="opacity-60">Panjang</td><td id="mpLen" class="font-semibold">25</td><td>karakter</td></tr>\n      <tr><td class="opacity-60">Entropy</td><td id="mpEnt" class="font-semibold">44</td><td>bits</td></tr>\n      <tr><td class="opacity-60">Kekuatan</td><td id="mpStr" class="font-semibold text-success">Strong</td><td><span id="mpTime" class="text-sm opacity-60">~years</span></td></tr>\n    </tbody></table>\n  </div></div>\n</div>';
---

<ToolLayout title={title} description=&#123;desc&#125; keywords={keywords}>
<Fragment set:html=&#123;bodyHtml&#125; />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float{position:fixed;bottom:24px;right:24px;z-index:9999;background:#ff6b6b;color:oklch(1 0 0);border-radius:50px;padding:10px 20px 10px 16px;text-decoration:none;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;box-shadow:0 4px 15px rgba(255,107,107,0.4);transition:all .3s ease;font-family:"Inter",sans-serif}
.saweria-float:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(255,107,107,0.6);color:oklch(1 0 0)}
.saweria-float svg{animation:pulse 1.5s ease infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
@media(max-width:576px){.saweria-float{bottom:16px;right:16px;padding:8px 14px 8px 10px;font-size:12px}}
</style>

<script is:inline>
const MPW=["correct","horse","battery","staple","apple","banana","cherry","dragon","eagle","forest","garden","hunter","island","jungle","knight","lemon","mountain","noble","ocean","piano","queen","river","silver","tiger","umbrella","velvet","winter","yellow","zebra","abstract","balance","crystal","diamond","emerald","flame","goblin","horizon","jasmine","kettle","lantern","marble","nebula","orbit","pepper","shadow","thunder","unique","violet","walnut","cactus","dawn","ember","frost","garnet","helix","iris","jade","koala","lunar","mango","nectar","onyx","polar","quest","ruby","solar","topaz","ultra","venus","aurora","bloom","comet","drift","echo","flair","glide","haven","ivory","joker","karma","lime","mellow","novel","olive","prism","rapid","sable","tango","ulna","vivid","wisp","amber","birch","coral","dusk","elm","fawn","gale","haze","kiwi","lark","mint","nova","oak","pine","reed","sage","tide","vale","wren","yarn","zest","acorn","blaze","creek","dune","edge","fern","grove","hollow","kelp","loom","meadow","nook","palm","ridge","spark","thaw","whisper","cedar","delta","ember","flint","gully","harbor","ivy","knoll","lilac","marsh","pearl","rye","shale","tarn","umbra","vine","warp","azure","basin","cove","fjord","geode","haven","isle","knot","loam","musk","nave","opal","slate","talc","vale"];
function mpGen(){const cnt=parseInt(document.getElementById("mpCnt").value);const sep=document.getElementById("mpSep").value;const cap=document.getElementById("mpCap").checked;const num=document.getElementById("mpNum").checked;const sel=[];const used=new Set();while(sel.length<cnt){const w=MPW[Math.floor(Math.random()*MPW.length)];if(!used.has(w)){used.add(w);sel.push(cap?w.charAt(0).toUpperCase()+w.slice(1):w)}}let pwd=sel.join(sep);if(num)pwd+=Math.floor(Math.random()*999);document.getElementById("mpOut").textContent=pwd;document.getElementById("mpLen").textContent=pwd.length;const bits=cnt*Math.log2(MPW.length);document.getElementById("mpEnt").textContent=bits.toFixed(0);const s=document.getElementById("mpStr");if(bits<30){s.textContent="Weak";s.style.color="#ef4444";document.getElementById("mpTime").textContent="instant"}else if(bits<45){s.textContent="Fair";s.style.color="#f59e0b";document.getElementById("mpTime").textContent="~hours"}else if(bits<60){s.textContent="Strong";s.style.color="#10b981";document.getElementById("mpTime").textContent="~years"}else{s.textContent="Very Strong";s.style.color="#059669";document.getElementById("mpTime").textContent="~centuries"}}
document.getElementById("mpGen").onclick=mpGen;document.getElementById("mpCopy").onclick=()=>navigator.clipboard.writeText(document.getElementById("mpOut").textContent);
document.getElementById("mpCnt").oninput=function(){document.getElementById("mpCntVal").textContent=this.value;mpGen()};
document.getElementById("mpSep").onchange=mpGen;document.getElementById("mpCap").onchange=mpGen;document.getElementById("mpNum").onchange=mpGen;mpGen();
</script>

