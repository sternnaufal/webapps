---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Image Resizer & Compressor';
const desc = 'Resize dan kompres gambar online. Ubah ukuran, kualitas, dan format gambar tanpa upload ke server.';
const keywords = 'image resizer, resize image, compress image, image optimizer, ubah ukuran gambar';
const aboutText = 'Image Resizer & Compressor Image Resizer & Compressor online. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'image-to-base64', name: 'Image To Base64', icon: '🖼' },
  { slug: 'color-picker', name: 'Color Picker', icon: '🎨' },
  { slug: 'screen-recorder', name: 'Screen Recorder', icon: '⏺' },
  { slug: 'qr-generator', name: 'Qr Generator', icon: '▐▌' }
];
const bodyHtml = '<div class="flex flex-wrap gap-4">\n  <div class="w-full">\n    <div id="irDrop" class="card card-bordered bg-base-100 p-5 text-center" style="border:2px dashed #ccc;border-radius:12px;cursor:pointer"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5" class="mb-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg><p class="mb-1 font-semibold">Drop gambar di sini atau klik untuk upload</p><p class="text-sm opacity-60 mb-0">JPG, PNG, WebP, GIF, BMP</p><input type="file" id="irFile" accept="image/*" style="display:none"></div>\n  </div>\n  <div id="irPanels" style="display:none" class="w-full">\n    <div class="flex flex-wrap gap-4">\n      <div class="md:w-1/3 w-full"><div class="card card-bordered bg-base-100 p-2 text-center"><label class="label-text small font-semibold">Original</label><img id="irOrig" style="max-width:100%;max-height:150px" class="rounded"><div class="text-sm opacity-60 mt-1"><span id="irOrigSize">0</span> KB</div></div></div>\n      <div class="md:w-1/3 w-full"><div class="card card-bordered bg-base-100 p-2 text-center"><label class="label-text small font-semibold">Preview</label><img id="irPrev" style="max-width:100%;max-height:150px" class="rounded"><div class="text-sm opacity-60 mt-1"><span id="irNewSize">0</span> KB <span id="irSaved" class="text-success ms-1"></span></div></div></div>\n      <div class="md:w-1/3 w-full"><div class="card card-bordered bg-base-100 p-3 small">\n        <h6 class="font-semibold mb-2">Settings</h6>\n        <div class="mb-2"><label class="label-text">Width (px)</label><input type="number" id="irW" class="input input-bordered w-full input input-bordered w-full-sm" value="800" min="1"></div>\n        <div class="mb-2"><label class="label-text">Height (px, 0=auto)</label><input type="number" id="irH" class="input input-bordered w-full input input-bordered w-full-sm" value="0" min="0"></div>\n        <div class="mb-2"><label class="label-text">Quality <span id="irQVal">80%</span></label><input type="range" id="irQ" class="range range-sm" min="10" max="100" value="80"></div>\n        <div class="mb-2"><select id="irFmt" class="select select-bordered w-full select select-bordered w-full-sm"><option value="image/png">PNG</option><option value="image/jpeg" selected>JPEG</option><option value="image/webp">WebP</option></select></div>\n        <div class="flex items-center gap-2 mb-2"><input class="checkbox" type="checkbox" id="irRatio" checked><label class="flex items-center gap-2-label small" for="irRatio">Keep ratio</label></div>\n        <button id="irApply" class="btn btn-warning btn-sm w-full">Apply</button>\n        <a id="irDl" class="btn btn-outline btn-sm w-full mt-1" download="resized.png">Download</a>\n      </div></div>\n    </div>\n  </div>\n</div>';
---

<ToolLayout title={title} description=&#123;desc&#125; keywords={keywords}>
<Fragment set:html=&#123;bodyHtml&#125; />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float{position:fixed;bottom:24px;right:24px;z-index:9999;background:#ff6b6b;color:#fff;border-radius:50px;padding:10px 20px 10px 16px;text-decoration:none;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;box-shadow:0 4px 15px rgba(255,107,107,0.4);transition:all .3s ease;font-family:"Inter",sans-serif}
.saweria-float:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(255,107,107,0.6);color:#fff}
.saweria-float svg{animation:pulse 1.5s ease infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
@media(max-width:576px){.saweria-float{bottom:16px;right:16px;padding:8px 14px 8px 10px;font-size:12px}}
</style>

<script is:inline>
let irFileObj=null;const dz=document.getElementById("irDrop");dz.onclick=()=>document.getElementById("irFile").click();dz.ondragover=e=>&#123;e.preventDefault();dz.style.borderColor="#6366f1";dz.style.background="rgba(99,102,241,.05)"&#125;;dz.ondragleave=()=>&#123;dz.style.borderColor="#ccc";dz.style.background=""&#125;;dz.ondrop=e=>&#123;e.preventDefault();dz.style.borderColor="#ccc";dz.style.background="";const f=e.dataTransfer.files[0];if(f&&f.type.startsWith("image/"))irLoad(f)&#125;;
document.getElementById("irFile").onchange=e=>&#123;if(e.target.files[0])irLoad(e.target.files[0])&#125;;
document.getElementById("irQ").oninput=function()&#123;document.getElementById("irQVal").textContent=this.value+"%"&#125;;
document.getElementById("irApply").onclick=irResize;
document.getElementById("irW").oninput=function()&#123;if(document.getElementById("irRatio").checked&&irFileObj)&#123;const img=new Image();img.onload=()=>&#123;document.getElementById("irH").value=Math.round(img.naturalHeight*(parseInt(document.getElementById("irW").value)||0)/img.naturalWidth)&#125;;img.src=URL.createObjectURL(irFileObj)&#125;&#125;
document.getElementById("irFmt").onchange=e=>&#123;document.getElementById("irDl").download="resized."+e.target.value.split("/")[1]&#125;;
function irLoad(f)&#123;irFileObj=f;const r=new FileReader();r.onload=function(e)&#123;document.getElementById("irOrig").src=e.target.result;document.getElementById("irOrigSize").textContent=(f.size/1024).toFixed(1);document.getElementById("irPanels").style.display="";const img=new Image();img.onload=function()&#123;document.getElementById("irW").value=img.naturalWidth;document.getElementById("irH").value=img.naturalHeight&#125;;img.src=e.target.result&#125;;r.readAsDataURL(f)&#125;
function irResize()&#123;if(!irFileObj)return;const w=parseInt(document.getElementById("irW").value)||0;const h=parseInt(document.getElementById("irH").value)||0;const q=parseInt(document.getElementById("irQ").value)/100;const fmt=document.getElementById("irFmt").value;const img=new Image();img.onload=function()&#123;const c=document.createElement("canvas");c.width=w;c.height=h||Math.round(img.naturalHeight*(w/img.naturalWidth));const ctx=c.getContext("2d");ctx.imageSmoothingQuality="high";ctx.drawImage(img,0,0,c.width,c.height);c.toBlob(function(b)&#123;const url=URL.createObjectURL(b);document.getElementById("irPrev").src=url;document.getElementById("irNewSize").textContent=(b.size/1024).toFixed(1);const svd=((irFileObj.size-b.size)/irFileObj.size*100).toFixed(1);document.getElementById("irSaved").textContent=svd>0?"-"+svd+"%":"+"+svd+"%";const dl=document.getElementById("irDl");dl.href=url&#125;,fmt,q)&#125;;img.src=URL.createObjectURL(irFileObj)&#125;
</script>

