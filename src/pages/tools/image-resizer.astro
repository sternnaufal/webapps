---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Image Resizer & Compressor';
const desc = 'Resize dan kompres gambar online. Ubah ukuran, kualitas, dan format gambar tanpa upload ke server.';
const keywords = 'image resizer, resize image, compress image, image optimizer, ubah ukuran gambar';
const aboutText = 'Image Resizer & Compressor Image Resizer & Compressor online. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'image-to-base64', name: 'Image To Base64', icon: '🖼' },
  { slug: 'color-picker', name: 'Color Picker', icon: '🎨' },
  { slug: 'screen-recorder', name: 'Screen Recorder', icon: '⏺' },
  { slug: 'qr-generator', name: 'Qr Generator', icon: '▐▌' }
];
---

<ToolLayout title={title} description={desc} keywords={keywords}>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{desc}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="w-full">
    <div class="rounded-xl p-5 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;" id="irDrop">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5" class="mb-2 mx-auto"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <p class="mb-1 text-sm font-medium">Drop gambar di sini atau klik untuk upload</p>
      <p class="text-xs opacity-60 mb-0">JPG, PNG, WebP, GIF, BMP</p>
      <input type="file" id="irFile" accept="image/*" style="display:none">
    </div>
  </div>
  <div id="irPanels" style="display:none" class="w-full">
    <div class="flex flex-wrap gap-4">
      <div class="md:w-1/3 w-full">
        <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
          <span class="text-xs font-medium opacity-60 mb-1 block">Original</span>
          <img id="irOrig" style="max-width:100%;max-height:150px" class="mx-auto rounded">
          <div class="text-xs opacity-60 mt-1"><span id="irOrigSize">0</span> KB</div>
        </div>
      </div>
      <div class="md:w-1/3 w-full">
        <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
          <span class="text-xs font-medium opacity-60 mb-1 block">Preview</span>
          <img id="irPrev" style="max-width:100%;max-height:150px" class="mx-auto rounded">
          <div class="text-xs opacity-60 mt-1"><span id="irNewSize">0</span> KB <span id="irSaved" class="text-green-600 ml-1"></span></div>
        </div>
      </div>
      <div class="md:w-1/3 w-full">
        <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
          <div class="text-xs font-medium opacity-60 mb-2">Settings</div>
          <div class="mb-2"><label class="text-xs font-medium opacity-60 mb-1 block">Width (px)</label><input type="number" id="irW" class="input input-bordered w-full input-sm" value="800" min="1"></div>
          <div class="mb-2"><label class="text-xs font-medium opacity-60 mb-1 block">Height (px, 0=auto)</label><input type="number" id="irH" class="input input-bordered w-full input-sm" value="0" min="0"></div>
          <label class="flex items-center gap-2 text-xs mb-2"><input type="checkbox" id="irRatio" class="checkbox checkbox-sm" checked> Maintain ratio</label>
          <div class="mb-2"><label class="text-xs font-medium opacity-60 mb-1 block">Quality</label><input type="range" id="irQ" class="range range-sm w-full" min="10" max="100" value="80"><span id="irQVal" class="text-xs opacity-60">80%</span></div>
          <div class="mb-2"><label class="text-xs font-medium opacity-60 mb-1 block">Format</label>
            <select id="irFmt" class="select select-bordered w-full select-sm">
              <option value="image/jpeg">JPEG</option>
              <option value="image/png">PNG</option>
              <option value="image/webp" selected>WebP</option>
            </select>
          </div>
          <div class="flex gap-2">
            <button id="irApply" class="btn btn-primary btn-sm flex-1">Terapkan</button>
            <a id="irDl" class="btn btn-ghost btn-sm flex-1" download="resized.webp">Download</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
let irFileObj=null;const dz=document.getElementById("irDrop");dz.onclick=()=>document.getElementById("irFile").click();dz.ondragover=e=>{e.preventDefault();dz.style.borderColor="#6366f1";dz.style.background="rgba(99,102,241,.05)"};dz.ondragleave=()=>{dz.style.borderColor="oklch(0.9 0.005 270)";dz.style.background=""};dz.ondrop=e=>{e.preventDefault();dz.style.borderColor="oklch(0.9 0.005 270)";dz.style.background="";const f=e.dataTransfer.files[0];if(f&&f.type.startsWith("image/"))irLoad(f)};
document.getElementById("irFile").onchange=e=>{if(e.target.files[0])irLoad(e.target.files[0])};
document.getElementById("irQ").oninput=function(){document.getElementById("irQVal").textContent=this.value+"%"};
document.getElementById("irApply").onclick=irResize;
document.getElementById("irW").oninput=function(){if(document.getElementById("irRatio").checked&&irFileObj){const img=new Image();img.onload=()=>{document.getElementById("irH").value=Math.round(img.naturalHeight*(parseInt(document.getElementById("irW").value)||0)/img.naturalWidth)};img.src=URL.createObjectURL(irFileObj)}}
document.getElementById("irFmt").onchange=e=>{document.getElementById("irDl").download="resized."+e.target.value.split("/")[1]};
function irLoad(f){irFileObj=f;const r=new FileReader();r.onload=function(e){document.getElementById("irOrig").src=e.target.result;document.getElementById("irOrigSize").textContent=(f.size/1024).toFixed(1);document.getElementById("irPanels").style.display="";const img=new Image();img.onload=function(){document.getElementById("irW").value=img.naturalWidth;document.getElementById("irH").value=img.naturalHeight};img.src=e.target.result};r.readAsDataURL(f)}
function irResize(){if(!irFileObj)return;const w=parseInt(document.getElementById("irW").value)||0;const h=parseInt(document.getElementById("irH").value)||0;const q=parseInt(document.getElementById("irQ").value)/100;const fmt=document.getElementById("irFmt").value;const img=new Image();img.onload=function(){const c=document.createElement("canvas");c.width=w;c.height=h||Math.round(img.naturalHeight*(w/img.naturalWidth));const ctx=c.getContext("2d");ctx.imageSmoothingQuality="high";ctx.drawImage(img,0,0,c.width,c.height);c.toBlob(function(b){const url=URL.createObjectURL(b);document.getElementById("irPrev").src=url;document.getElementById("irNewSize").textContent=(b.size/1024).toFixed(1);const svd=((irFileObj.size-b.size)/irFileObj.size*100).toFixed(1);document.getElementById("irSaved").textContent=svd>0?"-"+svd+"%":"+"+svd+"%";const dl=document.getElementById("irDl");dl.href=url},fmt,q)};img.src=URL.createObjectURL(irFileObj)}
</script>