---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Barcode Generator';
const description = 'Barcode generator online gratis. Buat barcode CODE128, EAN-13, EAN-8, UPC-A, CODE39, ITF-14, Codabar, Pharmacode. Download PNG/SVG.';
const keywords = 'barcode generator, generate barcode, barcode maker, code128, ean13, upc, barcode online gratis';
const aboutText = 'Barcode Generator Barcode generator online gratis. Buat barcode CODE128, EAN-13, EAN-8, UPC-A, CODE39, ITF-14, Codabar, Pharmacode. Download PNG/SVG.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'qr-generator', name: 'Qr Generator', icon: '▐▌' },
  { slug: 'avatar-generator', name: 'Avatar Generator', icon: '👤' },
  { slug: 'password-generator', name: 'Password Generator', icon: '🔑' },
  { slug: 'uuid-generator', name: 'Uuid Generator', icon: '🆔' }
];

const toolCss = `
    .barcode-output { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 20px; text-align: center; min-height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .barcode-output svg { max-width: 100%; height: auto; }
    .barcode-output .error-msg { color: #ef4444; font-weight: 600; }
    .opt-row { display: flex; flex-wrap: wrap; gap: 10px; }
    .opt-row > * { flex: 1; min-width: 100px; }
    @media (max-width: 576px) { .opt-row > * { min-width: 80px; } }
  `;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0f9ff;color:#0369a1;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="4" y1="5" x2="4" y2="19"/><line x1="7" y1="5" x2="7" y2="19"/><line x1="10" y1="5" x2="10" y2="19"/><line x1="13" y1="5" x2="13" y2="19"/><line x1="16" y1="5" x2="16" y2="19"/><line x1="19" y1="5" x2="19" y2="19"/></svg></div><div><h1 class="h3 mb-0">Barcode Generator</h1><p class="opacity-60 small mb-0">Generate barcode dengan berbagai format. Download PNG/SVG.</p></div></header>

<div class="flex flex-wrap gap-4">
<div class="lg:w-7/12 w-full">
<div class="card card-bordered bg-base-100 p-3">
<h6 class="font-semibold mb-3">Input</h6>
<div class="row gap-2 mb-3">
<div class="md:w-2/3 w-full"><label class="label-text small font-semibold">Nilai</label><input type="text" id="barcodeValue" class="input input-bordered w-full" value="1234567890128" placeholder="Masukkan nilai barcode..."></div>
<div class="md:w-1/3 w-full"><label class="label-text small font-semibold">Format</label><select id="barcodeFormat" class="select select-bordered w-full">
<option value="CODE128">CODE128 (auto)</option>
<option value="CODE128A">CODE128 A</option>
<option value="CODE128B">CODE128 B</option>
<option value="CODE128C">CODE128 C</option>
<option value="EAN13" selected>EAN-13</option>
<option value="EAN8">EAN-8</option>
<option value="UPC">UPC-A</option>
<option value="UPCE">UPC-E</option>
<option value="CODE39">CODE39</option>
<option value="ITF14">ITF-14</option>
<option value="ITF">ITF</option>
<option value="Codabar">Codabar</option>
<option value="CODE93">CODE93</option>
<option value="MSI">MSI</option>
<option value="pharmacode">Pharmacode</option>
</select></div>
</div>
<div class="opt-row mb-3">
<div><label class="label-text small">Width</label><input type="number" id="barWidth" class="input input-bordered w-full input input-bordered w-full-sm" value="2" min="1" max="10" step="0.5"></div>
<div><label class="label-text small">Height</label><input type="number" id="barHeight" class="input input-bordered w-full input input-bordered w-full-sm" value="80" min="10" max="500"></div>
<div><label class="label-text small">Margin</label><input type="number" id="barMargin" class="input input-bordered w-full input input-bordered w-full-sm" value="10" min="0" max="100"></div>
<div><label class="label-text small">Font Size</label><input type="number" id="barFontSize" class="input input-bordered w-full input input-bordered w-full-sm" value="16" min="6" max="80"></div>
</div>
<div class="opt-row mb-3">
<div><label class="label-text small">Line Color</label><input type="color" id="barLineColor" class="input input-bordered w-full input input-bordered w-full-color input input-bordered w-full-sm" value="#000000"></div>
<div><label class="label-text small">Background</label><input type="color" id="barBgColor" class="input input-bordered w-full input input-bordered w-full-color input input-bordered w-full-sm" value="#ffffff"></div>
<div class="flex align-items-end pb-1"><div class="flex items-center gap-2"><input type="checkbox" id="barShowVal" class="checkbox" checked><label class="flex items-center gap-2-label small" for="barShowVal">Tampilkan teks</label></div></div>
</div>
<button id="btnGenerate" class="btn btn-primary w-full">Generate Barcode</button>
</div>
<div id="barcodeOutput" class="barcode-output card shadow-sm border-0 mt-3">
<svg id="barcodeSvg"></svg>
</div>
<div class="flex gap-2 mt-2 flex-wrap">
<button id="btnPng" class="btn btn-outline-primary btn-sm">Download PNG</button>
<button id="btnSvg" class="btn btn-outline btn-sm">Download SVG</button>
<button id="btnCopy" class="btn btn-outline btn-sm">Copy Gambar</button>
</div>
</div>
<div class="lg:w-5/12 w-full">
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Quick Presets</h6>
<div class="flex gap-2 flex-wrap mb-3">
<button class="btn btn-outline-primary btn-sm preset" data-val="9781234567897" data-fmt="EAN13">Buku (EAN-13)</button>
<button class="btn btn-outline-primary btn-sm preset" data-val="4901234567890" data-fmt="EAN13">Produk (EAN-13)</button>
<button class="btn btn-outline-primary btn-sm preset" data-val="12345678" data-fmt="EAN8">Kecil (EAN-8)</button>
<button class="btn btn-outline-primary btn-sm preset" data-val="72527273070" data-fmt="CODE39">CODE39</button>
<button class="btn btn-outline-primary btn-sm preset" data-val="Hello World" data-fmt="CODE128">Teks (CODE128)</button>
<button class="btn btn-outline-primary btn-sm preset" data-val="1234567890128" data-fmt="EAN13">EAN-13</button>
</div>
<div class="text-sm opacity-60">Tips: EAN-13 butuh 12-13 digit. CODE128 menerima teks dan angka. Pharmacode hanya angka.</div>
</div>
</div></div>


<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>
<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var valInp=document.getElementById('barcodeValue'),fmtInp=document.getElementById('barcodeFormat');
var wInp=document.getElementById('barWidth'),hInp=document.getElementById('barHeight'),mInp=document.getElementById('barMargin');
var fsInp=document.getElementById('barFontSize'),lcInp=document.getElementById('barLineColor'),bgInp=document.getElementById('barBgColor');
var svInp=document.getElementById('barShowVal'),svgEl=document.getElementById('barcodeSvg'),outDiv=document.getElementById('barcodeOutput');

function getOptions()&#123;
  return &#123;
    format: fmtInp.value,
    width: parseFloat(wInp.value)||2,
    height: parseInt(hInp.value)||80,
    margin: parseInt(mInp.value)||10,
    fontSize: parseInt(fsInp.value)||16,
    lineColor: lcInp.value,
    background: bgInp.value,
    displayValue: svInp.checked
  &#125;;
&#125;

function validateInput(val,fmt)&#123;
  if(!val)&#123;return 'Nilai tidak boleh kosong';&#125;
  if(fmt==='EAN13'||fmt==='EAN13')&#123;if(!/^\d&#123;12,13&#125;$/.test(val))return 'EAN-13 harus 12-13 digit angka'&#125;
  if(fmt==='EAN8')&#123;if(!/^\d&#123;7,8&#125;$/.test(val))return 'EAN-8 harus 7-8 digit angka'&#125;
  if(fmt==='UPC')&#123;if(!/^\d&#123;11,12&#125;$/.test(val))return 'UPC-A harus 11-12 digit angka'&#125;
  if(fmt==='UPCE')&#123;if(!/^\d&#123;7,8&#125;$/.test(val))return 'UPC-E harus 7-8 digit angka'&#125;
  if(fmt==='ITF14')&#123;if(!/^\d&#123;13,14&#125;$/.test(val))return 'ITF-14 harus 13-14 digit angka'&#125;
  if(fmt==='pharmacode')&#123;if(!/^\d+$/.test(val))return 'Pharmacode hanya menerima angka'&#125;
  return null;
&#125;

function generate()&#123;
  var val=valInp.value.trim(),fmt=fmtInp.value;
  var err=validateInput(val,fmt);
  if(err)&#123;
    outDiv.innerHTML='<div class="error-msg">'+err+'</div>';
    return;
  &#125;
  outDiv.innerHTML='<svg id="barcodeSvg"></svg>';
  var svg=document.getElementById('barcodeSvg');
  try&#123;
    JsBarcode(svg,val,getOptions());
  &#125;catch(e)&#123;
    outDiv.innerHTML='<div class="error-msg">Error: '+e.message+'</div>';
  &#125;
&#125;

document.getElementById('btnGenerate').addEventListener('click',generate);

document.getElementById('btnPng').addEventListener('click',function()&#123;
  var svg=document.getElementById('barcodeSvg');
  if(!svg||!svg.getBBox)return;
  var b=svg.getBBox(),pad=5;
  var c=document.createElement('canvas');
  c.width=b.width+pad*2;c.height=b.height+pad*2;
  var ctx=c.getContext('2d');
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,c.width,c.height);
  var img=new Image();
  var s=new XMLSerializer();
  var svgStr=s.serializeToString(svg);
  img.onload=function()&#123;
    ctx.drawImage(img,pad,pad);
    c.toBlob(function(blob)&#123;
      var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='barcode.png';a.click();
    &#125;,'image/png');
  &#125;;
  img.src='data:image/svg+xml;base64,'+btoa(unescape(encodeURIComponent(svgStr)));
&#125;);

document.getElementById('btnSvg').addEventListener('click',function()&#123;
  var svg=document.getElementById('barcodeSvg');
  if(!svg||!svg.getBBox)return;
  var s=new XMLSerializer(),svgStr=s.serializeToString(svg);
  var a=document.createElement('a');a.href='data:image/svg+xml;base64,'+btoa(unescape(encodeURIComponent(svgStr)));a.download='barcode.svg';a.click();
&#125;);

document.getElementById('btnCopy').addEventListener('click',function()&#123;
  var svg=document.getElementById('barcodeSvg');
  if(!svg||!svg.getBBox)return;
  var s=new XMLSerializer(),svgStr=s.serializeToString(svg);
  navigator.clipboard.write([
    new ClipboardItem(&#123;'image/svg+xml':new Blob([svgStr],&#123;type:'image/svg+xml'&#125;)&#125;)
  ]).then(function()&#123;showToast('Gambar disalin ke clipboard');&#125;).catch(function()&#123;showToast('Gagal menyalin');&#125;);
&#125;);

document.querySelectorAll('.preset').forEach(function(el)&#123;el.addEventListener('click',function()&#123;
  valInp.value=this.dataset.val;fmtInp.value=this.dataset.fmt;generate();
&#125;)&#125;);

function showToast(m)&#123;
  var t=document.createElement('div');t.className='toast items-center text-bg-light border p-2';
  t.style.position='fixed';t.style.right='20px';t.style.bottom='20px';t.style.zIndex=9999;
  t.innerHTML='<div class="flex"><div class="toast-body">'+m+'</div><button type="button" class="btn-close btn-close-white mr-2 m-auto" aria-label="Close"></button></div>';
  document.body.appendChild(t);
  t.querySelector('.btn-close').addEventListener('click',function()&#123;t.remove();&#125;);
  setTimeout(function()&#123;t.remove();&#125;,2500);
&#125;

valInp.addEventListener('keydown',function(e)&#123;if(e.key==='Enter')generate()&#125;);
generate();
</script>

