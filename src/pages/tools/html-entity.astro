---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'HTML Entity Encoder/Decoder';
const description = 'Encode dan decode HTML entities online. Konversi &lt; &gt; &amp; &quot; ke entity HTML.';
const keywords = 'html entity encoder, html entity decoder, html escape, html unescape, special characters';
const aboutText = 'HTML Entity Encoder/Decoder Encode dan decode HTML entities online. Konversi &lt; &gt; &amp; &quot; ke entity HTML.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'url-encode', name: 'Url Encode', icon: '%' },
  { slug: 'base64-coded', name: 'Base64 Coded', icon: 'B64' },
  { slug: 'html-preview', name: 'Html Preview', icon: '</>' },
  { slug: 'slug-generator', name: 'Slug Generator', icon: '🔗' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#fefce8;color:#ca8a04;">&amp;</div><div><h1 class="h3 mb-0">HTML Entity Encoder / Decoder</h1><p class="opacity-60 small mb-0">Encode atau decode karakter khusus HTML seperti &lt;, &gt;, &amp;, &quot; menjadi entity HTML.</p></div></header>
<div class="flex flex-wrap gap-4">
<div class="col-lg-6"><label class="label-text font-semibold">Input</label>
<textarea id="inputArea" class="input input-bordered w-full font-mono" rows="8" placeholder="Paste teks..." autofocus>&lt;div class="container"&gt;
  &lt;h1&gt;Hello &amp; Welcome!&lt;/h1&gt;
  &lt;p&gt;Harga: Rp 50.000 &amp; diskon 20%&lt;/p&gt;
&lt;/div&gt;</textarea>
<div class="flex gap-2 mt-2 flex-wrap">
<button id="btnEncode" class="btn btn-primary">Encode</button>
<button id="btnDecode" class="btn btn-success">Decode</button>
<button id="btnClear" class="btn btn-outline-danger">Clear</button>
<button id="btnSwap" class="btn btn-outline">Swap Input ? Output</button>
</div></div>
<div class="col-lg-6"><div class="flex justify-between items-center mb-1"><label class="label-text font-semibold mb-0">Output</label><button id="btnCopy" class="btn btn-sm btn-outline-secondary">Copy</button></div>
<textarea id="outputArea" class="input input-bordered w-full font-mono" rows="8" readonly></textarea>
<div class="mt-2">
<div class="flex items-center gap-2 flex items-center gap-2-inline"><input type="radio" name="encodeMode" id="modeNamed" class="checkbox" checked><label class="flex items-center gap-2-label small" for="modeNamed">Named (&amp;nbsp;)</label></div>
<div class="flex items-center gap-2 flex items-center gap-2-inline"><input type="radio" name="encodeMode" id="modeNumeric" class="checkbox"><label class="flex items-center gap-2-label small" for="modeNumeric">Numeric (&amp;#160;)</label></div>
<div class="flex items-center gap-2 flex items-center gap-2-inline"><input type="radio" name="encodeMode" id="modeHex" class="checkbox"><label class="flex items-center gap-2-label small" for="modeHex">Hex (&amp;#xA0;)</label></div>
</div></div></div>
<div class="row mt-4"><div class="w-full">
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Referensi Cepat HTML Entities</h6>
<div class="overflow-x-auto"><table class="table table-sm small mb-0"><thead><tr><th>Karakter</th><th>Entity</th><th>Deskripsi</th><th>Karakter</th><th>Entity</th><th>Deskripsi</th></tr></thead><tbody id="entityTable"></tbody></table></div></div>
</div></div>
`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var inp=document.getElementById('inputArea'),out=document.getElementById('outputArea');

var namedEntities={
  '&amp;':'&','&lt;':'<','&gt;':'>','&quot;':'"','&apos;':"'",'&nbsp;':'\\xa0','&copy;':'','&reg;':'','&trade;':'','&euro;':'','&pound;':'','&yen;':'','&cent;':'','&sect;':'','&deg;':'','&plusmn;':'','&times;':'','&divide;':'','&micro;':'','&middot;':'','&bull;':'','&hellip;':'','&prime;':''','&Prime;':'?','&larr;':'?','&rarr;':'?','&uarr;':'?','&darr;':'?','&harr;':'?','&spades;':'?','&clubs;':'?','&hearts;':'?','&diams;':'?','&there4;':'?','&permil;':'','&sum;':'?','&prod;':'?','&radic;':'v','&infin;':'8','&int;':'?','&asymp;':'','&ne;':'?','&equiv;':'=','&le;':'=','&ge;':'=','&nabla;':'?','&alpha;':'a','&beta;':'','&gamma;':'?','&delta;':'d','&pi;':'p','&omega;':'?',
};
var namedToChar={};for(var k in namedEntities)namedToChar[namedEntities[k]]=k;

function getMode(){return document.querySelector('input[name=encodeMode]:checked').id}

function encode(){
  var t=inp.value,mode=getMode();
  var r='';
  for(var i=0;i<t.length;i++){
    var c=t[i],code=t.charCodeAt(i);
    if(c==='&'){r+='&amp;';continue}
    if(c==='<'){r+='&lt;';continue}
    if(c==='>'){r+='&gt;';continue}
    if(c==='"'){r+='&quot;';continue}
    if(c==="'"){r+='&apos;';continue}
    if(code>127||code<32){
      if(mode==='modeNamed'&&namedToChar[c]){r+=namedToChar[c];continue}
      if(mode==='modeNumeric'){r+='&#'+code+';';continue}
      if(mode==='modeHex'){r+='&#x'+code.toString(16).toUpperCase()+';';continue}
    }
    r+=c;
  }
  out.value=r;
}

function decode(){
  var t=inp.value;
  t=t.replace(/&amp;/g,'&');
  t=t.replace(/&lt;/g,'<');
  t=t.replace(/&gt;/g,'>');
  t=t.replace(/&quot;/g,'"');
  t=t.replace(/&apos;/g,"'");
  t=t.replace(/&#x([0-9a-fA-F]+);/g,function(m,h){return String.fromCodePoint(parseInt(h,16))});
  t=t.replace(/&#(\\d+);/g,function(m,d){return String.fromCodePoint(parseInt(d))});
  for(var e in namedEntities){
    t=t.split(e).join(namedEntities[e]);
  }
  out.value=t;
}

document.getElementById('btnEncode').addEventListener('click',encode);
document.getElementById('btnDecode').addEventListener('click',decode);
document.getElementById('btnClear').addEventListener('click',function(){inp.value='';out.value=''});
document.getElementById('btnSwap').addEventListener('click',function(){var t=inp.value;inp.value=out.value;out.value=t});
document.getElementById('btnCopy').addEventListener('click',function(){
  if(!out.value)return;var b=this;
  navigator.clipboard.writeText(out.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)});
});
document.querySelectorAll('input[name=encodeMode]').forEach(function(r){r.addEventListener('change',encode)});

var refs=[['&amp;','&','&lt;','<','&gt;','>','&quot;','"','&apos;','&#39;',"'",'&nbsp;',' '],
  ['&copy;','','&reg;','','&trade;','','&euro;','','&pound;','','&yen;','','&cent;',''],
  ['&sect;','','&deg;','','&plusmn;','','&times;','','&divide;','','&micro;','','&middot;',''],
  ['&bull;','','&hellip;','','&larr;','?','&rarr;','?','&uarr;','?','&darr;','?','&harr;','?'],
  ['&spades;','?','&clubs;','?','&hearts;','?','&diams;','?','&sum;','?','&prod;','?','&radic;','v'],
  ['&infin;','8','&asymp;','','&ne;','?','&equiv;','=','&le;','=','&ge;','=','&alpha;','a']];
var et=document.getElementById('entityTable');
refs.forEach(function(r){
  et.innerHTML+='<tr><td class="font-mono">'+r[1]+'</td><td class="font-mono">'+r[0]+'</td><td>'+r[0].slice(1,-1)+'</td><td class="font-mono">'+r[3]+'</td><td class="font-mono">'+r[2]+'</td><td>'+r[2].slice(1,-1)+'</td></tr>';
});
</script>

