---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'ASCII Table';
const description = 'Tabel ASCII lengkap 0-127 (0x00-0x7F). Lihat kode desimal, heksadesimal, biner, dan karakter. Cocok untuk programmer dan pelajar.';
const keywords = 'ascii table, tabel ascii, ascii codes, ascii chart, kode ascii, character codes';
const aboutText = 'ASCII Table Tabel ASCII lengkap 0-127 (0x00-0x7F). Lihat kode desimal, heksadesimal, biner, dan karakter. Cocok untuk programmer dan pelajar.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'char-counter', name: 'Char Counter', icon: '#' },
  { slug: 'word-counter', name: 'Word Counter', icon: '⚡' },
  { slug: 'morse-code-converter', name: 'Morse Code Converter', icon: '···' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f5f3ff;color:#8b5cf6;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><polyline points="9 12 11 14 15 10"/></svg></div><div><h1 class="h3 mb-0">ASCII Table</h1><p class="opacity-60 small mb-0">Tabel kode ASCII lengkap 0&ndash;127. Desimal, heksadesimal, biner, dan karakter.</p></div></header>

<div class="flex flex-wrap gap-3 mb-4">
<div class="md:w-2/3 w-full">
<input type="text" id="asciiSearch" class="input input-bordered w-full" placeholder="Cari kode atau karakter (misal: A, 65, 0x41, null, space, CR)..." autofocus>
</div>
<div class="md:w-1/3 w-full flex gap-2 items-center">
<select id="filterCat" class="select select-bordered w-full">
<option value="all">Semua</option>
<option value="control">Control (0-31, 127)</option>
<option value="print">Printable (32-126)</option>
</select>
<span class="text-sm opacity-60" id="rowCount">128 / 128</span>
</div>
</div>

<div class="card shadow-sm border-0" style="max-height: 600px; overflow-y: auto;">
<table class="table table-sm table-zebra ascii-table mb-0">
<thead>
<tr><th>Desimal</th><th>Hex</th><th>Biner</th><th>Karakter</th><th>Keterangan</th></tr>
</thead>
<tbody id="asciiBody"></tbody>
</table>
</div>

`;
const toolCss = `
    .ascii-table { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace; font-size: 0.8rem; }
    .ascii-table th { position: sticky; top: 0; background: var(--surface-soft); z-index: 1; }
    .ascii-table td, .ascii-table th { padding: 4px 10px; text-align: center; vertical-align: middle; }
    .ascii-table tbody tr:hover { background: rgba(99,102,241,.08); }
    td.ctrl { color: #ef4444; font-weight: 600; }
    td.print { color: #22c55e; font-weight: 600; }
    td.ext { color: #6366f1; font-weight: 600; }
  `;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>
<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
var ctrlNames = [
  'NUL','SOH','STX','ETX','EOT','ENQ','ACK','BEL','BS','HT','LF','VT','FF','CR','SO','SI',
  'DLE','DC1','DC2','DC3','DC4','NAK','SYN','ETB','CAN','EM','SUB','ESC','FS','GS','RS','US'
];

function asciiChar(i) {
  if (i === 32) return 'SP';
  if (i === 127) return 'DEL';
  if (i >= 33 && i <= 126) return String.fromCharCode(i);
  return ctrlNames[i] || '';
}

function asciiDesc(i) {
  var descs = {
    0:'Null byte', 1:'Start of Heading', 2:'Start of Text', 3:'End of Text',
    4:'End of Transmission', 5:'Enquiry', 6:'Acknowledgment', 7:'Bell',
    8:'Backspace', 9:'Horizontal Tab', 10:'Line Feed', 11:'Vertical Tab',
    12:'Form Feed', 13:'Carriage Return', 14:'Shift Out', 15:'Shift In',
    16:'Data Link Escape', 17:'Device Control 1', 18:'Device Control 2', 19:'Device Control 3',
    20:'Device Control 4', 21:'Negative Ack', 22:'Synchronous Idle', 23:'End of Trans. Block',
    24:'Cancel', 25:'End of Medium', 26:'Substitute', 27:'Escape',
    28:'File Separator', 29:'Group Separator', 30:'Record Separator', 31:'Unit Separator',
    32:'Spasi', 127:'Delete'
  };
  return descs[i] || '';
}

function buildRow(i) {
  var ch = asciiChar(i);
  var desc = asciiDesc(i);
  var isCtrl = i < 32 || i === 127;
  var isPrint = i >= 32 && i <= 126;
  var cls = isCtrl ? 'ctrl' : (isPrint ? 'print' : '');
  var display = i === 32 ? '\\u2423' : (i === 127 ? '\\u2421' : ch);
  return '<tr data-dec="' + i + '" data-hex="0x' + i.toString(16).toUpperCase().padStart(2,'0') + '" data-char="' + ch + '" data-desc="' + desc + '" data-cat="' + (isCtrl?'control':'print') + '">' +
    '<td>' + i + '</td>' +
    '<td>0x' + i.toString(16).toUpperCase().padStart(2,'0') + '</td>' +
    '<td>' + i.toString(2).padStart(8,'0') + '</td>' +
    '<td class="' + cls + '">' + display + '</td>' +
    '<td class="text-sm opacity-60">' + (desc || '&mdash;') + '</td></tr>';
}

var allRows = [];
for (var i = 0; i < 128; i++) allRows.push(buildRow(i));

function render(rows) {
  document.getElementById('asciiBody').innerHTML = rows.join('');
  document.getElementById('rowCount').textContent = rows.length + ' / 128';
}

render(allRows);

var searchTimer;
document.getElementById('asciiSearch').addEventListener('input', function() {
  clearTimeout(searchTimer);
  var self = this;
  searchTimer = setTimeout(function() {
    var q = self.value.toLowerCase().trim();
    var cat = document.getElementById('filterCat').value;
    var filtered = allRows.filter(function(r) {
      var el = document.createElement('tr');
      el.innerHTML = r;
      if (cat !== 'all' && el.dataset.cat !== cat) return false;
      if (!q) return true;
      return el.dataset.dec.indexOf(q) === 0 ||
             el.dataset.hex.toLowerCase().indexOf(q) !== -1 ||
             el.dataset.char.toLowerCase().indexOf(q) !== -1 ||
             el.dataset.desc.toLowerCase().indexOf(q) !== -1;
    });
    render(filtered);
  }, 150);
});

document.getElementById('filterCat').addEventListener('change', function() {
  document.getElementById('asciiSearch').dispatchEvent(new Event('input'));
});

function showToast(message) {
  var t = document.createElement('div');
  t.className = 'toast items-center text-bg-light border p-2';
  t.style.position = 'fixed'; t.style.right = '20px'; t.style.bottom = '20px'; t.style.zIndex = 9999;
  t.innerHTML = '<div class="flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white mr-2 m-auto" aria-label="Close"></button></div>';
  document.body.appendChild(t);
  t.querySelector('.btn-close').addEventListener('click', function() { t.remove(); });
  setTimeout(function() { t.remove(); }, 2500);
}
</script>

