---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Meta Tag Generator';
const description = 'Generate meta tags SEO untuk website. Generator meta description, Open Graph, Twitter Card, dan meta viewport. Copy paste langsung.';
const keywords = 'meta tag generator, SEO meta tags, og generator, meta description generator';
const aboutText = 'Generator meta tag SEO online untuk membuat meta description, Open Graph (OG), Twitter Card, canonical URL, dan meta robots secara instan. Alat ini membantu website owner, content creator, dan SEO specialist mengoptimalkan halaman web untuk social media sharing dan mesin pencari.';
const aboutExtra = 'Isi form untuk Page Title, Meta Description, Keywords, Open Graph (title, description, image, URL), Twitter Card, Canonical URL, dan Robots. Klik Generate untuk melihat output HTML yang siap dicopy-paste ke tag &lt;head&gt; website. Semua pemrosesan dilakukan 100% di browser, data tidak dikirim ke server mana pun.';
const relatedTools = [
  { slug: 'slug-generator', name: 'Slug Generator', icon: '🔗' },
  { slug: 'html-entity', name: 'HTML Entity Encoder', icon: '&' },
  { slug: 'html-preview', name: 'HTML Preview', icon: '</>' },
  { slug: 'json-formatter', name: 'JSON Formatter', icon: '{}' }
];

---

<ToolLayout title={title} description={description} keywords={keywords}>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <h6 class="text-sm font-semibold mb-3">Basic SEO</h6>
      <div class="mb-2">
        <label for="mt-title" class="text-xs font-medium opacity-60 mb-1 block">Page Title</label>
        <input id="mt-title" class="input input-bordered w-full input-sm" placeholder="Judul halaman">
      </div>
      <div class="mb-2">
        <label for="mt-desc" class="text-xs font-medium opacity-60 mb-1 block">Meta Description</label>
        <textarea id="mt-desc" class="textarea textarea-bordered w-full text-sm" rows="2" placeholder="Deskripsi halaman, max 160 karakter"></textarea>
      </div>
      <div class="mb-2">
        <label for="mt-keywords" class="text-xs font-medium opacity-60 mb-1 block">Keywords (pisah koma)</label>
        <input id="mt-keywords" class="input input-bordered w-full input-sm" placeholder="keyword1, keyword2">
      </div>

      <h6 class="text-sm font-semibold mt-4 mb-3">Open Graph</h6>
      <div class="mb-2">
        <label for="og-title" class="text-xs font-medium opacity-60 mb-1 block">OG Title</label>
        <input id="og-title" class="input input-bordered w-full input-sm" placeholder="Kosongi biar pake Page Title">
      </div>
      <div class="mb-2">
        <label for="og-desc" class="text-xs font-medium opacity-60 mb-1 block">OG Description</label>
        <textarea id="og-desc" class="textarea textarea-bordered w-full text-sm" rows="2" placeholder="Kosongi biar pake Meta Description"></textarea>
      </div>
      <div class="mb-2">
        <label for="og-image" class="text-xs font-medium opacity-60 mb-1 block">OG Image URL</label>
        <input id="og-image" class="input input-bordered w-full input-sm" placeholder="https://example.com/image.png">
      </div>
      <div class="mb-2">
        <label for="og-url" class="text-xs font-medium opacity-60 mb-1 block">OG URL</label>
        <input id="og-url" class="input input-bordered w-full input-sm" placeholder="https://example.com/page">
      </div>

      <h6 class="text-sm font-semibold mt-4 mb-3">Twitter Card</h6>
      <div class="mb-2">
        <label for="tw-title" class="text-xs font-medium opacity-60 mb-1 block">Twitter Title</label>
        <input id="tw-title" class="input input-bordered w-full input-sm" placeholder="Kosongi biar pake OG Title">
      </div>
      <div class="mb-2">
        <label for="tw-desc" class="text-xs font-medium opacity-60 mb-1 block">Twitter Description</label>
        <textarea id="tw-desc" class="textarea textarea-bordered w-full text-sm" rows="2" placeholder="Kosongi biar pake OG Description"></textarea>
      </div>

      <h6 class="text-sm font-semibold mt-4 mb-3">Lainnya</h6>
      <div class="mb-2">
        <label for="mt-canonical" class="text-xs font-medium opacity-60 mb-1 block">Canonical URL</label>
        <input id="mt-canonical" class="input input-bordered w-full input-sm" placeholder="https://example.com/page">
      </div>
      <div class="flex items-center gap-2 mb-2">
        <input type="checkbox" id="mt-robots" class="checkbox checkbox-sm" checked>
        <label class="text-xs font-medium opacity-60" for="mt-robots">Index, follow</label>
      </div>
      <div class="mb-2">
        <label for="og-sitename" class="text-xs font-medium opacity-60 mb-1 block">Site Name</label>
        <input id="og-sitename" class="input input-bordered w-full input-sm" placeholder="Nama situs">
      </div>

      <button id="btnGenerate" class="btn btn-primary btn-sm w-full mt-2">Generate</button>
    </div>

    <div>
      <div class="flex justify-between items-center mb-2">
        <h6 class="text-sm font-semibold mb-0">Output HTML</h6>
        <button id="btnCopy" class="btn btn-ghost btn-xs">Copy All</button>
      </div>
      <div id="output" class="rounded-lg p-3 text-xs font-mono" style="min-height: 200px; white-space: pre-wrap; word-break: break-all; background:oklch(0.96 0.003 270);border:1px solid oklch(0.9 0.005 270);">&lt;!-- Isi form di sebelah kiri, lalu klik Generate --&gt;</div>
    </div>
  </div>

</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
function esc(t) { return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

document.getElementById('btnGenerate').addEventListener('click', function() {
  var title = esc(document.getElementById('mt-title').value.trim());
  var desc = esc(document.getElementById('mt-desc').value.trim());
  var keywords = esc(document.getElementById('mt-keywords').value.trim());
  var ogTitle = esc(document.getElementById('og-title').value.trim()) || title;
  var ogDesc = esc(document.getElementById('og-desc').value.trim()) || desc;
  var ogImage = esc(document.getElementById('og-image').value.trim());
  var ogUrl = esc(document.getElementById('og-url').value.trim());
  var ogSitename = esc(document.getElementById('og-sitename').value.trim());
  var twTitle = esc(document.getElementById('tw-title').value.trim()) || ogTitle;
  var twDesc = esc(document.getElementById('tw-desc').value.trim()) || ogDesc;
  var canonical = esc(document.getElementById('mt-canonical').value.trim());
  var robots = document.getElementById('mt-robots').checked ? 'index, follow' : 'noindex, nofollow';

  var lines = [];

  lines.push('&lt;meta charset="UTF-8" /&gt;');
  lines.push('&lt;meta name="viewport" content="width=device-width, initial-scale=1.0" /&gt;');
  if (title) lines.push('&lt;title&gt;' + title + '&lt;/title&gt;');
  if (desc) lines.push('&lt;meta name="description" content="' + desc + '" /&gt;');
  if (keywords) lines.push('&lt;meta name="keywords" content="' + keywords + '" /&gt;');
  lines.push('&lt;meta name="robots" content="' + robots + '" /&gt;');
  if (canonical) lines.push('&lt;link rel="canonical" href="' + canonical + '" /&gt;');
  lines.push('');

  // OG
  lines.push('&lt;!-- Open Graph --&gt;');
  if (ogTitle) lines.push('&lt;meta property="og:title" content="' + ogTitle + '" /&gt;');
  if (ogDesc) lines.push('&lt;meta property="og:description" content="' + ogDesc + '" /&gt;');
  if (ogUrl) lines.push('&lt;meta property="og:url" content="' + ogUrl + '" /&gt;');
  lines.push('&lt;meta property="og:type" content="website" /&gt;');
  if (ogImage) lines.push('&lt;meta property="og:image" content="' + ogImage + '" /&gt;');
  lines.push('&lt;meta property="og:locale" content="id_ID" /&gt;');
  if (ogSitename) lines.push('&lt;meta property="og:site_name" content="' + ogSitename + '" /&gt;');
  if (ogImage) {
    lines.push('&lt;meta property="og:image:width" content="1200" /&gt;');
    lines.push('&lt;meta property="og:image:height" content="630" /&gt;');
  }
  lines.push('');

  // Twitter
  lines.push('&lt;!-- Twitter Card --&gt;');
  lines.push('&lt;meta name="twitter:card" content="summary_large_image" /&gt;');
  if (twTitle) lines.push('&lt;meta name="twitter:title" content="' + twTitle + '" /&gt;');
  if (twDesc) lines.push('&lt;meta name="twitter:description" content="' + twDesc + '" /&gt;');
  if (ogImage) lines.push('&lt;meta name="twitter:image" content="' + ogImage + '" /&gt;');

  document.getElementById('output').innerHTML = lines.join('\\n');
});

document.getElementById('btnCopy').addEventListener('click', function() {
  var text = document.getElementById('output').innerText;
  navigator.clipboard.writeText(text).then(function() { showToast('Copied to clipboard', 'success'); });
});

function showToast(message) {
  var t = document.createElement('div');
  t.className = 'toast items-center text-bg-light border p-2';
  t.style.position = 'fixed'; t.style.right = '20px'; t.style.bottom = '20px'; t.style.zIndex = 9999;
  t.innerHTML = '<div class="flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white mr-2 m-auto" aria-label="Close"></button></div>';
  document.body.appendChild(t);
  t.querySelector('.btn-close').addEventListener('click', function() { t.remove(); });
  setTimeout(function() { t.remove(); }, 2500);
}
</script>