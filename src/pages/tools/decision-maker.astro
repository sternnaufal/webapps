---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Decision Maker';
const description = 'Decision maker online. Acak pilihan, lempar koin, dadu, dan Magic 8 Ball untuk bantu keputusan.';
const keywords = 'decision maker, random picker, coin flip, dice roller, magic 8 ball, acak pilihan';
const aboutText = 'Decision Maker Decision maker online. Acak pilihan, lempar koin, dadu, dan Magic 8 Ball untuk bantu keputusan.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'dice-roller', name: 'Dice Roller', icon: '🎲' },
  { slug: 'random-number-generator', name: 'Random Number Generator', icon: '🎲' },
  { slug: 'palindrome-checker', name: 'Palindrome Checker', icon: '↔' },
  { slug: 'anagram-finder', name: 'Anagram Finder', icon: '🔀' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="md:w-1/2 w-full">
    <div class="rounded-xl p-5 mb-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Random Picker</div>
      <textarea id="pickerInput" class="textarea textarea-bordered w-full text-sm font-mono mb-2" rows="4" placeholder="Masukkan pilihan, satu per baris...">Nasi Goreng
Mie Ayam
Sate Ayam
Bakso
Pizza</textarea>
      <button id="btnPick" class="btn btn-primary btn-sm w-full">Acak Pilihan!</button>
      <div id="pickResult" class="mt-3 text-center text-lg font-bold" style="color:#6366f1"></div>
    </div>
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Ya / Tidak</div>
      <div class="text-center">
        <div id="ynResult" class="text-3xl font-bold mb-3" style="color:#6366f1">?</div>
        <button id="btnYN" class="btn btn-primary btn-sm px-5">Jawab!</button>
      </div>
    </div>
  </div>
  <div class="md:w-1/2 w-full">
    <div class="grid grid-cols-2 gap-3 mb-3">
      <div class="rounded-xl p-5 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
        <div class="text-xs font-medium opacity-60 mb-2">Koin</div>
        <div id="coinResult" class="text-3xl mb-2">?</div>
        <button id="btnCoin" class="btn btn-ghost btn-sm">Lempar!</button>
      </div>
      <div class="rounded-xl p-5 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
        <div class="text-xs font-medium opacity-60 mb-2">Dadu</div>
        <div id="diceResult" class="text-3xl mb-2">?</div>
        <button id="btnDice" class="btn btn-ghost btn-sm">Lempar!</button>
      </div>
    </div>
    <div class="rounded-xl p-5 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Magic 8 Ball</div>
      <div class="eight-ball" id="eightBall"><div class="eight-ball-inner" id="eightText">8</div></div>
      <div id="eightMsg" class="text-xs opacity-60 mt-2">Klik bola untuk bertanya</div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.eight-ball{width:120px;height:120px;border-radius:50%;background:var(--color-base-300);margin:0 auto;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 20px rgba(0,0,0,.3);transition:transform .2s}.eight-ball:hover{transform:scale(1.05)}.eight-ball-inner{width:60px;height:60px;border-radius:50%;background:var(--color-base-100);display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:800;color:var(--color-base-content)}.eight-ball.shake{animation:shakeBall .3s}@keyframes shakeBall{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
</style>

<script is:inline>
document.getElementById('btnPick').addEventListener('click',function(){
  var lines=document.getElementById('pickerInput').value.split('\n').filter(function(l){return l.trim()});
  if(!lines.length){document.getElementById('pickResult').textContent='Masukkan pilihan dulu!';return}
  document.getElementById('pickResult').textContent=lines[Math.floor(Math.random()*lines.length)];
});
document.getElementById('btnYN').addEventListener('click',function(){
  var answers=['Ya!','Tidak.','Mungkin','Coba lagi nanti','Pasti!','Jangan dulu','Terserah kamu','Iya sih','Kayaknya nggak deh','100% Ya!','No way!','Kenapa nggak?'];
  var el=document.getElementById('ynResult');el.textContent=answers[Math.floor(Math.random()*answers.length)];
  el.style.transform='scale(1.2)';setTimeout(function(){el.style.transform='scale(1)'},200);
});
var coinFaces=['?','?'];
document.getElementById('btnCoin').addEventListener('click',function(){
  document.getElementById('coinResult').textContent=coinFaces[Math.floor(Math.random()*2)];
});
var dice=[1,2,3,4,5,6];
document.getElementById('btnDice').addEventListener('click',function(){
  var el=document.getElementById('diceResult');el.textContent=dice[Math.floor(Math.random()*6)];
  el.style.transform='rotate(360deg)';setTimeout(function(){el.style.transform='rotate(0)'},300);
});
var eightAnswers=['It is certain','It is decidedly so','Without a doubt','Yes definitely','You may rely on it','As I see it, yes','Most likely','Outlook good','Yes','Signs point to yes','Reply hazy try again','Ask again later','Better not tell you now','Cannot predict now','Concentrate and ask again','Don\'t count on it','My reply is no','My sources say no','Outlook not so good','Very doubtful'];
document.getElementById('eightBall').addEventListener('click',function(){
  var el=document.getElementById('eightText'),msg=document.getElementById('eightMsg');
  el.textContent='?';msg.textContent='...';
  var ball=this;ball.classList.add('shake');
  setTimeout(function(){
    el.textContent=Math.floor(Math.random()*20+1);
    ball.classList.remove('shake');
  },300);
  setTimeout(function(){
    var answer=eightAnswers[Math.floor(Math.random()*eightAnswers.length)];
    el.textContent='';msg.textContent=answer;
    el.innerHTML='<span style="font-size:0.7rem;padding:4px">'+answer+'</span>';
  },600);
});
</script>