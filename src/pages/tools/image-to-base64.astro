---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Image to Base64';
const description = 'Konversi gambar ke Base64 online. Upload gambar dan dapatkan Base64 string untuk CSS/HTML.';
const keywords = 'image to base64, base64 image, convert image, img to base64';
const aboutText = 'Converter mengubah file gambar menjadi string Base64 data URI yang dapat digunakan langsung di CSS (background-image), HTML (img src), atau kode aplikasi.';
const aboutExtra = 'Konversi gambar ke Base64 sangat berguna untuk mengurangi jumlah HTTP request pada website dengan menyematkan gambar langsung ke dalam kode. Cocok untuk ikon kecil, logo, atau gambar yang perlu di-embed dalam CSS, HTML, atau JavaScript. Mendukung format PNG, JPG, GIF, WebP, dan SVG. Cukup drag & drop file gambar atau klik untuk memilih file, dan string Base64 akan langsung tersedia untuk di-copy.';
const relatedTools = [
  { slug: 'image-resizer', name: 'Image Resizer', icon: '🖼' },
  { slug: 'color-picker', name: 'Color Picker', icon: '🎨' },
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'qr-generator', name: 'QR Generator', icon: '▐▌' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <div id="dropZone" class="rounded-xl p-6 text-center cursor-pointer" style="border:2px dashed oklch(0.85 0.01 270);background:oklch(0.99 0.001 270);">
        <div class="mb-2">
          <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="opacity-40"><path d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <p class="mb-1 text-sm font-medium opacity-80">Drag & drop gambar di sini</p>
        <p class="text-xs opacity-40 mb-3">atau</p>
        <label class="btn btn-primary btn-sm">
          Pilih File
          <input type="file" id="fileInput" accept="image/*" hidden>
        </label>
        <p class="text-xs opacity-40 mt-2 mb-0">Format: PNG, JPG, GIF, WebP, SVG</p>
      </div>
      <div id="info" class="text-xs opacity-60 mt-2"></div>
    </div>
    <div>
      <div id="preview" class="mb-2"></div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs font-medium opacity-60">Base64 Data URI</span>
        <div class="flex gap-1">
          <button id="btnCopy" class="btn btn-ghost btn-sm">Copy</button>
          <button id="btnClear" class="btn btn-ghost btn-sm">Clear</button>
        </div>
      </div>
      <textarea id="outputText" class="textarea textarea-bordered w-full text-sm font-mono" rows="6" readonly placeholder="Hasil Base64 akan muncul di sini..."></textarea>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<style is:inline>
#dropZone.dragover { border-color: #f59e0b !important; background: oklch(0.95 0.01 90) !important; }
#preview img { max-width: 100%; max-height: 120px; border-radius: 0.5rem; object-fit: contain; }
</style>

<script is:inline>
var dropZone = document.getElementById('dropZone');
var fileInput = document.getElementById('fileInput');
var preview = document.getElementById('preview');
var output = document.getElementById('outputText');
var info = document.getElementById('info');

function handleFile(file) {
  if (!file) return;
  if (!file.type.startsWith('image/')) {
    alert('File harus berupa gambar');
    return;
  }

  var reader = new FileReader();
  reader.onload = function(e) {
    var dataUri = e.target.result;
    output.value = dataUri;
    preview.innerHTML = '<img src="' + dataUri + '" alt="preview">';
    var sizeKB = (file.size / 1024).toFixed(1);
    var base64Len = dataUri.length;
    info.textContent = file.name + ' | ' + sizeKB + ' KB | Base64: ' + base64Len + ' chars';
  };
  reader.readAsDataURL(file);
}

dropZone.addEventListener('dragover', function(e) { e.preventDefault(); this.classList.add('dragover'); });
dropZone.addEventListener('dragleave', function() { this.classList.remove('dragover'); });
dropZone.addEventListener('drop', function(e) {
  e.preventDefault();
  this.classList.remove('dragover');
  if (e.dataTransfer.files.length > 0) handleFile(e.dataTransfer.files[0]);
});
dropZone.addEventListener('click', function() { fileInput.click(); });
fileInput.addEventListener('change', function() { if (this.files.length > 0) handleFile(this.files[0]); });

document.getElementById('btnCopy').addEventListener('click', function() {
  if (!output.value) return;
  navigator.clipboard.writeText(output.value).then(function() {
    var btn = document.getElementById('btnCopy');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
  });
});
document.getElementById('btnClear').addEventListener('click', function() {
  output.value = '';
  preview.innerHTML = '';
  info.textContent = '';
  fileInput.value = '';
});
</script>