---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Age Calculator';
const description = 'Kalkulator usia online. Hitung umur dalam tahun, bulan, hari, jam, menit, dan detik secara real-time.';
const keywords = 'age calculator, kalkulator umur, hitung usia, age counter';
const aboutText = 'Kalkulator usia online untuk menghitung umur secara detail hingga tingkat detik. Cukup masukkan tanggal lahir, alat ini akan menghitung usia Anda dalam tahun, bulan, minggu, hari, jam, menit, dan detik secara real-time. Juga menampilkan fakta menarik seperti jumlah detak jantung dan total jam tidur sejak lahir.';
const aboutExtra = 'Kalkulator usia ini mendukung dua mode: mode real-time yang memperbarui hitungan setiap detik, dan mode tanggal tertentu untuk menghitung usia pada tanggal spesifik di masa lalu atau masa depan. Semua perhitungan dilakukan di browser tanpa mengirim data ke server.';
const relatedTools = [
  { slug: 'date-calculator', name: 'Date Calculator', icon: '📅' },
  { slug: 'time-converter', name: 'Time Converter', icon: '🌍' },
  { slug: 'countdown', name: 'Countdown Timer', icon: '⏳' },
  { slug: 'sleep-cycle', name: 'Sleep Cycle', icon: '😴' },
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
    <div class="flex flex-wrap gap-4">
      <div class="lg:w-5/12 w-full">
        <div class="mb-3">
          <label class="text-xs font-medium opacity-60 mb-1 block">Tanggal Lahir</label>
          <input type="date" id="birthDate" class="input input-bordered w-full input-sm" value="2000-01-01">
        </div>
        <div class="mb-3">
          <label class="text-xs font-medium opacity-60 mb-1 block">Hingga Tanggal</label>
          <select id="modeSelect" class="select select-bordered w-full select-sm mb-2">
            <option value="now">Sekarang (real-time)</option>
            <option value="custom">Tanggal Tertentu</option>
          </select>
          <input type="date" id="customDate" class="input input-bordered w-full input-sm" disabled>
        </div>
        <button id="btnCalc" class="btn btn-primary w-full btn-sm">Hitung Usia</button>
      </div>

      <div class="lg:w-7/12 w-full">
        <div class="grid grid-cols-3 gap-3 mb-3 text-center">
          <div class="p-3 rounded-lg" style="background:oklch(0.55 0.25 270 / 0.1);">
            <div class="text-2xl font-bold" id="years" style="color:#6366f1">0</div>
            <div class="text-xs opacity-50">Tahun</div>
          </div>
          <div class="p-3 rounded-lg" style="background:oklch(0.6 0.18 150 / 0.1);">
            <div class="text-2xl font-bold" id="months" style="color:#16a34a">0</div>
            <div class="text-xs opacity-50">Bulan</div>
          </div>
          <div class="p-3 rounded-lg" style="background:oklch(0.8 0.18 85 / 0.1);">
            <div class="text-2xl font-bold" id="days" style="color:#ca8a04">0</div>
            <div class="text-xs opacity-50">Hari</div>
          </div>
        </div>

        <div class="mb-3">
          <div class="text-xs font-semibold opacity-50 mb-2">Detail Usia</div>
          <div id="ageDetail" class="text-sm"></div>
        </div>

        <div>
          <div class="text-xs font-semibold opacity-50 mb-2">Fakta Menarik</div>
          <div id="funFacts" class="text-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
var birth=document.getElementById('birthDate'),mode=document.getElementById('modeSelect'),custom=document.getElementById('customDate'),btn=document.getElementById('btnCalc');
mode.addEventListener('change',function() { custom.disabled=this.value!=='custom'; if(this.value==='custom') custom.value=new Date().toISOString().split('T')[0]; });

function calc() {
  var b=new Date(birth.value), e=mode.value==='now' ? new Date() : new Date(custom.value);
  if(isNaN(b)) {
    document.getElementById('years').textContent='?'; document.getElementById('months').textContent='?';
    document.getElementById('days').textContent='?';
    document.getElementById('ageDetail').innerHTML='<span class="text-error text-xs">Tanggal lahir tidak valid</span>';
    return;
  }
  var ms=e-b, y=Math.floor(ms/31557600000), m=Math.floor((ms%31557600000)/2592000000), d=Math.floor((ms%2592000000)/86400000);
  var h=Math.floor((ms%86400000)/3600000), mi=Math.floor((ms%3600000)/60000), s=Math.floor((ms%60000)/1000);
  document.getElementById('years').textContent=y;
  document.getElementById('months').textContent=m;
  document.getElementById('days').textContent=d;

  document.getElementById('ageDetail').innerHTML='<table class="table table-sm w-full text-xs">'+
    '<tr><td class="py-1 opacity-60">Tahun</td><td class="py-1 font-bold text-right">'+y+'</td></tr>'+
    '<tr><td class="py-1 opacity-60">Bulan</td><td class="py-1 font-bold text-right">'+(y*12+m)+' bulan</td></tr>'+
    '<tr><td class="py-1 opacity-60">Minggu</td><td class="py-1 font-bold text-right">'+Math.floor(ms/604800000)+' minggu</td></tr>'+
    '<tr><td class="py-1 opacity-60">Hari</td><td class="py-1 font-bold text-right">'+Math.floor(ms/86400000)+' hari</td></tr>'+
    '<tr><td class="py-1 opacity-60">Jam</td><td class="py-1 font-bold text-right">'+Math.floor(ms/3600000)+' jam</td></tr>'+
    '<tr><td class="py-1 opacity-60">Menit</td><td class="py-1 font-bold text-right">'+Math.floor(ms/60000)+' menit</td></tr>'+
    '<tr><td class="py-1 opacity-60">Detik</td><td class="py-1 font-bold text-right">'+Math.floor(ms/1000)+' detik</td></tr></table>';

  var facts=document.getElementById('funFacts');
  facts.innerHTML='<ul class="space-y-1 text-xs opacity-70">'+
    '<li>Anda hidup selama <strong>'+Math.floor(ms/86400000)+' hari</strong></li>'+
    '<li>Jantung berdetak ~<strong>'+Math.floor(ms/86400000*100000)+' kali</strong></li>'+
    '<li>Anda tidur ~<strong>'+Math.floor(ms/86400000*8)+' jam</strong></li>'+
    '<li>Usia dalam jam: <strong>'+Math.floor(ms/3600000)+' jam</strong></li>'+
    '<li>Usia dalam menit: <strong>'+Math.floor(ms/60000)+' menit</strong></li></ul>';
}
btn.addEventListener('click',calc);
if(mode.value==='now') { calc(); setInterval(calc,1000); } else { calc(); }
</script>
