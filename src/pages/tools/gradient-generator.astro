---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'CSS Gradient Generator';
const description = 'Buat CSS gradient kustom online. Pilih warna, arah, dan tipe gradient. Preview live & copy CSS.';
const keywords = 'css gradient generator, gradient css, linear gradient, radial gradient, color picker';
const aboutText = 'CSS Gradient Generator untuk membuat gradient CSS kustom dengan preview langsung. Pilih tipe gradient (linear atau radial), arah, dan warna. Hasil CSS code bisa langsung di-copy ke project Anda. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const aboutExtra = 'Gradient CSS banyak digunakan dalam desain web modern untuk membuat background yang menarik, tombol, kartu, dan elemen UI lainnya. Dengan alat ini Anda bisa bereksperimen dengan kombinasi warna dan melihat hasilnya secara real-time sebelum menerapkannya di project. Mendukung hingga 3 warna dengan berbagai arah dan tipe gradient.';
const relatedTools = [
  { slug: 'color-picker', name: 'Color Picker', icon: '🎨' },
  { slug: 'color-converter', name: 'Color Converter', icon: '🌈' },
  { slug: 'contrast-checker', name: 'Contrast Checker', icon: '◐' },
  { slug: 'css-unit', name: 'CSS Unit Converter', icon: 'px' },
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Tipe</label>
        <select id="gradType" class="select select-bordered w-full select-sm">
          <option value="linear">Linear</option>
          <option value="radial">Radial</option>
        </select>
      </div>
      <div class="mb-3" id="directionGroup">
        <label class="text-xs font-medium opacity-60 mb-1 block">Arah</label>
        <select id="gradDirection" class="select select-bordered w-full select-sm">
          <option value="to bottom">Atas ke Bawah</option>
          <option value="to top">Bawah ke Atas</option>
          <option value="to right">Kiri ke Kanan</option>
          <option value="to left">Kanan ke Kiri</option>
          <option value="to bottom right">Diagonal Bawah Kanan</option>
          <option value="to bottom left">Diagonal Bawah Kiri</option>
          <option value="to top right">Diagonal Atas Kanan</option>
          <option value="to top left">Diagonal Atas Kiri</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Warna 1</label>
        <div class="flex items-center gap-2">
          <input type="color" id="color1" class="input input-bordered w-full input-sm" value="#3b82f6" style="max-width:48px;padding:2px;">
          <input type="text" id="hex1" class="input input-bordered w-full input-sm font-mono" value="#3b82f6" style="max-width:100px;">
        </div>
      </div>
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Warna 2</label>
        <div class="flex items-center gap-2">
          <input type="color" id="color2" class="input input-bordered w-full input-sm" value="#8b5cf6" style="max-width:48px;padding:2px;">
          <input type="text" id="hex2" class="input input-bordered w-full input-sm font-mono" value="#8b5cf6" style="max-width:100px;">
        </div>
      </div>
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Warna 3 <span class="opacity-60">(opsional)</span></label>
        <div class="flex items-center gap-2">
          <input type="color" id="color3" class="input input-bordered w-full input-sm" value="#ec4899" style="max-width:48px;padding:2px;">
          <input type="text" id="hex3" class="input input-bordered w-full input-sm font-mono" value="#ec4899" style="max-width:100px;">
        </div>
        <div class="flex items-center gap-2 mt-1">
          <input type="checkbox" id="useColor3" class="checkbox checkbox-xs">
          <label for="useColor3" class="text-xs">Gunakan warna ke-3</label>
        </div>
      </div>
    </div>

    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div id="preview" class="mb-3 rounded" style="height:200px;border:1px solid oklch(0.9 0.005 270);"></div>
      <div class="flex justify-between items-center mb-1">
        <label class="text-xs font-medium opacity-60 mb-1 block">CSS Code</label>
        <button id="btnCopy" class="btn btn-ghost btn-sm">Copy</button>
      </div>
      <textarea id="cssOutput" class="textarea textarea-bordered w-full text-sm font-mono" rows="4" readonly></textarea>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var color1=document.getElementById('color1'),hex1=document.getElementById('hex1');
var color2=document.getElementById('color2'),hex2=document.getElementById('hex2');
var color3=document.getElementById('color3'),hex3=document.getElementById('hex3');
var use3=document.getElementById('useColor3');
var type=document.getElementById('gradType'),dir=document.getElementById('gradDirection');
var preview=document.getElementById('preview'),output=document.getElementById('cssOutput');

function syncHex(picker,hex){hex.value=picker.value}
function syncPicker(hex,picker){picker.value=hex.value}
color1.addEventListener('input',function(){syncHex(color1,hex1);update();});
color2.addEventListener('input',function(){syncHex(color2,hex2);update();});
color3.addEventListener('input',function(){syncHex(color3,hex3);update();});
hex1.addEventListener('input',function(){syncPicker(hex1,color1);update();});
hex2.addEventListener('input',function(){syncPicker(hex2,color2);update();});
hex3.addEventListener('input',function(){syncPicker(hex3,color3);update();});
use3.addEventListener('change',update);
type.addEventListener('change',function(){document.getElementById('directionGroup').style.display=this.value==='linear'?'block':'none';update();});
dir.addEventListener('change',update);

function update(){
  var c1=color1.value,c2=color2.value,c3=color3.value;
  var css;
  if(type.value==='linear'){
    var d=dir.value;
    if(use3.checked) css='linear-gradient('+d+', '+c1+', '+c2+', '+c3+')';
    else css='linear-gradient('+d+', '+c1+', '+c2+')';
  } else {
    if(use3.checked) css='radial-gradient(circle, '+c1+', '+c2+', '+c3+')';
    else css='radial-gradient(circle, '+c1+', '+c2+')';
  }
  preview.style.background=css;
  output.value='background: '+css+';';
}
update();

document.getElementById('btnCopy').addEventListener('click',function(){
  var b=this;navigator.clipboard.writeText(output.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)});
});
</script>