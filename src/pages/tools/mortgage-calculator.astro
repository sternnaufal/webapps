---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Mortgage Calculator';
const description = 'Kalkulator KPR (mortgage) online. Hitung cicilan rumah per bulan, total bunga, dan total pembayaran. Mendukung simulasi KPR dengan bunga fixed dan floating.';
const keywords = 'mortgage calculator, kalkulator KPR, kalkulator rumah, cicilan rumah, kredit pemilikan rumah, simulasi KPR';
const aboutText = 'Mortgage Calculator Kalkulator KPR (mortgage) online. Hitung cicilan rumah per bulan, total bunga, dan total pembayaran. Mendukung simulasi KPR dengan bunga fixed dan floating.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' },
  { slug: 'compound-interest-calculator', name: 'Compound Interest Calculator', icon: '💰' },
  { slug: 'discount-calculator', name: 'Discount Calculator', icon: '🏷' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#ecfdf5;color:#059669;">$</div><div><h1 class="h3 mb-0">Mortgage Calculator</h1><p class="opacity-60 small mb-0">Hitung estimasi cicilan KPR rumah per bulan.</p></div></header>
<div class="flex flex-wrap gap-4"><div class="lg:w-7/12 w-full">
<div class="card card-bordered bg-base-100 p-3">
<div class="flex flex-wrap gap-3"><div class="col-6"><label class="label-text small font-semibold">Harga Properti (Rp)</label><input type="number" id="homePrice" class="input input-bordered w-full" value="500000000" min="0" step="1000000"></div>
<div class="col-6"><label class="label-text small font-semibold">Uang Muka / DP (Rp)</label><input type="number" id="downPayment" class="input input-bordered w-full" value="100000000" min="0" step="1000000"></div></div>
<div class="flex flex-wrap gap-3 mt-1"><div class="col-6"><label class="label-text small font-semibold">Bunga (%) per tahun</label><input type="number" id="interestRate" class="input input-bordered w-full" value="8" min="0" max="50" step="0.1"></div>
<div class="col-6"><label class="label-text small font-semibold">Tenor (tahun)</label><select id="loanTerm" class="select select-bordered w-full"><option>5</option><option>10</option><option selected>15</option><option>20</option><option>25</option><option>30</option></select></div></div>
<button id="btnCalc" class="btn btn-primary w-full mt-3">Hitung Cicilan</button>
</div>
<div class="card card-bordered bg-base-100 p-3 mt-3">
<div class="flex flex-wrap gap-3 text-center"><div class="col-4"><div class="text-sm opacity-60">Pinjaman</div><div class="font-bold" id="loanAmount">Rp 400.000.000</div></div>
<div class="col-4"><div class="text-sm opacity-60">Cicilan / Bulan</div><div class="font-bold fs-5 text-primary" id="monthlyPayment">Rp 3.822.942</div></div>
<div class="col-4"><div class="text-sm opacity-60">Total Bunga</div><div class="font-bold text-error" id="totalInterest">Rp 288.129.640</div></div></div>
<hr class="my-2">
<div class="row text-center"><div class="w-full"><div class="text-sm opacity-60">Total Pembayaran</div><div class="font-bold" id="totalPayment" style="font-size:1.1rem">Rp 688.129.640</div></div></div>
</div>
</div>
<div class="lg:w-5/12 w-full">
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Ringkasan</h6>
<table class="table table-sm small mb-0">
<tr><td>DP</td><td class="text-right font-bold" id="dpDisplay">20%</td></tr>
<tr><td>Bunga Efektif</td><td class="text-right" id="effRateDisplay">8%</td></tr>
<tr><td>Jumlah Cicilan</td><td class="text-right" id="numPayDisplay">180x</td></tr>
<tr><td>Rasio Cicilan ke Pinjaman</td><td class="text-right" id="ratioDisplay">0.96%</td></tr>
</table>
</div>
</div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var hp=document.getElementById('homePrice'),dp=document.getElementById('downPayment'),ir=document.getElementById('interestRate'),lt=document.getElementById('loanTerm');
function fmt(x)&#123;if(x>=1e12)return'Rp '+(x/1e12).toFixed(1)+' T';return'Rp '+Math.round(x).toLocaleString('id-ID')&#125;
function calc()&#123;
  var h=Math.max(0,parseFloat(hp.value)||0),d=Math.max(0,parseFloat(dp.value)||0),i=Math.max(0,parseFloat(ir.value)||0)/100/12,t=Math.max(1,parseInt(lt.value)||1)*12;
  var loan=Math.max(0,h-d);
  var monthly=i>0?loan*i*Math.pow(1+i,t)/(Math.pow(1+i,t)-1):loan/t;
  var totalPay=monthly*t,totalInt=totalPay-loan;
  document.getElementById('loanAmount').textContent=fmt(loan);
  document.getElementById('monthlyPayment').textContent=fmt(monthly);
  document.getElementById('totalInterest').textContent=fmt(totalInt);
  document.getElementById('totalPayment').textContent=fmt(totalPay);
  document.getElementById('dpDisplay').textContent=h>0?Math.round(d/h*100)+'%':'-';
  document.getElementById('effRateDisplay').textContent=ir.value+'%';
  document.getElementById('numPayDisplay').textContent=t+'x';
  document.getElementById('ratioDisplay').textContent=loan>0?(monthly/loan*100).toFixed(2)+'%':'-';
&#125;
document.getElementById('btnCalc').addEventListener('click',calc);
calc();
</script>

