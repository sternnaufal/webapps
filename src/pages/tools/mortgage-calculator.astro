---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Mortgage Calculator';
const description = 'Kalkulator KPR (mortgage) online. Hitung cicilan rumah per bulan, total bunga, dan total pembayaran. Mendukung simulasi KPR dengan bunga fixed dan floating.';
const keywords = 'mortgage calculator, kalkulator KPR, kalkulator rumah, cicilan rumah, kredit pemilikan rumah, simulasi KPR';
const aboutText = 'Mortgage Calculator Kalkulator KPR (mortgage) online. Hitung cicilan rumah per bulan, total bunga, dan total pembayaran. Mendukung simulasi KPR dengan bunga fixed dan floating.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' },
  { slug: 'compound-interest-calculator', name: 'Compound Interest Calculator', icon: '💰' },
  { slug: 'discount-calculator', name: 'Discount Calculator', icon: '🏷' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="grid grid-cols-2 gap-3">
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Harga Properti (Rp)</label><input type="number" id="homePrice" class="input input-bordered w-full input-sm" value="500000000" min="0" step="1000000"></div>
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Uang Muka / DP (Rp)</label><input type="number" id="downPayment" class="input input-bordered w-full input-sm" value="100000000" min="0" step="1000000"></div>
      </div>
      <div class="grid grid-cols-2 gap-3 mt-3">
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Bunga (%) per tahun</label><input type="number" id="interestRate" class="input input-bordered w-full input-sm" value="8" min="0" max="50" step="0.1"></div>
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Tenor (tahun)</label>
          <select id="loanTerm" class="select select-bordered w-full select-sm">
            <option>5</option><option>10</option><option selected>15</option><option>20</option><option>25</option><option>30</option>
          </select>
        </div>
      </div>
      <button id="btnCalc" class="btn btn-primary btn-sm w-full mt-3">Hitung Cicilan</button>
    </div>
    <div class="rounded-xl p-5 mt-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="grid grid-cols-3 gap-3 text-center text-xs">
        <div><span class="opacity-60">Pinjaman</span><div class="text-sm font-bold" id="loanAmount">Rp 400.000.000</div></div>
        <div><span class="opacity-60">Cicilan / Bulan</span><div class="text-sm font-bold text-blue-500" id="monthlyPayment">Rp 3.822.942</div></div>
        <div><span class="opacity-60">Total Bunga</span><div class="text-sm font-bold text-red-500" id="totalInterest">Rp 288.129.640</div></div>
      </div>
      <hr class="my-2" style="border-color:oklch(0.9 0.005 270);">
      <div class="text-center text-xs"><span class="opacity-60">Total Pembayaran</span><div class="text-sm font-bold" id="totalPayment">Rp 688.129.640</div></div>
    </div>
  </div>
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Ringkasan</div>
      <table class="table table-sm w-full text-xs mb-0">
        <tr><td class="py-1 opacity-60">DP</td><td class="py-1 text-right font-bold" id="dpDisplay">20%</td></tr>
        <tr><td class="py-1 opacity-60">Bunga Efektif</td><td class="py-1 text-right" id="effRateDisplay">8%</td></tr>
        <tr><td class="py-1 opacity-60">Jumlah Cicilan</td><td class="py-1 text-right" id="numPayDisplay">180x</td></tr>
        <tr><td class="py-1 opacity-60">Rasio Cicilan ke Pinjaman</td><td class="py-1 text-right" id="ratioDisplay">0.96%</td></tr>
      </table>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
var hp=document.getElementById('homePrice'),dp=document.getElementById('downPayment'),ir=document.getElementById('interestRate'),lt=document.getElementById('loanTerm');
function fmt(x){if(x>=1e12)return'Rp '+(x/1e12).toFixed(1)+' T';return'Rp '+Math.round(x).toLocaleString('id-ID')}
function calc(){
  var h=Math.max(0,parseFloat(hp.value)||0),d=Math.max(0,parseFloat(dp.value)||0),i=Math.max(0,parseFloat(ir.value)||0)/100/12,t=Math.max(1,parseInt(lt.value)||1)*12;
  var loan=Math.max(0,h-d);
  var monthly=i>0?loan*i*Math.pow(1+i,t)/(Math.pow(1+i,t)-1):loan/t;
  var totalPay=monthly*t,totalInt=totalPay-loan;
  document.getElementById('loanAmount').textContent=fmt(loan);
  document.getElementById('monthlyPayment').textContent=fmt(monthly);
  document.getElementById('totalInterest').textContent=fmt(totalInt);
  document.getElementById('totalPayment').textContent=fmt(totalPay);
  document.getElementById('dpDisplay').textContent=h>0?Math.round(d/h*100)+'%':'-';
  document.getElementById('effRateDisplay').textContent=ir.value+'%';
  document.getElementById('numPayDisplay').textContent=t+'x';
  document.getElementById('ratioDisplay').textContent=loan>0?(monthly/loan*100).toFixed(2)+'%':'-';
}
document.getElementById('btnCalc').addEventListener('click',calc);
calc();
</script>