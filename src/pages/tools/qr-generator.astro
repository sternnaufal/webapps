---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'QR Code Generator';
const description = 'Buat QR code online gratis. QR code generator untuk URL, teks, dan lainnya. Download PNG.';
const keywords = 'qr code generator, qr generator, buat qr code, qr online';
const aboutText = 'QR code generator online untuk membuat QR code dari teks, URL, atau data apa pun secara instan. Cukup masukkan teks atau URL, pilih ukuran, level error correction, warna foreground dan background, lalu klik Generate. QR code yang dihasilkan dapat langsung di-download sebagai file PNG dengan resolusi tinggi sesuai ukuran yang dipilih (dari 128px hingga 1024px). QR generator ini berjalan sepenuhnya di sisi klien tanpa mengirim data ke server.';
const aboutExtra = 'QR code memiliki banyak kegunaan praktis dalam kehidupan sehari-hari: membagikan link website, alamat kontak (vCard), koneksi WiFi, pembayaran digital (QRIS), menu restoran digital, tiket event, undangan pernikahan, dan informasi produk. QR code yang dihasilkan bisa di-scan dengan kamera smartphone atau aplikasi QR reader apa pun. Generator ini gratis, tanpa batasan jumlah generate, dan bisa digunakan untuk keperluan pribadi maupun komersial.';
const relatedTools = [
  { slug: 'password-generator', name: 'Password Generator', icon: '🔑' },
  { slug: 'uuid-generator', name: 'UUID Generator', icon: '🆔' },
  { slug: 'image-to-base64', name: 'Image to Base64', icon: '🖼' },
  { slug: 'base64-coded', name: 'Base64 Encoder', icon: 'B64' },
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>

  <div class="grid grid-cols-1 lg:grid-cols-7 gap-4 mt-4">
    <div class="lg:col-span-4">
      <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
        <form id="qrForm" class="grid grid-cols-1 md:grid-cols-2 gap-3" onsubmit="return false;">
          <div class="md:col-span-2">
            <label for="qrText" class="text-xs font-medium opacity-60 mb-1 block">Teks / URL</label>
            <textarea id="qrText" class="textarea textarea-bordered w-full text-sm font-mono" rows="3" placeholder="https://naufalrakha.my.id atau teks biasa..."></textarea>
            <div class="text-xs opacity-50 mt-0.5">Tip: prefill via URL <code>?t=...</code></div>
          </div>

          <div>
            <label for="qrSize" class="text-xs font-medium opacity-60 mb-1 block">Ukuran</label>
            <select id="qrSize" class="select select-bordered w-full select-sm">
              <option value="128">128 px</option>
              <option value="256" selected>256 px</option>
              <option value="512">512 px</option>
              <option value="1024">1024 px</option>
            </select>
          </div>

          <div>
            <label for="qrEcc" class="text-xs font-medium opacity-60 mb-1 block">Error Correction</label>
            <select id="qrEcc" class="select select-bordered w-full select-sm">
              <option value="L">L (7%)</option>
              <option value="M" selected>M (15%)</option>
              <option value="Q">Q (25%)</option>
              <option value="H">H (30%)</option>
            </select>
          </div>

          <div>
            <label for="qrMargin" class="text-xs font-medium opacity-60 mb-1 block">Margin</label>
            <select id="qrMargin" class="select select-bordered w-full select-sm">
              <option value="0">0 px</option>
              <option value="1">1 px</option>
              <option value="2" selected>2 px</option>
              <option value="4">4 px</option>
              <option value="8">8 px</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="qrFg" class="text-xs font-medium opacity-60 mb-1 block">Warna Depan</label>
              <input type="color" id="qrFg" class="input input-bordered w-full input-sm" value="#000000">
            </div>
            <div>
              <label for="qrBg" class="text-xs font-medium opacity-60 mb-1 block">Warna Belakang</label>
              <input type="color" id="qrBg" class="input input-bordered w-full input-sm" value="#ffffff">
            </div>
          </div>

          <div class="md:col-span-2 flex gap-2 flex-wrap">
            <button type="button" id="btnGenerate" class="btn btn-primary btn-sm">Generate</button>
            <button type="button" id="btnDownload" class="btn btn-ghost btn-sm" disabled>Download PNG</button>
            <button type="button" id="btnSample" class="btn btn-ghost btn-sm">Sample</button>
            <button type="button" id="btnClear" class="btn btn-ghost btn-sm">Clear</button>
          </div>
        </form>
      </div>
    </div>

    <div class="lg:col-span-3">
      <div class="rounded-xl p-5 h-full" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
        <div class="font-bold text-sm mb-2">Preview</div>
        <div id="qrWrap" class="border border-base-300 rounded-xl flex items-center justify-center p-3 bg-white min-h-[280px]">
          <div id="qrcode" class="select-none"></div>
        </div>
        <div class="text-xs opacity-50 mt-2">
          Preview max 320px. Download sesuai ukuran asli.
        </div>
      </div>
    </div>
  </div>

  <p class="text-xs opacity-50 mt-3">
    QR code dibuat 100% di browser. Data tidak dikirim ke server.
  </p>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
</script>

<script is:inline>
(function(){
  var elText   = document.getElementById('qrText');
  var elSize   = document.getElementById('qrSize');
  var elEcc    = document.getElementById('qrEcc');
  var elMargin = document.getElementById('qrMargin');
  var elFg     = document.getElementById('qrFg');
  var elBg     = document.getElementById('qrBg');
  var elGen    = document.getElementById('btnGenerate');
  var elDl     = document.getElementById('btnDownload');
  var elSample = document.getElementById('btnSample');
  var elClear  = document.getElementById('btnClear');
  var wrap     = document.getElementById('qrcode');
  var wrapOuter= document.getElementById('qrWrap');

  var lastCanvasDataURL = null;

  function clearQR(){
    wrap.innerHTML = '';
    lastCanvasDataURL = null;
    elDl.disabled = true;
  }

  function gen(previewOnly){
    if (previewOnly === undefined) previewOnly = true;
    var text = elText.value.trim();
    if (!text) return;

    clearQR();

    var LEVEL = QRCode.CorrectLevel;
    var chosenLevel = LEVEL[elEcc.value] || LEVEL.M;
    var size = parseInt(elSize.value, 10);
    var previewSize = Math.min(size, 320);

    new QRCode(wrap, {
      text: text,
      width: previewOnly ? previewSize : size,
      height: previewOnly ? previewSize : size,
      colorDark: elFg.value,
      colorLight: elBg.value,
      correctLevel: chosenLevel
    });

    wrapOuter.style.padding = Math.max(0, parseInt(elMargin.value, 10)) + 'px';

    setTimeout(function() {
      var canvas = wrap.querySelector('canvas');
      if (canvas) {
        lastCanvasDataURL = canvas.toDataURL('image/png');
        elDl.disabled = false;
      }
    }, 80);
  }

  function downloadPNG(){
    var text = elText.value.trim();
    if (!text) return;

    var LEVEL = QRCode.CorrectLevel;
    var chosenLevel = LEVEL[elEcc.value] || LEVEL.M;
    var size = parseInt(elSize.value, 10);

    var tempDiv = document.createElement('div');
    new QRCode(tempDiv, {
      text: text,
      width: size,
      height: size,
      colorDark: elFg.value,
      colorLight: elBg.value,
      correctLevel: chosenLevel
    });

    setTimeout(function() {
      var canvas = tempDiv.querySelector('canvas');
      if (canvas) {
        var a = document.createElement('a');
        a.href = canvas.toDataURL('image/png');
        a.download = 'qrcode.png';
        document.body.appendChild(a);
        a.click();
        a.remove();
      }
    }, 100);
  }

  function sample(){
    elText.value = 'https://webapps.naufalrakha.my.id/?ref=qr';
    elSize.value = '320';
    elEcc.value  = 'M';
    elMargin.value = '2';
    elFg.value = '#000000';
    elBg.value = '#ffffff';
    gen();
  }

  function clearAll(){
    elText.value = '';
    clearQR();
    elText.focus();
  }

  (function() {
    var params = new URLSearchParams(location.search);
    var t = params.get('t');
    if (t) {
      elText.value = decodeURIComponent(t);
      gen();
    }
  })();

  elGen.addEventListener('click', function() { gen(true); });
  elDl.addEventListener('click', downloadPNG);
  elSample.addEventListener('click', sample);
  elClear.addEventListener('click', clearAll);

  [elSize, elEcc, elMargin, elFg, elBg].forEach(function(el) {
    el.addEventListener('change', function() { if (elText.value.trim()) gen(); });
  });
})();
</script>