---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Base64 Encode / Decode';
const description = 'Encode dan decode Base64 online gratis. Konversi teks ke Base64 dan sebaliknya dengan cepat.';
const keywords = 'base64, encode, decode, base64 encoder, base64 decoder';
const aboutText = 'Base64 encoder/decoder online untuk mengkonversi teks ke format Base64 dan sebaliknya. Base64 adalah skema encoding yang mengubah data biner menjadi teks ASCII yang aman untuk ditransmisikan melalui media yang hanya mendukung teks. Alat ini berguna untuk encoding file gambar menjadi string, mengirim data melalui API, atau menyimpan data biner di database.';
const aboutExtra = 'Proses encoding dan decoding dilakukan sepenuhnya di browser menggunakan fungsi btoa() dan atob() JavaScript. Teks yang dimasukkan tidak pernah dikirim ke server sehingga aman untuk data sensitif. Mendukung berbagai karakter termasuk Unicode melalui encodeURIComponent/decodeURIComponent.';
const relatedTools = [
  { slug: 'hash-generator', name: 'Hash Generator', icon: '#' },
  { slug: 'uuid-generator', name: 'UUID Generator', icon: '🆔' },
  { slug: 'url-encode', name: 'URL Encode/Decode', icon: '%' },
  { slug: 'json-formatter', name: 'JSON Formatter', icon: '{}' },
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);">
    <div class="mb-4">
      <label for="text" class="text-xs font-medium opacity-60 mb-1 block">Masukkan Teks</label>
      <textarea id="text" class="textarea textarea-bordered w-full text-sm font-mono" rows="4" placeholder="Teks untuk encode atau Base64 untuk decode">Hello World! Selamat datang di WebApps Naufalrakha.</textarea>
    </div>
    <div class="flex gap-2 mb-4">
      <button type="button" id="encodeBtn" class="btn btn-primary btn-sm">Encode</button>
      <button type="button" id="decodeBtn" class="btn btn-secondary btn-sm">Decode</button>
    </div>

    <div id="results" style="display:none;">
      <div id="resultContent"></div>
      <div class="mt-3">
        <button type="button" id="copyBtn" class="btn btn-ghost btn-xs">Copy</button>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
let currentResult = '';

function encode() {
  const input = document.getElementById('text').value;
  if (!input.trim()) { alert('Masukkan teks terlebih dahulu'); return; }
  try {
    currentResult = btoa(unescape(encodeURIComponent(input)));
    document.getElementById('resultContent').innerHTML = '<div class="text-xs font-semibold opacity-50 mb-1">Encoded:</div><pre class="text-xs font-mono p-3 rounded-lg" style="background:oklch(0.9 0.005 270);word-break:break-all;">' + escapeHtml(currentResult) + '</pre>';
    document.getElementById('results').style.display = 'block';
  } catch (e) { alert('Gagal encode: ' + e.message); }
}

function decode() {
  const input = document.getElementById('text').value;
  if (!input.trim()) { alert('Masukkan Base64 terlebih dahulu'); return; }
  try {
    currentResult = decodeURIComponent(escape(atob(input)));
    document.getElementById('resultContent').innerHTML = '<div class="text-xs font-semibold opacity-50 mb-1">Decoded:</div><pre class="text-xs font-mono p-3 rounded-lg" style="background:oklch(0.9 0.005 270);word-break:break-all;">' + escapeHtml(currentResult) + '</pre>';
    document.getElementById('results').style.display = 'block';
  } catch (e) { alert('Input bukan Base64 yang valid!'); }
}

function escapeHtml(text) { var d = document.createElement('div'); d.textContent = text; return d.innerHTML; }

document.getElementById('encodeBtn').addEventListener('click', encode);
document.getElementById('decodeBtn').addEventListener('click', decode);
document.getElementById('copyBtn').addEventListener('click', function() {
  navigator.clipboard.writeText(currentResult).then(() => {
    const btn = document.getElementById('copyBtn');
    btn.textContent = '✓ Copied!';
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  }).catch(() => { alert('Gagal menyalin'); });
});
</script>
