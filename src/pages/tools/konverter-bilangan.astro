---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Konverter Bilangan';
const description = 'Konversi bilangan biner, oktal, desimal, heksadesimal online gratis. Alat konversi angka lengkap.';
const keywords = 'konverter bilangan, biner, oktal, desimal, heksadesimal, number converter';
const aboutText = 'Konverter Bilangan Konversi bilangan biner, oktal, desimal, heksadesimal online gratis. Alat konversi angka lengkap.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'unit-converter', name: 'Unit Converter', icon: '⚖' },
  { slug: 'decimal-to-fraction', name: 'Decimal To Fraction', icon: '½' },
  { slug: 'roman-numeral', name: 'Roman Numeral', icon: 'IV' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="mb-5">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</header>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <!-- Desimal -->
  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
    <div class="text-sm font-semibold mb-3">Desimal <span class="text-xs opacity-40 ml-1">basis 10</span></div>
    <div class="flex gap-2 mb-2">
      <input id="dec" class="input input-bordered w-full input-sm" inputmode="numeric" placeholder="Misal: 1337 atau -42" />
      <button class="btn btn-ghost btn-sm" data-copy="dec" title="Salin">📋</button>
    </div>
    <div class="text-xs opacity-40">Karakter valid: 0-9, opsional tanda minus.</div>
    <div class="mt-2 flex justify-between">
      <span class="text-xs opacity-40" id="decInfo"></span>
    </div>
    <div class="text-xs text-red-500 mt-1" id="decErr"></div>
  </div>

  <!-- Hex -->
  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
    <div class="text-sm font-semibold mb-3">Heksadesimal <span class="text-xs opacity-40 ml-1">basis 16</span></div>
    <div class="flex gap-2 mb-2">
      <input id="hex" class="input input-bordered w-full input-sm" placeholder="Misal: 1A3F atau -ff" />
      <button class="btn btn-ghost btn-sm" data-copy="hex" title="Salin">📋</button>
    </div>
    <div class="flex items-center gap-2 mb-2">
      <input class="checkbox checkbox-sm" type="checkbox" id="hexUpper">
      <label class="text-xs opacity-60" for="hexUpper">Uppercase</label>
    </div>
    <div class="text-xs opacity-40">Karakter valid: 0-9, a-f. Gunakan tanda minus untuk negatif.</div>
    <div class="mt-2 flex justify-between">
      <span class="text-xs opacity-40" id="hexInfo"></span>
    </div>
    <div class="text-xs text-red-500 mt-1" id="hexErr"></div>
  </div>

  <!-- Biner -->
  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
    <div class="text-sm font-semibold mb-3">Biner <span class="text-xs opacity-40 ml-1">basis 2</span></div>
    <div class="flex gap-2 mb-2">
      <input id="bin" class="input input-bordered w-full input-sm" placeholder="Misal: 101010 atau -1111" />
      <button class="btn btn-ghost btn-sm" data-copy="bin" title="Salin">📋</button>
    </div>
    <div class="flex items-center gap-2 mb-2">
      <input class="checkbox checkbox-sm" type="checkbox" id="binGroup" checked>
      <label class="text-xs opacity-60" for="binGroup">Kelompok 4-bit</label>
    </div>
    <div class="text-xs opacity-40">Karakter valid: 0 atau 1. Min untuk negatif.</div>
    <div class="mt-2 flex justify-between">
      <span class="text-xs opacity-40" id="binInfo"></span>
    </div>
    <div class="text-xs text-red-500 mt-1" id="binErr"></div>
  </div>

  <!-- Oktal -->
  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
    <div class="text-sm font-semibold mb-3">Oktal <span class="text-xs opacity-40 ml-1">basis 8</span></div>
    <div class="flex gap-2 mb-2">
      <input id="oct" class="input input-bordered w-full input-sm" placeholder="Misal: 755 atau -17" />
      <button class="btn btn-ghost btn-sm" data-copy="oct" title="Salin">📋</button>
    </div>
    <div class="text-xs opacity-40">Karakter valid: 0-7. Min untuk negatif.</div>
    <div class="mt-2 flex justify-between">
      <span class="text-xs opacity-40" id="octInfo"></span>
    </div>
    <div class="text-xs text-red-500 mt-1" id="octErr"></div>
  </div>
</div>

<p class="text-xs opacity-40 mt-4">
  💡 Tip: tekan <kbd>Tab</kbd> untuk berpindah bidang. Semua konversi dilakukan lokal di browser, tanpa internet.
</p>

<ToolShell about={aboutText} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
const el = id => document.getElementById(id);

const RE = {
  dec: /^-?[0-9]+$/i,
  hex: /^-?[0-9a-f]+$/i,
  bin: /^-?[01]+$/,
  oct: /^-?[0-7]+$/
};

function stripGrouping(s){ return s.replace(/\s+/g, ""); }

function parseToBigInt(str, base){
  let neg = false;
  let s = stripGrouping(String(str).trim());
  if (!s) return null;
  if (s[0] === '-') { neg = true; s = s.slice(1); }
  let bi;
  if (base === 10) {
    bi = BigInt(s);
  } else if (base === 16) {
    bi = BigInt('0x' + s);
  } else if (base === 2) {
    bi = BigInt('0b' + s);
  } else if (base === 8) {
    bi = BigInt('0o' + s);
  } else {
    bi = [...s].reduce((acc, ch)=>{
      const d = parseInt(ch, 36);
      if (Number.isNaN(d) || d >= base) throw new Error('invalid');
      return acc * BigInt(base) + BigInt(d);
    }, 0n);
  }
  return neg ? -bi : bi;
}

function toBaseString(bi, base, {uppercase=false}={}){
  let s = bi.toString(base);
  if (uppercase) s = s.toUpperCase();
  return s;
}

function groupBinary(s){
  const neg = s.startsWith('-');
  if (neg) s = s.slice(1);
  const pad = (4 - (s.length % 4)) % 4;
  s = '0'.repeat(pad) + s;
  const parts = s.match(/.{1,4}/g) || [s];
  const out = parts.join(' ');
  return (neg?'-':'') + out;
}

function setInfo(){
  const dec = el('dec').value.trim();
  const hex = el('hex').value.trim();
  const bin = el('bin').value.trim();
  const oct = el('oct').value.trim();
  el('decInfo').textContent = dec ? `${dec.length} digit` : '';
  el('hexInfo').textContent = hex ? `${stripGrouping(hex).length} digit` : '';
  el('binInfo').textContent = bin ? `${stripGrouping(bin).replace(/^-/, '').replace(/\s+/g,'').length} bit` : '';
  el('octInfo').textContent = oct ? `${stripGrouping(oct).length} digit` : '';
}

function showError(which, msg){ el(which+'Err').textContent = msg || ''; }
function clearErrors(){ ['dec','hex','bin','oct'].forEach(x=>showError(x,'')); }

let editing = null;

function updateFrom(source){
  if (editing && editing !== source) return;
  editing = source;
  clearErrors();

  const optsUpper = el('hexUpper').checked;
  const optsGroup = el('binGroup').checked;

  const raw = el(source).value.trim();
  const valid = RE[source].test(stripGrouping(raw));

  if (!raw){
    ['dec','hex','bin','oct'].forEach(id=>{ el(id).value=''; });
    setInfo(); editing=null; return;
  }

  if (!valid){
    showError(source, 'Input tidak valid untuk basis ini.');
    editing=null; return;
  }

  try{
    const base = {dec:10, hex:16, bin:2, oct:8}[source];
    const bi = parseToBigInt(raw, base);

    el('dec').value = bi.toString(10);
    el('hex').value = toBaseString(bi, 16, {uppercase: optsUpper});
    let bin = toBaseString(bi, 2);
    el('bin').value = optsGroup ? groupBinary(bin) : bin;
    el('oct').value = toBaseString(bi, 8);
    setInfo();
  } catch(e){
    showError(source, 'Terjadi kesalahan saat konversi.');
  } finally{
    editing=null;
  }
}

['dec','hex','bin','oct'].forEach(id=>{
  el(id).addEventListener('input', ()=>updateFrom(id));
  el(id).addEventListener('blur', setInfo);
});

el('hexUpper').addEventListener('change', ()=>{
  if (el('hex').value.trim()) updateFrom('hex');
});
el('binGroup').addEventListener('change', ()=>{
  if (el('bin').value.trim()) updateFrom('bin');
  else if (el('dec').value.trim()) updateFrom('dec');
});

document.querySelectorAll('[data-copy]').forEach(btn=>{
  btn.addEventListener('click', async ()=>{
    const id = btn.getAttribute('data-copy');
    const val = el(id).value;
    if (!val) return;
    try{ await navigator.clipboard.writeText(val); btn.textContent='✅'; setTimeout(()=>btn.textContent='📋', 900); }
    catch{ btn.textContent='❌'; setTimeout(()=>btn.textContent='📋', 900); }
  });
});

el('btnClear').addEventListener('click', ()=>{
  ['dec','hex','bin','oct'].forEach(id=>el(id).value='');
  clearErrors(); setInfo(); el('dec').focus();
});

el('btnSample').addEventListener('click', ()=>{
  el('hexUpper').checked = true; el('binGroup').checked = true;
  el('dec').value = '2025'; updateFrom('dec');
});

setInfo();
</script>