---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Konverter Bilangan';
const description = 'Konversi bilangan biner, oktal, desimal, heksadesimal online gratis. Alat konversi angka lengkap.';
const keywords = 'konverter bilangan, biner, oktal, desimal, heksadesimal, number converter';
const aboutText = 'Konverter Bilangan Konversi bilangan biner, oktal, desimal, heksadesimal online gratis. Alat konversi angka lengkap.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'unit-converter', name: 'Unit Converter', icon: '⚖' },
  { slug: 'decimal-to-fraction', name: 'Decimal To Fraction', icon: '½' },
  { slug: 'roman-numeral', name: 'Roman Numeral', icon: 'IV' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<!-- Navbar khusus mobile -->
      

      

      <div class="flex flex-wrap gap-4">
        <!-- Desimal -->
        <div class="md:w-1/2 w-full">
          <div class="card shadow-sm h-full">
            <div class="card-body">
              <h5 class="card-title">Desimal <span class="badge bg-primary">basis 10</span></h5>
              <div class="input-group mb-2">
                <input id="dec" class="input input-bordered w-full" inputmode="numeric" placeholder="Misal: 1337 atau -42" />
                <button class="btn btn-outline" data-copy="dec" title="Salin">??</button>
              </div>
              <div class="text-sm opacity-60">Karakter valid: 09, opsional tanda minus.</div>
              <div class="mt-2 flex justify-between">
                <span class="badge bg-secondary" id="decInfo"></span>
              </div>
              <div class="text-error small mt-1" id="decErr"></div>
            </div>
          </div>
        </div>

        <!-- Hex -->
        <div class="md:w-1/2 w-full">
          <div class="card shadow-sm h-full">
            <div class="card-body">
              <h5 class="card-title">Hexadesimal <span class="badge bg-primary">basis 16</span></h5>
              <div class="input-group mb-2">
                <input id="hex" class="input input-bordered w-full" placeholder="Misal: 1A3F atau -ff" />
                <button class="btn btn-outline" data-copy="hex" title="Salin">??</button>
              </div>
              <div class="flex items-center gap-2 form-switch mb-2">
                <input class="checkbox" type="checkbox" id="hexUpper">
                <label class="flex items-center gap-2-label" for="hexUpper">Uppercase</label>
              </div>
              <div class="text-sm opacity-60">Karakter valid: 09, af. Gunakan tanda minus untuk negatif.</div>
              <div class="mt-2 flex justify-between">
                <span class="badge bg-secondary" id="hexInfo"></span>
              </div>
              <div class="text-error small mt-1" id="hexErr"></div>
            </div>
          </div>
        </div>

        <!-- Biner -->
        <div class="md:w-1/2 w-full">
          <div class="card shadow-sm h-full">
            <div class="card-body">
              <h5 class="card-title">Biner <span class="badge bg-primary">basis 2</span></h5>
              <div class="input-group mb-2">
                <input id="bin" class="input input-bordered w-full" placeholder="Misal: 101010 atau -1111" />
                <button class="btn btn-outline" data-copy="bin" title="Salin">??</button>
              </div>
              <div class="flex items-center gap-2 form-switch mb-2">
                <input class="checkbox" type="checkbox" id="binGroup" checked>
                <label class="flex items-center gap-2-label" for="binGroup">Kelompok 4-bit</label>
              </div>
              <div class="text-sm opacity-60">Karakter valid: 0 atau 1. Min untuk negatif.</div>
              <div class="mt-2 flex justify-between">
                <span class="badge bg-secondary" id="binInfo"></span>
              </div>
              <div class="text-error small mt-1" id="binErr"></div>
            </div>
          </div>
        </div>

        <!-- Oktal -->
        <div class="md:w-1/2 w-full">
          <div class="card shadow-sm h-full">
            <div class="card-body">
              <h5 class="card-title">Oktal <span class="badge bg-primary">basis 8</span></h5>
              <div class="input-group mb-2">
                <input id="oct" class="input input-bordered w-full" placeholder="Misal: 755 atau -17" />
                <button class="btn btn-outline" data-copy="oct" title="Salin">??</button>
              </div>
              <div class="text-sm opacity-60">Karakter valid: 07. Min untuk negatif.</div>
              <div class="mt-2 flex justify-between">
                <span class="badge bg-secondary" id="octInfo"></span>
              </div>
              <div class="text-error small mt-1" id="octErr"></div>
            </div>
          </div>
        </div>
      </div>

      <p class="opacity-60 small mt-4">
        ?? Tip: tekan <kbd>Tab</kbd> untuk berpindah bidang. Semua konversi dilakukan lokal di browser, tanpa internet.
      </p>
    `n

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
const el = id => document.getElementById(id);

const RE = &#123;
  dec: /^-?[0-9]+$/i,
  hex: /^-?[0-9a-f]+$/i,
  bin: /^-?[01]+$/,
  oct: /^-?[0-7]+$/
&#125;;

function stripGrouping(s)&#123; return s.replace(/\\s+/g, ""); &#125;

function parseToBigInt(str, base)&#123;
  let neg = false;
  let s = stripGrouping(String(str).trim());
  if (!s) return null;
  if (s[0] === '-') &#123; neg = true; s = s.slice(1); &#125;
  let bi;
  if (base === 10) &#123;
    bi = BigInt(s);
  &#125; else if (base === 16) &#123;
    bi = BigInt('0x' + s);
  &#125; else if (base === 2) &#123;
    bi = BigInt('0b' + s);
  &#125; else if (base === 8) &#123;
    bi = BigInt('0o' + s);
  &#125; else &#123;
    bi = [...s].reduce((acc, ch)=>&#123;
      const d = parseInt(ch, 36);
      if (Number.isNaN(d) || d >= base) throw new Error('invalid');
      return acc * BigInt(base) + BigInt(d);
    &#125;, 0n);
  &#125;
  return neg ? -bi : bi;
&#125;

function toBaseString(bi, base, &#123;uppercase=false&#125;=&#123;&#125;)&#123;
  let s = bi.toString(base);
  if (uppercase) s = s.toUpperCase();
  return s;
&#125;

function groupBinary(s)&#123;
  const neg = s.startsWith('-');
  if (neg) s = s.slice(1);
  const pad = (4 - (s.length % 4)) % 4;
  s = '0'.repeat(pad) + s;
  const parts = s.match(/.&#123;1,4&#125;/g) || [s];
  const out = parts.join(' ');
  return (neg?'-':'') + out;
&#125;

function setInfo()&#123;
  const dec = el('dec').value.trim();
  const hex = el('hex').value.trim();
  const bin = el('bin').value.trim();
  const oct = el('oct').value.trim();
  el('decInfo').textContent = dec ? \`\$&#123;dec.length&#125; digit\` : '';
  el('hexInfo').textContent = hex ? \`\$&#123;stripGrouping(hex).length&#125; digit\` : '';
  el('binInfo').textContent = bin ? \`\$&#123;stripGrouping(bin).replace(/^-/, '').replace(/\\s+/g,'').length&#125; bit\` : '';
  el('octInfo').textContent = oct ? \`\$&#123;stripGrouping(oct).length&#125; digit\` : '';
&#125;

function showError(which, msg)&#123; el(which+'Err').textContent = msg || ''; &#125;
function clearErrors()&#123; ['dec','hex','bin','oct'].forEach(x=>showError(x,'')); &#125;

let editing = null;

function updateFrom(source)&#123;
  if (editing && editing !== source) return;
  editing = source;
  clearErrors();

  const optsUpper = el('hexUpper').checked;
  const optsGroup = el('binGroup').checked;

  const raw = el(source).value.trim();
  const valid = RE[source].test(stripGrouping(raw));

  if (!raw)&#123;
    ['dec','hex','bin','oct'].forEach(id=>&#123; el(id).value=''; &#125;);
    setInfo(); editing=null; return;
  &#125;

  if (!valid)&#123;
    showError(source, 'Input tidak valid untuk basis ini.');
    editing=null; return;
  &#125;

  try&#123;
    const base = &#123;dec:10, hex:16, bin:2, oct:8&#125;[source];
    const bi = parseToBigInt(raw, base);

    el('dec').value = bi.toString(10);
    el('hex').value = toBaseString(bi, 16, &#123;uppercase: optsUpper&#125;);
    let bin = toBaseString(bi, 2);
    el('bin').value = optsGroup ? groupBinary(bin) : bin;
    el('oct').value = toBaseString(bi, 8);
    setInfo();
  &#125; catch(e)&#123;
    showError(source, 'Terjadi kesalahan saat konversi.');
  &#125; finally&#123;
    editing=null;
  &#125;
&#125;

['dec','hex','bin','oct'].forEach(id=>&#123;
  el(id).addEventListener('input', ()=>updateFrom(id));
  el(id).addEventListener('blur', setInfo);
&#125;);

el('hexUpper').addEventListener('change', ()=>&#123;
  if (el('hex').value.trim()) updateFrom('hex');
&#125;);
el('binGroup').addEventListener('change', ()=>&#123;
  if (el('bin').value.trim()) updateFrom('bin');
  else if (el('dec').value.trim()) updateFrom('dec');
&#125;);

document.querySelectorAll('[data-copy]').forEach(btn=>&#123;
  btn.addEventListener('click', async ()=>&#123;
    const id = btn.getAttribute('data-copy');
    const val = el(id).value;
    if (!val) return;
    try&#123; await navigator.clipboard.writeText(val); btn.textContent='?'; setTimeout(()=>btn.textContent='??', 900); &#125;
    catch&#123; btn.textContent='?'; setTimeout(()=>btn.textContent='??', 900); &#125;
  &#125;);
&#125;);

el('btnClear').addEventListener('click', ()=>&#123;
  ['dec','hex','bin','oct'].forEach(id=>el(id).value='');
  clearErrors(); setInfo(); el('dec').focus();
&#125;);

el('btnSample').addEventListener('click', ()=>&#123;
  el('hexUpper').checked = true; el('binGroup').checked = true;
  el('dec').value = '2025'; updateFrom('dec');
&#125;);

setInfo();
</script>

