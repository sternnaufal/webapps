---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'JSON Schema Generator';
const description = 'Generate JSON Schema dari data JSON. Buat schema validasi API, database, dan form otomatis.';
const keywords = 'json schema generator, generate schema, api schema, json validation, schema from json';
const aboutText = 'JSON Schema generator online untuk membuat JSON Schema dari data JSON secara otomatis. Alat ini membantu developer membuat schema validasi untuk API, database, dan form dengan cepat dan akurat.';
const aboutExtra = 'Tempel JSON object pada kolom input, JSON Schema akan langsung di-generate. Tersedia opsi Strict mode yang menambahkan array required untuk properti yang wajib diisi. Hasil dapat disalin ke clipboard. Semua pemrosesan dilakukan 100% di browser menggunakan logika rekursif untuk menelusuri nested object dan array, data tidak dikirim ke server mana pun.';
const relatedTools = [
  { slug: 'json-formatter', name: 'JSON Formatter', icon: '{}' },
  { slug: 'json-to-typescript', name: 'JSON to TypeScript', icon: 'TS' },
  { slug: 'json-csv', name: 'JSON to CSV', icon: '⇄' },
  { slug: 'yaml-json', name: 'YAML to JSON Converter', icon: '⇄' }
];

---

<ToolLayout title={title} description={description} keywords={keywords}>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);">

  <div class="flex gap-2 flex-wrap items-center mb-3">
    <button id="jsgBtn" class="btn btn-primary btn-sm">Generate Schema</button>
    <button id="jsgCopy" class="btn btn-ghost btn-sm">Copy</button>
    <label class="flex items-center gap-1.5 text-xs ml-auto">
      <input class="checkbox checkbox-xs" type="checkbox" id="jsgStrict">
      Strict (required)
    </label>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label for="jsgIn" class="text-xs font-medium opacity-60 mb-1 block">JSON Input</label>
      <textarea id="jsgIn" class="textarea textarea-bordered w-full text-sm font-mono" rows="16" placeholder='{"name":"John","age":30}'></textarea>
    </div>
    <div>
      <label for="jsgOut" class="text-xs font-medium opacity-60 mb-1 block">JSON Schema</label>
      <textarea id="jsgOut" class="textarea textarea-bordered w-full text-sm font-mono" rows="16" readonly></textarea>
    </div>
  </div>

</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
document.getElementById("jsgBtn").onclick=jsg;document.getElementById("jsgCopy").onclick=()=>navigator.clipboard.writeText(document.getElementById("jsgOut").value);document.getElementById("jsgIn").oninput=jsg;document.getElementById("jsgStrict").onchange=jsg;
function jsg(){const i=document.getElementById("jsgIn").value.trim();const s=document.getElementById("jsgStrict").checked;const o=document.getElementById("jsgOut");if(!i){o.value="";return}try{const obj=JSON.parse(i);const schema=jsgBuild(obj,s);o.value=JSON.stringify(schema,null,2);o.style.color="inherit"}catch(e){o.value="// Error: "+e.message;o.style.color="#dc3545"}}
function jsgBuild(val,strict){const type=Array.isArray(val)?"array":typeof val;const t={type};if(val===null){t.type="null";return t}if(type==="object"&&!Array.isArray(val)){t.properties={};t.additionalProperties=false;const req=[];Object.entries(val).forEach(([k,v])=>{t.properties[k]=jsgBuild(v,strict);if(strict)req.push(k)});if(req.length)t.required=req}else if(type==="array"){t.items=val.length>0?jsgBuild(val[0],strict):{}}else if(type==="string"){if(/^\d{4}-\d{2}-\d{2}/.test(val))t.format="date"}return t}jsg();
</script>