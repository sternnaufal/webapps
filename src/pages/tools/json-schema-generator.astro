---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'JSON Schema Generator';
const desc = 'Generate JSON Schema dari data JSON. Buat schema validasi API, database, dan form otomatis.';
const keywords = 'json schema generator, generate schema, api schema, json validation, schema from json';
const aboutText = 'JSON Schema Generator JSON Schema Generator online. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'json-formatter', name: 'Json Formatter', icon: '{}' },
  { slug: 'json-to-typescript', name: 'Json To Typescript', icon: 'TS' },
  { slug: 'json-csv', name: 'Json Csv', icon: '⇄' },
  { slug: 'yaml-json', name: 'Yaml Json', icon: '⇄' }
];
const bodyHtml = '<div class="flex flex-wrap gap-4">\n  <div class="w-full"><div class="flex gap-2 flex-wrap">\n    <button id="jsgBtn" class="btn btn-warning">Generate Schema</button>\n    <button id="jsgCopy" class="btn btn-outline">Copy</button>\n    <div class="flex items-center gap-2 form-switch flex items-center ml-auto"><input class="checkbox" type="checkbox" id="jsgStrict"><label class="flex items-center gap-2-label small" for="jsgStrict">Strict (required)</label></div>\n  </div></div>\n  <div class="md:w-1/2 w-full"><label class="label-text font-semibold">JSON Input</label><textarea id="jsgIn" class="input input-bordered w-full font-mono" rows="16" placeholder=\'{"name":"John","age":30}\'></textarea></div>\n  <div class="md:w-1/2 w-full"><label class="label-text font-semibold">JSON Schema</label><textarea id="jsgOut" class="input input-bordered w-full font-mono" rows="16" readonly></textarea></div>\n</div>';
---

<ToolLayout title={title} description=&#123;desc&#125; keywords={keywords}>
<Fragment set:html=&#123;bodyHtml&#125; />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float{position:fixed;bottom:24px;right:24px;z-index:9999;background:#ff6b6b;color:#fff;border-radius:50px;padding:10px 20px 10px 16px;text-decoration:none;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;box-shadow:0 4px 15px rgba(255,107,107,0.4);transition:all .3s ease;font-family:"Inter",sans-serif}
.saweria-float:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(255,107,107,0.6);color:#fff}
.saweria-float svg{animation:pulse 1.5s ease infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
@media(max-width:576px){.saweria-float{bottom:16px;right:16px;padding:8px 14px 8px 10px;font-size:12px}}
</style>

<script is:inline>
document.getElementById("jsgBtn").onclick=jsg;document.getElementById("jsgCopy").onclick=()=>navigator.clipboard.writeText(document.getElementById("jsgOut").value);document.getElementById("jsgIn").oninput=jsg;document.getElementById("jsgStrict").onchange=jsg;
function jsg()&#123;const i=document.getElementById("jsgIn").value.trim();const s=document.getElementById("jsgStrict").checked;const o=document.getElementById("jsgOut");if(!i)&#123;o.value="";return&#125;try&#123;const obj=JSON.parse(i);const schema=jsgBuild(obj,s);o.value=JSON.stringify(schema,null,2);o.style.color="inherit"&#125;catch(e)&#123;o.value="// Error: "+e.message;o.style.color="#dc3545"&#125;&#125;
function jsgBuild(val,strict)&#123;const type=Array.isArray(val)?"array":typeof val;const t=&#123;type&#125;;if(val===null)&#123;t.type="null";return t&#125;if(type==="object"&&!Array.isArray(val))&#123;t.properties=&#123;&#125;;t.additionalProperties=false;const req=[];Object.entries(val).forEach(([k,v])=>&#123;t.properties[k]=jsgBuild(v,strict);if(strict)req.push(k)&#125;);if(req.length)t.required=req&#125;else if(type==="array")&#123;t.items=val.length>0?jsgBuild(val[0],strict):&#123;&#125;&#125;else if(type==="string")&#123;if(/^\d&#123;4&#125;-\d&#123;2&#125;-\d&#123;2&#125;/.test(val))t.format="date"&#125;return t&#125;jsg();
</script>

