---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Regex Tester';
const description = 'Tes regular expression online dengan highlight matches. Regex tester dengan replace dan split.';
const keywords = 'regex tester, regular expression, regex online, regex test, regex tool';
const aboutText = 'Regex tester online untuk menguji pola regular expression secara langsung. Alat ini mendukung test pattern, replace, dan split dengan visual highlight pada matched text. Sangat berguna bagi developer, data analyst, dan siapa pun yang bekerja dengan pencarian teks berbasis pola.';
const aboutExtra = 'Masukkan pola regex (tanpa delimiter), atur flags seperti g (global), i (case-insensitive), m (multiline), lalu tulis teks yang ingin diuji. Panel Match Results akan menampilkan semua hasil kecocokan beserta posisinya. Fitur Replace memungkinkan penggantian teks yang cocok dengan string baru. Semua pemrosesan dilakukan 100% di browser, data tidak dikirim ke server mana pun.';
const relatedTools = [
  { slug: 'json-formatter', name: 'JSON Formatter', icon: '{}' },
  { slug: 'diff-checker', name: 'Diff Checker', icon: '⇔' },
  { slug: 'slug-generator', name: 'Slug Generator', icon: '🔗' },
  { slug: 'html-preview', name: 'HTML Preview', icon: '</>' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
    <div>
      <label for="regexPattern" class="text-xs font-medium opacity-60 mb-1 block">Pattern</label>
      <div class="join w-full">
        <span class="input input-bordered input-sm join-item flex items-center px-2 text-xs opacity-50">/</span>
        <input type="text" id="regexPattern" class="input input-bordered w-full input-sm join-item font-mono" placeholder="[a-z]+" value="\b\w&#123;4,&#125;\b">
        <span class="input input-bordered input-sm join-item flex items-center px-2 text-xs opacity-50">/</span>
        <input type="text" id="regexFlags" class="input input-bordered input-sm join-item font-mono" placeholder="gmi" value="gm" style="max-width: 80px;">
      </div>
    </div>
    <div>
      <label for="replaceText" class="text-xs font-medium opacity-60 mb-1 block">Replace with</label>
      <div class="flex gap-2">
        <input type="text" id="replaceText" class="input input-bordered w-full input-sm font-mono" placeholder="(opsional)">
        <button id="btnReplace" class="btn btn-primary btn-sm">Replace</button>
        <button id="btnClear" class="btn btn-ghost btn-sm">Clear</button>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label for="testArea" class="text-xs font-medium opacity-60 mb-1 block">Test String</label>
      <textarea id="testArea" class="textarea textarea-bordered w-full text-sm font-mono" rows="6" placeholder="Masukkan teks untuk diuji...">The quick brown fox jumps over the lazy dog. Contact: support@example.com or call 555-1234.</textarea>
      <div id="highlightedPreview" class="border rounded p-3 mt-2" style="min-height: 80px; white-space: pre-wrap; font-family: monospace; font-size: 0.9rem; border-color: oklch(0.9 0.005 270);"></div>
    </div>
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Match Results</label>
      <div class="rounded-lg p-3" style="background:oklch(0.96 0.003 270);border:1px solid oklch(0.9 0.005 270);">
        <div id="matchCount" class="text-xs opacity-60 mb-2">0 matches</div>
        <div id="matchList" style="max-height: 300px; overflow-y: auto; font-family: monospace; font-size: 0.8rem;"></div>
      </div>
    </div>
  </div>

</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var pattern = document.getElementById('regexPattern');
var flags = document.getElementById('regexFlags');
var testArea = document.getElementById('testArea');
var preview = document.getElementById('highlightedPreview');
var matchCount = document.getElementById('matchCount');
var matchList = document.getElementById('matchList');
var replaceText = document.getElementById('replaceText');

function update() {
  try {
    var re = new RegExp(pattern.value, flags.value);
    var text = testArea.value;
    var matches = [];
    var m;
    var safety = 0;
    while ((m = re.exec(text)) !== null) {
      matches.push({ index: m.index, text: m[0], groups: m.slice(1) });
      if (!re.global) break;
      if (m.index === re.lastIndex) re.lastIndex++;
      if (++safety > 50000) { matches.push({ text: '(truncated at 50k matches)', index: -1, groups: [] }); break; }
    }

    if (matches.length === 0) {
      preview.textContent = text;
      matchCount.textContent = '0 matches';
      matchList.innerHTML = '<div class="opacity-60 p-2">No matches</div>';
      return;
    }

    matchCount.textContent = matches.length + (matches.length === 1 ? ' match' : ' matches');
    var listHtml = '';
    matches.forEach(function(mt, i) {
      var groups = mt.groups.length > 0 ? ' groups: [' + mt.groups.join(', ') + ']' : '';
      listHtml += '<div class="border-bottom py-1 px-1"><span class="badge bg-secondary mr-1">' + (i + 1) + '</span> <span class="text-success">"' + escapeHtml(mt.text) + '"</span> <span class="opacity-60">@' + mt.index + '</span>' + groups + '</div>';
    });
    matchList.innerHTML = listHtml;

    var html = '';
    var lastIdx = 0;
    matches.forEach(function(mt) {
      html += escapeHtml(text.slice(lastIdx, mt.index));
      html += '<span class="bg-warning bg-opacity-25 border border-warning rounded px-1">' + escapeHtml(mt.text) + '</span>';
      lastIdx = mt.index + mt.text.length;
    });
    html += escapeHtml(text.slice(lastIdx));
    preview.innerHTML = html;
  } catch (e) {
    preview.textContent = 'Error: ' + e.message;
    matchCount.textContent = '';
    matchList.innerHTML = '<div class="text-error p-2">' + escapeHtml(e.message) + '</div>';
  }
}

function escapeHtml(s) {
  var div = document.createElement('div');
  div.textContent = s;
  return div.innerHTML;
}

function doReplace() {
  try {
    var re = new RegExp(pattern.value, flags.value);
    var replacement = replaceText.value;
    testArea.value = testArea.value.replace(re, replacement);
    update();
  } catch (e) {
    alert('Regex error: ' + e.message);
  }
}

pattern.addEventListener('input', update);
flags.addEventListener('input', update);
testArea.addEventListener('input', update);
document.getElementById('btnReplace').addEventListener('click', doReplace);
document.getElementById('btnClear').addEventListener('click', function() { testArea.value = ''; update(); });

update();
</script>