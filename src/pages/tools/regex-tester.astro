---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Regex Tester';
const description = 'Tes regular expression online dengan highlight matches. Regex tester dengan replace dan split.';
const keywords = 'regex tester, regular expression, regex online, regex test, regex tool';
const aboutText = 'Regex Tester Tes regular expression online dengan highlight matches. Regex tester dengan replace dan split.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'json-formatter', name: 'Json Formatter', icon: '{}' },
  { slug: 'diff-checker', name: 'Diff Checker', icon: '⇔' },
  { slug: 'slug-generator', name: 'Slug Generator', icon: '🔗' },
  { slug: 'html-preview', name: 'Html Preview', icon: '</>' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="flex flex-wrap gap-3 mb-4">
        <div class="md:w-1/2 w-full">
          <label for="regexPattern" class="label-text">Pattern</label>
          <div class="input-group">
            <span class="input-group-text">/</span>
            <input type="text" id="regexPattern" class="input input-bordered w-full font-monospace" placeholder="[a-z]+" value="\b\w&#123;4,&#125;\b">
            <span class="input-group-text">/</span>
            <input type="text" id="regexFlags" class="input input-bordered w-full font-monospace" placeholder="gmi" value="gm" style="max-width: 80px;">
          </div>
        </div>
        <div class="md:w-1/4 w-full">
          <label class="label-text">Replace with</label>
          <input type="text" id="replaceText" class="input input-bordered w-full font-monospace" placeholder="(opsional)">
        </div>
        <div class="md:w-1/4 w-full flex align-items-end gap-2">
          <button id="btnReplace" class="btn btn-warning">Replace</button>
          <button id="btnClear" class="btn btn-outline-danger">Clear</button>
        </div>
      </div>

      <div class="flex flex-wrap gap-4">
        <div class="col-lg-8">
          <label for="testArea" class="label-text">Test String</label>
          <textarea id="testArea" class="input input-bordered w-full" placeholder="Masukkan teks untuk diuji...">The quick brown fox jumps over the lazy dog. Contact: support@example.com or call 555-1234.</textarea>
          <div id="highlightedPreview" class="border rounded p-3 mt-2 bg-white" style="min-height: 80px; white-space: pre-wrap; font-family: monospace; font-size: 0.9rem;"></div>
        </div>
        <div class="col-lgap-4">
          <div class="card shadow-sm">
            <div class="card-header font-semibold">Match Results</div>
            <div class="card-body p-2">
              <div id="matchCount" class="small mb-2 opacity-60">0 matches</div>
              <div id="matchList" style="max-height: 300px; overflow-y: auto; font-family: monospace; font-size: 0.8rem;"></div>
            </div>
          </div>
        </div>
      </div>
    `n

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
</script>

<script is:inline>
var pattern = document.getElementById('regexPattern');
var flags = document.getElementById('regexFlags');
var testArea = document.getElementById('testArea');
var preview = document.getElementById('highlightedPreview');
var matchCount = document.getElementById('matchCount');
var matchList = document.getElementById('matchList');
var replaceText = document.getElementById('replaceText');

function update() &#123;
  try &#123;
    var re = new RegExp(pattern.value, flags.value);
    var text = testArea.value;
    var matches = [];
    var m;
    var safety = 0;
    while ((m = re.exec(text)) !== null) &#123;
      matches.push(&#123; index: m.index, text: m[0], groups: m.slice(1) &#125;);
      if (!re.global) break;
      if (m.index === re.lastIndex) re.lastIndex++;
      if (++safety > 50000) &#123; matches.push(&#123; text: '(truncated at 50k matches)', index: -1, groups: [] &#125;); break; &#125;
    &#125;

    if (matches.length === 0) &#123;
      preview.textContent = text;
      matchCount.textContent = '0 matches';
      matchList.innerHTML = '<div class="opacity-60 p-2">No matches</div>';
      return;
    &#125;

    matchCount.textContent = matches.length + (matches.length === 1 ? ' match' : ' matches');
    var listHtml = '';
    matches.forEach(function(mt, i) &#123;
      var groups = mt.groups.length > 0 ? ' groups: [' + mt.groups.join(', ') + ']' : '';
      listHtml += '<div class="border-bottom py-1 px-1"><span class="badge bg-secondary mr-1">' + (i + 1) + '</span> <span class="text-success">"' + escapeHtml(mt.text) + '"</span> <span class="opacity-60">@' + mt.index + '</span>' + groups + '</div>';
    &#125;);
    matchList.innerHTML = listHtml;

    var html = '';
    var lastIdx = 0;
    matches.forEach(function(mt) &#123;
      html += escapeHtml(text.slice(lastIdx, mt.index));
      html += '<span class="bg-warning bg-opacity-25 border border-warning rounded px-1">' + escapeHtml(mt.text) + '</span>';
      lastIdx = mt.index + mt.text.length;
    &#125;);
    html += escapeHtml(text.slice(lastIdx));
    preview.innerHTML = html;
  &#125; catch (e) &#123;
    preview.textContent = 'Error: ' + e.message;
    matchCount.textContent = '';
    matchList.innerHTML = '<div class="text-error p-2">' + escapeHtml(e.message) + '</div>';
  &#125;
&#125;

function escapeHtml(s) &#123;
  var div = document.createElement('div');
  div.textContent = s;
  return div.innerHTML;
&#125;

function doReplace() &#123;
  try &#123;
    var re = new RegExp(pattern.value, flags.value);
    var replacement = replaceText.value;
    testArea.value = testArea.value.replace(re, replacement);
    update();
  &#125; catch (e) &#123;
    alert('Regex error: ' + e.message);
  &#125;
&#125;

pattern.addEventListener('input', update);
flags.addEventListener('input', update);
testArea.addEventListener('input', update);
document.getElementById('btnReplace').addEventListener('click', doReplace);
document.getElementById('btnClear').addEventListener('click', function() &#123; testArea.value = ''; update(); &#125;);

update();
</script>

