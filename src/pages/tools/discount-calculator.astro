---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Discount Calculator';
const description = 'Kalkulator diskon online. Hitung harga setelah diskon, jumlah diskon, dan hemat. Menghitung persentase diskon dengan cepat dan akurat.';
const keywords = 'discount calculator, kalkulator diskon, hitung diskon, persen diskon, harga setelah diskon';
const aboutText = 'Discount Calculator Kalkulator diskon online. Hitung harga setelah diskon, jumlah diskon, dan hemat. Menghitung persentase diskon dengan cepat dan akurat.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'tip-calculator', name: 'Tip Calculator', icon: '💰' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' },
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' },
  { slug: 'mortgage-calculator', name: 'Mortgage Calculator', icon: '🏠' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#fef2f2;color:#dc2626;">%</div><div><h1 class="h3 mb-0">Discount Calculator</h1><p class="opacity-60 small mb-0">Hitung harga setelah diskon, jumlah diskon, dan total penghematan.</p></div></header>
<div class="flex flex-wrap gap-4"><div class="lg:w-7/12 w-full">
<div class="card card-bordered bg-base-100 p-3">
<div class="mb-3"><label class="label-text font-semibold small">Harga Asli (Rp)</label><input type="number" id="originalPrice" class="input input-bordered w-full" value="100000" min="0"></div>
<div class="flex flex-wrap gap-3 mb-3">
<div class="col-6"><label class="label-text small">Diskon 1 (%)</label><input type="number" id="disc1" class="input input-bordered w-full" value="20" min="0" max="100"></div>
<div class="col-6"><label class="label-text small">Diskon 2 (%)</label><input type="number" id="disc2" class="input input-bordered w-full" value="0" min="0" max="100"></div>
</div>
<button id="btnCalc" class="btn btn-primary w-full">Hitung Diskon</button>
</div>
<div class="card card-bordered bg-base-100 p-3 mt-3">
<table class="table table-sm mb-0">
<tr><td class="opacity-60">Harga Asli</td><td class="text-right font-bold" id="originalDisplay">Rp 100.000</td></tr>
<tr><td class="opacity-60">Diskon 1</td><td class="text-right text-error" id="discount1Display">-Rp 20.000</td></tr>
<tr id="disc2Row" style="display:none"><td class="opacity-60">Diskon 2</td><td class="text-right text-error" id="discount2Display">-Rp 0</td></tr>
<tr><td class="opacity-60">Total Diskon</td><td class="text-right text-error font-bold" id="totalDiscountDisplay">-Rp 20.000</td></tr>
<tr class="table-active"><td class="font-bold">Harga Akhir</td><td class="text-right font-bold text-success fs-5" id="finalPriceDisplay">Rp 80.000</td></tr>
<tr><td class="opacity-60">Hemat</td><td class="text-right text-success" id="savedDisplay">Rp 20.000</td></tr>
</table>
</div></div>
<div class="lg:w-5/12 w-full">
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Preset Diskon</h6>
<div class="flex gap-2 flex-wrap">
<button class="btn btn-outline-danger btn-sm preset" data-d1="10">10%</button>
<button class="btn btn-outline-danger btn-sm preset" data-d1="20">20%</button>
<button class="btn btn-outline-danger btn-sm preset" data-d1="30">30%</button>
<button class="btn btn-outline-danger btn-sm preset" data-d1="50">50%</button>
<button class="btn btn-outline-danger btn-sm preset" data-d1="70">70%</button>
<button class="btn btn-outline-danger btn-sm preset" data-d1="10" data-d2="10">10+10%</button>
</div>
</div>
</div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var ori=document.getElementById('originalPrice'),d1=document.getElementById('disc1'),d2=document.getElementById('disc2'),d2r=document.getElementById('disc2Row');
function fmt(x){return'Rp '+x.toLocaleString('id-ID')}
function calc(){
  var o=parseFloat(ori.value)||0,a=parseFloat(d1.value)||0,b=parseFloat(d2.value)||0;
  var ad=o*a/100,bd=(o-ad)*b/100,td=ad+bd,fp=o-td;
  document.getElementById('originalDisplay').textContent=fmt(o);
  document.getElementById('discount1Display').textContent='-'+fmt(ad);
  d2r.style.display=b>0?'':'none';
  document.getElementById('discount2Display').textContent='-'+fmt(bd);
  document.getElementById('totalDiscountDisplay').textContent='-'+fmt(td);
  document.getElementById('finalPriceDisplay').textContent=fmt(fp);
  document.getElementById('savedDisplay').textContent=fmt(td);
}
document.getElementById('btnCalc').addEventListener('click',calc);
document.querySelectorAll('.preset').forEach(function(el){el.addEventListener('click',function(){
  d1.value=this.dataset.d1||0;d2.value=this.dataset.d2||0;calc();
})});
calc();
</script>

