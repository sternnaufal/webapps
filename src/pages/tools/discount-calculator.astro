---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Discount Calculator';
const description = 'Kalkulator diskon online. Hitung harga setelah diskon, jumlah diskon, dan hemat. Menghitung persentase diskon dengan cepat dan akurat.';
const keywords = 'discount calculator, kalkulator diskon, hitung diskon, persen diskon, harga setelah diskon';
const aboutText = 'Discount Calculator Kalkulator diskon online. Hitung harga setelah diskon, jumlah diskon, dan hemat. Menghitung persentase diskon dengan cepat dan akurat.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'tip-calculator', name: 'Tip Calculator', icon: '💰' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' },
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' },
  { slug: 'mortgage-calculator', name: 'Mortgage Calculator', icon: '🏠' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="mb-3"><label class="text-xs font-medium opacity-60 mb-1 block">Harga Asli (Rp)</label><input type="number" id="originalPrice" class="input input-bordered w-full input-sm" value="100000" min="0"></div>
      <div class="grid grid-cols-2 gap-3 mb-3">
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Diskon 1 (%)</label><input type="number" id="disc1" class="input input-bordered w-full input-sm" value="20" min="0" max="100"></div>
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Diskon 2 (%)</label><input type="number" id="disc2" class="input input-bordered w-full input-sm" value="0" min="0" max="100"></div>
      </div>
      <button id="btnCalc" class="btn btn-primary btn-sm w-full">Hitung Diskon</button>
    </div>
    <div class="rounded-xl p-5 mt-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <table class="table table-sm w-full text-xs mb-0">
        <tr><td class="py-1 opacity-60">Harga Asli</td><td class="py-1 text-right font-bold" id="originalDisplay">Rp 100.000</td></tr>
        <tr><td class="py-1 opacity-60">Diskon 1</td><td class="py-1 text-right text-red-500" id="discount1Display">-Rp 20.000</td></tr>
        <tr id="disc2Row" style="display:none"><td class="py-1 opacity-60">Diskon 2</td><td class="py-1 text-right text-red-500" id="discount2Display">-Rp 0</td></tr>
        <tr><td class="py-1 opacity-60">Total Diskon</td><td class="py-1 text-right text-red-500 font-bold" id="totalDiscountDisplay">-Rp 20.000</td></tr>
        <tr style="background:oklch(0.55 0.25 270 / 0.08);"><td class="py-1 font-medium">Harga Akhir</td><td class="py-1 text-right font-bold text-green-600" id="finalPriceDisplay">Rp 80.000</td></tr>
        <tr><td class="py-1 opacity-60">Hemat</td><td class="py-1 text-right text-green-600" id="savedDisplay">Rp 20.000</td></tr>
      </table>
    </div>
  </div>
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Preset Diskon</div>
      <div class="flex gap-2 flex-wrap">
        <button class="btn btn-ghost btn-xs preset" data-d1="10">10%</button>
        <button class="btn btn-ghost btn-xs preset" data-d1="20">20%</button>
        <button class="btn btn-ghost btn-xs preset" data-d1="30">30%</button>
        <button class="btn btn-ghost btn-xs preset" data-d1="50">50%</button>
        <button class="btn btn-ghost btn-xs preset" data-d1="70">70%</button>
        <button class="btn btn-ghost btn-xs preset" data-d1="10" data-d2="10">10+10%</button>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
var ori=document.getElementById('originalPrice'),d1=document.getElementById('disc1'),d2=document.getElementById('disc2'),d2r=document.getElementById('disc2Row');
function fmt(x){return'Rp '+x.toLocaleString('id-ID')}
function calc(){
  var o=parseFloat(ori.value)||0,a=parseFloat(d1.value)||0,b=parseFloat(d2.value)||0;
  var ad=o*a/100,bd=(o-ad)*b/100,td=ad+bd,fp=o-td;
  document.getElementById('originalDisplay').textContent=fmt(o);
  document.getElementById('discount1Display').textContent='-'+fmt(ad);
  d2r.style.display=b>0?'':'none';
  document.getElementById('discount2Display').textContent='-'+fmt(bd);
  document.getElementById('totalDiscountDisplay').textContent='-'+fmt(td);
  document.getElementById('finalPriceDisplay').textContent=fmt(fp);
  document.getElementById('savedDisplay').textContent=fmt(td);
}
document.getElementById('btnCalc').addEventListener('click',calc);
document.querySelectorAll('.preset').forEach(function(el){el.addEventListener('click',function(){
  d1.value=this.dataset.d1||0;d2.value=this.dataset.d2||0;calc();
})});
calc();
</script>