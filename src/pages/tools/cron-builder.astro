---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Cron Expression Builder';
const description = 'Buat dan uji ekspresi cron online. Cron builder dengan visual preview dan penjelasan schedule.';
const keywords = 'cron, cron expression, cron builder, cron job, scheduler';
const aboutText = 'Cron expression builder online untuk membuat, menguji, dan memahami ekspresi cron. Dilengkapi preset umum (every minute, every hour, daily midnight, weekdays 9 AM, monthly) dan penjelasan schedule real-time.';
const aboutExtra = 'Cron expression digunakan secara luas untuk penjadwalan task otomatis di sistem Unix/Linux (crontab), pipeline CI/CD (GitHub Actions, GitLab CI), dan berbagai scheduler aplikasi. Format standar cron memiliki 5 field: menit (0-59), jam (0-23), hari bulan (1-31), bulan (1-12), dan hari minggu (0-7, 0/7 = Minggu). Alat ini juga mendukung preset @yearly, @monthly, @weekly, @daily, @midnight, dan @hourly yang langsung dikonversi ke ekspresi cron standar. Semua pemrosesan dilakukan 100% di browser, data tidak dikirim ke server mana pun.';
const relatedTools = [
  { slug: 'subnetting', name: 'Subnetting', icon: '📐' },
  { slug: 'ip-calculator', name: 'IP Calculator', icon: '🔌' },
  { slug: 'epoch-converter', name: 'Epoch Converter', icon: '⏱' },
  { slug: 'timer', name: 'Timer', icon: '⏱' }
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #3b82f6;">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="md:col-span-2">
        <label class="text-xs font-medium opacity-60 mb-1 block">Preset</label>
        <div class="flex gap-2 flex-wrap mb-3">
          <button class="btn btn-ghost btn-sm preset" data-cron="* * * * *">Every minute</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="*/5 * * * *">Every 5 min</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="*/15 * * * *">Every 15 min</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="0 * * * *">Every hour</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="0 */6 * * *">Every 6 hours</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="0 0 * * *">Daily midnight</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="0 9 * * 1-5">Weekdays 9 AM</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="0 0 1 * *">Monthly</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="@daily">@daily</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="@weekly">@weekly</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="@monthly">@monthly</button>
          <button class="btn btn-ghost btn-sm preset" data-cron="@yearly">@yearly</button>
        </div>
        <label class="text-xs font-medium opacity-60 mb-1 block">Cron Expression</label>
        <div class="flex gap-2">
          <input id="cronExpr" class="input input-bordered w-full input-sm font-mono" value="*/5 * * * *">
          <button id="btnCopy" class="btn btn-ghost btn-sm">Copy</button>
        </div>
        <div id="cronDesc" class="mt-2 text-sm opacity-60"></div>
      </div>
      <div>
        <h6 class="text-xs font-medium opacity-60 mb-2">Legend</h6>
        <div class="text-xs space-y-1">
          <div class="flex gap-3"><span class="opacity-60 w-12">min</span><span>0-59</span></div>
          <div class="flex gap-3"><span class="opacity-60 w-12">hour</span><span>0-23</span></div>
          <div class="flex gap-3"><span class="opacity-60 w-12">day</span><span>1-31</span></div>
          <div class="flex gap-3"><span class="opacity-60 w-12">month</span><span>1-12</span></div>
          <div class="flex gap-3"><span class="opacity-60 w-12">weekday</span><span>0-7 (0/7=Sun)</span></div>
        </div>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
var inp=document.getElementById('cronExpr'),desc=document.getElementById('cronDesc');
var PRESETS={'@yearly':'0 0 1 1 *','@annually':'0 0 1 1 *','@monthly':'0 0 1 * *','@weekly':'0 0 * * 0','@daily':'0 0 * * *','@midnight':'0 0 * * *','@hourly':'0 * * * *'};
function describe(e){e=e.trim();if(PRESETS[e])e=PRESETS[e];var p=e.split(/\s+/);if(p.length!==5){desc.textContent='Expression tidak valid. Gunakan 5 field atau @preset.';return}
var labels=[['minute','minutes'],['hour','hours'],['day','days'],['month','months'],['weekday','weekdays']];
var parts=[];for(var i=0;i<5;i++){var f=p[i];if(f==='*')parts.push('every '+labels[i][1]);else if(f.startsWith('*/'))parts.push('every '+f.slice(2)+' '+labels[i][1]);else parts.push(f+' '+labels[i][0])}
desc.textContent=parts.join(', ')}
inp.addEventListener('input',function(){describe(inp.value)});describe(inp.value);
document.querySelectorAll('.preset').forEach(function(b){b.addEventListener('click',function(){inp.value=this.getAttribute('data-cron');describe(inp.value)})});
document.getElementById('btnCopy').addEventListener('click',function(){var b=this;navigator.clipboard.writeText(inp.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)})});
</script>