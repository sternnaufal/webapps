---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Cron Expression Builder';
const description = 'Buat dan uji ekspresi cron online. Cron builder dengan visual preview dan penjelasan schedule.';
const keywords = 'cron, cron expression, cron builder, cron job, scheduler';
const aboutText = 'Cron Expression Builder Buat dan uji ekspresi cron online. Cron builder dengan visual preview dan penjelasan schedule.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'subnetting', name: 'Subnetting', icon: '📐' },
  { slug: 'ip-calculator', name: 'Ip Calculator', icon: '🔌' },
  { slug: 'epoch-converter', name: 'Epoch Converter', icon: '⏱' },
  { slug: 'timer', name: 'Timer', icon: '⏱' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#fef2f2;color:#ef4444;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div><h1 class="h3 mb-0">Cron Expression Builder</h1><p class="opacity-60 small mb-0">Buat cron expression dengan GUI. Copy-paste ke crontab, scheduler, atau GitHub Actions.</p></div></header>
<div class="flex flex-wrap gap-3 mb-4">
<div class="md:w-2/3 w-full"><div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Preset</h6>
<div class="flex gap-2 flex-wrap mb-3">
<button class="btn btn-outline-primary btn-sm preset" data-cron="* * * * *">Every minute</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="*/5 * * * *">Every 5 min</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="*/15 * * * *">Every 15 min</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="0 * * * *">Every hour</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="0 */6 * * *">Every 6 hours</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="0 0 * * *">Daily midnight</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="0 9 * * 1-5">Weekdays 9 AM</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="0 0 1 * *">Monthly</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="@daily">@daily</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="@weekly">@weekly</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="@monthly">@monthly</button>
<button class="btn btn-outline-primary btn-sm preset" data-cron="@yearly">@yearly</button>
</div>
<label class="label-text font-semibold">Cron Expression</label>
<div class="input-group"><input id="cronExpr" class="input input-bordered w-full font-mono" value="*/5 * * * *"><button id="btnCopy" class="btn btn-outline">Copy</button></div>
<div id="cronDesc" class="mt-2 text-sm opacity-60"></div></div></div>
<div class="md:w-1/3 w-full"><div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Legend</h6>
<table class="table table-sm small mb-0"><tr><td class="opacity-60">min</td><td>0-59</td></tr><tr><td class="opacity-60">hour</td><td>0-23</td></tr><tr><td class="opacity-60">day</td><td>1-31</td></tr><tr><td class="opacity-60">month</td><td>1-12</td></tr><tr><td class="opacity-60">weekday</td><td>0-7 (0/7=Sun)</td></tr></table></div></div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
var inp=document.getElementById('cronExpr'),desc=document.getElementById('cronDesc');
var PRESETS=&#123;'@yearly':'0 0 1 1 *','@annually':'0 0 1 1 *','@monthly':'0 0 1 * *','@weekly':'0 0 * * 0','@daily':'0 0 * * *','@midnight':'0 0 * * *','@hourly':'0 * * * *'&#125;;
function describe(e)&#123;e=e.trim();if(PRESETS[e])e=PRESETS[e];var p=e.split(/\\s+/);if(p.length!==5)&#123;desc.textContent='Expression tidak valid. Gunakan 5 field atau @preset.';return&#125;
var labels=[['minute','minutes'],['hour','hours'],['day','days'],['month','months'],['weekday','weekdays']];
var parts=[];for(var i=0;i<5;i++)&#123;var f=p[i];if(f==='*')parts.push('every '+labels[i][1]);else if(f.startsWith('*/'))parts.push('every '+f.slice(2)+' '+labels[i][1]);else parts.push(f+' '+labels[i][0])&#125;
desc.textContent=parts.join(', ')&#125;
inp.addEventListener('input',function()&#123;describe(inp.value)&#125;);describe(inp.value);
document.querySelectorAll('.preset').forEach(function(b)&#123;b.addEventListener('click',function()&#123;inp.value=this.getAttribute('data-cron');describe(inp.value)&#125;)&#125;);
document.getElementById('btnCopy').addEventListener('click',function()&#123;var b=this;navigator.clipboard.writeText(inp.value).then(function()&#123;b.textContent='Copied!';setTimeout(function()&#123;b.textContent='Copy'&#125;,1500)&#125;)&#125;);
</script>

