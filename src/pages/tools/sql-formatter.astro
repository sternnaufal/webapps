---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'SQL Formatter';
const description = 'Format dan beautify SQL query online. SQL formatter dengan keyword highlighting.';
const keywords = 'sql formatter, sql beautifier, format sql, sql online, sql prettify';
const aboutText = 'SQL formatter online untuk memformat dan mempercantik query SQL. Alat ini secara otomatis menambahkan indentasi, line breaks, dan kapitalisasi pada keyword SQL sehingga query lebih mudah dibaca. Mendukung berbagai database termasuk MySQL, PostgreSQL, dan SQL Server.';
const aboutExtra = 'Fitur yang tersedia: format (beautify) dengan indentasi keyword utama seperti SELECT, FROM, WHERE, JOIN, GROUP BY, dll. Juga tersedia mode minify untuk memperkecil ukuran query. Cocok digunakan saat debugging query kompleks, code review, atau dokumentasi.';
const relatedTools = [
  { slug: 'json-formatter', name: 'JSON Formatter', icon: '{}' },
  { slug: 'yaml-json', name: 'YAML/JSON Converter', icon: '⇄' },
  { slug: 'css-minifier', name: 'CSS Minifier', icon: 'CSS' },
  { slug: 'html-minifier', name: 'HTML Minifier', icon: 'CSS' },
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-3">
      <div>
        <label for="sqlInput" class="text-xs font-medium opacity-60 mb-1 block">Input SQL</label>
        <textarea id="sqlInput" class="textarea textarea-bordered w-full text-sm font-mono" rows="10" placeholder="Paste SQL query...">SELECT id, name, email, created_at FROM users WHERE status = 'active' ORDER BY created_at DESC LIMIT 10</textarea>
        <div class="flex gap-2 mt-2">
          <button id="btnFormat" class="btn btn-primary btn-sm">Format</button>
          <button id="btnMinify" class="btn btn-ghost btn-sm">Minify</button>
          <button id="btnClear" class="btn btn-ghost btn-sm">Clear</button>
        </div>
      </div>
      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="text-xs font-medium opacity-60 mb-0">Output</label>
          <button id="btnCopy" class="btn btn-ghost btn-xs">Copy</button>
        </div>
        <textarea id="sqlOutput" class="textarea textarea-bordered w-full text-sm font-mono" rows="10" readonly></textarea>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
var inp=document.getElementById('sqlInput'),out=document.getElementById('sqlOutput');
var KW=['SELECT','FROM','WHERE','AND','OR','NOT','IN','IS','NULL','LIKE','BETWEEN','EXISTS','ORDER BY','GROUP BY','HAVING','LIMIT','OFFSET','JOIN','INNER JOIN','LEFT JOIN','RIGHT JOIN','FULL JOIN','CROSS JOIN','ON','AS','INSERT INTO','VALUES','UPDATE','SET','DELETE FROM','CREATE TABLE','ALTER TABLE','DROP TABLE','INDEX','UNIQUE','PRIMARY KEY','FOREIGN KEY','REFERENCES','CASCADE','DEFAULT','CHECK','CONSTRAINT','DISTINCT','COUNT','SUM','AVG','MIN','MAX','CASE','WHEN','THEN','ELSE','END','UNION','ALL','ASC','DESC','INSERT','INTO','TABLE','CREATE','ALTER','DROP','INDEX','VIEW'];
function escapeRegex(s){return s.replace(/[.*+?${}()|[\]\\]/g,'\\$&')}
function format(){
  var s=inp.value;if(!s.trim()){out.value='';return}
  var kwMap={};KW.forEach(function(k){kwMap[k.toLowerCase()]=k});
  var t=s.replace(/\b[a-zA-Z]+\b/g,function(m){var l=m.toLowerCase();return kwMap[l]||m});
  t=t.replace(/\s*,\s*/g,', ').replace(/\s+/g,' ').trim();
  var indent=0,lines=[],tokens=t.split(/\b(?=(?:SELECT|FROM|WHERE|AND|OR|ORDER BY|GROUP BY|HAVING|LIMIT|OFFSET|JOIN|INNER JOIN|LEFT JOIN|RIGHT JOIN|FULL JOIN|CROSS JOIN|ON|UNION|INSERT INTO|VALUES|SET|INTO)\b)|(?<=\b(?:SELECT|FROM|WHERE|AND|OR|ORDER BY|GROUP BY|HAVING|LIMIT|OFFSET|JOIN|INNER JOIN|LEFT JOIN|RIGHT JOIN|FULL JOIN|CROSS JOIN|ON|UNION|INSERT INTO|VALUES|SET|INTO)\b)/i);
  if(tokens.length<2)tokens=[t];
  var bigKWs=['SELECT','FROM','WHERE','ORDER BY','GROUP BY','HAVING','LIMIT','OFFSET','UNION'];
  for(var i=0;i<tokens.length;i++){
    var tok=tokens[i].trim();if(!tok)continue;
    var isBig=bigKWs.some(function(k){return tok.toUpperCase().startsWith(k)});
    var isJoin=tok.toUpperCase().startsWith('JOIN')||tok.toUpperCase().endsWith(' JOIN');
    if(isBig||isJoin){lines.push('  '.repeat(indent)+tok);if(tok.toUpperCase()==='SELECT')indent++}
    else{lines.push('  '.repeat(indent+1)+tok)}
  }
  if(lines.length<2)out.value=t;
  else out.value=lines.join('\n').replace(/,/g,',\n'+'  '.repeat(indent));
}
function minify(){var s=inp.value.replace(/--.*/g,'').replace(/\/\*[\s\S]*?\*\//g,'').replace(/\s+/g,' ').trim();out.value=s}
document.getElementById('btnFormat').addEventListener('click',format);
document.getElementById('btnMinify').addEventListener('click',minify);
document.getElementById('btnClear').addEventListener('click',function(){inp.value='';out.value=''});
document.getElementById('btnCopy').addEventListener('click',function(){
  if(!out.value)return;var b=this;
  navigator.clipboard.writeText(out.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)});
});
</script>
