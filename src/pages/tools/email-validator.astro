---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Email Validator';
const desc = 'Validasi format email sesuai standar RFC 5322. Cek format, local part, domain, dan TLD.';
const keywords = 'email validator, email check, validasi email, format email, rfc 5322';
const aboutText = 'Validasi format email sesuai standar RFC 5322. Cek format, local part, domain, dan TLD.';
const relatedTools = [
  { slug: 'user-agent-parser', name: 'User Agent Parser', icon: '🖥' },
  { slug: 'url-encode', name: 'Url Encode', icon: '%' },
  { slug: 'slug-generator', name: 'Slug Generator', icon: '🔗' },
  { slug: 'html-entity', name: 'Html Entity', icon: '&' }
];
const bodyHtml = '<div class="flex flex-wrap gap-4">\n  <div class="w-full">\n    <div class="input-group input-group-lg"><input type="email" id="evIn" class="input input-bordered w-full" placeholder="Masukkan email..." value="user@example.com"><button id="evBtn" class="btn btn-warning">Check</button></div>\n  </div>\n  <div class="md:w-1/2 w-full">\n    <div class="card card-bordered bg-base-100 p-4 text-center">\n      <div class="opacity-60 small mb-2">Status</div>\n      <div id="evStatus" class="text-2xl font-bold mb-2">---</div>\n      <div id="evMsg" class="text-sm opacity-60">Masukkan email dan klik Check</div>\n    </div>\n  </div>\n  <div class="md:w-1/2 w-full">\n    <div class="card card-bordered bg-base-100 p-3 small">\n      <h6 class="font-semibold mb-2">Detail</h6>\n      <table class="table table-sm mb-0"><tbody>\n        <tr><td class="opacity-60">Format</td><td id="evFormat" class="font-semibold">---</td></tr>\n        <tr><td class="opacity-60">Local part</td><td id="evLocal" class="font-semibold">---</td></tr>\n        <tr><td class="opacity-60">Domain</td><td id="evDomain" class="font-semibold">---</td></tr>\n        <tr><td class="opacity-60">TLD</td><td id="evTLD" class="font-semibold">---</td></tr>\n        <tr><td class="opacity-60">Panjang</td><td id="evLen" class="font-semibold">---</td></tr>\n      </tbody></table>\n    </div>\n  </div>\n</div>';
---

<ToolLayout title={title} description=&#123;desc&#125; keywords={keywords}>
<Fragment set:html=&#123;bodyHtml&#125; />

  <ToolShell about={aboutText} />

</ToolLayout>



<script is:inline>
document.getElementById("evBtn").onclick=ev;document.getElementById("evIn").onkeydown=e=>{if(e.key==="Enter")ev()};
function ev(){const e=document.getElementById("evIn").value.trim();const r=/^(([^<>()\[\]\.,;:\s@"]+(\.[^<>()\[\]\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;const s=document.getElementById("evStatus");const msg=document.getElementById("evMsg");const fmt=document.getElementById("evFormat");const loc=document.getElementById("evLocal");const dom=document.getElementById("evDomain");const tld=document.getElementById("evTLD");const len=document.getElementById("evLen");if(!e){s.textContent="---";msg.textContent="Masukkan email";fmt.textContent=loc.textContent=dom.textContent=tld.textContent=len.textContent="---";s.style.color="inherit";return}const ok=r.test(e);const at=e.lastIndexOf("@");s.innerHTML=ok?"✓ Valid":"✗ Invalid";s.style.color=ok?"#10b981":"#ef4444";msg.textContent=ok?"Format email valid.":"Format tidak valid RFC 5322.";fmt.textContent=ok?"Valid":"Invalid";fmt.style.color=ok?"#10b981":"#ef4444";loc.textContent=at>0?e.substring(0,at):"---";dom.textContent=at>0?e.substring(at+1):"---";const p=dom.textContent.split(".");tld.textContent=p.length>1?"."+p[p.length-1]:"---";len.textContent=e.length+" karakter"}ev();
</script>

