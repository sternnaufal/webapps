---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Dice Roller';
const description = 'Dice roller online virtual. Lempar dadu dengan berbagai sisi (D4, D6, D8, D10, D12, D20, D100). Multiple dice, animasi, history, dan statistik.';
const keywords = 'dice roller, dadu online, roll dice, random dice, lempar dadu, d20, d6, dnd dice, tabletop';
const aboutText = 'Dice Roller Dice roller online virtual. Lempar dadu dengan berbagai sisi (D4, D6, D8, D10, D12, D20, D100). Multiple dice, animasi, history, dan statistik.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'random-number-generator', name: 'Random Number Generator', icon: '🎲' },
  { slug: 'decision-maker', name: 'Decision Maker', icon: '🎲' },
  { slug: 'random-color-generator', name: 'Random Color Generator', icon: '🎰' },
  { slug: 'char-counter', name: 'Char Counter', icon: '#' }
];

const toolCss = `.dice-icon{display:inline-flex;width:44px;height:44px;border-radius:8px;align-items:center;justify-content:center;font-weight:800;font-size:1.1rem;margin:3px;background:oklch(0.93 0.003 270);transition:all .2s}.dice-icon.rolling{animation:shake .3s}@keyframes shake{0%,100%{transform:rotate(0)}25%{transform:rotate(-12deg)}75%{transform:rotate(12deg)}}`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-8/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="grid grid-cols-3 gap-3 items-end mb-3">
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Jenis Dadu</label>
          <select id="diceType" class="select select-bordered w-full select-sm">
            <option value="4">D4</option><option value="6" selected>D6</option><option value="8">D8</option><option value="10">D10</option><option value="12">D12</option><option value="20">D20</option><option value="100">D100</option>
          </select>
        </div>
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Jumlah</label>
          <select id="diceCount" class="select select-bordered w-full select-sm">
            <option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option><option>10</option>
          </select>
        </div>
        <div><button id="btnRoll" class="btn btn-primary btn-sm w-full">Roll!</button></div>
      </div>
      <div id="diceResult" class="flex flex-wrap justify-center gap-2 mb-3 py-3 rounded" style="background:oklch(0.95 0.003 270);"></div>
      <div class="grid grid-cols-3 gap-2 text-center text-xs">
        <div><span class="opacity-60">Total</span><br><span class="text-sm font-bold" id="totalDisplay">0</span></div>
        <div><span class="opacity-60">Tertinggi</span><br><span class="text-sm font-bold" id="maxDisplay">0</span></div>
        <div><span class="opacity-60">Terendah</span><br><span class="text-sm font-bold" id="minDisplay">0</span></div>
      </div>
    </div>
  </div>
  <div class="lg:w-4/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Riwayat</div>
      <div id="historyList" style="max-height:240px;overflow-y:auto" class="text-xs"><span class="opacity-60">Belum ada lemparan</span></div>
      <button id="btnClearHistory" class="btn btn-ghost btn-xs w-full mt-2">Hapus Riwayat</button>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>

<script is:inline>
var dt=document.getElementById('diceType'),dc=document.getElementById('diceCount'),dr=document.getElementById('diceResult'),td=document.getElementById('totalDisplay'),mxd=document.getElementById('maxDisplay'),mnd=document.getElementById('minDisplay'),hl=document.getElementById('historyList'),history=[];
function roll(){
  var sides=parseInt(dt.value),cnt=parseInt(dc.value),vals=[];
  for(var i=0;i<cnt;i++)vals.push(Math.floor(Math.random()*sides)+1);
  dr.innerHTML='';vals.forEach(function(v,i){
    var el=document.createElement('span');el.className='dice-icon rolling';el.textContent=v;
    setTimeout(function(){el.classList.remove('rolling')},300);
    dr.appendChild(el);
  });
  var total=vals.reduce(function(a,b){return a+b},0);
  td.textContent=total;mxd.textContent=Math.max.apply(null,vals);mnd.textContent=Math.min.apply(null,vals);
  var label='D'+sides+' x'+cnt+': ['+vals.join(', ')+'] = '+total;
  history.unshift(label);if(history.length>20)history.pop();
  hl.innerHTML=history.map(function(h){return'<div class="py-1 border-b text-xs">'+h+'</div>'}).join('');
}
document.getElementById('btnRoll').addEventListener('click',roll);
document.getElementById('btnClearHistory').addEventListener('click',function(){history=[];hl.innerHTML='<span class="opacity-60 text-xs">Belum ada lemparan</span>'});
roll();
</script>