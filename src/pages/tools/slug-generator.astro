---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Text to Slug Generator';
const description = 'Text to slug generator online. Ubah judul atau teks menjadi URL slug yang SEO friendly. Konversi teks ke slug untuk URL.';
const keywords = 'slug generator, url slug, text to slug, seo slug, slug maker, generate slug, slug converter';
const aboutText = 'Text to slug generator online. Ubah judul atau teks menjadi URL slug yang SEO friendly. Konversi teks ke slug untuk URL.';
const aboutExtra = 'Slug adalah versi URL-friendly dari sebuah judul atau teks, biasanya terdiri dari huruf kecil, angka, dan tanda hubung. Slug yang baik sangat penting untuk SEO karena mempengaruhi struktur URL dan membantu mesin pencari memahami konten halaman. Alat ini mendukung konversi karakter khusus Indonesia (aksen), opsi hapus kata umum (stop words), dan contoh slug untuk referensi.';
const relatedTools = [
  { slug: 'url-encode', name: 'Url Encode', icon: '%' },
  { slug: 'textcase', name: 'Textcase', icon: 'Aa' },
  { slug: 'html-entity', name: 'Html Entity', icon: '&' },
  { slug: 'meta-tag-generator', name: 'Meta Tag Generator', icon: '🏷' }
];

const toolCss = `.slug-result{font-family:monospace;font-size:1.4rem;font-weight:600;padding:1rem;border-radius:8px;background:#f0fdf4;color:#16a34a;word-break:break-all}`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-8/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Masukkan Teks</label>
        <input type="text" id="textInput" class="input input-bordered w-full input-sm" value="Cara Membuat Kue Bolu Enak dan Lembut" placeholder="Tulis judul di sini...">
      </div>
      <button id="btnSlugify" class="btn btn-primary btn-sm mb-3">Buat Slug</button>
      <div class="mb-2">
        <div class="flex justify-between items-center mb-1">
          <span class="text-xs font-medium opacity-60">Hasil Slug</span>
          <button id="btnCopy" class="btn btn-ghost btn-xs">Copy</button>
        </div>
        <div id="slugResult" class="slug-result mt-1 text-sm">cara-membuat-kue-bolu-enak-dan-lembut</div>
      </div>
    </div>
    <div class="rounded-xl p-5 mt-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Opsi Tambahan</div>
      <label class="flex items-center gap-2 text-xs mb-2"><input type="checkbox" id="removeStopWords" class="checkbox checkbox-sm"> Hapus kata umum (dan, di, ke, dari, yang, ini, itu, dengan, untuk, pada, adalah)</label>
      <div class="flex gap-2 flex-wrap">
        <button class="btn btn-ghost btn-xs example" data-txt="Tips SEO Website 2026">Tips SEO Website 2026</button>
        <button class="btn btn-ghost btn-xs example" data-txt="Cara Memasak Nasi Goreng Spesial">Cara Memasak Nasi Goreng Spesial</button>
        <button class="btn btn-ghost btn-xs example" data-txt="Review: Produk Terbaik Bulan Ini!">Review Produk Terbaik Bulan Ini</button>
      </div>
    </div>
  </div>
  <div class="lg:w-4/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Contoh Penggunaan Slug</div>
      <div class="text-xs space-y-2 opacity-70">
        <p class="mb-1"><strong>Judul Artikel:</strong><br>Cara Membuat Kue Bolu</p>
        <p class="mb-1"><strong>URL Slug:</strong><br><code class="text-xs">cara-membuat-kue-bolu</code></p>
        <p class="mb-0"><strong>URL Lengkap:</strong><br><code class="text-xs">blog.com/cara-membuat-kue-bolu</code></p>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>

<script is:inline>
var inp=document.getElementById('textInput'),sR=document.getElementById('slugResult'),rSW=document.getElementById('removeStopWords');var STOP=['dan','di','ke','dari','yang','ini','itu','dengan','untuk','pada','adalah','dalam','akan','telah','sudah','bisa','dapat','tidak','atau','serta'];function slugify(t,r){t=t.toLowerCase().trim();t=t.replace(/[]/g,'a').replace(/[]/g,'e').replace(/[]/g,'i').replace(/[]/g,'o').replace(/[]/g,'u').replace(/[]/g,'n').replace(/[]/g,'c').replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,' ').trim();if(r){var words=t.split(' ');t=words.filter(function(w){return STOP.indexOf(w)===-1}).join(' ')}t=t.replace(/\s+/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'');return t}function makeSlug(){var t=inp.value;sR.textContent=slugify(t,rSW.checked)||'(kosong)'}document.getElementById('btnSlugify').addEventListener('click',makeSlug);document.getElementById('btnCopy').addEventListener('click',function(){navigator.clipboard.writeText(sR.textContent).catch(function(){})});inp.addEventListener('input',makeSlug);rSW.addEventListener('change',makeSlug);document.querySelectorAll('.example').forEach(function(el){el.addEventListener('click',function(){inp.value=this.dataset.txt;makeSlug()})});makeSlug();
</script>