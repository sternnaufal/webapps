---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'User Agent Parser';
const description = 'Parse dan analisis User Agent string. Deteksi browser, versi, engine, OS, device, dan kategori.';
const keywords = 'user agent parser, browser detection, ua parser, parse user agent, browser info';
const aboutText = 'User Agent Parser online untuk mengidentifikasi browser, versi, engine rendering, sistem operasi, tipe device (mobile/desktop/tablet), dan deteksi bot/crawler dari string User Agent. Cukup tempel UA string dan dapatkan informasi lengkap tentang pengunjung atau request.';
const aboutExtra = 'User Agent string adalah informasi yang dikirim oleh browser atau klien HTTP setiap kali mengakses website. String ini berisi informasi tentang browser, versi, engine rendering, sistem operasi, dan device. Alat ini dapat mengidentifikasi browser utama (Chrome, Firefox, Safari, Edge, IE), engine (Blink, Gecko, WebKit, Trident), OS (Windows, macOS, Linux, Android, iOS, ChromeOS), dan tipe device (mobile, desktop, tablet). Juga mendeteksi bot/crawler seperti Googlebot, Bingbot, dan lainnya. Sangat berguna untuk web developer, QA engineer, dan analis log dalam debugging kompatibilitas browser dan analisis traffic. Semua pemrosesan dilakukan 100% di browser, data tidak dikirim ke server mana pun.';
const relatedTools = [
  { slug: 'subnetting', name: 'Subnetting', icon: '📐' },
  { slug: 'ip-calculator', name: 'IP Calculator', icon: '🔌' },
  { slug: 'url-encode', name: 'URL Encode', icon: '%' },
  { slug: 'cron-builder', name: 'Cron Builder', icon: '⏰' }
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #3b82f6;">
    <div class="mb-4">
      <label for="uaIn" class="text-xs font-medium opacity-60 mb-1 block">User Agent String</label>
      <textarea id="uaIn" class="textarea textarea-bordered w-full text-sm font-mono" rows="3" placeholder="Tempel User Agent string..."></textarea>
      <div class="flex gap-2 mt-2 flex-wrap">
        <button id="uaBtn" class="btn btn-primary btn-sm">Parse</button>
        <button id="uaMy" class="btn btn-ghost btn-sm">User Agent Saya</button>
        <button id="uaClear" class="btn btn-ghost btn-sm">Clear</button>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="rounded-lg p-3" style="background:oklch(0.93 0.005 270);">
        <h6 class="text-xs font-semibold opacity-60 mb-2">Browser & OS</h6>
        <table class="table table-sm mb-0"><tbody>
          <tr><td class="text-xs opacity-50">Browser</td><td id="uaBr" class="font-semibold text-sm">---</td></tr>
          <tr><td class="text-xs opacity-50">Version</td><td id="uaVer" class="font-semibold text-sm">---</td></tr>
          <tr><td class="text-xs opacity-50">Engine</td><td id="uaEng" class="font-semibold text-sm">---</td></tr>
          <tr><td class="text-xs opacity-50">OS</td><td id="uaOS" class="font-semibold text-sm">---</td></tr>
          <tr><td class="text-xs opacity-50">Device</td><td id="uaDev" class="font-semibold text-sm">---</td></tr>
        </tbody></table>
      </div>
      <div class="rounded-lg p-3" style="background:oklch(0.93 0.005 270);">
        <h6 class="text-xs font-semibold opacity-60 mb-2">Kategori</h6>
        <table class="table table-sm mb-0"><tbody>
          <tr><td class="text-xs opacity-50">Mobile</td><td id="uaMob" class="font-semibold text-sm">---</td></tr>
          <tr><td class="text-xs opacity-50">Desktop</td><td id="uaDesk" class="font-semibold text-sm">---</td></tr>
          <tr><td class="text-xs opacity-50">Tablet</td><td id="uaTab" class="font-semibold text-sm">---</td></tr>
          <tr><td class="text-xs opacity-50">Bot/Crawler</td><td id="uaBot" class="font-semibold text-sm">---</td></tr>
        </tbody></table>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
function uaParse(u){const r={};r.br="Unknown";r.ver=r.eng=r.os=r.dev="";r.mob=/Mobile|Android|iPhone|iPod|BlackBerry|IEMobile/i.test(u);r.tab=/Tablet|iPad|Android(?!.*Mobile)|Silk/i.test(u);r.desk=!r.mob&&!r.tab;r.bot=/bot|crawl|spider|scraper|curl|wget|googlebot|bingbot|facebook|twitter|whatsapp/i.test(u);if(/Edg\//i.test(u)){r.br="Edge";r.ver=(u.match(/Edg\/([\d.]+)/)||[])[1]||"";r.eng="Blink"}else if(/Firefox\//i.test(u)){r.br="Firefox";r.ver=(u.match(/Firefox\/([\d.]+)/)||[])[1]||"";r.eng="Gecko"}else if(/Chrome\//i.test(u)){r.br="Chrome";r.ver=(u.match(/Chrome\/([\d.]+)/)||[])[1]||"";r.eng="Blink"}else if(/Safari\//i.test(u)&&!/Chrome/i.test(u)){r.br="Safari";r.ver=(u.match(/Version\/([\d.]+)/)||[])[1]||"";r.eng="WebKit"}else if(/Trident|MSIE/i.test(u)){r.br="IE";r.ver=(u.match(/(?:MSIE |rv:)([\d.]+)/)||[])[1]||"";r.eng="Trident"}if(/Windows NT 10/i.test(u))r.os="Windows 10/11";else if(/Windows NT 6\.3/i.test(u))r.os="Windows 8.1";else if(/Windows/i.test(u))r.os="Windows";else if(/Mac OS X/i.test(u)){r.os="macOS";r.fver=(u.match(/Mac OS X ([\d_]+)/)||[])[1]?.replace(/_/g,".")||""}else if(/Android/i.test(u)){r.os="Android";r.fver=(u.match(/Android ([\d.]+)/)||[])[1]||""}else if(/iPhone|iPad/i.test(u)){r.os="iOS";r.fver=(u.match(/OS ([\d_]+)/)||[])[1]?.replace(/_/g,".")||""}else if(/Linux/i.test(u))r.os="Linux";else if(/CrOS/i.test(u))r.os="ChromeOS";if(r.mob&&/iPhone/i.test(u))r.dev="iPhone";else if(r.mob&&/Android/i.test(u))r.dev="Android Phone";else if(r.tab&&/iPad/i.test(u))r.dev="iPad";else if(r.tab)r.dev="Tablet";else r.dev=r.mob?"Phone":"Desktop/Laptop";return r}
function uaShow(r){document.getElementById("uaBr").textContent=r.br;document.getElementById("uaVer").textContent=r.ver||"---";document.getElementById("uaEng").textContent=r.eng||"---";document.getElementById("uaOS").textContent=r.os||"---";document.getElementById("uaDev").textContent=r.dev||"---";const ok="#10b981",no="#6b7280",warn="#ef4444";document.getElementById("uaMob").textContent=r.mob?"Yes":"No";document.getElementById("uaMob").style.color=r.mob?ok:no;document.getElementById("uaDesk").textContent=r.desk?"Yes":"No";document.getElementById("uaDesk").style.color=r.desk?ok:no;document.getElementById("uaTab").textContent=r.tab?"Yes":"No";document.getElementById("uaTab").style.color=r.tab?ok:no;document.getElementById("uaBot").textContent=r.bot?"Yes":"No";document.getElementById("uaBot").style.color=r.bot?warn:no}
document.getElementById("uaBtn").onclick=()=>{const ua=document.getElementById("uaIn").value.trim();if(ua)uaShow(uaParse(ua))};
document.getElementById("uaMy").onclick=()=>{document.getElementById("uaIn").value=navigator.userAgent;uaShow(uaParse(navigator.userAgent))};
document.getElementById("uaClear").onclick=()=>{document.getElementById("uaIn").value="";["uaBr","uaVer","uaEng","uaOS","uaDev","uaMob","uaDesk","uaTab","uaBot"].forEach(id=>{document.getElementById(id).textContent="---";document.getElementById(id).style.color=""})};
document.getElementById("uaMy").click();
</script>