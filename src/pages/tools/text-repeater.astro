---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Text Repeater';
const description = 'Text repeater online. Ulangi teks sebanyak N kali dengan separator kustom.';
const keywords = 'text repeater, repeat text, repeat string, teks berulang';
const aboutText = 'Text Repeater adalah alat untuk mengulang teks sebanyak N kali dengan berbagai opsi separator, prefix, dan suffix. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const aboutExtra = 'Mengulang teks secara manual sangat membosankan dan rawan error. Text Repeater memudahkan Anda menghasilkan teks berulang dalam hitungan detik. Berguna untuk generate data testing, membuat template, mengisi placeholder konten, pembuatan pola teks berulang, dan berbagai kebutuhan pengembangan lainnya. Tersedia pilihan separator seperti baris baru, spasi, koma, atau separator kustom.';
const relatedTools = [
  { slug: 'reverse-text', name: 'Reverse Text', icon: '↩' },
  { slug: 'textcase', name: 'Text Case Converter', icon: 'Aa' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' },
  { slug: 'lorem-ipsum', name: 'Lorem Ipsum Generator', icon: '¶' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Teks</label>
        <textarea id="textInput" class="textarea textarea-bordered w-full text-sm font-mono" rows="3" placeholder="Teks yang akan diulang..." autofocus>Hello!</textarea>
      </div>
      <div class="grid grid-cols-2 gap-2 mb-3">
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Jumlah</label>
          <input type="number" id="countInput" class="input input-bordered w-full input-sm" value="5" min="1" max="10000">
        </div>
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Separator</label>
          <select id="separator" class="select select-bordered w-full select-sm">
            <option value="\n">Baris baru</option>
            <option value=" ">Spasi</option>
            <option value=",">Koma</option>
            <option value=", ">Koma + spasi</option>
            <option value="">Tanpa separator</option>
            <option value="custom">Kustom...</option>
          </select>
          <input type="text" id="customSep" class="input input-bordered w-full input-sm mt-1" style="display:none" placeholder="Separator kustom...">
        </div>
      </div>
      <button id="btnGenerate" class="btn btn-primary btn-sm w-full">Generate</button>
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs font-medium opacity-60">Output</span>
        <span id="outputStats" class="text-xs opacity-60"></span>
      </div>
      <textarea id="outputArea" class="textarea textarea-bordered w-full text-sm font-mono" rows="8" readonly></textarea>
      <button id="btnCopy" class="btn btn-ghost btn-sm mt-2">Copy</button>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var inp=document.getElementById('textInput'),cnt=document.getElementById('countInput'),sep=document.getElementById('separator'),cst=document.getElementById('customSep'),out=document.getElementById('outputArea'),stats=document.getElementById('outputStats');
sep.addEventListener('change',function(){cst.style.display=this.value==='custom'?'block':'none'});
document.getElementById('btnGenerate').addEventListener('click',function(){
  var t=inp.value,n=parseInt(cnt.value)||1,s=sep.value;
  if(s==='custom')s=cst.value;
  else if(s==='\\n')s='\n';
  var result=Array(n).fill(t).join(s);
  out.value=result;
  stats.textContent=result.length+' chars, '+n+'x repeat';
});
document.getElementById('btnCopy').addEventListener('click',function(){
  if(!out.value)return;var b=this;
  navigator.clipboard.writeText(out.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)});
});
document.getElementById('btnGenerate').click();
</script>