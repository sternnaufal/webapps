---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Sleep Cycle Calculator';
const description = 'Sleep cycle calculator online. Hitung waktu tidur optimal berdasarkan siklus 90 menit. Bangun segar tanpa alarm shock.';
const keywords = 'sleep cycle, sleep calculator, kalkulator tidur, sleep cycle calculator, sleep time, optimal sleep';
const aboutText = 'Sleep cycle calculator online. Hitung waktu tidur optimal berdasarkan siklus 90 menit. Bangun segar tanpa alarm shock.';
const relatedTools = [
  { slug: 'pomodoro', name: 'Pomodoro', icon: '🍅' },
  { slug: 'timer', name: 'Timer', icon: '⏱' },
  { slug: 'countdown', name: 'Countdown', icon: '⏳' },
  { slug: 'age-calculator', name: 'Age Calculator', icon: '🎂' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-5 mb-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="flex gap-4 mb-3 border-b pb-2" style="border-color:oklch(0.9 0.005 270);">
        <button class="text-xs font-medium pb-2 border-b-2 border-[#14b8a6] text-[#14b8a6] active" id="tabWake" data-mode="wake">Saya mau bangun jam...</button>
        <button class="text-xs font-medium pb-2 opacity-60 hover:opacity-100" id="tabSleep" data-mode="sleep">Saya mau tidur jam...</button>
      </div>
      <div id="wakePane">
        <label class="text-xs font-medium opacity-60 mb-1 block">Waktu Bangun</label>
        <input type="time" id="wakeTime" class="input input-bordered w-full input-sm" value="06:00">
        <span class="text-xs opacity-60 mt-1 block">Kalkulator akan menyarankan waktu tidur optimal</span>
      </div>
      <div id="sleepPane" style="display:none">
        <label class="text-xs font-medium opacity-60 mb-1 block">Waktu Tidur</label>
        <input type="time" id="sleepTime" class="input input-bordered w-full input-sm" value="23:00">
        <span class="text-xs opacity-60 mt-1 block">Kalkulator akan menyarankan waktu bangun optimal</span>
      </div>
    </div>
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Tips Tidur</div>
      <div class="text-xs space-y-1 opacity-70">
        <p class="mb-1">&#128161; Siklus tidur rata-rata 90 menit</p>
        <p class="mb-1">&#128161; Idealnya tidur 5-6 siklus (7.5-9 jam)</p>
        <p class="mb-1">&#128161; Bangun di tengah siklus = masih ngantuk</p>
        <p class="mb-0">&#128161; Butuh ~14 menit untuk tertidur</p>
      </div>
    </div>
  </div>
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Waktu Optimal</div>
      <div id="results" class="text-xs"></div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
var wakePane=document.getElementById('wakePane'),sleepPane=document.getElementById('sleepPane'),wakeInp=document.getElementById('wakeTime'),sleepInp=document.getElementById('sleepTime'),res=document.getElementById('results');
document.getElementById('tabWake').addEventListener('click',function(){wakePane.style.display='block';sleepPane.style.display='none';this.classList.add('active');this.style.borderBottomColor='#14b8a6';this.style.color='#14b8a6';this.style.opacity='1';document.getElementById('tabSleep').classList.remove('active');document.getElementById('tabSleep').style.borderBottomColor='transparent';document.getElementById('tabSleep').style.opacity='0.6';calc();});
document.getElementById('tabSleep').addEventListener('click',function(){wakePane.style.display='none';sleepPane.style.display='block';this.classList.add('active');this.style.borderBottomColor='#14b8a6';this.style.color='#14b8a6';this.style.opacity='1';document.getElementById('tabWake').classList.remove('active');document.getElementById('tabWake').style.borderBottomColor='transparent';document.getElementById('tabWake').style.opacity='0.6';calc();});

function fmt(t){
  var h=t.getHours(),m=t.getMinutes();
  return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0');
}
function fmtLong(t){
  var days=['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
  return days[t.getDay()]+', '+fmt(t);
}

function calc(){
  var mode=wakePane.style.display!=='none'?'wake':'sleep',now=new Date();
  if(mode==='wake'){
    var wp=wakeInp.value.split(':'),wh=parseInt(wp[0]),wm=parseInt(wp[1]);
    var wake=new Date(now);wake.setHours(wh,wm,0,0);if(wake<=now)wake.setDate(wake.getDate()+1);
    var html='<div class="font-medium mb-2">Jika bangun '+fmt(wake)+':</div><table class="table table-sm w-full text-xs mb-0"><tr style="background:oklch(0.55 0.25 270 / 0.08);"><th class="text-left py-1 font-medium">Waktu Tidur</th><th class="text-left py-1 font-medium">Siklus</th><th class="text-left py-1 font-medium">Keterangan</th></tr>';
    for(var c=6;c>=3;c--){
      var sleep=new Date(wake);sleep.setMinutes(sleep.getMinutes()-c*90-14);
      var desc=c+' siklus ('+(c*90+14)+' menit)';
      var label=c>=5?'&#9989; Optimal':c===4?'&#9989; Cukup':'&#9888; Minimal';
      html+='<tr><td class="py-1 font-bold">'+fmt(sleep)+'</td><td class="py-1">'+desc+'</td><td class="py-1">'+label+'</td></tr>';
    }
    html+='</table><div class="text-xs opacity-60 mt-2">* Termasuk 14 menit untuk tertidur</div>';
    res.innerHTML=html;
  }else{
    var sp=sleepInp.value.split(':'),sh=parseInt(sp[0]),sm=parseInt(sp[1]);
    var sleep=new Date(now);sleep.setHours(sh,sm,0,0);
    var html='<div class="font-medium mb-2">Jika tidur '+fmt(sleep)+':</div><table class="table table-sm w-full text-xs mb-0"><tr style="background:oklch(0.55 0.25 270 / 0.08);"><th class="text-left py-1 font-medium">Waktu Bangun</th><th class="text-left py-1 font-medium">Siklus</th><th class="text-left py-1 font-medium">Keterangan</th></tr>';
    for(var c=3;c<=6;c++){
      var wake=new Date(sleep);wake.setMinutes(wake.getMinutes()+c*90+14);
      var desc=c+' siklus ('+(c*90+14)+' menit)';
      var label=c>=5?'&#9989; Optimal':c===4?'&#9989; Cukup':'&#9888; Minimal';
      html+='<tr><td class="py-1 font-bold">'+fmt(wake)+' ('+(wake<=now?'besok':'hari ini')+')</td><td class="py-1">'+desc+'</td><td class="py-1">'+label+'</td></tr>';
    }
    html+='</table><div class="text-xs opacity-60 mt-2">* Termasuk 14 menit untuk tertidur</div>';
    res.innerHTML=html;
  }
}
[wakeInp,sleepInp].forEach(function(el){el.addEventListener('input',calc);el.addEventListener('change',calc)});
calc();
</script>