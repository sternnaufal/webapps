---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Character Counter';
const description = 'Hitung karakter, kata, kalimat, paragraf, dan baris secara real-time online.';
const keywords = 'character counter, word counter, character count, word count, text analyzer';
const aboutText = 'Character Counter untuk menganalisis teks secara real-time. Hitung jumlah karakter (dengan dan tanpa spasi), kata, kalimat, paragraf, baris, estimasi waktu baca, dan kata unik. Dilengkapi juga dengan fitur top words yang menampilkan kata-kata yang paling sering muncul.';
const aboutExtra = 'Alat ini sangat berguna bagi penulis, content creator, pelajar, dan siapa pun yang perlu menghitung panjang teks. Fitur karakter tanpa spasi berguna untuk platform yang membatasi karakter tanpa menghitung spasi. Estimasi waktu baca membantu mengetahui berapa lama waktu yang dibutuhkan untuk membaca teks (berdasarkan kecepatan baca 200 kata/menit). Analisis kata unik dan top words membantu memahami keragaman kosakata dalam tulisan Anda.';
const relatedTools = [
  { slug: 'word-counter', name: 'Word Counter', icon: '⚡' },
  { slug: 'word-frequency', name: 'Word Frequency', icon: '📊' },
  { slug: 'textcase', name: 'Text Case Converter', icon: 'Aa' },
  { slug: 'lorem-ipsum', name: 'Lorem Ipsum', icon: '¶' },
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>

  <textarea id="textInput" class="textarea textarea-bordered w-full text-sm font-mono mt-4" rows="8" placeholder="Ketik atau paste teks di sini..." autofocus>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.

Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.

Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</textarea>

  <div class="grid grid-cols-2 md:grid-cols-6 gap-3 mt-4">
    <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="text-lg font-bold" id="charCount">0</div>
      <div class="text-xs opacity-60">Karakter</div>
    </div>
    <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="text-lg font-bold" id="charNoSpace">0</div>
      <div class="text-xs opacity-60">Tanpa Spasi</div>
    </div>
    <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="text-lg font-bold" id="wordCount">0</div>
      <div class="text-xs opacity-60">Kata</div>
    </div>
    <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="text-lg font-bold" id="sentCount">0</div>
      <div class="text-xs opacity-60">Kalimat</div>
    </div>
    <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="text-lg font-bold" id="paraCount">0</div>
      <div class="text-xs opacity-60">Paragraf</div>
    </div>
    <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="text-lg font-bold" id="lineCount">0</div>
      <div class="text-xs opacity-60">Baris</div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-3 mt-3">
    <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="font-bold" id="readTime">0</div>
      <div class="text-xs opacity-60">Menit baca</div>
    </div>
    <div class="rounded-xl p-4 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="font-bold" id="density">0</div>
      <div class="text-xs opacity-60">Kata unik</div>
    </div>
    <div class="md:col-span-2 rounded-xl p-4" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #10b981;">
      <div class="text-xs opacity-60 mb-1">Top words:</div>
      <div id="topWords" class="text-xs mt-1"></div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var inp=document.getElementById('textInput');
['charCount','charNoSpace','wordCount','sentCount','paraCount','lineCount','readTime','density'].forEach(function(id){window[id]=document.getElementById(id)});
window.topWords=document.getElementById('topWords');
function analyze(){
  var t=inp.value;
  charCount.textContent=t.length;
  charNoSpace.textContent=t.replace(/\s/g,'').length;
  wordCount.textContent=t.trim()?t.trim().split(/\s+/).length:0;
  sentCount.textContent=t.split(/[.!?]+/).filter(function(s){return s.trim().length>0}).length;
  paraCount.textContent=t.split(/\n\s*\n/).filter(function(p){return p.trim().length>0}).length;
  lineCount.textContent=t.split('\n').length;
  readTime.textContent=Math.max(1,Math.round((t.trim().split(/\s+/).length||0)/200))+' menit';
  var words=t.toLowerCase().match(/\b\w+\b/g)||[];
  var uniq={};words.forEach(function(w){uniq[w]=(uniq[w]||0)+1});
  var keys=Object.keys(uniq);
  density.textContent=keys.length;
  var sorted=keys.sort(function(a,b){return uniq[b]-uniq[a]}).slice(0,6);
  topWords.innerHTML=sorted.map(function(w){return '<span class="text-xs px-1 py-0.5 rounded mr-1 mb-1 inline-block" style="background:oklch(0.9 0.005 270);">'+w+' <span class="opacity-60">x'+uniq[w]+'</span></span>'}).join('');
}
inp.addEventListener('input',analyze);analyze();
</script>