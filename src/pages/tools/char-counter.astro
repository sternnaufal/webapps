---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Character Counter';
const description = 'Character counter online. Hitung karakter, kata, kalimat, paragraf, dan baris secara real-time.';
const keywords = 'character counter, word counter, character count, word count, text analyzer';
const aboutText = 'Character Counter Character counter online. Hitung karakter, kata, kalimat, paragraf, dan baris secara real-time.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'word-counter', name: 'Word Counter', icon: '⚡' },
  { slug: 'word-frequency', name: 'Word Frequency', icon: '📊' },
  { slug: 'textcase', name: 'Textcase', icon: 'Aa' },
  { slug: 'lorem-ipsum', name: 'Lorem Ipsum', icon: '¶' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0f9ff;color:#0284c7;">Aa</div><div><h1 class="h3 mb-0">Character Counter</h1><p class="opacity-60 small mb-0">Analisis teks secara real-time: karakter, kata, kalimat, paragraf, dan lainnya.</p></div></header>
<textarea id="textInput" class="input input-bordered w-full font-mono mb-3" rows="8" placeholder="Ketik atau paste teks di sini..." autofocus>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.

Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.

Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</textarea>
<div class="flex flex-wrap gap-3">
<div class="col-4 col-md-2"><div class="card card-bordered bg-base-100 p-3 text-center"><div class="h4 mb-0 font-bold" id="charCount">0</div><small class="opacity-60">Karakter</small></div></div>
<div class="col-4 col-md-2"><div class="card card-bordered bg-base-100 p-3 text-center"><div class="h4 mb-0 font-bold" id="charNoSpace">0</div><small class="opacity-60">Tanpa Spasi</small></div></div>
<div class="col-4 col-md-2"><div class="card card-bordered bg-base-100 p-3 text-center"><div class="h4 mb-0 font-bold" id="wordCount">0</div><small class="opacity-60">Kata</small></div></div>
<div class="col-4 col-md-2"><div class="card card-bordered bg-base-100 p-3 text-center"><div class="h4 mb-0 font-bold" id="sentCount">0</div><small class="opacity-60">Kalimat</small></div></div>
<div class="col-4 col-md-2"><div class="card card-bordered bg-base-100 p-3 text-center"><div class="h4 mb-0 font-bold" id="paraCount">0</div><small class="opacity-60">Paragraf</small></div></div>
<div class="col-4 col-md-2"><div class="card card-bordered bg-base-100 p-3 text-center"><div class="h4 mb-0 font-bold" id="lineCount">0</div><small class="opacity-60">Baris</small></div></div>
</div>
<div class="flex flex-wrap gap-3 mt-2">
<div class="md:w-1/4 w-full"><div class="card card-bordered bg-base-100 p-3 text-center"><div class="h5 mb-0 font-bold" id="readTime">0</div><small class="opacity-60">Menit baca</small></div></div>
<div class="md:w-1/4 w-full"><div class="card card-bordered bg-base-100 p-3 text-center"><div class="h5 mb-0 font-bold" id="density">0</div><small class="opacity-60">Kata unik</small></div></div>
<div class="md:w-1/2 w-full"><div class="card card-bordered bg-base-100 p-3"><small class="opacity-60">Top words:</small><div id="topWords" class="small mt-1"></div></div></div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var inp=document.getElementById('textInput');
['charCount','charNoSpace','wordCount','sentCount','paraCount','lineCount','readTime','density'].forEach(function(id)&#123;window[id]=document.getElementById(id)&#125;);
window.topWords=document.getElementById('topWords');
function analyze()&#123;
  var t=inp.value;
  charCount.textContent=t.length;
  charNoSpace.textContent=t.replace(/\\s/g,'').length;
  wordCount.textContent=t.trim()?t.trim().split(/\\s+/).length:0;
  sentCount.textContent=t.split(/[.!?]+/).filter(function(s)&#123;return s.trim().length>0&#125;).length;
  paraCount.textContent=t.split(/\\n\\s*\\n/).filter(function(p)&#123;return p.trim().length>0&#125;).length;
  lineCount.textContent=t.split('\\n').length;
  readTime.textContent=Math.max(1,Math.round((t.trim().split(/\\s+/).length||0)/200))+' menit';
  var words=t.toLowerCase().match(/\\b\\w+\\b/g)||[];
  var uniq=&#123;&#125;;words.forEach(function(w)&#123;uniq[w]=(uniq[w]||0)+1&#125;);
  var keys=Object.keys(uniq);
  density.textContent=keys.length;
  var sorted=keys.sort(function(a,b)&#123;return uniq[b]-uniq[a]&#125;).slice(0,6);
  topWords.innerHTML=sorted.map(function(w)&#123;return '<span class="badge bg-light text-dark mr-1 mb-1">'+w+' <span class="opacity-60">x'+uniq[w]+'</span></span>'&#125;).join('');
&#125;
inp.addEventListener('input',analyze);analyze();
</script>

