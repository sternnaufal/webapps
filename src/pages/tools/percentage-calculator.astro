---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Percentage Calculator';
const description = 'Kalkulator persentase online. Hitung persentase, kenaikan, diskon, dan perbandingan.';
const keywords = 'percentage calculator, kalkulator persen, persentase, diskon, kenaikan';
const aboutText = 'Percentage Calculator Kalkulator persentase online. Hitung persentase, kenaikan, diskon, dan perbandingan.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'discount-calculator', name: 'Discount Calculator', icon: '🏷' },
  { slug: 'tip-calculator', name: 'Tip Calculator', icon: '💰' },
  { slug: 'decimal-to-fraction', name: 'Decimal To Fraction', icon: '½' },
  { slug: 'bmi-calculator', name: 'Bmi Calculator', icon: '⚖' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0f9ff;color:#0891b2;">%</div><div><h1 class="h3 mb-0">Percentage Calculator</h1><p class="opacity-60 small mb-0">Kalkulator persentase dengan 3 mode: hitung persen, cari persentase, dan hitung perubahan.</p></div></header>
<div class="flex flex-wrap gap-4">
<div class="col-lg-8">
<div class="card card-bordered bg-base-100 p-3">
<ul class="nav nav-tabs mb-3" id="pctTabs">
<li class="nav-item"><button class="nav-link active" data-mode="mode1">X% dari Y</button></li>
<li class="nav-item"><button class="nav-link" data-mode="mode2">X adalah ?% dari Y</button></li>
<li class="nav-item"><button class="nav-link" data-mode="mode3">Kenaikan/Penurunan</button></li>
</ul>
<div id="mode1" class="tab-pane">
<div class="row gap-2 mb-3"><div class="col-4"><label class="label-text small">Persen (%)</label><input type="number" id="m1Pct" class="input input-bordered w-full" value="20"></div><div class="col-4"><label class="label-text small">Dari</label><input type="number" id="m1Val" class="input input-bordered w-full" value="500000"></div><div class="col-4 flex align-items-end"><button class="btn btn-primary w-full" data-calc="m1">Hitung</button></div></div>
<div id="m1Result" class="p-3 bg-light rounded small"></div>
</div>
<div id="mode2" class="tab-pane" style="display:none">
<div class="row gap-2 mb-3"><div class="col-4"><label class="label-text small">Nilai X</label><input type="number" id="m2X" class="input input-bordered w-full" value="75000"></div><div class="col-4"><label class="label-text small">Dari Y</label><input type="number" id="m2Y" class="input input-bordered w-full" value="500000"></div><div class="col-4 flex align-items-end"><button class="btn btn-primary w-full" data-calc="m2">Hitung</button></div></div>
<div id="m2Result" class="p-3 bg-light rounded small"></div>
</div>
<div id="mode3" class="tab-pane" style="display:none">
<div class="row gap-2 mb-3"><div class="col-4"><label class="label-text small">Nilai Awal</label><input type="number" id="m3Old" class="input input-bordered w-full" value="500000"></div><div class="col-4"><label class="label-text small">Nilai Akhir</label><input type="number" id="m3New" class="input input-bordered w-full" value="600000"></div><div class="col-4 flex align-items-end"><button class="btn btn-primary w-full" data-calc="m3">Hitung</button></div></div>
<div id="m3Result" class="p-3 bg-light rounded small"></div>
</div>
</div>
</div>
<div class="col-lgap-4">
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Quick Reference</h6>
<div class="small">
<div class="flex justify-between py-1"><span>10%</span><span class="opacity-60">1/10</span></div>
<div class="flex justify-between py-1"><span>12.5%</span><span class="opacity-60">1/8</span></div>
<div class="flex justify-between py-1"><span>20%</span><span class="opacity-60">1/5</span></div>
<div class="flex justify-between py-1"><span>25%</span><span class="opacity-60">1/4</span></div>
<div class="flex justify-between py-1"><span>33.3%</span><span class="opacity-60">1/3</span></div>
<div class="flex justify-between py-1"><span>50%</span><span class="opacity-60">1/2</span></div>
<div class="flex justify-between py-1"><span>66.7%</span><span class="opacity-60">2/3</span></div>
<div class="flex justify-between py-1"><span>75%</span><span class="opacity-60">3/4</span></div>
<div class="flex justify-between py-1"><span>100%</span><span class="opacity-60">1/1</span></div>
</div>
</div>
</div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
function fmt(n)&#123;return n.toLocaleString('id-ID',&#123;maximumFractionDigits:2,minimumFractionDigits:2&#125;)&#125;

document.querySelectorAll('#pctTabs .nav-link').forEach(function(tab)&#123;
  tab.addEventListener('click',function()&#123;
    document.querySelectorAll('#pctTabs .nav-link').forEach(function(t)&#123;t.classList.remove('active')&#125;);
    this.classList.add('active');
    document.querySelectorAll('.tab-pane').forEach(function(p)&#123;p.style.display='none'&#125;);
    document.getElementById(this.dataset.mode).style.display='block';
  &#125;);
&#125;);

document.querySelectorAll('[data-calc]').forEach(function(btn)&#123;
  btn.addEventListener('click',function()&#123;
    var mode=this.dataset.calc,res=document.getElementById(mode+'Result');
    if(mode==='m1')&#123;
      var p=parseFloat(document.getElementById('m1Pct').value)||0,v=parseFloat(document.getElementById('m1Val').value)||0;
      res.innerHTML='<table class="table table-sm small mb-0"><tr><td>'+fmt(p)+'% dari '+fmt(v)+'</td><td class="font-bold">'+fmt(v*p/100)+'</td></tr><tr><td>Total</td><td class="font-bold">'+fmt(v+v*p/100)+'</td></tr><tr><td>Diskon (jika diskon '+fmt(p)+'%)</td><td class="text-error font-bold">-'+fmt(v*p/100)+'</td></tr></table>';
    &#125;else if(mode==='m2')&#123;
      var x=parseFloat(document.getElementById('m2X').value)||0,y=parseFloat(document.getElementById('m2Y').value)||0;
      var pct=y?x/y*100:0;
      res.innerHTML='<table class="table table-sm small mb-0"><tr><td>'+fmt(x)+' adalah</td><td class="font-bold">'+fmt(pct)+'%</td></tr><tr><td>dari '+fmt(y)+'</td><td></td></tr></table>';
    &#125;else if(mode==='m3')&#123;
      var o=parseFloat(document.getElementById('m3Old').value)||0,n=parseFloat(document.getElementById('m3New').value)||0;
      var diff=n-o,pct=o?diff/o*100:0;
      res.innerHTML='<table class="table table-sm small mb-0"><tr><td>Perubahan</td><td class="font-bold'+(diff<0?' text-error':' text-success')+'">'+(diff>=0?'+':'')+fmt(diff)+'</td></tr><tr><td>Persentase</td><td class="font-bold'+(pct<0?' text-error':' text-success')+'">'+(pct>=0?'+':'')+fmt(pct)+'%</td></tr><tr><td>Dari</td><td>'+fmt(o)+' &rarr; '+fmt(n)+'</td></tr></table>';
    &#125;
  &#125;);
&#125;);
// Trigger initial calculation
document.querySelector('[data-calc="m1"]').click();
</script>

