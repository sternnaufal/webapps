---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Random Number Generator';
const description = 'Random number generator online. Hasilkan angka acak antara 2 nilai, multiple numbers, tanpa duplikat. Generator nomor acak untuk undian, giveaway, togel, dan eksperimen.';
const keywords = 'random number generator, angka acak, generator nomor, random generator, undian acak, number randomizer';
const aboutText = 'Random Number Generator Random number generator online. Hasilkan angka acak antara 2 nilai, multiple numbers, tanpa duplikat. Generator nomor acak untuk undian, giveaway, togel, dan eksperimen.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'dice-roller', name: 'Dice Roller', icon: '🎲' },
  { slug: 'decision-maker', name: 'Decision Maker', icon: '🎲' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' },
  { slug: 'char-counter', name: 'Char Counter', icon: '#' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#fef3c7;color:#d97706;">#</div><div><h1 class="h3 mb-0">Random Number Generator</h1><p class="opacity-60 small mb-0">Hasilkan angka acak antara 2 nilai, multiple numbers, tanpa duplikat.</p></div></header>
<div class="flex flex-wrap gap-4"><div class="lg:w-7/12 w-full">
<div class="card card-bordered bg-base-100 p-3">
<div class="flex flex-wrap gap-3">
<div class="col-6"><label class="label-text small font-semibold">Min</label><input type="number" id="minVal" class="input input-bordered w-full" value="1"></div>
<div class="col-6"><label class="label-text small font-semibold">Max</label><input type="number" id="maxVal" class="input input-bordered w-full" value="100"></div>
</div>
<div class="flex flex-wrap gap-3 mt-1">
<div class="col-6"><label class="label-text small font-semibold">Jumlah</label><input type="number" id="countVal" class="input input-bordered w-full" value="1" min="1" max="1000"></div>
<div class="col-6 flex align-items-end pb-2"><div class="flex items-center gap-2"><input type="checkbox" id="uniqueOnly" class="checkbox" checked><label class="flex items-center gap-2-label small" for="uniqueOnly">Unik (tanpa duplikat)</label></div></div>
</div>
<div class="flex gap-2 mt-2">
<button id="btnGenerate" class="btn btn-primary">Generate</button>
<button id="btnCopy" class="btn btn-outline">Copy</button>
</div>
</div>
<div id="resultArea" class="card card-bordered bg-base-100 p-3 mt-3">
<div class="flex gap-2 flex-wrap" id="numDisplay"><span class="num-badge">?</span></div>
</div>
</div>
<div class="lg:w-5/12 w-full">
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Quick Presets</h6>
<div class="flex gap-2 flex-wrap">
<button class="btn btn-outline-primary btn-sm preset" data-min="1" data-max="6">Dadu (1-6)</button>
<button class="btn btn-outline-primary btn-sm preset" data-min="1" data-max="10">1-10</button>
<button class="btn btn-outline-primary btn-sm preset" data-min="1" data-max="50">1-50</button>
<button class="btn btn-outline-primary btn-sm preset" data-min="0" data-max="1">Coin (0-1)</button>
<button class="btn btn-outline-primary btn-sm preset" data-min="1" data-max="12">1-12</button>
<button class="btn btn-outline-primary btn-sm preset" data-min="100" data-max="999">100-999</button>
</div>
</div>
</div></div>
`;
const toolCss = `.num-badge{display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:8px;background:var(--surface-soft);font-weight:700;font-size:1.1rem;margin:4px}`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>
<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var minInp=document.getElementById('minVal'),maxInp=document.getElementById('maxVal'),cntInp=document.getElementById('countVal'),uniq=document.getElementById('uniqueOnly'),disp=document.getElementById('numDisplay');
function generate(){
  var min=parseInt(minInp.value)||0,max=parseInt(maxInp.value)||100,cnt=parseInt(cntInp.value)||1,arr=[];
  if(!uniq.checked) for(var i=0;i<cnt;i++) arr.push(Math.floor(Math.random()*(max-min+1))+min);
  else{var range=max-min+1;if(cnt>range){disp.innerHTML='<span class="text-error">Jumlah melebihi rentang angka yang tersedia</span>';return}var pool=[];for(var i=min;i<=max;i++)pool.push(i);for(var i=pool.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=pool[i];pool[i]=pool[j];pool[j]=t}arr=pool.slice(0,cnt)}
  disp.innerHTML=arr.map(function(n){return'<span class="num-badge">'+n+'</span>'}).join('');
}
document.getElementById('btnGenerate').addEventListener('click',generate);
document.getElementById('btnCopy').addEventListener('click',function(){
  var txt=disp.textContent.replace(/\\s+/g,', ');navigator.clipboard.writeText(txt).catch(function(){});
});
document.querySelectorAll('.preset').forEach(function(el){el.addEventListener('click',function(){
  minInp.value=this.dataset.min;maxInp.value=this.dataset.max;cntInp.value=1;generate();
})});
generate();
</script>

