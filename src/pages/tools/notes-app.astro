---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Notes App';
const description = 'Notes app online untuk mencatat ide dan daftar tugas. Catatan disimpan otomatis di browser (localStorage).';
const keywords = 'notes app, catatan online, sticky notes, todo notes, pencatat digital';
const aboutText = 'Notes app online untuk mencatat ide dan daftar tugas. Catatan disimpan otomatis di browser (localStorage).';
const relatedTools = [
  { slug: 'char-counter', name: 'Char Counter', icon: '#' },
  { slug: 'word-counter', name: 'Word Counter', icon: '⚡' },
  { slug: 'md-preview', name: 'Md Preview', icon: 'MD' },
  { slug: 'lorem-ipsum', name: 'Lorem Ipsum', icon: '¶' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-4/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Buat Catatan Baru</div>
      <input type="text" id="noteTitle" class="input input-bordered w-full input-sm mb-2" placeholder="Judul catatan...">
      <textarea id="noteContent" class="textarea textarea-bordered w-full text-sm font-mono mb-2" rows="4" placeholder="Isi catatan..."></textarea>
      <button id="btnSave" class="btn btn-primary btn-sm w-full">Simpan</button>
    </div>
  </div>
  <div class="lg:w-8/12 w-full">
    <div class="flex justify-between items-center mb-2">
      <span class="text-xs font-medium opacity-60">Catatan Saya</span>
      <button id="btnExport" class="btn btn-ghost btn-sm">Export</button>
    </div>
    <div id="noteList" class="grid gap-2">
      <p class="text-xs opacity-60">Belum ada catatan</p>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
var nT=document.getElementById('noteTitle'),nC=document.getElementById('noteContent'),bS=document.getElementById('btnSave'),nL=document.getElementById('noteList'),notes=[];try{var saved=localStorage.getItem('notes');if(saved)notes=JSON.parse(saved)}catch(e){}var editingId=null;function render(){if(notes.length===0){nL.innerHTML='<p class="text-xs opacity-60">Belum ada catatan</p>';return}nL.innerHTML=notes.map(function(n){return'<div class="rounded-xl p-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:2px solid #14b8a6"><div class="flex justify-between items-start"><div style="flex:1"><div class="text-sm font-medium mb-1" style="cursor:pointer" onclick="editNote(\''+n.id+'\')">'+n.title+'</div><p class="text-xs opacity-60 mb-0" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">'+(n.content.substring(0,80)||'(kosong)')+'</p></div><div class="flex gap-1 ml-2"><button class="btn btn-ghost btn-xs py-0 px-1" onclick="delNote(\''+n.id+'\')">&#10005;</button></div></div><div class="text-xs opacity-40 mt-1" style="font-size:0.65rem">'+new Date(n.created).toLocaleString('id-ID')+'</div></div>'}).join('')}function saveNote(){var title=nT.value.trim()||'Tanpa Judul',content=nC.value.trim();if(!content){alert('Isi catatan tidak boleh kosong');return}if(editingId){var idx=notes.findIndex(function(n){return n.id===editingId});if(idx>=0){notes[idx].title=title;notes[idx].content=content;notes[idx].updated=Date.now()}editingId=null}else notes.push({id:Date.now().toString(),title:title,content:content,created:Date.now()});localStorage.setItem('notes',JSON.stringify(notes));nT.value='';nC.value='';bS.textContent='Simpan';render()}function editNote(id){var n=notes.find(function(n){return n.id===id});if(!n)return;nT.value=n.title;nC.value=n.content;editingId=id;bS.textContent='Update';nT.focus()}function delNote(id){if(!confirm('Hapus catatan ini?'))return;notes=notes.filter(function(n){return n.id!==id});localStorage.setItem('notes',JSON.stringify(notes));render()}bS.addEventListener('click',saveNote);document.getElementById('btnExport').addEventListener('click',function(){var t=JSON.stringify(notes,null,2);navigator.clipboard.writeText(t).catch(function(){})});render();
</script>