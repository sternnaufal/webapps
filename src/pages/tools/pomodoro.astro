---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Pomodoro Timer';
const description = 'Pomodoro timer online. Fokus kerja 25 menit, istirahat 5 menit. Tingkatkan produktivitas.';
const keywords = 'pomodoro timer, pomodoro technique, focus timer, productivity timer, time management';
const aboutText = 'Pomodoro timer online. Fokus kerja 25 menit, istirahat 5 menit. Tingkatkan produktivitas.';
const relatedTools = [
  { slug: 'timer', name: 'Timer', icon: '⏱' },
  { slug: 'stopwatch', name: 'Stopwatch', icon: '⏱' },
  { slug: 'countdown', name: 'Countdown', icon: '⏳' },
  { slug: 'sleep-cycle', name: 'Sleep Cycle', icon: '😴' }
];

const toolCss = `.pomo-circle{width:200px;height:200px;border-radius:50%;border:6px solid #6366f1;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:border-color .3s}.pomo-circle.rest{border-color:#22c55e}.pomo-time{font-size:2.2rem;font-weight:700;font-variant-numeric:tabular-nums}`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5 text-center" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="pomo-circle mx-auto mb-3" id="pomoCircle">
        <div>
          <div class="pomo-time" id="pomoTime">25:00</div>
          <div class="text-xs opacity-60" id="pomoPhase">Fokus</div>
        </div>
      </div>
      <div class="flex justify-center gap-2 mb-3">
        <button id="btnStart" class="btn btn-primary btn-sm px-4">Mulai</button>
        <button id="btnPause" class="btn btn-ghost btn-sm px-4" disabled>Jeda</button>
        <button id="btnReset" class="btn btn-ghost btn-sm px-4">Reset</button>
      </div>
      <div class="flex justify-center"><span class="text-xs px-2 py-1 rounded" style="background:#eef2ff;color:#6366f1;" id="pomoCount">Sesi: 0</span></div>
    </div>
  </div>
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-5 mb-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Pengaturan</div>
      <div class="grid grid-cols-3 gap-2">
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Fokus (menit)</label><input type="number" id="focusTime" class="input input-bordered w-full input-sm" value="25" min="1" max="120"></div>
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Istirahat (menit)</label><input type="number" id="breakTime" class="input input-bordered w-full input-sm" value="5" min="1" max="60"></div>
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Long Break (menit)</label><input type="number" id="longBreak" class="input input-bordered w-full input-sm" value="15" min="1" max="120"></div>
      </div>
      <div class="text-xs opacity-60 mt-1">Long break setiap 4 sesi</div>
    </div>
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Apa Itu Pomodoro?</div>
      <div class="text-xs space-y-1 opacity-70">
        <p class="mb-1">Teknik Pomodoro dikembangkan oleh Francesco Cirillo. Metode ini menggunakan timer untuk membagi pekerjaan menjadi interval fokus (25 menit) yang dipisahkan oleh istirahat pendek (5 menit).</p>
        <p class="mb-0">Setelah 4 sesi, ambil long break (15-30 menit).</p>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>

<script is:inline>
var timer=null,isRunning=false,isFocus=true,seconds=25*60,sessionCount=0;
var timeEl=document.getElementById('pomoTime'),phaseEl=document.getElementById('pomoPhase'),circleEl=document.getElementById('pomoCircle'),countEl=document.getElementById('pomoCount');
var focusInp=document.getElementById('focusTime'),breakInp=document.getElementById('breakTime'),longInp=document.getElementById('longBreak');
var btnStart=document.getElementById('btnStart'),btnPause=document.getElementById('btnPause'),btnReset=document.getElementById('btnReset');

function updateDisplay(){
  var m=Math.floor(seconds/60),s=seconds%60;
  timeEl.textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
  phaseEl.textContent=isFocus?'Fokus':(sessionCount%4===0&&!isFocus?'Long Break':'Istirahat');
  phaseEl.style.color=isFocus?'#6366f1':'#22c55e';
  circleEl.className='pomo-circle'+(isFocus?'':' rest');
  countEl.textContent='Sesi: '+sessionCount;
}

function tick(){
  if(seconds<=0){
    if(isFocus){
      sessionCount++;
      isFocus=false;
      var longEvery=4,lb=parseInt(longInp.value)||15;
      seconds=(sessionCount%longEvery===0?lb:parseInt(breakInp.value||5))*60;
      notify('Waktu habis!','Waktunya '+(sessionCount%longEvery===0?'long break':'istirahat')+'!');
    }else{
      isFocus=true;
      seconds=parseInt(focusInp.value||25)*60;
      notify('Istirahat selesai!','Kembali fokus!');
    }
  }else{
    seconds--;
  }
  updateDisplay();
}

function notify(title,body){
  if('Notification'in window&&Notification.permission==='granted')new Notification(title,{body:body,icon:'apple-touch-icon.png'});
}

function startTimer(){
  if(isRunning)return;
  if(seconds<=0)return;
  if('Notification'in window&&Notification.permission==='default')Notification.requestPermission();
  isRunning=true;
  timer=setInterval(tick,1000);
  btnStart.disabled=true;btnPause.disabled=false;
}

function pauseTimer(){
  if(!isRunning)return;
  isRunning=false;
  clearInterval(timer);timer=null;
  btnStart.disabled=false;btnPause.disabled=true;
}

function resetTimer(){
  pauseTimer();
  isFocus=true;seconds=parseInt(focusInp.value||25)*60;sessionCount=0;
  updateDisplay();
  btnStart.disabled=false;btnPause.disabled=true;
}

btnStart.addEventListener('click',startTimer);
btnPause.addEventListener('click',pauseTimer);
btnReset.addEventListener('click',resetTimer);
[focusInp,breakInp,longInp].forEach(function(el){
  el.addEventListener('change',function(){
    if(!isRunning){resetTimer()}
  });
});
resetTimer();
</script>