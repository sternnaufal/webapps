---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'XML to JSON Converter';
const description = 'Konversi XML menjadi JSON online. Atribut XML diubah menjadi properti, elemen berulang menjadi array.';
const keywords = 'xml to json, konversi xml ke json, xml converter, xml parser, json converter';
const aboutText = 'XML to JSON Converter mengubah struktur XML menjadi objek JSON yang mudah dipakai di JavaScript, API, atau aplikasi modern.';
const aboutExtra = 'Atribut XML ditulis dengan awalan @, sedangkan elemen yang berulang otomatis menjadi array. Proses konversi berjalan sepenuhnya di browser.';
const relatedTools = [
  { slug: 'xml-formatter', name: 'XML Formatter', icon: 'XML' },
  { slug: 'json-formatter', name: 'JSON Formatter', icon: '{}' },
  { slug: 'csv-to-json', name: 'CSV to JSON', icon: 'CSV' },
  { slug: 'yaml-json', name: 'YAML to JSON', icon: 'YML' }
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="text-xs font-medium opacity-60 mb-1 block">Input XML</label>
        <textarea id="xmlInput" class="textarea textarea-bordered w-full text-sm font-mono" rows="10" placeholder="<root><item id='1'>A</item></root>"><root><item id="1">Contoh</item><item id="2">Data</item></root></textarea>
        <label class="flex items-center gap-2 text-xs mt-3">
          <input type="checkbox" id="useAttrs" class="checkbox checkbox-sm" checked>
          Sertakan atribut sebagai @nama
        </label>
        <button id="btnConvert" class="btn btn-primary btn-sm mt-3">Convert</button>
      </div>
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium opacity-60">Output JSON</label>
          <button id="btnCopy" class="btn btn-ghost btn-xs">Copy</button>
        </div>
        <textarea id="jsonOutput" class="textarea textarea-bordered w-full text-sm font-mono" rows="10" readonly></textarea>
        <p id="status" class="text-xs mt-2 opacity-60"></p>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
var input=document.getElementById('xmlInput'),output=document.getElementById('jsonOutput'),status=document.getElementById('status'),useAttrs=document.getElementById('useAttrs');
function elementToJson(el,attrs){
  var obj={};
  if(attrs && el.attributes.length){
    for(var i=0;i<el.attributes.length;i++) obj['@'+el.attributes[i].name]=el.attributes[i].value;
  }
  var kids=Array.prototype.slice.call(el.children);
  if(!kids.length){
    var text=el.textContent.trim();
    if(Object.keys(obj).length===0) return text;
    if(text) obj['#text']=text;
    return obj;
  }
  kids.forEach(function(child){
    var key=child.tagName, val=elementToJson(child,attrs);
    if(obj[key]===undefined) obj[key]=val;
    else if(Array.isArray(obj[key])) obj[key].push(val);
    else obj[key]=[obj[key],val];
  });
  return obj;
}
function convert(){
  var xml=input.value.trim(); if(!xml) return;
  var doc=new DOMParser().parseFromString(xml,'application/xml');
  var err=doc.querySelector('parsererror');
  if(err){ output.value=''; status.textContent='XML tidak valid: '+err.textContent.split('\n')[0]; status.style.color='#ef4444'; return; }
  var root=doc.documentElement, result={};
  result[root.tagName]=elementToJson(root,useAttrs.checked);
  output.value=JSON.stringify(result,null,2);
  status.textContent='Konversi selesai.'; status.style.color='#10b981';
}
document.getElementById('btnConvert').addEventListener('click',convert);
document.getElementById('btnCopy').addEventListener('click',function(){
  if(!output.value) return;
  navigator.clipboard.writeText(output.value).then(function(){ status.textContent='JSON disalin.'; status.style.color='#10b981'; });
});
useAttrs.addEventListener('change',convert);
convert();
</script>
