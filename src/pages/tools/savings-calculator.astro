---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Savings Calculator';
const description = 'Kalkulator tabungan online. Hitung bunga majemuk, target tabungan, dan simulasi investasi.';
const keywords = 'savings calculator, kalkulator tabungan, bunga majemuk, compound interest, investasi';
const aboutText = 'Kalkulator tabungan online. Hitung bunga majemuk, target tabungan, dan simulasi investasi.';
const relatedTools = [
  { slug: 'compound-interest-calculator', name: 'Compound Interest Calculator', icon: '💰' },
  { slug: 'mortgage-calculator', name: 'Mortgage Calculator', icon: '🏠' },
  { slug: 'calorie-calculator', name: 'Calorie Calculator', icon: '🍎' },
  { slug: 'bmi-calculator', name: 'Bmi Calculator', icon: '⚖' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="mb-3"><label class="text-xs font-medium opacity-60 mb-1 block">Jumlah Awal (Rp)</label><input type="number" id="initialAmount" class="input input-bordered w-full input-sm" value="1000000" step="100000"></div>
      <div class="mb-3"><label class="text-xs font-medium opacity-60 mb-1 block">Setoran Bulanan (Rp)</label><input type="number" id="monthlyAmount" class="input input-bordered w-full input-sm" value="500000" step="50000"></div>
      <div class="mb-3"><label class="text-xs font-medium opacity-60 mb-1 block">Bunga per Tahun (%)</label><input type="number" id="interestRate" class="input input-bordered w-full input-sm" value="6" step="0.1"></div>
      <div class="grid grid-cols-2 gap-2 mb-3">
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Jangka Waktu</label><input type="number" id="years" class="input input-bordered w-full input-sm" value="5" min="1" max="50"></div>
        <div><label class="text-xs font-medium opacity-60 mb-1 block">Frekuensi Bunga</label>
          <select id="compoundFreq" class="select select-bordered w-full select-sm">
            <option value="12">Bulanan</option>
            <option value="4">Kuartalan</option>
            <option value="1" selected>Tahunan</option>
          </select>
        </div>
      </div>
      <button id="btnCalc" class="btn btn-primary btn-sm w-full">Hitung</button>
    </div>
  </div>
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5 mb-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Hasil Simulasi</div>
      <div class="grid grid-cols-3 gap-3">
        <div class="p-3 rounded text-center" style="background:oklch(0.55 0.25 270 / 0.1);"><span class="text-xs opacity-60">Total Setoran</span><div class="text-sm font-bold" id="totalContrib" style="color:#6366f1">Rp0</div></div>
        <div class="p-3 rounded text-center" style="background:oklch(0.6 0.18 150 / 0.1);"><span class="text-xs opacity-60">Bunga</span><div class="text-sm font-bold" id="totalInterest" style="color:#16a34a">Rp0</div></div>
        <div class="p-3 rounded text-center" style="background:oklch(0.8 0.18 85 / 0.1);"><span class="text-xs opacity-60">Total Akhir</span><div class="text-sm font-bold" id="totalFinal" style="color:#ca8a04">Rp0</div></div>
      </div>
    </div>
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Detail per Tahun</div>
      <div class="overflow-x-auto" style="max-height:300px;overflow-y:auto">
        <table class="table table-sm w-full text-xs mb-0">
          <thead><tr><th class="text-left opacity-60 font-medium pb-1">Tahun</th><th class="text-right opacity-60 font-medium pb-1">Setoran</th><th class="text-right opacity-60 font-medium pb-1">Bunga</th><th class="text-right opacity-60 font-medium pb-1">Saldo</th></tr></thead>
          <tbody id="yearlyTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
var initial=document.getElementById('initialAmount'),monthly=document.getElementById('monthlyAmount'),rate=document.getElementById('interestRate'),years=document.getElementById('years'),freq=document.getElementById('compoundFreq');
function fmt(n){return 'Rp '+Math.round(n).toLocaleString('id-ID')}

document.getElementById('btnCalc').addEventListener('click',function(){
  var P=parseFloat(initial.value)||0,M=parseFloat(monthly.value)||0,r=parseFloat(rate.value)/100/100,y=parseInt(years.value)||1,n=parseInt(freq.value);
  var totalContrib=P+(M*12*y),balance=P,prevBalance=P,totalInterest=0;
  var rows='',monthsPerYear=12,months=y*12,monthlyRate=r/12;

  for(var year=1;year<=y;year++){
    var annualContrib=M*12;
    for(var m=1;m<=12;m++){
      balance=(balance+monthlyRate)*(1+monthlyRate);
      balance+=M;
    }
    var yearInterest=balance-prevBalance-annualContrib;
    totalInterest+=yearInterest;
    prevBalance=balance;
    rows+='<tr><td class="py-1">'+year+'</td><td class="py-1 text-right">'+fmt(totalContrib)+'</td><td class="py-1 text-right">'+fmt(totalInterest)+'</td><td class="py-1 font-bold text-right">'+fmt(balance)+'</td></tr>';
  }

  document.getElementById('totalContrib').textContent=fmt(totalContrib);
  document.getElementById('totalInterest').textContent=fmt(totalInterest);
  document.getElementById('totalFinal').textContent=fmt(balance);
  document.getElementById('yearlyTable').innerHTML=rows;
});
document.getElementById('btnCalc').click();
</script>