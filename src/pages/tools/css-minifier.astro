---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'CSS Minifier / Beautifier';
const desc = 'Minify atau beautify CSS kode. Kompres CSS untuk produksi, atau format/tulis rapi untuk development.';
const keywords = 'css minifier, css beautifier, css formatter, minify css, format css, css compression';
const aboutText = 'CSS Minifier / Beautifier CSS Minifier / Beautifier online. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'html-minifier', name: 'Html Minifier', icon: 'CSS' },
  { slug: 'json-formatter', name: 'Json Formatter', icon: '{}' },
  { slug: 'sql-formatter', name: 'Sql Formatter', icon: 'SQL' },
  { slug: 'css-unit', name: 'Css Unit', icon: 'px' }
];
const bodyHtml = '<div class="flex flex-wrap gap-4">\n  <div class="w-full"><div class="flex gap-2 flex-wrap">\n    <button id="cssMin" class="btn btn-warning">Minify</button>\n    <button id="cssBeaut" class="btn btn-outline-primary">Beautify</button>\n    <button id="cssCopy" class="btn btn-outline">Copy</button>\n    <button id="cssClear" class="btn btn-outline">Clear</button>\n    <span id="cssStats" class="ml-auto text-sm opacity-60 flex items-center">---</span>\n  </div></div>\n  <div class="md:w-1/2 w-full"><label class="label-text font-semibold">Input</label><textarea id="cssIn" class="input input-bordered w-full font-mono" rows="16" placeholder="Tempel CSS di sini...">body &#123; background: #fff; color: #333; font-family: system-ui; margin: 0; padding: 2rem; &#125;</textarea></div>\n  <div class="md:w-1/2 w-full"><label class="label-text font-semibold">Output</label><textarea id="cssOut" class="input input-bordered w-full font-mono" rows="16" readonly></textarea></div>\n</div>';
---

<ToolLayout title={title} description=&#123;desc&#125; keywords={keywords}>
<Fragment set:html=&#123;bodyHtml&#125; />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float{position:fixed;bottom:24px;right:24px;z-index:9999;background:#ff6b6b;color:#fff;border-radius:50px;padding:10px 20px 10px 16px;text-decoration:none;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;box-shadow:0 4px 15px rgba(255,107,107,0.4);transition:all .3s ease;font-family:"Inter",sans-serif}
.saweria-float:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(255,107,107,0.6);color:#fff}
.saweria-float svg{animation:pulse 1.5s ease infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
@media(max-width:576px){.saweria-float{bottom:16px;right:16px;padding:8px 14px 8px 10px;font-size:12px}}
</style>

<script is:inline>
document.getElementById("cssMin").onclick=()=>&#123;const i=document.getElementById("cssIn").value;const o=i.replace(/\/\*[\s\S]*?\*\//g,"").replace(/\s+/g," ").replace(/\s*&#123;\s*/g,"&#123;").replace(/\s*&#125;\s*/g,"&#125;").replace(/;&#125;/g,"&#125;").replace(/\s*:\s*/g,":").replace(/\s*;\s*/g,";").replace(/\s*,\s*/g,",").trim();document.getElementById("cssOut").value=o;cssStats(i,o)&#125;;
document.getElementById("cssBeaut").onclick=()=>&#123;let i=document.getElementById("cssIn").value;const o=i.replace(/\/\*[\s\S]*?\*\//g,m=>m+"\n").replace(/\s+/g," ").replace(/&#123;/g," &#123;\n  ").replace(/;/g,";\n  ").replace(/&#125;/g,"\n&#125;\n").replace(/,\s*/g,", ").replace(/:\s*/g,": ").replace(/^\s+|\s+$/gm,"").replace(/\n&#123;3,&#125;/g,"\n\n").trim();document.getElementById("cssOut").value=o;cssStats(i,o)&#125;;
document.getElementById("cssCopy").onclick=()=>navigator.clipboard.writeText(document.getElementById("cssOut").value);
document.getElementById("cssClear").onclick=()=>&#123;document.getElementById("cssIn").value="";document.getElementById("cssOut").value="";document.getElementById("cssStats").textContent="---"&#125;;
function cssStats(i,o)&#123;const ib=new TextEncoder().encode(i).length,ob=new TextEncoder().encode(o).length;const saved=((ib-ob)/ib*100).toFixed(1);document.getElementById("cssStats").innerHTML=ib+" B &rarr; "+ob+" B ("+saved+"%)"&#125;
</script>

