---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Roman Numeral Converter';
const description = 'Konverter angka Romawi online. Ubah angka desimal ke Romawi (I, V, X, L, C, D, M) dan sebaliknya.';
const keywords = 'roman numeral converter, angka romawi, romawi converter, roman to number, number to roman';
const aboutText = 'Roman Numeral Converter Konverter angka Romawi online. Ubah angka desimal ke Romawi (I, V, X, L, C, D, M) dan sebaliknya.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'konverter-bilangan', name: 'Konverter Bilangan', icon: '2' },
  { slug: 'number-to-words', name: 'Number To Words', icon: '🔤' },
  { slug: 'decimal-to-fraction', name: 'Decimal To Fraction', icon: '½' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' }
];
const bodyHtml = `<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#fefce8;color:#ca8a04;">IV</div><div><h1 class="h3 mb-0">Roman Numeral Converter</h1><p class="opacity-60 small mb-0">Konversi angka desimal ke Romawi (I, V, X, L, C, D, M) dan sebaliknya.</p></div></header>
<div class="flex flex-wrap gap-4"><div class="lg:w-5/12 w-full">
<div class="card card-bordered bg-base-100 p-3 mb-3">
<div class="btn-group mb-3 w-full" role="group"><button id="modeToRoman" class="btn btn-primary w-50">Desimal ? Romawi</button><button id="modeToDecimal" class="btn btn-outline-primary w-50">Romawi ? Desimal</button></div>
<div id="toRomanPane"><label class="label-text font-semibold">Angka Desimal</label><input type="number" id="decimalInput" class="input input-bordered w-full font-mono" value="2024" min="1" max="3999">
<button id="btnToRoman" class="btn btn-primary w-full mt-2">Konversi ke Romawi</button>
<div id="romanResult" class="mt-3 p-3 bg-light rounded text-center"><div class="text-3xl font-bold font-bold" style="color:#6366f1;letter-spacing:4px">MMXXIV</div></div></div>
<div id="toDecimalPane" style="display:none"><label class="label-text font-semibold">Angka Romawi</label><input type="text" id="romanInput" class="input input-bordered w-full font-mono" value="MMXXIV" maxlength="20">
<button id="btnToDecimal" class="btn btn-primary w-full mt-2">Konversi ke Desimal</button>
<div id="decimalResult" class="mt-3 p-3 bg-light rounded text-center"><div class="text-3xl font-bold font-bold" style="color:#6366f1">2024</div></div></div>
</div>
<div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Tabel Referensi Cepat</h6>
<div class="overflow-x-auto"><table class="table table-sm small mb-0"><thead><tr><th>Romawi</th><th>Desimal</th><th>Romawi</th><th>Desimal</th></tr></thead><tbody>
<tr><td>I</td><td>1</td><td>XL</td><td>40</td></tr>
<tr><td>IV</td><td>4</td><td>L</td><td>50</td></tr>
<tr><td>V</td><td>5</td><td>XC</td><td>90</td></tr>
<tr><td>IX</td><td>9</td><td>C</td><td>100</td></tr>
<tr><td>X</td><td>10</td><td>CD</td><td>400</td></tr>
<tr><td>XIV</td><td>14</td><td>D</td><td>500</td></tr>
<tr><td>XIX</td><td>19</td><td>CM</td><td>900</td></tr>
<tr><td>XX</td><td>20</td><td>M</td><td>1000</td></tr>
</tbody></table></div></div>
</div>
<div class="lg:w-7/12 w-full">
<div class="card card-bordered bg-base-100 p-3">
<h6 class="mb-3">Konversi Cepat</h6>
<div class="row gap-2">
<button class="btn btn-outline btn-sm col-3" data-val="1">I</button>
<button class="btn btn-outline btn-sm col-3" data-val="4">IV</button>
<button class="btn btn-outline btn-sm col-3" data-val="5">V</button>
<button class="btn btn-outline btn-sm col-3" data-val="9">IX</button>
<button class="btn btn-outline btn-sm col-3" data-val="10">X</button>
<button class="btn btn-outline btn-sm col-3" data-val="14">XIV</button>
<button class="btn btn-outline btn-sm col-3" data-val="19">XIX</button>
<button class="btn btn-outline btn-sm col-3" data-val="20">XX</button>
<button class="btn btn-outline btn-sm col-3" data-val="40">XL</button>
<button class="btn btn-outline btn-sm col-3" data-val="50">L</button>
<button class="btn btn-outline btn-sm col-3" data-val="90">XC</button>
<button class="btn btn-outline btn-sm col-3" data-val="100">C</button>
<button class="btn btn-outline btn-sm col-3" data-val="400">CD</button>
<button class="btn btn-outline btn-sm col-3" data-val="500">D</button>
<button class="btn btn-outline btn-sm col-3" data-val="900">CM</button>
<button class="btn btn-outline btn-sm col-3" data-val="1000">M</button>
</div>
</div>
<div class="card card-bordered bg-base-100 p-3 mt-3">
<h6 class="mb-3">Tahun Romawi Populer</h6>
<div id="yearList" class="small"></div>
</div>
</div></div>
`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<Fragment set:html={bodyHtml} />

  <ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
function toRoman(n){
  if(n<1||n>3999)return '';
  var vals=[1000,900,500,400,100,90,50,40,10,9,5,4,1],nums=['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'],r='';
  for(var i=0;i<vals.length;i++){while(n>=vals[i]){r+=nums[i];n-=vals[i]}}
  return r;
}
function fromRoman(r){
  var m={I:1,V:5,X:10,L:50,C:100,D:500,M:1000},total=0;
  for(var i=0;i<r.length;i++){
    var cur=m[r[i]]||0,next=m[r[i+1]]||0;
    if(cur<next){total-=cur}else{total+=cur}
  }
  return total;
}

var mode='roman';
document.getElementById('modeToRoman').addEventListener('click',function(){
  mode='roman';this.className='btn btn-primary w-50';
  document.getElementById('modeToDecimal').className='btn btn-outline-primary w-50';
  document.getElementById('toRomanPane').style.display='block';
  document.getElementById('toDecimalPane').style.display='none';
});
document.getElementById('modeToDecimal').addEventListener('click',function(){
  mode='decimal';this.className='btn btn-primary w-50';
  document.getElementById('modeToRoman').className='btn btn-outline-primary w-50';
  document.getElementById('toRomanPane').style.display='none';
  document.getElementById('toDecimalPane').style.display='block';
});

document.getElementById('btnToRoman').addEventListener('click',function(){
  var v=parseInt(document.getElementById('decimalInput').value)||0;
  document.getElementById('romanResult').innerHTML='<div class="text-3xl font-bold font-bold" style="color:#6366f1;letter-spacing:4px">'+(toRoman(v)||'<span class="text-error">Invalid</span>')+'</div>';
});
document.getElementById('btnToDecimal').addEventListener('click',function(){
  var v=document.getElementById('romanInput').value.toUpperCase().replace(/[^IVXLCDM]/g,'');
  document.getElementById('decimalResult').innerHTML='<div class="text-3xl font-bold font-bold" style="color:#6366f1">'+fromRoman(v)+'</div>';
});
document.getElementById('decimalInput').addEventListener('input',function(){
  var v=parseInt(this.value)||0;
  document.getElementById('romanResult').innerHTML='<div class="text-3xl font-bold font-bold" style="color:#6366f1;letter-spacing:4px">'+(toRoman(v)||'')+'</div>';
});
document.getElementById('romanInput').addEventListener('input',function(){
  var v=this.value.toUpperCase().replace(/[^IVXLCDM]/g,'');
  document.getElementById('decimalResult').innerHTML='<div class="text-3xl font-bold font-bold" style="color:#6366f1">'+fromRoman(v)+'</div>';
});

document.querySelectorAll('[data-val]').forEach(function(b){
  b.addEventListener('click',function(){
    var v=parseInt(this.dataset.val),r=toRoman(v);
    if(mode==='roman'){document.getElementById('decimalInput').value=v;document.getElementById('romanResult').innerHTML='<div class="text-3xl font-bold font-bold" style="color:#6366f1;letter-spacing:4px">'+r+'</div>'}
    else{document.getElementById('romanInput').value=r;document.getElementById('decimalResult').innerHTML='<div class="text-3xl font-bold font-bold" style="color:#6366f1">'+v+'</div>'}
  });
});

var yearsHtml='';
[1990,2000,2010,2020,2024,2025,2026,2027,2045,2050].forEach(function(y){
  yearsHtml+='<span class="badge bg-light text-dark mr-1 mb-1" style="cursor:pointer" data-yr="'+y+'">'+y+' = '+toRoman(y)+'</span> ';
});
document.getElementById('yearList').innerHTML=yearsHtml;
document.querySelectorAll('[data-yr]').forEach(function(el){
  el.addEventListener('click',function(){
    var y=parseInt(this.dataset.yr);
    document.getElementById('decimalInput').value=y;
    document.getElementById('romanResult').innerHTML='<div class="text-3xl font-bold font-bold" style="color:#6366f1;letter-spacing:4px">'+toRoman(y)+'</div>';
  });
});
</script>

