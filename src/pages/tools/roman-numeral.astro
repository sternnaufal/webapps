---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Roman Numeral Converter';
const description = 'Konverter angka Romawi online. Ubah angka desimal ke Romawi (I, V, X, L, C, D, M) dan sebaliknya.';
const keywords = 'roman numeral converter, angka romawi, romawi converter, roman to number, number to roman';
const aboutText = 'Roman Numeral Converter Konverter angka Romawi online. Ubah angka desimal ke Romawi (I, V, X, L, C, D, M) dan sebaliknya.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'konverter-bilangan', name: 'Konverter Bilangan', icon: '2' },
  { slug: 'number-to-words', name: 'Number To Words', icon: '🔤' },
  { slug: 'decimal-to-fraction', name: 'Decimal To Fraction', icon: '½' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-5 mb-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="flex mb-3">
        <button id="modeToRoman" class="btn btn-primary btn-sm flex-1 rounded-r-none">Desimal &rarr; Romawi</button>
        <button id="modeToDecimal" class="btn btn-ghost btn-sm flex-1 rounded-l-none">Romawi &rarr; Desimal</button>
      </div>
      <div id="toRomanPane">
        <label class="text-xs font-medium opacity-60 mb-1 block">Angka Desimal</label>
        <input type="number" id="decimalInput" class="input input-bordered w-full input-sm font-mono" value="2024" min="1" max="3999">
        <button id="btnToRoman" class="btn btn-primary btn-sm w-full mt-2">Konversi ke Romawi</button>
        <div id="romanResult" class="mt-3 p-3 rounded text-center text-sm" style="background:oklch(0.95 0.003 270);"><span class="text-lg font-bold" style="color:#6366f1;letter-spacing:4px">MMXXIV</span></div>
      </div>
      <div id="toDecimalPane" style="display:none">
        <label class="text-xs font-medium opacity-60 mb-1 block">Angka Romawi</label>
        <input type="text" id="romanInput" class="input input-bordered w-full input-sm font-mono" value="MMXXIV" maxlength="20">
        <button id="btnToDecimal" class="btn btn-primary btn-sm w-full mt-2">Konversi ke Desimal</button>
        <div id="decimalResult" class="mt-3 p-3 rounded text-center text-sm" style="background:oklch(0.95 0.003 270);"><span class="text-lg font-bold" style="color:#6366f1">2024</span></div>
      </div>
    </div>
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Tabel Referensi Cepat</div>
      <div class="overflow-x-auto">
        <table class="table table-sm w-full text-xs mb-0">
          <thead><tr><th class="text-left opacity-60 font-medium">Romawi</th><th class="text-left opacity-60 font-medium">Desimal</th><th class="text-left opacity-60 font-medium">Romawi</th><th class="text-left opacity-60 font-medium">Desimal</th></tr></thead>
          <tbody>
            <tr><td>I</td><td>1</td><td>XL</td><td>40</td></tr>
            <tr><td>IV</td><td>4</td><td>L</td><td>50</td></tr>
            <tr><td>V</td><td>5</td><td>XC</td><td>90</td></tr>
            <tr><td>IX</td><td>9</td><td>C</td><td>100</td></tr>
            <tr><td>X</td><td>10</td><td>CD</td><td>400</td></tr>
            <tr><td>XIV</td><td>14</td><td>D</td><td>500</td></tr>
            <tr><td>XIX</td><td>19</td><td>CM</td><td>900</td></tr>
            <tr><td>XX</td><td>20</td><td>M</td><td>1000</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Konversi Cepat</div>
      <div class="grid grid-cols-4 gap-1">
        <button class="btn btn-ghost btn-xs" data-val="1">I</button>
        <button class="btn btn-ghost btn-xs" data-val="4">IV</button>
        <button class="btn btn-ghost btn-xs" data-val="5">V</button>
        <button class="btn btn-ghost btn-xs" data-val="9">IX</button>
        <button class="btn btn-ghost btn-xs" data-val="10">X</button>
        <button class="btn btn-ghost btn-xs" data-val="14">XIV</button>
        <button class="btn btn-ghost btn-xs" data-val="19">XIX</button>
        <button class="btn btn-ghost btn-xs" data-val="20">XX</button>
        <button class="btn btn-ghost btn-xs" data-val="40">XL</button>
        <button class="btn btn-ghost btn-xs" data-val="50">L</button>
        <button class="btn btn-ghost btn-xs" data-val="90">XC</button>
        <button class="btn btn-ghost btn-xs" data-val="100">C</button>
        <button class="btn btn-ghost btn-xs" data-val="400">CD</button>
        <button class="btn btn-ghost btn-xs" data-val="500">D</button>
        <button class="btn btn-ghost btn-xs" data-val="900">CM</button>
        <button class="btn btn-ghost btn-xs" data-val="1000">M</button>
      </div>
    </div>
    <div class="rounded-xl p-5 mt-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-xs font-medium opacity-60 mb-3">Tahun Romawi Populer</div>
      <div id="yearList" class="text-xs flex flex-wrap gap-1"></div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
function toRoman(n){
  if(n<1||n>3999)return '';
  var vals=[1000,900,500,400,100,90,50,40,10,9,5,4,1],nums=['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'],r='';
  for(var i=0;i<vals.length;i++){while(n>=vals[i]){r+=nums[i];n-=vals[i]}}
  return r;
}
function fromRoman(r){
  var m={I:1,V:5,X:10,L:50,C:100,D:500,M:1000},total=0;
  for(var i=0;i<r.length;i++){
    var cur=m[r[i]]||0,next=m[r[i+1]]||0;
    if(cur<next){total-=cur}else{total+=cur}
  }
  return total;
}

var mode='roman';
document.getElementById('modeToRoman').addEventListener('click',function(){
  mode='roman';this.className='btn btn-primary btn-sm flex-1 rounded-r-none';
  document.getElementById('modeToDecimal').className='btn btn-ghost btn-sm flex-1 rounded-l-none';
  document.getElementById('toRomanPane').style.display='block';
  document.getElementById('toDecimalPane').style.display='none';
});
document.getElementById('modeToDecimal').addEventListener('click',function(){
  mode='decimal';this.className='btn btn-primary btn-sm flex-1 rounded-l-none';
  document.getElementById('modeToRoman').className='btn btn-ghost btn-sm flex-1 rounded-r-none';
  document.getElementById('toRomanPane').style.display='none';
  document.getElementById('toDecimalPane').style.display='block';
});

document.getElementById('btnToRoman').addEventListener('click',function(){
  var v=parseInt(document.getElementById('decimalInput').value)||0;
  document.getElementById('romanResult').innerHTML='<span class="text-lg font-bold" style="color:#6366f1;letter-spacing:4px">'+(toRoman(v)||'<span class="text-red-500">Invalid</span>')+'</span>';
});
document.getElementById('btnToDecimal').addEventListener('click',function(){
  var v=document.getElementById('romanInput').value.toUpperCase().replace(/[^IVXLCDM]/g,'');
  document.getElementById('decimalResult').innerHTML='<span class="text-lg font-bold" style="color:#6366f1">'+fromRoman(v)+'</span>';
});
document.getElementById('decimalInput').addEventListener('input',function(){
  var v=parseInt(this.value)||0;
  document.getElementById('romanResult').innerHTML='<span class="text-lg font-bold" style="color:#6366f1;letter-spacing:4px">'+(toRoman(v)||'')+'</span>';
});
document.getElementById('romanInput').addEventListener('input',function(){
  var v=this.value.toUpperCase().replace(/[^IVXLCDM]/g,'');
  document.getElementById('decimalResult').innerHTML='<span class="text-lg font-bold" style="color:#6366f1">'+fromRoman(v)+'</span>';
});

document.querySelectorAll('[data-val]').forEach(function(b){
  b.addEventListener('click',function(){
    var v=parseInt(this.dataset.val),r=toRoman(v);
    if(mode==='roman'){document.getElementById('decimalInput').value=v;document.getElementById('romanResult').innerHTML='<span class="text-lg font-bold" style="color:#6366f1;letter-spacing:4px">'+r+'</span>'}
    else{document.getElementById('romanInput').value=r;document.getElementById('decimalResult').innerHTML='<span class="text-lg font-bold" style="color:#6366f1">'+v+'</span>'}
  });
});

var yearsHtml='';
[1990,2000,2010,2020,2024,2025,2026,2027,2045,2050].forEach(function(y){
  yearsHtml+='<span class="px-2 py-1 rounded text-xs cursor-pointer" style="background:oklch(0.93 0.003 270);" data-yr="'+y+'">'+y+' = '+toRoman(y)+'</span> ';
});
document.getElementById('yearList').innerHTML=yearsHtml;
document.querySelectorAll('[data-yr]').forEach(function(el){
  el.addEventListener('click',function(){
    var y=parseInt(this.dataset.yr);
    document.getElementById('decimalInput').value=y;
    document.getElementById('romanResult').innerHTML='<span class="text-lg font-bold" style="color:#6366f1;letter-spacing:4px">'+toRoman(y)+'</span>';
  });
});
</script>