---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'BMI Calculator';
const description = 'Kalkulator BMI online. Hitung Indeks Massa Tubuh dan cek kategori berat badan.';
const keywords = 'bmi calculator, bmi kalkulator, indeks massa tubuh, berat badan ideal, health calculator';
const aboutText = 'BMI Calculator Kalkulator BMI online. Hitung Indeks Massa Tubuh dan cek kategori berat badan.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'calorie-calculator', name: 'Calorie Calculator', icon: '🍎' },
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' },
  { slug: 'tip-calculator', name: 'Tip Calculator', icon: '💰' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#f0fdf4;color:#16a34a;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg></div><div><h1 class="h3 mb-0">BMI Calculator</h1><p class="opacity-60 small mb-0">Hitung Indeks Massa Tubuh (BMI) dan cek kategori berat badan.</p></div></header>
<div class="flex flex-wrap gap-4"><div class="lg:w-5/12 w-full">
<div class="card card-bordered bg-base-100 p-3">
<div class="mb-3"><label class="label-text font-semibold">Jenis Kelamin</label><div><div class="flex items-center gap-2 flex items-center gap-2-inline"><input type="radio" name="gender" id="genderMale" class="checkbox" checked><label class="flex items-center gap-2-label" for="genderMale">Laki-laki</label></div><div class="flex items-center gap-2 flex items-center gap-2-inline"><input type="radio" name="gender" id="genderFemale" class="checkbox"><label class="flex items-center gap-2-label" for="genderFemale">Perempuan</label></div></div></div>
<div class="row gap-2 mb-3"><div class="col-6"><label class="label-text small">Tinggi Badan (cm)</label><input type="number" id="heightInput" class="input input-bordered w-full" value="170" min="50" max="300"></div><div class="col-6"><label class="label-text small">Berat Badan (kg)</label><input type="number" id="weightInput" class="input input-bordered w-full" value="65" min="10" max="500"></div></div>
<button id="btnCalc" class="btn btn-primary w-full">Hitung BMI</button>
</div></div>
<div class="lg:w-7/12 w-full">
<div class="card card-bordered bg-base-100 p-3">
<div class="text-center mb-3"><div class="display-3 font-bold" id="bmiValue">22.5</div><div class="font-semibold" id="bmiCategory" style="color:#22c55e">Normal</div></div>
<div class="relative" style="height:12px;margin:20px 0"><div class="bmi-scale"><span style="background:#3b82f6"></span><span style="background:#22c55e"></span><span style="background:#f59e0b"></span><span style="background:#f97316"></span><span style="background:#ef4444"></span></div><div class="bmi-arrow" id="bmiArrow" style="left:45%"></div></div>
<div class="row text-center small gap-2"><div class="col"><span class="text-primary">Kurus<br>&lt;18.5</span></div><div class="col"><span class="text-success">Normal<br>18.524.9</span></div><div class="col"><span class="text-warning">Overweight<br>2529.9</span></div><div class="col"><span class="text-orange">Obesitas I<br>3034.9</span></div><div class="col"><span class="text-error">Obesitas II<br>=35</span></div></div>
<div id="bmiDetail" class="mt-3 p-3 bg-light rounded small"></div>
</div></div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<script is:inline>
var hInp=document.getElementById('heightInput'),wInp=document.getElementById('weightInput'),bmiV=document.getElementById('bmiValue'),bmiC=document.getElementById('bmiCategory'),bmiA=document.getElementById('bmiArrow'),bmiD=document.getElementById('bmiDetail');
function calc()&#123;
  var h=parseFloat(hInp.value)||0,w=parseFloat(wInp.value)||0;
  if(h<=0||w<=0)&#123;bmiV.textContent='0';bmiC.textContent='Masukkan data';return&#125;
  var bmi=w/((h/100)*(h/100));
  bmiV.textContent=bmi.toFixed(1);
  var cat,color,advice;
  if(bmi<18.5)&#123;cat='Kurus';color='#3b82f6';advice='Anda memiliki berat badan di bawah normal. Disarankan untuk meningkatkan asupan nutrisi dan konsultasi dengan ahli gizi.';bmiA.style.left=''+(bmi/18.5*20)+'%'&#125;
  else if(bmi<25)&#123;cat='Normal';color='#22c55e';advice='Berat badan Anda ideal. Pertahankan pola makan sehat dan olahraga teratur!';bmiA.style.left=''+(20+(bmi-18.5)/6.4*20)+'%'&#125;
  else if(bmi<30)&#123;cat='Overweight';color='#f59e0b';advice='Anda memiliki kelebihan berat badan. Disarankan untuk meningkatkan aktivitas fisik dan mengatur pola makan.';bmiA.style.left=''+(40+(bmi-25)/4.9*20)+'%'&#125;
  else if(bmi<35)&#123;cat='Obesitas I';color='#f97316';advice='Anda berada dalam kategori obesitas tingkat I. Sangat disarankan untuk berkonsultasi dengan dokter.';bmiA.style.left=''+(60+(bmi-30)/4.9*20)+'%'&#125;
  else&#123;cat='Obesitas II';color='#ef4444';advice='Anda berada dalam kategori obesitas tingkat II. Segera konsultasi dengan dokter untuk penanganan lebih lanjut.';bmiA.style.left='80%'&#125;
  bmiC.textContent=cat;bmiC.style.color=color;
  bmiD.innerHTML='<div class="font-bold mb-1">Informasi BMI</div><table class="table table-sm small mb-0"><tr><td>BMI</td><td class="font-bold">'+bmi.toFixed(1)+'</td></tr><tr><td>Kategori</td><td style="color:'+color+';font-weight:600">'+cat+'</td></tr><tr><td>Keterangan</td><td>'+advice+'</td></tr></table>';
&#125;
document.getElementById('btnCalc').addEventListener('click',calc);
[hInp,wInp].forEach(function(el)&#123;el.addEventListener('input',calc)&#125;);
calc();
</script>

