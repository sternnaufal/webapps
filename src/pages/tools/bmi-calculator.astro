---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'BMI Calculator';
const description = 'Kalkulator BMI online. Hitung Indeks Massa Tubuh dan cek kategori berat badan.';
const keywords = 'bmi calculator, bmi kalkulator, indeks massa tubuh, berat badan ideal, health calculator';
const aboutText = 'Kalkulator BMI online. Hitung Indeks Massa Tubuh dan cek kategori berat badan.';
const relatedTools = [
  { slug: 'calorie-calculator', name: 'Calorie Calculator', icon: '🍎' },
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' },
  { slug: 'tip-calculator', name: 'Tip Calculator', icon: '💰' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="flex flex-wrap gap-4">
  <div class="lg:w-5/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Jenis Kelamin</label>
        <div class="flex gap-3 text-xs">
          <label class="flex items-center gap-2"><input type="radio" name="gender" id="genderMale" class="checkbox checkbox-sm" checked> Laki-laki</label>
          <label class="flex items-center gap-2"><input type="radio" name="gender" id="genderFemale" class="checkbox checkbox-sm"> Perempuan</label>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2 mb-3">
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Tinggi Badan (cm)</label>
          <input type="number" id="heightInput" class="input input-bordered w-full input-sm" value="170" min="50" max="300">
        </div>
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Berat Badan (kg)</label>
          <input type="number" id="weightInput" class="input input-bordered w-full input-sm" value="65" min="10" max="500">
        </div>
      </div>
      <button id="btnCalc" class="btn btn-primary btn-sm w-full">Hitung BMI</button>
    </div>
  </div>
  <div class="lg:w-7/12 w-full">
    <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
      <div class="text-center mb-3">
        <div class="text-3xl font-bold" id="bmiValue">22.5</div>
        <div class="text-sm font-medium" id="bmiCategory" style="color:#22c55e">Normal</div>
      </div>
      <div class="relative" style="height:12px;margin:20px 0">
        <div class="flex h-full rounded-full overflow-hidden">
          <span style="flex:1;background:#3b82f6"></span>
          <span style="flex:1;background:#22c55e"></span>
          <span style="flex:1;background:#f59e0b"></span>
          <span style="flex:1;background:#f97316"></span>
          <span style="flex:1;background:#ef4444"></span>
        </div>
        <div id="bmiArrow" class="absolute top-0 w-0 h-0" style="left:45%;border-left:6px solid transparent;border-right:6px solid transparent;border-top:8px solid #333;transform:translateX(-50%);"></div>
      </div>
      <div class="grid grid-cols-5 gap-1 text-center text-xs">
        <div><span class="text-blue-500">Kurus<br>&lt;18.5</span></div>
        <div><span class="text-green-500">Normal<br>18.5-24.9</span></div>
        <div><span class="text-yellow-500">Overweight<br>25-29.9</span></div>
        <div><span class="text-orange-500">Obesitas I<br>30-34.9</span></div>
        <div><span class="text-red-500">Obesitas II<br>=35</span></div>
      </div>
      <div id="bmiDetail" class="mt-3 p-3 rounded text-xs" style="background:oklch(0.95 0.003 270);"></div>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
var hInp=document.getElementById('heightInput'),wInp=document.getElementById('weightInput'),bmiV=document.getElementById('bmiValue'),bmiC=document.getElementById('bmiCategory'),bmiA=document.getElementById('bmiArrow'),bmiD=document.getElementById('bmiDetail');
function calc(){
  var h=parseFloat(hInp.value)||0,w=parseFloat(wInp.value)||0;
  if(h<=0||w<=0){bmiV.textContent='0';bmiC.textContent='Masukkan data';return}
  var bmi=w/((h/100)*(h/100));
  bmiV.textContent=bmi.toFixed(1);
  var cat,color,advice;
  if(bmi<18.5){cat='Kurus';color='#3b82f6';advice='Anda memiliki berat badan di bawah normal. Disarankan untuk meningkatkan asupan nutrisi dan konsultasi dengan ahli gizi.';bmiA.style.left=''+(bmi/18.5*20)+'%'}
  else if(bmi<25){cat='Normal';color='#22c55e';advice='Berat badan Anda ideal. Pertahankan pola makan sehat dan olahraga teratur!';bmiA.style.left=''+(20+(bmi-18.5)/6.4*20)+'%'}
  else if(bmi<30){cat='Overweight';color='#f59e0b';advice='Anda memiliki kelebihan berat badan. Disarankan untuk meningkatkan aktivitas fisik dan mengatur pola makan.';bmiA.style.left=''+(40+(bmi-25)/4.9*20)+'%'}
  else if(bmi<35){cat='Obesitas I';color='#f97316';advice='Anda berada dalam kategori obesitas tingkat I. Sangat disarankan untuk berkonsultasi dengan dokter.';bmiA.style.left=''+(60+(bmi-30)/4.9*20)+'%'}
  else{cat='Obesitas II';color='#ef4444';advice='Anda berada dalam kategori obesitas tingkat II. Segera konsultasi dengan dokter untuk penanganan lebih lanjut.';bmiA.style.left='80%'}
  bmiC.textContent=cat;bmiC.style.color=color;
  bmiD.innerHTML='<div class="font-bold mb-1">Informasi BMI</div><table class="table table-sm w-full text-xs mb-0"><tr><td class="py-1 opacity-60">BMI</td><td class="py-1 font-bold text-right">'+bmi.toFixed(1)+'</td></tr><tr><td class="py-1 opacity-60">Kategori</td><td class="py-1 font-bold text-right" style="color:'+color+'">'+cat+'</td></tr><tr><td class="py-1 opacity-60">Keterangan</td><td class="py-1 text-right text-xs">'+advice+'</td></tr></table>';
}
document.getElementById('btnCalc').addEventListener('click',calc);
[hInp,wInp].forEach(function(el){el.addEventListener('input',calc)});
calc();
</script>