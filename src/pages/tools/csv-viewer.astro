---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'CSV/TSV Viewer';
const description = 'Lihat dan filter file CSV/TSV online. Preview tabel dengan pencarian dan pengurutan data.';
const keywords = 'csv viewer, tsv viewer, csv parser, csv editor, data viewer';
const aboutText = 'Lihat dan filter file CSV/TSV online. Preview tabel dengan pencarian dan pengurutan data.';
const relatedTools = [
  { slug: 'json-csv', name: 'Json Csv', icon: '⇄' },
  { slug: 'json-formatter', name: 'Json Formatter', icon: '{}' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' },
  { slug: 'word-frequency', name: 'Word Frequency', icon: '📊' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5 mb-3" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #14b8a6;">
  <div class="flex flex-wrap gap-3 mb-3">
    <div class="md:w-2/3 w-full">
      <label class="text-xs font-medium opacity-60 mb-1 block">Data</label>
      <textarea id="csvInput" class="textarea textarea-bordered w-full text-sm font-mono" rows="8" placeholder="name,email,role&#10;Naufal,naufal@example.com,Admin&#10;Rakha,rakha@example.com,User">name,email,role&#10;Naufal,naufal@example.com,Admin&#10;Rakha,rakha@example.com,User</textarea>
    </div>
    <div class="md:w-1/3 w-full">
      <div class="mb-3">
        <label class="text-xs font-medium opacity-60 mb-1 block">Delimiter</label>
        <select id="delimiter" class="select select-bordered w-full select-sm">
          <option value="," selected>Comma (,)</option>
          <option value=";">Semicolon (;)</option>
          <option value="|">Pipe (|)</option>
          <option value="	">Tab</option>
        </select>
      </div>
      <label class="flex items-center gap-2 text-xs mb-2">
        <input class="checkbox checkbox-sm" type="checkbox" id="hasHeader" checked>
        Baris pertama header
      </label>
      <button id="btnParse" class="btn btn-primary btn-sm w-full">Parse</button>
      <button id="btnClear" class="btn btn-ghost btn-sm w-full mt-2">Clear</button>
    </div>
  </div>
  <div id="tableContainer" style="display:none;">
    <div class="overflow-x-auto">
      <table id="csvTable" class="table table-sm w-full text-xs"></table>
    </div>
  </div>
</div>

<ToolShell about={aboutText} />

</ToolLayout>

<script is:inline>
var inp=document.getElementById('csvInput'),delim=document.getElementById('delimiter'),hasHdr=document.getElementById('hasHeader'),con=document.getElementById('tableContainer'),tbl=document.getElementById('csvTable');
function parse(){var t=inp.value.trim();if(!t)return;var d=delim.value,r=t.split('\n').map(function(l){return l.split(d)}),h=hasHdr.checked&&r.length>0?r.shift():null,s='<thead>';if(h){s+='<tr>';for(var i=0;i<h.length;i++)s+='<th class="text-xs font-medium text-left px-2 py-1">'+esc(h[i])+'</th>';s+='</tr>'}s+='</thead><tbody>';for(var i=0;i<r.length;i++){s+='<tr>';for(var j=0;j<r[i].length;j++)s+='<td class="px-2 py-1 text-xs">'+esc(r[i][j])+'</td>';s+='</tr>'}s+='</tbody>';tbl.innerHTML=s;con.style.display='block'}
function esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML}
document.getElementById('btnParse').addEventListener('click',parse);document.getElementById('btnClear').addEventListener('click',function(){inp.value='';con.style.display='none'});
</script>