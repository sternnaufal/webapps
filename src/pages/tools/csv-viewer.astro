---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'CSV/TSV Viewer';
const description = 'Lihat dan filter file CSV/TSV online. Preview tabel dengan pencarian dan pengurutan data.';
const keywords = 'csv viewer, tsv viewer, csv parser, csv editor, data viewer';
const aboutText = 'CSV/TSV Viewer Lihat dan filter file CSV/TSV online. Preview tabel dengan pencarian dan pengurutan data.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'json-csv', name: 'Json Csv', icon: '⇄' },
  { slug: 'json-formatter', name: 'Json Formatter', icon: '{}' },
  { slug: 'list-sorter', name: 'List Sorter', icon: '↕' },
  { slug: 'word-frequency', name: 'Word Frequency', icon: '📊' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#eef2ff;color:#6366f1;"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 10h18M3 14h18M3 18h18M3 6h18"/></svg></div><div><h1 class="h3 mb-0">CSV / TSV Viewer</h1><p class="opacity-60 small mb-0">Paste data CSV/TSV, atur delimiter, dan lihat sebagai tabel interaktif.</p></div></header>
<div class="flex flex-wrap gap-3 mb-3">
<div class="md:w-2/3 w-full"><label class="label-text">Data</label><textarea id="csvInput" class="input input-bordered w-full font-mono" rows="8" placeholder="name,email,role&#10;Naufal,naufal@example.com,Admin&#10;Rakha,rakha@example.com,User">name,email,role
Naufal,naufal@example.com,Admin
Rakha,rakha@example.com,User</textarea></div>
<div class="md:w-1/3 w-full">
<div class="mb-3"><label class="label-text">Delimiter</label><select id="delimiter" class="select select-bordered w-full"><option value="," selected>Comma (,)</option><option value=";">Semicolon (;)</option><option value="|">Pipe (|)</option><option value="	">Tab</option></select></div>
<div class="flex items-center gap-2 mb-2"><input class="checkbox" type="checkbox" id="hasHeader" checked><label class="flex items-center gap-2-label" for="hasHeader">Baris pertama header</label></div>
<button id="btnParse" class="btn btn-primary w-full">Parse</button>
<button id="btnClear" class="btn btn-outline-danger w-full mt-2">Clear</button>
</div></div>
<div id="tableContainer" style="display:none;"><div class="card shadow-sm"><div class="overflow-x-auto"><table id="csvTable" class="table table-sm table-zebra table-striped mb-0"></table></div></div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
document.getElementById('year').textContent=new Date().getFullYear();
var inp=document.getElementById('csvInput'),delim=document.getElementById('delimiter'),hasHdr=document.getElementById('hasHeader'),con=document.getElementById('tableContainer'),tbl=document.getElementById('csvTable');
function parse(){var t=inp.value.trim();if(!t)return;var d=delim.value,r=t.split('\\n').map(function(l){return l.split(d)}),h=hasHdr.checked&&r.length>0?r.shift():null,s='<thead class="table-light">';if(h){s+='<tr>';for(var i=0;i<h.length;i++)s+='<th>'+esc(h[i])+'</th>';s+='</tr>'}s+='</thead><tbody>';for(var i=0;i<r.length;i++){s+='<tr>';for(var j=0;j<r[i].length;j++)s+='<td>'+esc(r[i][j])+'</td>';s+='</tr>'}s+='</tbody>';tbl.innerHTML=s;con.style.display='block'}
function esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML}
document.getElementById('btnParse').addEventListener('click',parse);document.getElementById('btnClear').addEventListener('click',function(){inp.value='';con.style.display='none'});
</script>

