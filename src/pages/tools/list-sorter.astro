---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'List Sorter';
const description = 'Sort list online. Urutkan daftar teks secara ascending, descending, random, atau by length.';
const keywords = 'list sorter, sort list, urutkan daftar, sort text, alphabetical sorter';
const aboutText = 'adalah alat untuk mengurutkan daftar teks dengan berbagai mode: ascending (A-Z), descending (Z-A), by length, atau acak. Dilengkapi fitur hapus duplikat dan ignore case.';
const aboutExtra = 'Mengurutkan daftar secara manual rawan error dan memakan waktu, terutama untuk daftar panjang. List Sorter memudahkan Anda mengurutkan item dalam hitungan detik. Berguna untuk mengatur daftar belanja, mengurutkan nama, memproses data teks, menghapus duplikat, mengacak item, dan berbagai keperluan organisasi data lainnya. Cukup paste daftar (satu item per baris), pilih mode sorting, dan dapatkan hasil instan.';
const relatedTools = [
  { slug: 'textcase', name: 'Text Case Converter', icon: 'Aa' },
  { slug: 'reverse-text', name: 'Reverse Text', icon: '↩' },
  { slug: 'text-repeater', name: 'Text Repeater', icon: '×' },
  { slug: 'word-frequency', name: 'Word Frequency Counter', icon: '📊' }
];
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="mb-6">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</div>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #f59e0b;">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Input (satu item per baris)</label>
      <textarea id="textInput" class="textarea textarea-bordered w-full text-sm font-mono" rows="8" placeholder="Masukkan daftar, satu per baris..." autofocus>Pisang
Apel
Jeruk
Mangga
Anggur
Durian
Melon
Nanas</textarea>
      <div class="grid grid-cols-2 gap-2 mt-3 mb-3">
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">Mode</label>
          <select id="modeSelect" class="select select-bordered w-full select-sm">
            <option value="asc">A-Z (Ascending)</option>
            <option value="desc">Z-A (Descending)</option>
            <option value="length">By Length (Pendek)</option>
            <option value="lengthDesc">By Length (Panjang)</option>
            <option value="random">Acak (Random)</option>
          </select>
        </div>
        <div>
          <label class="text-xs font-medium opacity-60 mb-1 block">&nbsp;</label>
          <div>
            <div class="flex items-center gap-2">
              <input type="checkbox" id="uniqueOnly" class="checkbox checkbox-sm">
              <label class="text-xs opacity-60" for="uniqueOnly">Hapus duplikat</label>
            </div>
            <div class="flex items-center gap-2">
              <input type="checkbox" id="ignoreCase" class="checkbox checkbox-sm" checked>
              <label class="text-xs opacity-60" for="ignoreCase">Ignore case</label>
            </div>
          </div>
        </div>
      </div>
      <button id="btnSort" class="btn btn-primary btn-sm w-full">Urutkan</button>
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs font-medium opacity-60">Output</span>
        <span id="stats" class="text-xs opacity-60"></span>
      </div>
      <textarea id="outputArea" class="textarea textarea-bordered w-full text-sm font-mono" rows="8" readonly></textarea>
      <button id="btnCopy" class="btn btn-ghost btn-sm mt-2">Copy</button>
    </div>
  </div>
</div>

<ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var inp=document.getElementById('textInput'),mode=document.getElementById('modeSelect'),out=document.getElementById('outputArea'),stats=document.getElementById('stats'),unique=document.getElementById('uniqueOnly'),ic=document.getElementById('ignoreCase');
function sortList(){
  var lines=inp.value.split('\n'),origCount=lines.length;
  if(ic.checked){lines=lines.filter(function(l,i,a){return a.findIndex(function(x){return x.toLowerCase()===l.toLowerCase()})===i})}
  else if(unique.checked)lines=lines.filter(function(l,i,a){return a.indexOf(l)===i});
  else lines=lines.filter(function(l){return l!==undefined});
  var m=mode.value;
  if(m==='asc')lines.sort(function(a,b){var x=a.toLowerCase(),y=b.toLowerCase();return x<y?-1:x>y?1:0});
  else if(m==='desc')lines.sort(function(a,b){var x=a.toLowerCase(),y=b.toLowerCase();return x<y?1:x>y?-1:0});
  else if(m==='length')lines.sort(function(a,b){return a.length-b.length});
  else if(m==='lengthDesc')lines.sort(function(a,b){return b.length-a.length});
  else if(m==='random')for(var i=lines.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=lines[i];lines[i]=lines[j];lines[j]=t;}
  out.value=lines.join('\n');
  stats.textContent=origCount+' item → '+lines.length+' item';
}
document.getElementById('btnSort').addEventListener('click',sortList);
document.getElementById('btnCopy').addEventListener('click',function(){
  if(!out.value)return;var b=this;
  navigator.clipboard.writeText(out.value).then(function(){b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)});
});
[inp,mode,unique,ic].forEach(function(el){el.addEventListener('input',sortList);el.addEventListener('change',sortList)});
sortList();
</script>