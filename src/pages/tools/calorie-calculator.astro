---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Calorie Calculator (BMR/TDEE)';
const description = 'Kalkulator kalori online. Hitung BMR dan TDEE untuk kebutuhan kalori harian Anda.';
const keywords = 'calorie calculator, bmr calculator, tdee calculator, kalkulator kalori, bmr, tdee';
const aboutText = 'Kalkulator kalori online untuk menghitung BMR (Basal Metabolic Rate) dan TDEE (Total Daily Energy Expenditure). Alat ini membantu Anda menentukan kebutuhan kalori harian berdasarkan usia, jenis kelamin, tinggi, berat badan, dan level aktivitas fisik. Hasil perhitungan mencakup BMR, TDEE, serta rekomendasi kalori untuk menurunkan atau menaikkan berat badan.';
const aboutExtra = 'BMR adalah jumlah kalori minimum yang dibutuhkan tubuh saat istirahat total untuk menjaga fungsi vital seperti pernapasan, sirkulasi darah, dan suhu tubuh. TDEE adalah total kalori yang dibakar per hari termasuk aktivitas fisik. Dengan mengetahui TDEE, Anda dapat mengatur asupan kalori untuk mencapai tujuan berat badan ideal.';
const relatedTools = [
  { slug: 'bmi-calculator', name: 'BMI Calculator', icon: '⚖' },
  { slug: 'savings-calculator', name: 'Savings Calculator', icon: '🏦' },
  { slug: 'tip-calculator', name: 'Tip Calculator', icon: '💰' },
  { slug: 'percentage-calculator', name: 'Percentage Calculator', icon: '%' },
];
---

<ToolLayout title={title} description={description} keywords={keywords}>
  <div class="mb-6">
    <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
    <p class="text-sm opacity-50 mt-0.5">{description}</p>
  </div>

  <div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);">
    <div class="flex flex-wrap gap-4">
      <div class="lg:w-5/12 w-full">
        <div class="mb-3">
          <label class="text-xs font-medium opacity-60 mb-1 block">Jenis Kelamin</label>
          <div class="flex gap-3">
            <label class="flex items-center gap-2 text-sm">
              <input type="radio" name="gender" id="genMale" class="checkbox" checked>
              Laki-laki
            </label>
            <label class="flex items-center gap-2 text-sm">
              <input type="radio" name="gender" id="genFemale" class="checkbox">
              Perempuan
            </label>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-2 mb-3">
          <div>
            <label class="text-xs opacity-60 mb-0.5 block">Usia (thn)</label>
            <input type="number" id="ageInput" class="input input-bordered w-full input-sm" value="25" min="1" max="120">
          </div>
          <div>
            <label class="text-xs opacity-60 mb-0.5 block">Tinggi (cm)</label>
            <input type="number" id="heightInput" class="input input-bordered w-full input-sm" value="170" min="50" max="300">
          </div>
          <div>
            <label class="text-xs opacity-60 mb-0.5 block">Berat (kg)</label>
            <input type="number" id="weightInput" class="input input-bordered w-full input-sm" value="65" min="10" max="500">
          </div>
        </div>

        <div class="mb-3">
          <label class="text-xs opacity-60 mb-0.5 block">Level Aktivitas</label>
          <select id="activitySelect" class="select select-bordered w-full select-sm">
            <option value="1.2">Sedentary (jarang olahraga)</option>
            <option value="1.375" selected>Light (1-3 hari/minggu)</option>
            <option value="1.55">Moderate (3-5 hari/minggu)</option>
            <option value="1.725">Active (6-7 hari/minggu)</option>
            <option value="1.9">Very Active (atlet/fisik berat)</option>
          </select>
        </div>

        <button id="btnCalc" class="btn btn-primary w-full btn-sm">Hitung Kebutuhan Kalori</button>
      </div>

      <div class="lg:w-7/12 w-full">
        <div class="mb-3">
          <div class="text-xs font-semibold opacity-50 mb-2">Hasil Perhitungan</div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-3 rounded-lg text-center" style="background:oklch(0.55 0.25 270 / 0.1);">
              <div class="text-xs opacity-50">BMR</div>
              <div class="text-xl font-bold" id="bmrResult" style="color:#6366f1">0</div>
              <div class="text-xs opacity-40">kkal/hari</div>
            </div>
            <div class="p-3 rounded-lg text-center" style="background:oklch(0.6 0.18 150 / 0.1);">
              <div class="text-xs opacity-50">TDEE</div>
              <div class="text-xl font-bold" id="tdeeResult" style="color:#16a34a">0</div>
              <div class="text-xs opacity-40">kkal/hari</div>
            </div>
          </div>
        </div>

        <div>
          <div class="text-xs font-semibold opacity-50 mb-2">Rekomendasi Kalori Harian</div>
          <div id="recommendations" class="text-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <ToolShell about={aboutText} aboutExtra={aboutExtra} relatedTools={relatedTools} />
</ToolLayout>

<script is:inline>
var age=document.getElementById('ageInput'),height=document.getElementById('heightInput'),weight=document.getElementById('weightInput'),activity=document.getElementById('activitySelect'),bmrEl=document.getElementById('bmrResult'),tdeeEl=document.getElementById('tdeeResult'),recEl=document.getElementById('recommendations');
function calc() {
  var a=parseInt(age.value)||0,h=parseFloat(height.value)||0,w=parseFloat(weight.value)||0,act=parseFloat(activity.value);
  var isMale=document.getElementById('genMale').checked;
  if(!a||!h||!w) { bmrEl.textContent='0';tdeeEl.textContent='0';recEl.innerHTML='';return; }
  var bmr=isMale ? 10*w+6.25*h-5*a+5 : 10*w+6.25*h-5*a-161;
  var tdee=bmr*act;
  bmrEl.textContent=Math.round(bmr); tdeeEl.textContent=Math.round(tdee);
  var loss05=Math.round(tdee-500),loss1=Math.round(tdee-1000),gain05=Math.round(tdee+500),gain1=Math.round(tdee+1000);
  recEl.innerHTML='<table class="table table-sm w-full text-xs">'+
    '<tr><td class="py-1 opacity-60">Maintenance (jaga berat)</td><td class="py-1 font-bold text-right">'+Math.round(tdee)+' kkal/hari</td></tr>'+
    '<tr><td class="py-1 opacity-60">Turun berat (0.5 kg/minggu)</td><td class="py-1 font-bold text-right text-success">'+loss05+' kkal/hari</td></tr>'+
    '<tr><td class="py-1 opacity-60">Turun berat (1 kg/minggu)</td><td class="py-1 font-bold text-right text-success">'+Math.max(loss1,1200)+' kkal/hari</td></tr>'+
    '<tr><td class="py-1 opacity-60">Naik berat (0.5 kg/minggu)</td><td class="py-1 font-bold text-right text-error">'+gain05+' kkal/hari</td></tr>'+
    '<tr><td class="py-1 opacity-60">Naik berat (1 kg/minggu)</td><td class="py-1 font-bold text-right text-error">'+gain1+' kkal/hari</td></tr></table>';
}
document.getElementById('btnCalc').addEventListener('click',calc);
[age,height,weight,activity].forEach(function(el) { el.addEventListener('input',calc); el.addEventListener('change',calc); });
document.querySelectorAll('input[name=gender]').forEach(function(el) { el.addEventListener('change',calc); });
calc();
</script>
