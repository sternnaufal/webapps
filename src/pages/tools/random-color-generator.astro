---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Random Color Generator';
const description = 'Random color generator online. Hasilkan warna acak dalam format HEX, RGB, HSL. Copy warna dengan satu klik. Generator palet warna untuk desainer.';
const keywords = 'random color generator, warna acak, color palette, hex color, rgb color, hsl color, pembangkit warna';
const aboutText = 'Random color generator online. Hasilkan warna acak dalam format HEX, RGB, HSL. Copy warna dengan satu klik. Generator palet warna untuk desainer.';
const relatedTools = [
  { slug: 'color-picker', name: 'Color Picker', icon: '🎨' },
  { slug: 'color-converter', name: 'Color Converter', icon: '🌈' },
  { slug: 'gradient-generator', name: 'Gradient Generator', icon: '◐' },
  { slug: 'contrast-checker', name: 'Contrast Checker', icon: '◐' }
];

const toolCss = `.color-swatch{height:120px;border-radius:12px;display:flex;align-items:center;justify-content:center;transition:background .3s;position:relative}.swatch-label{background:rgba(0,0,0,.5);color:oklch(1 0 0);padding:4px 12px;border-radius:6px;font-family:monospace;font-size:.85rem;cursor:pointer}.swatch-label:hover{background:rgba(0,0,0,.8)}.lock-btn{position:absolute;top:6px;right:8px;background:rgba(0,0,0,.3);border:none;color:oklch(1 0 0);border-radius:50%;width:28px;height:28px;font-size:.85rem;cursor:pointer;display:flex;align-items:center;justify-content:center}.lock-btn:hover{background:rgba(0,0,0,.6)}`;
---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="flex items-center gap-3 mb-4"><div class="tool-icon" style="background:#ec489920;color:#ec4899;">&#127912;</div><div><h1 class="h3 mb-0">Random Color Generator</h1><p class="opacity-60 small mb-0">Hasilkan warna acak dalam format HEX, RGB, HSL. Lock warna favorit.</p></div></header><div class="flex flex-wrap gap-3"><div class="w-full"><div class="flex gap-2 flex-wrap justify-between items-center mb-2"><div class="flex gap-2"><button id="btnGenerate" class="btn btn-primary">Generate</button><button id="btnCopyAll" class="btn btn-outline">Copy All</button></div><div><select id="paletteSize" class="select select-bordered w-full select select-bordered w-full-sm"><option value="1">1 warna</option><option value="2">2 warna</option><option value="3" selected>3 warna</option><option value="4">4 warna</option><option value="5">5 warna</option></select></div></div></div><div id="paletteContainer" class="w-full"><div class="row gap-2"></div></div><div class="w-full"><div class="card card-bordered bg-base-100 p-3"><h6 class="mb-3">Detail Warna Terpilih</h6><div id="colorDetails" class="small"><select id="colorSelector" class="select select-bordered w-full select select-bordered w-full-sm mb-2"><option value="0">Warna 1</option><option value="1">Warna 2</option><option value="2">Warna 3</option></select><div class="flex gap-3 items-center"><div id="detailSwatch" style="width:60px;height:60px;border-radius:8px;border:2px solid var(--border)"></div><div><div>HEX: <span class="font-bold font-monospace" id="detailHex">#000000</span> <button class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="copyText(document.getElementById('detailHex').textContent)">Copy</button></div><div>RGB: <span class="font-bold font-monospace" id="detailRgb">rgb(0,0,0)</span> <button class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="copyText(document.getElementById('detailRgb').textContent)">Copy</button></div><div>HSL: <span class="font-bold font-monospace" id="detailHsl">hsl(0,0%,0%)</span> <button class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="copyText(document.getElementById('detailHsl').textContent)">Copy</button></div></div></div></div></div></div></div>

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
{toolCss}
</style>


<script is:inline>
var pC=document.getElementById('paletteContainer'),pS=document.getElementById('paletteSize'),cS=document.getElementById('colorSelector'),dS=document.getElementById('detailSwatch'),dH=document.getElementById('detailHex'),dR=document.getElementById('detailRgb'),dL=document.getElementById('detailHsl');var colors=[],locked={};function randHex(){return'#'+Math.floor(Math.random()*16777215).toString(16).padStart(6,'0')}function hexToRgb(h){var r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);return{r:r,g:g,b:b}}function rgbToHsl(r,g,b){r/=255;g/=255;b/=255;var mx=Math.max(r,g,b),mn=Math.min(r,g,b),h=0,s=0,l=(mx+mn)/2;if(mx!==mn){var d=mx-mn;s=l>0.5?d/(2-mx-mn):d/(mx+mn);switch(mx){case r:h=(g-b)/d+(g<b?6:0);break;case g:h=(b-r)/d+2;break;case b:h=(r-g)/d+4;break}h/=6}return{h:Math.round(h*360),s:Math.round(s*100),l:Math.round(l*100)}}function generate(){
  var n=parseInt(pS.value);colors=[];
  for(var i=0;i<n;i++){var hex=locked[i]?colors[i]||randHex():randHex();colors.push(hex)}
  render()}function render(){
  var r=document.createElement('div');r.className='row gap-2';
  for(var i=0;i<colors.length;i++){
    var hex=colors[i],rgb=hexToRgb(hex),hsl=rgbToHsl(rgb.r,rgb.g,rgb.b);
    var col=document.createElement('div');col.className='col-md-'+(12/colors.length>3?4:Math.floor(12/colors.length));
    col.innerHTML='<div class="color-swatch" style="background:'+hex+'"><button class="lock-btn" data-idx="'+i+'">'+(locked[i]?'&#128274;':'&#128275;')+'</button><span class="swatch-label" onclick="copyText(\\''+hex+'\\')">'+hex+'</span></div><div class="small mt-1 text-center opacity-60">RGB: '+rgb.r+','+rgb.g+','+rgb.b+' | HSL: '+hsl.h+','+hsl.s+'%,'+hsl.l+'%</div>';
    r.appendChild(col)}
  pC.querySelector('.row').replaceWith(r);
  pC.querySelectorAll('.lock-btn').forEach(function(b){b.addEventListener('click',function(){var i=parseInt(this.dataset.idx);locked[i]=!locked[i];render()})});
  // update selector
  cS.innerHTML='';for(var i=0;i<colors.length;i++){var o=document.createElement('option');o.value=i;o.textContent='Warna '+(i+1);cS.appendChild(o)}
  updateDetail(0)}function updateDetail(i){
  if(i>=colors.length)return;var hex=colors[i]||'#000000',rgb=hexToRgb(hex),hsl=rgbToHsl(rgb.r,rgb.g,rgb.b);
  dS.style.background=hex;dH.textContent=hex;dR.textContent='rgb('+rgb.r+','+rgb.g+','+rgb.b+')';dL.textContent='hsl('+hsl.h+','+hsl.s+'%,'+hsl.l+'%)'}function copyText(t){navigator.clipboard.writeText(t).catch(function(){})}
document.getElementById('btnGenerate').addEventListener('click',generate);
document.getElementById('btnCopyAll').addEventListener('click',function(){var t=colors.join('\\n');navigator.clipboard.writeText(t).catch(function(){})});
cS.addEventListener('change',function(){updateDetail(parseInt(this.value))});
generate();
</script>

