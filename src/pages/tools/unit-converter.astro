---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Unit Converter';
const description = 'Konversi satuan panjang, berat, suhu, volume online gratis. Unit converter lengkap.';
const keywords = 'unit converter, konversi satuan, length converter, weight converter, temperature converter';
const aboutText = 'Unit Converter Konversi satuan panjang, berat, suhu, volume online gratis. Unit converter lengkap.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'konverter-bilangan', name: 'Konverter Bilangan', icon: '2' },
  { slug: 'time-converter', name: 'Time Converter', icon: '🌍' },
  { slug: 'date-calculator', name: 'Date Calculator', icon: '📅' },
  { slug: 'css-unit', name: 'Css Unit', icon: 'px' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<header class="mb-5">
  <h1 class="text-xl font-bold tracking-tight" style="letter-spacing:-0.03em;">{title}</h1>
  <p class="text-sm opacity-50 mt-0.5">{description}</p>
</header>

<div class="rounded-xl p-5" style="background:oklch(0.97 0.003 270);border:1px solid oklch(0.9 0.005 270);border-top:3px solid #8b5cf6;">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Kategori</label>
      <select id="category" class="select select-bordered w-full select-sm">
        <option value="length">Length</option>
        <option value="weight">Weight</option>
        <option value="temperature">Temperature</option>
        <option value="volume">Volume</option>
        <option value="area">Area</option>
        <option value="speed">Speed</option>
        <option value="data">Data</option>
      </select>
    </div>
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Nilai</label>
      <input type="number" id="fromVal" class="input input-bordered w-full input-sm" value="1" step="any">
    </div>
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Dari</label>
      <select id="fromUnit" class="select select-bordered w-full select-sm"></select>
    </div>
    <div>
      <label class="text-xs font-medium opacity-60 mb-1 block">Ke</label>
      <select id="toUnit" class="select select-bordered w-full select-sm"></select>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
    <div class="md:col-span-2">
      <div class="rounded-lg p-3" style="background:oklch(0.95 0.005 270);border:1px solid oklch(0.9 0.005 270);">
        <div class="text-lg font-semibold" id="resultDisplay">1 = 1</div>
      </div>
    </div>
    <div>
      <button id="btnSwap" class="btn btn-ghost btn-sm w-full">Swap Units</button>
    </div>
  </div>
</div>

<ToolShell about={aboutText} relatedTools={relatedTools} />

</ToolLayout>

<script is:inline>
var UNITS = {
  length: {
    base: 'm',
    units: { mm: 0.001, cm: 0.01, m: 1, km: 1000, in: 0.0254, ft: 0.3048, yd: 0.9144, mi: 1609.344 }
  },
  weight: {
    base: 'kg',
    units: { mg: 0.000001, g: 0.001, kg: 1, ton: 1000, oz: 0.0283495, lb: 0.453592 }
  },
  volume: {
    base: 'L',
    units: { mL: 0.001, L: 1, 'm\u00B3': 1000, gal: 3.78541, qt: 0.946353, pt: 0.473176, cup: 0.236588, floz: 0.0295735 }
  },
  area: {
    base: 'm\u00B2',
    units: { 'mm\u00B2': 0.000001, 'cm\u00B2': 0.0001, 'm\u00B2': 1, ha: 10000, 'km\u00B2': 1000000, 'in\u00B2': 0.00064516, 'ft\u00B2': 0.092903, ac: 4046.86 }
  },
  speed: {
    base: 'm/s',
    units: { 'm/s': 1, 'km/h': 0.277778, 'mph': 0.44704, knot: 0.514444, 'ft/s': 0.3048 }
  },
  data: {
    base: 'B',
    units: { B: 1, KB: 1000, MB: 1000000, GB: 1000000000, TB: 1000000000000, KiB: 1024, MiB: 1048576, GiB: 1073741824 }
  }
};

// Temperature special case
UNITS.temperature = {
  base: 'C',
  units: { C: 'c', F: 'f', K: 'k' },
  convert: function(val, from, to) {
    var c;
    if (from === 'C') c = val;
    else if (from === 'F') c = (val - 32) * 5/9;
    else c = val - 273.15;

    if (to === 'C') return c;
    if (to === 'F') return c * 9/5 + 32;
    return c + 273.15;
  }
};

var category = document.getElementById('category');
var fromUnit = document.getElementById('fromUnit');
var toUnit = document.getElementById('toUnit');
var fromVal = document.getElementById('fromVal');
var resultDisplay = document.getElementById('resultDisplay');

function populateUnits(cat) {
  fromUnit.innerHTML = '';
  toUnit.innerHTML = '';
  var units = UNITS[cat];
  var keys;
  if (cat === 'temperature') {
    keys = ['C', 'F', 'K'];
  } else {
    keys = Object.keys(units.units);
  }
  keys.forEach(function(k, i) {
    var opt1 = document.createElement('option');
    opt1.value = k;
    opt1.textContent = k;
    fromUnit.appendChild(opt1);
    var opt2 = document.createElement('option');
    opt2.value = k;
    opt2.textContent = k;
    toUnit.appendChild(opt2);
  });
  if (keys.length > 1) toUnit.value = keys[1];
  convert();
}

function convert() {
  var cat = category.value;
  var val = parseFloat(fromVal.value) || 0;
  var from = fromUnit.value;
  var to = toUnit.value;

  var result;
  if (cat === 'temperature') {
    result = UNITS.temperature.convert(val, from, to);
  } else {
    var u = UNITS[cat].units;
    var baseVal = val * u[from];
    result = baseVal / u[to];
  }

  resultDisplay.textContent = val + ' ' + from + ' = ' + result.toPrecision(10).replace(/\.?0+$/, '') + ' ' + to;
}

category.addEventListener('change', function() { populateUnits(this.value); });
fromUnit.addEventListener('change', convert);
toUnit.addEventListener('change', convert);
fromVal.addEventListener('input', convert);

document.getElementById('btnSwap').addEventListener('click', function() {
  var tmp = fromUnit.value;
  fromUnit.value = toUnit.value;
  toUnit.value = tmp;
  convert();
});

populateUnits('length');
</script>