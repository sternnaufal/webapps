---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ToolShell from "../../components/ToolShell.astro";

const title = 'Unit Converter';
const description = 'Konversi satuan panjang, berat, suhu, volume online gratis. Unit converter lengkap.';
const keywords = 'unit converter, konversi satuan, length converter, weight converter, temperature converter';
const aboutText = 'Unit Converter Konversi satuan panjang, berat, suhu, volume online gratis. Unit converter lengkap.. Alat ini berjalan 100% di browser, data tidak dikirim ke server.';
const relatedTools = [
  { slug: 'konverter-bilangan', name: 'Konverter Bilangan', icon: '2' },
  { slug: 'time-converter', name: 'Time Converter', icon: '🌍' },
  { slug: 'date-calculator', name: 'Date Calculator', icon: '📅' },
  { slug: 'css-unit', name: 'Css Unit', icon: 'px' }
];

---

<ToolLayout
  title={title}
  description={description}
  keywords={keywords}
>

<div class="card card-bordered bg-base-100 p-4 shadow-sm">
        <div class="flex flex-wrap gap-3 mb-3">
          <div class="md:w-1/3 w-full">
            <label class="label-text">Kategori</label>
            <select id="category" class="select select-bordered w-full">
              <option value="length">Length</option>
              <option value="weight">Weight</option>
              <option value="temperature">Temperature</option>
              <option value="volume">Volume</option>
              <option value="area">Area</option>
              <option value="speed">Speed</option>
              <option value="data">Data</option>
            </select>
          </div>
          <div class="md:w-1/3 w-full">
            <label for="fromVal" class="label-text">Nilai</label>
            <input type="number" id="fromVal" class="input input-bordered w-full" value="1" step="any">
          </div>
          <div class="col-md-2">
            <label for="fromUnit" class="label-text">Dari</label>
            <select id="fromUnit" class="select select-bordered w-full"></select>
          </div>
          <div class="col-md-2">
            <label for="toUnit" class="label-text">Ke</label>
            <select id="toUnit" class="select select-bordered w-full"></select>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 align-items-end">
          <div class="md:w-2/3 w-full">
            <div class="p-3 bg-light rounded border">
              <div class="h4 mb-0" id="resultDisplay">1 = 1</div>
            </div>
          </div>
          <div class="md:w-1/3 w-full d-grid">
            <button id="btnSwap" class="btn btn-outline">Swap Units</button>
          </div>
        </div>
      </div>
    `n

<ToolShell about={aboutText} />

</ToolLayout>

<style is:inline>
.saweria-float { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: #ff6b6b; color: #fff; border-radius: 50px; padding: 10px 20px 10px 16px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(255,107,107,0.4); transition: all 0.3s ease; font-family: "Inter",sans-serif; }
.saweria-float:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); color: #fff; }
.saweria-float svg { animation: pulse 1.5s ease infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@media (max-width: 576px) { .saweria-float { bottom: 16px; right: 16px; padding: 8px 14px 8px 10px; font-size: 12px; } }
</style>

<script is:inline>
</script>

<script is:inline>
var UNITS = &#123;
  length: &#123;
    base: 'm',
    units: &#123; mm: 0.001, cm: 0.01, m: 1, km: 1000, in: 0.0254, ft: 0.3048, yd: 0.9144, mi: 1609.344 &#125;
  &#125;,
  weight: &#123;
    base: 'kg',
    units: &#123; mg: 0.000001, g: 0.001, kg: 1, ton: 1000, oz: 0.0283495, lb: 0.453592 &#125;
  &#125;,
  volume: &#123;
    base: 'L',
    units: &#123; mL: 0.001, L: 1, 'm\\u00B3': 1000, gal: 3.78541, qt: 0.946353, pt: 0.473176, cup: 0.236588, floz: 0.0295735 &#125;
  &#125;,
  area: &#123;
    base: 'm\\u00B2',
    units: &#123; 'mm\\u00B2': 0.000001, 'cm\\u00B2': 0.0001, 'm\\u00B2': 1, ha: 10000, 'km\\u00B2': 1000000, 'in\\u00B2': 0.00064516, 'ft\\u00B2': 0.092903, ac: 4046.86 &#125;
  &#125;,
  speed: &#123;
    base: 'm/s',
    units: &#123; 'm/s': 1, 'km/h': 0.277778, 'mph': 0.44704, knot: 0.514444, 'ft/s': 0.3048 &#125;
  &#125;,
  data: &#123;
    base: 'B',
    units: &#123; B: 1, KB: 1000, MB: 1000000, GB: 1000000000, TB: 1000000000000, KiB: 1024, MiB: 1048576, GiB: 1073741824 &#125;
  &#125;
&#125;;

// Temperature special case
UNITS.temperature = &#123;
  base: 'C',
  units: &#123; C: 'c', F: 'f', K: 'k' &#125;,
  convert: function(val, from, to) &#123;
    var c;
    if (from === 'C') c = val;
    else if (from === 'F') c = (val - 32) * 5/9;
    else c = val - 273.15;

    if (to === 'C') return c;
    if (to === 'F') return c * 9/5 + 32;
    return c + 273.15;
  &#125;
&#125;;

var category = document.getElementById('category');
var fromUnit = document.getElementById('fromUnit');
var toUnit = document.getElementById('toUnit');
var fromVal = document.getElementById('fromVal');
var resultDisplay = document.getElementById('resultDisplay');

function populateUnits(cat) &#123;
  fromUnit.innerHTML = '';
  toUnit.innerHTML = '';
  var units = UNITS[cat];
  var keys;
  if (cat === 'temperature') &#123;
    keys = ['C', 'F', 'K'];
  &#125; else &#123;
    keys = Object.keys(units.units);
  &#125;
  keys.forEach(function(k, i) &#123;
    var opt1 = document.createElement('option');
    opt1.value = k;
    opt1.textContent = k;
    fromUnit.appendChild(opt1);
    var opt2 = document.createElement('option');
    opt2.value = k;
    opt2.textContent = k;
    toUnit.appendChild(opt2);
  &#125;);
  if (keys.length > 1) toUnit.value = keys[1];
  convert();
&#125;

function convert() &#123;
  var cat = category.value;
  var val = parseFloat(fromVal.value) || 0;
  var from = fromUnit.value;
  var to = toUnit.value;

  var result;
  if (cat === 'temperature') &#123;
    result = UNITS.temperature.convert(val, from, to);
  &#125; else &#123;
    var u = UNITS[cat].units;
    var baseVal = val * u[from];
    result = baseVal / u[to];
  &#125;

  resultDisplay.textContent = val + ' ' + from + ' = ' + result.toPrecision(10).replace(/\.?0+$/, '') + ' ' + to;
&#125;

category.addEventListener('change', function() &#123; populateUnits(this.value); &#125;);
fromUnit.addEventListener('change', convert);
toUnit.addEventListener('change', convert);
fromVal.addEventListener('input', convert);

document.getElementById('btnSwap').addEventListener('click', function() &#123;
  var tmp = fromUnit.value;
  fromUnit.value = toUnit.value;
  toUnit.value = tmp;
  convert();
&#125;);

populateUnits('length');
</script>

