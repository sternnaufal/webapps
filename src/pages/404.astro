---
import ToolLayout from '../layouts/ToolLayout.astro';
---

<ToolLayout title="404 - Halaman Tidak Ditemukan" description="Maaf, halaman tidak ditemukan." noindex={true}>
  <div class="text-center py-5">
    <div class="text-6xl text-text-muted font-bold">404</div>
    <h4 class="mb-3 mt-2">Halaman Tidak Ditemukan</h4>
    <p class="text-text-muted mb-4">Maaf, halaman yang Anda cari tidak tersedia atau telah dipindahkan.</p>
    <a href="/" class="btn btn-warning">Kembali ke Beranda</a>
  </div>
</ToolLayout>