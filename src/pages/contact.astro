---
import ToolLayout from '../layouts/ToolLayout.astro';

const title = 'Kontak - WebApps';
const description = 'Hubungi Naufal Rakha Putra via email, WhatsApp, GitHub, atau LinkedIn. Respons cepat untuk pertanyaan, saran, dan kolaborasi.';
const keywords = 'kontak webapps, hubungi developer, naufal rakha putra, email, whatsapp, github, linkedin';
