---
interface Tool { slug: string; name: string; desc: string; }
const { tool } = Astro.props as { tool: Tool };

const colors: Record<string, string> = {
  'hash-generator': '#ef4444', 'uuid-generator': '#8b5cf6', 'base64-coded': '#06b6d4',
  'json-formatter': '#f59e0b', 'regex-tester': '#10b981', 'diff-checker': '#6366f1',
  'sql-formatter': '#3b82f6', 'yaml-json': '#f97316', 'meta-tag-generator': '#ec4899',
  'ascii-table': '#14b8a6', 'subnetting': '#0ea5e9', 'ip-calculator': '#64748b',
  'url-encode': '#8b5cf6', 'cron-builder': '#a855f7', 'mac-address-generator': '#6366f1',
  'textcase': '#f43f5e', 'lorem-ipsum': '#64748b', 'md-preview': '#059669',
  'color-picker': '#e11d48', 'image-to-base64': '#0ea5e9', 'password-generator': '#10b981',
  'qr-generator': '#6366f1', 'rsa-generator': '#f43f5e', 'gradient-generator': '#8b5cf6',
  'random-number-generator': '#f59e0b', 'jwt-decoder': '#ec4899', 'html-preview': '#059669',
  'http-status': '#3b82f6', 'timer': '#ef4444', 'stopwatch': '#f97316',
  'typing-speed-test': '#6366f1', 'notes-app': '#f59e0b', 'bmi-calculator': '#059669',
  'default': '#6366f1'
};
const bgColor = colors[tool.slug] || colors.default;
const ico = tool.slug.includes('password') ? '🔑' : tool.slug.includes('qr') ? '▐▌' : tool.slug.includes('json') ? '{}' : tool.slug.includes('color') ? '🎨' : '⚡';
---

<a href={`/tools/${tool.slug}`} class="tool-card" data-slug={tool.slug}>
  <div class="tool-card-icon" style={`background:${bgColor}15;color:${bgColor}`}>{ico}</div>
  <div class="min-w-0 flex-1">
    <div class="tool-card-name">{tool.name}</div>
    <div class="tool-card-desc">{tool.desc}</div>
  </div>
</a>
