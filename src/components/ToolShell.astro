---
interface RelatedTool { slug: string; name: string; icon?: string; }
interface Props {
  about?: string;
  aboutExtra?: string;
  relatedTools?: RelatedTool[];
}
const { about, aboutExtra, relatedTools } = Astro.props;
const currentUrl = Astro.url.href;
---

{
  about && (
    <div class="mt-8 pt-6 border-t" style="border-color:oklch(0.9 0.005 270);">
      <h3 class="text-xs font-semibold opacity-40 mb-3 uppercase tracking-wider">Tentang Tool Ini</h3>
      <div class="text-sm leading-relaxed opacity-70 space-y-3 max-w-prose">
        <p>{about}</p>
        {aboutExtra && <p>{aboutExtra}</p>}
      </div>
    </div>
  )
}

<!-- FAQ (visible + schema) -->
<div class="mt-6 pt-4 border-t" style="border-color:oklch(0.9 0.005 270);" itemscope itemtype="https://schema.org/FAQPage">
  <h3 class="text-xs font-semibold opacity-40 mb-3 uppercase tracking-wider">Pertanyaan Umum</h3>
  <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
    <h4 class="text-sm font-medium" itemprop="name">Apakah alat ini gratis?</h4>
    <div class="text-sm opacity-70 mt-1" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
      <div itemprop="text">Ya, 100% gratis. Tidak ada biaya tersembunyi, tidak perlu daftar akun, dan tidak ada batasan penggunaan.</div>
    </div>
  </div>
  <div class="mt-3" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
    <h4 class="text-sm font-medium" itemprop="name">Apakah data saya aman?</h4>
    <div class="text-sm opacity-70 mt-1" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
      <div itemprop="text">Semua pemrosesan dilakukan 100% di browser Anda. Data tidak pernah dikirim, disimpan, atau dibagikan ke server mana pun.</div>
    </div>
  </div>
  <div class="mt-3" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
    <h4 class="text-sm font-medium" itemprop="name">Apakah perlu install aplikasi?</h4>
    <div class="text-sm opacity-70 mt-1" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
      <div itemprop="text">Tidak perlu. Cukup buka WebApps di browser Chrome, Firefox, Safari, atau Edge. Berfungsi di komputer dan HP tanpa installasi.</div>
    </div>
  </div>
</div>

<!-- Share -->
<div class="mt-6 pt-4 flex items-center gap-3 border-t" style="border-color:oklch(0.9 0.005 270);">
  <span class="text-xs opacity-30">Share:</span>
  <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" class="btn btn-ghost btn-xs btn-square opacity-40 hover:opacity-100 transition-opacity" aria-label="Twitter/X">𝕏</a>
  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" class="btn btn-ghost btn-xs btn-square opacity-40 hover:opacity-100 transition-opacity" aria-label="LinkedIn">in</a>
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" class="btn btn-ghost btn-xs btn-square opacity-40 hover:opacity-100 transition-opacity" aria-label="Facebook">f</a>
  <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" class="btn btn-ghost btn-xs btn-square opacity-40 hover:opacity-100 transition-opacity" aria-label="WhatsApp">wa</a>
</div>

<!-- Related -->
{
  relatedTools && relatedTools.length > 0 && (
    <div class="mt-4">
      <span class="text-xs opacity-30 mr-2">Alat Terkait:</span>
      <div class="flex gap-2 flex-wrap mt-1">
        {relatedTools.map(t => (
          <a href={`/tools/${t.slug}`} class="btn btn-ghost btn-xs rounded-full gap-1 opacity-50 hover:opacity-100 transition-opacity">
            {t.icon || '⚡'} {t.name}
          </a>
        ))}
      </div>
    </div>
  )
}
