---
interface RelatedTool { slug: string; name: string; }
interface Props {
  /** Deskripsi panjang tentang tool (SEO) — 2-3 paragraf */
  about?: string;
  /** Paragraf tambahan (opsional) */
  aboutExtra?: string;
  /** Daftar tool terkait */
  relatedTools?: RelatedTool[];
}
const { about, aboutExtra, relatedTools } = Astro.props;
const currentUrl = Astro.url.href;
---

<!-- About / SEO description -->
{
  about && (
    <div class="mt-6 p-4 rounded-xl bg-base-200/50 border border-base-300">
      <h6 class="font-bold text-sm mb-2">Tentang Tool Ini</h6>
      <div class="text-xs leading-relaxed opacity-80 space-y-2">
        <p>{about}</p>
        {aboutExtra && <p>{aboutExtra}</p>}
      </div>
    </div>
  )
}

<!-- Share buttons -->
<div class="mt-4 pt-3 flex flex-wrap gap-2 justify-center items-center border-t border-base-300">
  <span class="text-xs opacity-50 mr-1">Bagikan:</span>
  <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" class="btn btn-outline btn-xs rounded-full" aria-label="Twitter/X">𝕏</a>
  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" class="btn btn-outline btn-xs rounded-full" aria-label="LinkedIn">in</a>
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" class="btn btn-outline btn-xs rounded-full" aria-label="Facebook">f</a>
  <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener" class="btn btn-outline btn-xs rounded-full" aria-label="WhatsApp">wa</a>
</div>

<!-- Related tools -->
{
  relatedTools && relatedTools.length > 0 && (
    <div class="mt-3">
      <div class="text-xs font-semibold mb-2 opacity-50">Alat Terkait</div>
      <div class="flex gap-2 flex-wrap">
        {relatedTools.map(t => (
          <a href={`/tools/${t.slug}`} class="btn btn-outline btn-xs rounded-full">{t.icon || '⚡'} {t.name}</a>
        ))}
      </div>
    </div>
  )
}
