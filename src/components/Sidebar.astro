---
import tools from '../data/tools.json';
const current = Astro.url.pathname.replace('/tools/', '').replace(/\/$/, '') || 'index';
---

<aside class="sidebar w-[260px] shrink-0 overflow-hidden sticky top-0 max-h-screen flex flex-col text-white">
  <!-- Header -->
  <div class="flex items-center gap-2 px-3 py-3 border-b border-white/8">
    <span class="text-xl">🚀</span>
    <div>
      <a href="/" class="text-white no-underline font-bold text-sm">WebApps</a>
      <div class="text-[.65rem] text-white/40">{tools.categories.flatMap(c => c.tools).length} tools</div>
    </div>
  </div>

  <!-- Search -->
  <div class="px-3 py-2">
    <input type="text" class="sidebar-search w-full text-xs bg-white/7 border border-white/10 text-white rounded-md px-2 py-1.5 focus:border-accent focus:outline-none" placeholder="Cari tool..." />
  </div>

  <!-- Categories -->
  <nav class="flex-1 overflow-y-auto overflow-x-hidden px-1.5 scrollbar-thin">
    {tools.categories.map((cat, i) => (
      <div class="mb-0.5">
        <a class="sidebar-cat-header flex items-center gap-2" data-bs-toggle="collapse" href={`#sc${i}`} role="button" aria-expanded={i === 0 ? 'true' : 'false'}>
          <span class="text-sm">{cat.icon}</span>
          <span class="flex-1 truncate">{cat.name}</span>
          <span class="text-[.55rem] transition-transform duration-200 cat-chevron">{'>'}</span>
        </a>
        <div class={`collapse${i === 0 ? ' show' : ''}`} id={`sc${i}`}>
          {cat.tools.map(t => (
            <a class={`sidebar-navlink flex items-center gap-2 my-0.5 ${t.slug === current ? 'active' : ''}`} href={`/tools/${t.slug}`}>
              <span class="tool-icon-badge">{t.icon}</span>
              <span class="truncate">{t.name}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </nav>

  <!-- Footer -->
  <div class="flex items-center justify-between px-3 py-2 border-t border-white/8">
    <span class="text-[.6rem] text-white/30">🌙 Dark mode</span>
    <button class="dark-toggle w-7 h-7 rounded-full border-0 bg-white/8 text-white/50 text-sm flex items-center justify-center cursor-pointer hover:bg-white/12">🌙</button>
  </div>
</aside>

<style>
  .cat-chevron.rotate { transform: rotate(90deg); }
  .sidebar-search:focus { box-shadow: 0 0 0 2px rgba(99,102,241,.2); }
</style>