---
import tools from '../data/tools.json';
const current = Astro.url.pathname.replace('/tools/', '').replace(/\/$/, '') || 'index';
const allTools = tools.categories.flatMap(c => c.tools);
---

<div class="menu-title flex items-center gap-2 px-4 py-3 border-b border-base-300 sticky top-0 bg-base-200 z-10">
  <span class="text-lg">🚀</span>
  <div>
    <a href="/" class="font-bold text-base no-underline">WebApps</a>
    <div class="text-xs opacity-60">{allTools.length} tools</div>
  </div>
</div>

<div class="p-2 border-b border-base-300">
  <input type="text" class="sidebar-search input input-bordered input-xs w-full" placeholder="Cari tool...">
</div>

<nav class="flex-1 overflow-y-auto px-2 py-2 scrollbar-thin">
  {tools.categories.map((cat, i) => (
    <ul class="menu menu-xs mb-3">
      <li class="menu-title text-xs flex items-center gap-1">
        <span>{cat.icon}</span> {cat.name}
      </li>
      <li>
        <details open={i < 2}>
          <summary class="hidden"></summary>
          <ul>
            {cat.tools.map(t => (
              <li><a href={`/tools/${t.slug}`} class={`flex items-center gap-2 ${t.slug === current ? 'active' : ''}`}>
                <span class="w-5 h-5 flex items-center justify-center text-[10px] font-bold rounded bg-base-300 shrink-0">{t.icon}</span>
                <span class="truncate">{t.name}</span>
              </a></li>
            ))}
          </ul>
        </details>
      </li>
    </ul>
  ))}
</nav>

<div class="p-3 border-t border-base-300 flex items-center justify-between">
  <span class="text-xs opacity-40">🌙 Tema</span>
  <label class="swap swap-rotate">
    <input type="checkbox" id="themeToggleSidebar" />
    <span class="swap-off">☀️</span>
    <span class="swap-on">🌙</span>
  </label>
</div>

<script is:inline>
  const sToggle = document.getElementById('themeToggleSidebar');
  const cToggle = document.getElementById('themeToggle');
  if (sToggle && cToggle) {
    sToggle.checked = cToggle.checked;
    sToggle.addEventListener('change', () => { cToggle.click(); });
    cToggle.addEventListener('change', () => { sToggle.checked = cToggle.checked; });
  }
</script>