---
// ToolLayout.astro — main layout for all pages
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  keywords?: string;
  breadcrumbs?: { name: string; url: string }[];
  noindex?: boolean;
}

const { title, description, canonical, ogTitle, ogDescription, ogImage, keywords, breadcrumbs, noindex } = Astro.props;
const site = 'https://webapps.naufalrakha.my.id';
const pageUrl = canonical || Astro.url.pathname;
const fullUrl = pageUrl.startsWith('http') ? pageUrl : `${site}${pageUrl}`;
const img = ogImage || `${site}/og-image.png`;
const ogT = ogTitle || title;
const ogD = ogDescription || description;
const keyw = keywords || 'web tools, online tools, developer tools, web apps, naufal rakha';
const crumbs = breadcrumbs || [{ name: 'Beranda', url: '/tools' }, { name: title, url: pageUrl }];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keyw} />
    <link rel="canonical" href={fullUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="/style.css" rel="stylesheet" />

    <!-- OG -->
    <meta property="og:title" content={ogT} />
    <meta property="og:description" content={ogD} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={img} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="WebApps Naufal Rakha" />
    <meta property="og:logo" content={`${site}/logo-512.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogT} />
    <meta name="twitter:description" content={ogD} />
    <meta name="twitter:image" content={img} />

    <!-- JSON-LD BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": crumbs.map((c, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": c.name,
        "item": c.url.startsWith('http') ? c.url : `${site}${c.url}`
      }))
    })}></script>

    <!-- JSON-LD WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "WebApps Naufal Rakha",
      "url": site,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${site}/tools/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    })}></script>

    <!-- JSON-LD Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Naufal Rakha Putra",
      "url": "https://naufalrakha.my.id",
      "description": "Full-Stack Developer, Game Developer & AI Builder. Creator of WebApps — koleksi 40+ online tools gratis.",
      "sameAs": [
        "https://github.com/sternnaufal",
        "https://www.linkedin.com/in/naufal-rakha-putra"
      ]
    })}></script>
  </head>

  <body style="display:flex;min-height:100vh;">
    <!-- Desktop sidebar -->
    <div class="d-none d-md-flex">
      <Sidebar />
    </div>

    <!-- Page wrapper: content + footer -->
    <div style="display:flex;flex-direction:column;flex:1;min-width:0;">
      <!-- Main content -->
      <main id="main-content" class="flex-grow-1 px-4 py-3">
        <!-- Mobile navbar -->
        <nav class="d-md-none navbar navbar-dark mb-3 rounded" style="background:var(--gradient-dark);border:1px solid rgba(255,255,255,.08);">
          <div class="container-fluid px-2">
            <span class="navbar-brand mb-0 h1 d-flex align-items-center gap-2" style="font-size:.95rem">
              <img src="/favicon-48x48.png" alt="logo" width="24" height="24" class="rounded" />
              WebApps
            </span>
            <button id="mobileMenuBtn" class="btn btn-sm d-flex align-items-center gap-1" style="background:rgba(255,255,255,.1);border:none;color:#fff;border-radius:8px;padding:6px 12px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
              <span style="font-size:.8rem">Menu</span>
            </button>
          </div>
        </nav>

        <slot />
      </main>

      <!-- Footer (inside page wrapper, below main) -->
      <SiteFooter />
    </div>

    <!-- Mobile sidebar (bottom sheet) -->
    <div id="mobileSheetOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9998;transition:opacity .3s"></div>
    <div id="mobileSheet" style="position:fixed;bottom:0;left:0;right:0;z-index:9999;background:var(--gradient-dark);border-radius:16px 16px 0 0;max-height:85vh;display:flex;flex-direction:column;transform:translateY(100%);transition:transform .3s cubic-bezier(.32,.72,0,1);">
      <div class="d-flex align-items-center justify-content-between px-4 py-3" style="border-bottom:1px solid rgba(255,255,255,.08)">
        <div class="d-flex align-items-center gap-2">
          <span style="font-size:1.2rem">🚀</span>
          <span class="fw-bold text-white" style="font-size:.95rem">WebApps</span>
        </div>
        <button id="mobileSheetClose" class="btn btn-sm" style="background:rgba(255,255,255,.1);border:none;color:#fff;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;">✕</button>
      </div>
      <div class="px-3 py-2">
        <input type="text" id="mobileSearch" class="form-control form-control-sm" placeholder="Cari tool..." style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);color:#fff;font-size:.78rem;border-radius:6px;">
      </div>
      <div style="overflow-y:auto;flex:1;padding:0 8px 20px">
        <Sidebar />
      </div>
    </div>

    <!-- Scripts -->
    <script is:inline src="/sidebar.js"></script>
    <script is:inline>
      // Mobile sheet toggle
      const sheet = document.getElementById('mobileSheet');
      const overlay = document.getElementById('mobileSheetOverlay');
      const openBtn = document.getElementById('mobileMenuBtn');
      const closeBtn = document.getElementById('mobileSheetClose');
      if (sheet && openBtn) {
        function openSheet() { sheet.style.transform = 'translateY(0)'; overlay.style.display = 'block'; document.body.style.overflow = 'hidden'; }
        function closeSheet() { sheet.style.transform = 'translateY(100%)'; overlay.style.display = 'none'; document.body.style.overflow = ''; }
        openBtn.addEventListener('click', openSheet);
        if (closeBtn) closeBtn.addEventListener('click', closeSheet);
        overlay.addEventListener('click', closeSheet);
        // Escape key
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });
        // Sync mobile search with sidebar search
        const mobSearch = document.getElementById('mobileSearch');
        const sideSearch = document.querySelector('.sidebar-search');
        if (mobSearch && sideSearch) {
          mobSearch.addEventListener('input', function() { sideSearch.value = this.value; sideSearch.dispatchEvent(new Event('input')); });
          sideSearch.addEventListener('input', function() { mobSearch.value = this.value; });
        }
      }
    </script>
  </body>
</html>
