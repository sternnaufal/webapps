---
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  keywords?: string;
  breadcrumbs?: { name: string; url: string }[];
  noindex?: boolean;
}

const { title, description, canonical, ogTitle, ogDescription, ogImage, keywords, breadcrumbs, noindex } = Astro.props;
const site = 'https://webapps.naufalrakha.my.id';
const pageUrl = canonical || Astro.url.pathname;
const fullUrl = pageUrl.startsWith('http') ? pageUrl : `${site}${pageUrl}`;
const img = ogImage || `${site}/og-image.png`;
const ogT = ogTitle || title;
const ogD = ogDescription || description;
const keyw = keywords || 'web tools, online tools, developer tools, web apps, naufal rakha';
const crumbs = breadcrumbs || [{ name: 'Beranda', url: '/tools' }, { name: title, url: pageUrl }];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keyw} />
    <link rel="canonical" href={fullUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <meta property="og:title" content={ogT} />
    <meta property="og:description" content={ogD} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={img} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="WebApps Naufal Rakha" />
    <meta property="og:logo" content={`${site}/logo-512.png`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogT} />
    <meta name="twitter:description" content={ogD} />
    <meta name="twitter:image" content={img} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": crumbs.map((c, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": c.name,
        "item": c.url.startsWith('http') ? c.url : `${site}${c.url}`
      }))
    })}></script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "WebApps Naufal Rakha",
      "url": site,
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": `${site}/tools/?q={search_term_string}` },
        "query-input": "required name=search_term_string"
      }
    })}></script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Naufal Rakha Putra",
      "url": "https://naufalrakha.my.id",
      "description": "Full-Stack Developer, Game Developer & AI Builder. Creator of WebApps.",
      "sameAs": ["https://github.com/sternnaufal", "https://www.linkedin.com/in/naufal-rakha-putra"]
    })}></script>
  </head>

  <body class="flex min-h-screen">
    <div class="hidden md:flex shrink-0">
      <Sidebar />
    </div>

    <div class="flex flex-col flex-1 min-w-0">
      <main id="main-content" class="flex-1 px-4 py-3">
        <!-- Mobile navbar -->
        <nav class="md:hidden mb-3 rounded-lg" style="background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);border:1px solid rgba(255,255,255,.08)">
          <div class="flex items-center justify-between px-2 py-2">
            <span class="flex items-center gap-2 text-sm font-semibold text-white">
              <img src="/favicon-32x32.png" alt="logo" width="24" height="24" class="rounded" />
              WebApps
            </span>
            <button id="mobileMenuBtn" class="flex items-center gap-1 text-xs text-white bg-white/10 border-0 rounded-lg px-3 py-1.5 cursor-pointer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
              Menu
            </button>
          </div>
        </nav>

        <slot />
      </main>

      <SiteFooter />
    </div>

    <!-- Mobile sheet -->
    <div id="mobileSheetOverlay" class="hidden fixed inset-0 bg-black/50 z-[9998] transition-opacity duration-300"></div>
    <div id="mobileSheet" class="fixed bottom-0 left-0 right-0 z-[9999] rounded-t-2xl max-h-[85vh] flex flex-col translate-y-full transition-transform duration-300" style="background:linear-gradient(135deg,#0f0c29,#302b63,#24243e)">
      <div class="flex items-center justify-between px-4 py-3 border-b border-white/8">
        <div class="flex items-center gap-2">
          <span class="text-xl">🚀</span>
          <span class="font-bold text-white text-sm">WebApps</span>
        </div>
        <button id="mobileSheetClose" class="w-8 h-8 flex items-center justify-center rounded-full bg-white/10 border-0 text-white text-sm cursor-pointer">✕</button>
      </div>
      <div class="px-3 py-2">
        <input type="text" id="mobileSearch" class="w-full text-xs bg-white/7 border border-white/10 text-white rounded-md px-2 py-1.5 focus:border-accent focus:outline-none" placeholder="Cari tool...">
      </div>
      <div class="flex-1 overflow-y-auto px-2 pb-5">
        <Sidebar />
      </div>
    </div>

    <script is:inline src="/sidebar.js"></script>
    <script is:inline>
      const sheet = document.getElementById('mobileSheet');
      const overlay = document.getElementById('mobileSheetOverlay');
      const openBtn = document.getElementById('mobileMenuBtn');
      const closeBtn = document.getElementById('mobileSheetClose');
      if (sheet && openBtn) {
        function openS() { sheet.style.transform = 'translateY(0)'; overlay.style.display = 'block'; document.body.style.overflow = 'hidden'; }
        function closeS() { sheet.style.transform = 'translateY(100%)'; overlay.style.display = 'none'; document.body.style.overflow = ''; }
        openBtn.addEventListener('click', openS);
        if (closeBtn) closeBtn.addEventListener('click', closeS);
        overlay.addEventListener('click', closeS);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeS(); });
        const mobS = document.getElementById('mobileSearch');
        const sideS = document.querySelector('.sidebar-search');
        if (mobS && sideS) { mobS.addEventListener('input', function() { sideS.value = this.value; sideS.dispatchEvent(new Event('input')); }); sideS.addEventListener('input', function() { mobS.value = this.value; }); }
      }
    </script>
  </body>
</html>
